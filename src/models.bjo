;; bjostat/src/models.bjo — the module (bjostat models): linear models of
;; least squares, as R's lm, fitted by a collector.
;;
;; A model is a loop like any other statistic. Each row gives the response
;; and its predictors; a null is left out by the loop:
;;
;;     (loop (:for p* price) (:for a* area) (:for r* rooms)
;;           (:when-let (Some p) p*) (:when-let (Some a) a*) (:when-let (Some r) r*)
;;           (:acc (linear-model ["area" "rooms"] (Tuple p [a (cast double r)]))))
;;
;; is R's lm(price ~ area + rooms). The model has an intercept, as in R;
;; linear-model/origin has none, as R's `- 1`. simple-linear-model is the
;; model of one predictor, with no Vec for each row.
;;
;; The rows are not kept: each one is put into a QR decomposition by Givens
;; rotations, so the memory is that of p² numbers for p coefficients, and
;; the fit is as stable as R's QR. The result is an Err when the model
;; cannot be fitted: no more rows than coefficients, or a predictor that is
;; a linear combination of the others, where R gives NA.
;;
;; The standard errors, t values and p-values are those of R's summary.lm,
;; from the t distribution of n - p degrees of freedom; the F statistic tests
;; all predictors but the intercept at once.

(export
  LinearModel ModelError
  LinearModelling linear-model linear-model/origin
  SimpleModelling simple-linear-model
  model->table model->string model-predict
  ;; Generalized linear models
  GeneralizedModel GeneralizedModelling logistic-model poisson-model
  glm->table glm->string glm-predict
  ;; Intervals and predictors of categories
  model-intervals glm-intervals indicators indicator-names
  WithCategories with-categories
  model-anova anova-terms
  ;; Rows, after the fit
  model-residual model-leverage model-standardized-residual
  model-mean-interval model-prediction-interval glm-residual)

(import (std prelude))
(import (bjostat table))
(import (bjostat distributions))
(import (only (std maths) nan? exp))

(import/class (Regression (: Bjostat.Regression)) (Glm (: Bjostat.Glm)))

(import/extern
  (clr-make (: Bjostat.Regression.Make (-> bool Regression)))
  (clr-add (: Bjostat.Regression.Add (-> Regression double (Vec double) Regression)))
  (clr-add-one (: Bjostat.Regression.AddOne (-> Regression double double Regression)))
  (clr-problem (: Bjostat.Regression.Problem (-> Regression (Array string) string)))
  (clr-rows (: Bjostat.Regression.Rows (-> Regression long)))
  (clr-coefficients (: Bjostat.Regression.Coefficients (-> Regression int)))
  (clr-intercept? (: Bjostat.Regression.Intercept (-> Regression bool)))
  (clr-estimates (: Bjostat.Regression.Estimates (-> Regression (Array double))))
  (clr-rss (: Bjostat.Regression.ResidualSquares (-> Regression double)))
  (clr-tss (: Bjostat.Regression.TotalSquares (-> Regression double)))
  (clr-unscaled-errors (: Bjostat.Regression.UnscaledErrors (-> Regression (Array double))))
  (clr-unscaled-covariance (: Bjostat.Regression.UnscaledCovariance (-> Regression (Array double))))
  (clr-effects (: Bjostat.Regression.Effects (-> Regression (Array double))))
  (significant (: Bjostat.Regression.Significant (-> double int string)))
  (glm-make (: Bjostat.Glm.Make (-> int bool Glm)))
  (glm-add (: Bjostat.Glm.Add (-> Glm double (Vec double) Glm)))
  (glm-fit (: Bjostat.Glm.Fit (-> Glm (Array string) string)))
  (glm-estimates (: Bjostat.Glm.Estimates (-> Glm (Array double))))
  (glm-errors (: Bjostat.Glm.StandardErrors (-> Glm (Array double))))
  (glm-deviance (: Bjostat.Glm.Deviance (-> Glm double)))
  (glm-null-deviance (: Bjostat.Glm.NullDeviance (-> Glm double)))
  (glm-log-likelihood (: Bjostat.Glm.LogLikelihood (-> Glm double)))
  (glm-rows (: Bjostat.Glm.Rows (-> Glm long)))
  (glm-coefficients (: Bjostat.Glm.Coefficients (-> Glm int)))
  (glm-intercept? (: Bjostat.Glm.Intercept (-> Glm bool)))
  (glm-iterations (: Bjostat.Glm.Iterations (-> Glm int)))
  (glm-converged? (: Bjostat.Glm.Converged (-> Glm bool))))

;; ===========================================================================
;; The model
;; ===========================================================================

;; A fitted model. The terms are "(Intercept)", when the model has one, and
;; the names of the predictors; the estimates and the others are in their
;; order. `df` is that of the residuals, n - p. The F statistic and its
;; p-value test all predictors but the intercept, and are NaN for a model of
;; the intercept alone. `unscaled-covariance` is (X'X)⁻¹, row by row, R's
;; cov.unscaled: σ² times it is the covariance of the estimates. `effects`
;; is Q'y, R's effects, of which model-anova makes its sums of squares.
(type (: LinearModel
         (Record (: terms (Vec string))
                 (: estimates (Vec double))
                 (: standard-errors (Vec double))
                 (: t-values (Vec double))
                 (: p-values (Vec double))
                 (: sigma double)
                 (: df long)
                 (: rows long)
                 (: r-squared double)
                 (: adjusted-r-squared double)
                 (: f-statistic double)
                 (: f-p-value double)
                 (: unscaled-covariance (Vec double))
                 (: effects (Vec double))
                 (: intercept? bool))))

;; Why a model cannot be fitted.
(type (: ModelError (Record (: message string))))

(impl (Displayed ModelError)
  (defun (displayed e) (record-ref e message))
  (defun (display-into e b) (stringbuilder-add-string! b (record-ref e message))))

(: (-> Regression (Vec string) (Result ModelError LinearModel)))
(defun (fit m names)
  (def problem (clr-problem m (vec->array names)))
  (def predictors (- (clr-coefficients m) (if (clr-intercept? m) 1 0)))
  (cond
    ((not (= problem "")) (Err (ModelError (message problem))))
    ((not (= (vec-length names) predictors))
     (Err (ModelError (message (str "the rows have " (int->string predictors) (if (= predictors 1) " predictor" " predictors")
                                    ", and there are "
                                    (int->string (vec-length names)) " names.")))))
    (else (Ok (fitted m names)))))

(: (-> Regression (Vec string) LinearModel))
(defun (fitted m names)
  (def p (clr-coefficients m))
  (def intercept? (clr-intercept? m))
  (def n (clr-rows m))
  (def df (- n (cast long p)))
  (def dfd (cast double df))
  (def b (array->vec (clr-estimates m)))
  (def rss (clr-rss m))
  (def tss (clr-tss m))
  (def sigma (sqrt (/ rss dfd)))
  (def se (vec-map (fun (e) (* sigma e)) (array->vec (clr-unscaled-errors m))))
  (def ts {vecing (/ (vec-ref b i) (vec-ref se i)) (:for i (range 0 p))})
  (def ps (vec-map (fun (t) (* 2.0 (t-cdf (- 0.0 (abs t)) dfd))) ts))
  (def free (if intercept? (- p 1) p))
  (def r2 (- 1.0 (/ rss tss)))
  (def f (/ (/ (- tss rss) (cast double free)) (/ rss dfd)))
  (LinearModel (terms (if intercept? (vec-add-first names "(Intercept)") names))
               (estimates b) (standard-errors se) (t-values ts) (p-values ps)
               (sigma sigma) (df df) (rows n)
               (r-squared r2)
               (adjusted-r-squared (- 1.0 (* (- 1.0 r2)
                                              (/ (cast double (- n (if intercept? 1L 0L))) dfd))))
               (f-statistic (if (> free 0) f (/ 0.0 0.0)))
               (f-p-value (if (> free 0) (f-cdf f (cast double free) dfd #:lower? #f) (/ 0.0 0.0)))
               (unscaled-covariance (array->vec (clr-unscaled-covariance m)))
               (effects (array->vec (clr-effects m)))
               (intercept? intercept?)))

;; ===========================================================================
;; The collectors
;; ===========================================================================

;; A model of the response on the predictors named `names`, with an
;; intercept: each element is the response and a Vec of the predictors.
(type (: LinearModelling #:opaque (Struct (: names (Vec string)) (: intercept bool))))

(: (-> (Vec string) LinearModelling))
(defun (linear-model names) (LinearModelling (names names) (intercept #t)))

;; The same, with no intercept: the model goes through the origin.
(: (-> (Vec string) LinearModelling))
(defun (linear-model/origin names) (LinearModelling (names names) (intercept #f)))

(impl (Collector LinearModelling)
  (type %elem (Tuple double (Vec double)))
  (type %acc Regression)
  (type %out (Result ModelError LinearModel))
  (defun (collector-init c) (clr-make (record-ref c intercept)))
  (defun (collector-step c acc e)
    (match e ((Tuple y xs) (clr-add acc y xs))))
  (defun (collector-finish c acc) (fit acc (record-ref c names))))

;; A model of one predictor, with an intercept: each element is the response
;; and the predictor.
(type (: SimpleModelling #:opaque (Struct (: name string))))

(: (-> string SimpleModelling))
(defun (simple-linear-model name) (SimpleModelling (name name)))

(impl (Collector SimpleModelling)
  (type %elem (Tuple double double))
  (type %acc Regression)
  (type %out (Result ModelError LinearModel))
  (defun (collector-init c) (clr-make #t))
  (defun (collector-step c acc e)
    (match e ((Tuple y x) (clr-add-one acc y x))))
  (defun (collector-finish c acc) (fit acc [(record-ref c name)])))

;; ===========================================================================
;; What a model tells
;; ===========================================================================

;; The coefficients as a table, as broom's tidy: term, estimate, std.error,
;; statistic (the t value) and p.value.
(: (-> LinearModel Table))
(defun (model->table m)
  (match (make-table
           [(named-strings "term" (array->string-column (vec->array (record-ref m terms))))
            (named "estimate" (array->column (vec->array (record-ref m estimates))))
            (named "std.error" (array->column (vec->array (record-ref m standard-errors))))
            (named "statistic" (array->column (vec->array (record-ref m t-values))))
            (named "p.value" (array->column (vec->array (record-ref m p-values))))])
    ((Ok t) t)
    ((Err e) (panic! (displayed e)))))

;; The response the model gives for the predictors, in the order of its
;; names.
(: (-> LinearModel (Vec double) double))
(defun (model-predict m xs)
  (def b (record-ref m estimates))
  (def start (if (record-ref m intercept?) 1 0))
  (loop (:for i (range 0 (vec-length xs)))
        (:acc sum (summing (* (vec-ref b (+ i start)) (vec-ref xs i))))
        => (+ (if (record-ref m intercept?) (vec-ref b 0) 0.0) sum)))

;; A p-value as R prints it: below 2.2e-16 as "< 2.2e-16".
(: (-> double string))
(defun (p-value-text p)
  (if (< p 2.2e-16) "<2e-16" (significant p 3)))

;; Rows of cells as columns, each as wide as its widest cell: the first to
;; the left, the others to the right, as R prints a table of coefficients.
(: (-> (Vec (Vec string)) string))
(defun (columns->string rows)
  (def k (vec-length (vec-ref rows 0)))
  (def widths {vecing (loop (:for r rows) (:acc w (folding 0 (max w (string-length (vec-ref r c))))))
                      (:for c (range 0 k))})
  (def sb (stringbuilder-empty))
  (loop (:for r rows)
        (:do (loop (:for c (range 0 k))
                   (:do (when (> c 0) (stringbuilder-add-string! sb " "))
                        (stringbuilder-add-string!
                          sb (if (= c 0)
                                 (string-pad-right (vec-ref r c) (vec-ref widths c))
                                 (string-pad-left (vec-ref r c) (vec-ref widths c))))))
             (stringbuilder-add-string! sb "\n")))
  (stringbuilder->string sb))

;; The model as R's summary.lm prints it.
(: (-> LinearModel string))
(defun (model->string m)
  (def terms (record-ref m terms))
  (def rows
    {vecing [(vec-ref terms i)
             (significant (vec-ref (record-ref m estimates) i) 4)
             (significant (vec-ref (record-ref m standard-errors) i) 4)
             (significant (vec-ref (record-ref m t-values) i) 4)
             (p-value-text (vec-ref (record-ref m p-values) i))]
            (:for i (range 0 (vec-length terms)))})
  (def sb (stringbuilder-empty))
  (stringbuilder-add-string! sb "Coefficients:\n")
  (stringbuilder-add-string! sb (columns->string (vec-add-first rows ["" "Estimate" "Std. Error" "t value" "Pr(>|t|)"])))
  (stringbuilder-add-string!
    sb (str "\nResidual standard error: " (significant (record-ref m sigma) 4)
            " on " (long->string (record-ref m df)) " degrees of freedom\n"
            "Multiple R-squared: " (significant (record-ref m r-squared) 4)
            ", Adjusted R-squared: " (significant (record-ref m adjusted-r-squared) 4) "\n"))
  (unless (nan? (record-ref m f-statistic))
    (stringbuilder-add-string!
      sb (str "F-statistic: " (significant (record-ref m f-statistic) 4)
              " on " (int->string (- (vec-length terms) (if (record-ref m intercept?) 1 0)))
              " and " (long->string (record-ref m df)) " DF, p-value: "
              (p-value-text (record-ref m f-p-value)) "\n")))
  (stringbuilder->string sb))

;; ===========================================================================
;; Generalized linear models
;; ===========================================================================
;;
;; Logistic regression, R's glm(family = binomial), and Poisson regression,
;; R's glm(family = poisson), with their usual links, the logit and the log:
;;
;;     (loop (:for w* weight) (:for a* automatic)
;;           (:when-let (Some w) w*) (:when-let (Some a) a*)
;;           (:acc (logistic-model ["weight"] (Tuple (if a 1.0 0.0) [w]))))
;;
;; The fit is iteratively reweighted least squares, as R's: each step is a
;; QR of the rows weighted, so the collector keeps the rows, p + 1 numbers
;; for each. The standard errors, z values and p-values are those of R's
;; summary.glm, from the normal distribution, as the dispersion of both
;; families is 1.

;; A fitted model. `deviance` is the residual deviance, of `df` degrees of
;; freedom; `null-deviance` that of the model of the intercept alone, of
;; `null-df`. `aic` is Akaike's criterion, -2 ln L + 2 p, as R's. When the
;; fit did not converge in 25 steps, `converged?` is #f, as R warns; data
;; that a predictor separates do not converge, as their estimates grow
;; without end.
(type (: GeneralizedModel
         (Record (: family string)
                 (: terms (Vec string))
                 (: estimates (Vec double))
                 (: standard-errors (Vec double))
                 (: z-values (Vec double))
                 (: p-values (Vec double))
                 (: deviance double)
                 (: df long)
                 (: null-deviance double)
                 (: null-df long)
                 (: aic double)
                 (: rows long)
                 (: iterations int)
                 (: converged? bool)
                 (: intercept? bool))))

;; The model of a family on the predictors named `names`, with an intercept.
(type (: GeneralizedModelling #:opaque (Struct (: family int) (: names (Vec string)))))

;; Logistic regression: each element is a response from 0 to 1, most often
;; 0 or 1, and the predictors.
(: (-> (Vec string) GeneralizedModelling))
(defun (logistic-model names) (GeneralizedModelling (family 0) (names names)))

;; Poisson regression: each element is a count, and the predictors.
(: (-> (Vec string) GeneralizedModelling))
(defun (poisson-model names) (GeneralizedModelling (family 1) (names names)))

(impl (Collector GeneralizedModelling)
  (type %elem (Tuple double (Vec double)))
  (type %acc Glm)
  (type %out (Result ModelError GeneralizedModel))
  (defun (collector-init c) (glm-make (record-ref c family) #t))
  (defun (collector-step c acc e)
    (match e ((Tuple y xs) (glm-add acc y xs))))
  (defun (collector-finish c acc) (glm-of acc (record-ref c family) (record-ref c names))))

(: (-> Glm int (Vec string) (Result ModelError GeneralizedModel)))
(defun (glm-of m family names)
  (def problem (glm-fit m (vec->array names)))
  (def predictors (- (glm-coefficients m) (if (glm-intercept? m) 1 0)))
  (cond
    ((not (= problem "")) (Err (ModelError (message problem))))
    ((not (= (vec-length names) predictors))
     (Err (ModelError (message (str "the rows have " (int->string predictors)
                                    (if (= predictors 1) " predictor" " predictors")
                                    ", and there are " (int->string (vec-length names)) " names.")))))
    (else
     (def p (glm-coefficients m))
     (def b (array->vec (glm-estimates m)))
     (def se (array->vec (glm-errors m)))
     (def zs {vecing (/ (vec-ref b i) (vec-ref se i)) (:for i (range 0 p))})
     (def n (glm-rows m))
     (def intercept? (glm-intercept? m))
     (Ok (GeneralizedModel
           (family (if (= family 0) "binomial" "poisson"))
           (terms (if intercept? (vec-add-first names "(Intercept)") names))
           (estimates b) (standard-errors se) (z-values zs)
           (p-values (vec-map (fun (z) (* 2.0 (normal-cdf (- 0.0 (abs z))))) zs))
           (deviance (glm-deviance m)) (df (- n (cast long p)))
           (null-deviance (glm-null-deviance m)) (null-df (- n (if intercept? 1L 0L)))
           (aic (+ (* -2.0 (glm-log-likelihood m)) (* 2.0 (cast double p))))
           (rows n) (iterations (glm-iterations m)) (converged? (glm-converged? m))
           (intercept? intercept?))))))

;; The coefficients as a table, as broom's tidy: term, estimate, std.error,
;; statistic (the z value) and p.value.
(: (-> GeneralizedModel Table))
(defun (glm->table m)
  (match (make-table
           [(named-strings "term" (array->string-column (vec->array (record-ref m terms))))
            (named "estimate" (array->column (vec->array (record-ref m estimates))))
            (named "std.error" (array->column (vec->array (record-ref m standard-errors))))
            (named "statistic" (array->column (vec->array (record-ref m z-values))))
            (named "p.value" (array->column (vec->array (record-ref m p-values))))])
    ((Ok t) t)
    ((Err e) (panic! (displayed e)))))

;; The mean response the model gives for the predictors: a probability of
;; the logistic model, a mean count of the Poisson one.
(: (-> GeneralizedModel (Vec double) double))
(defun (glm-predict m xs)
  (def b (record-ref m estimates))
  (def start (if (record-ref m intercept?) 1 0))
  (def eta (loop (:for i (range 0 (vec-length xs)))
                 (:acc sum (summing (* (vec-ref b (+ i start)) (vec-ref xs i))))
                 => (+ (if (record-ref m intercept?) (vec-ref b 0) 0.0) sum)))
  (if (= (record-ref m family) "binomial")
      (/ 1.0 (+ 1.0 (exp (- 0.0 eta))))
      (exp eta)))

;; The model as R's summary.glm prints it.
(: (-> GeneralizedModel string))
(defun (glm->string m)
  (def terms (record-ref m terms))
  (def rows
    {vecing [(vec-ref terms i)
             (significant (vec-ref (record-ref m estimates) i) 4)
             (significant (vec-ref (record-ref m standard-errors) i) 4)
             (significant (vec-ref (record-ref m z-values) i) 4)
             (p-value-text (vec-ref (record-ref m p-values) i))]
            (:for i (range 0 (vec-length terms)))})
  (def sb (stringbuilder-empty))
  (stringbuilder-add-string! sb "Coefficients:\n")
  (stringbuilder-add-string! sb (columns->string (vec-add-first rows ["" "Estimate" "Std. Error" "z value" "Pr(>|z|)"])))
  (stringbuilder-add-string!
    sb (str "\n(Dispersion parameter for " (record-ref m family) " family taken to be 1)\n\n"
            "    Null deviance: " (significant (record-ref m null-deviance) 5)
            "  on " (long->string (record-ref m null-df)) "  degrees of freedom\n"
            "Residual deviance: " (significant (record-ref m deviance) 5)
            "  on " (long->string (record-ref m df)) "  degrees of freedom\n"
            "AIC: " (significant (record-ref m aic) 5) "\n\n"
            "Number of Fisher Scoring iterations: " (int->string (record-ref m iterations)) "\n"))
  (unless (record-ref m converged?)
    (stringbuilder-add-string! sb "The fit did not converge in 25 iterations.\n"))
  (stringbuilder->string sb))

;; ===========================================================================
;; Intervals
;; ===========================================================================

;; A table of term, lower and upper.
(: (-> (Vec string) (Vec double) (Vec double) double Table))
(defun (interval-table terms estimates errors q)
  (match (make-table
           [(named-strings "term" (array->string-column (vec->array terms)))
            (named "lower" (array->column {arraying (- (vec-ref estimates i) (* q (vec-ref errors i)))
                                                    (:for i (range 0 (vec-length terms)))}))
            (named "upper" (array->column {arraying (+ (vec-ref estimates i) (* q (vec-ref errors i)))
                                                    (:for i (range 0 (vec-length terms)))}))])
    ((Ok t) t)
    ((Err e) (panic! (displayed e)))))

;; The interval of each coefficient at the level, as R's confint: the
;; estimate plus and minus the t quantile of the residual degrees of freedom
;; times the standard error.
(: (-> LinearModel double Table))
(defun (model-intervals m level)
  (interval-table (record-ref m terms) (record-ref m estimates) (record-ref m standard-errors)
                  (t-quantile (/ (- 1.0 level) 2.0) (cast double (record-ref m df)) #:lower? #f)))

;; The same of a generalized model, with the normal quantile: Wald's
;; intervals, as R's confint.default. R's confint of a glm profiles the
;; likelihood instead, which gives other intervals of small samples.
(: (-> GeneralizedModel double Table))
(defun (glm-intervals m level)
  (interval-table (record-ref m terms) (record-ref m estimates) (record-ref m standard-errors)
                  (normal-quantile (/ (- 1.0 level) 2.0) #:lower? #f)))

;; ===========================================================================
;; Categories as predictors
;; ===========================================================================
;;
;; A category is a predictor of k levels as k - 1 predictors of 0 and 1, one
;; for each level but the first, as R's treatment contrasts: the first level
;; is in the intercept, and the coefficient of each other level is its
;; difference from the first.
;;
;;     (def (Ok levels) (category-levels t "region"))
;;     (def (Ok codes) (category-codes t "region"))
;;     (loop (:for c* codes) (:for y* sales)
;;           (:when-let (Some c) c*) (:when-let (Some y) y*)
;;           (:acc (linear-model (indicator-names "region" levels)
;;                               (Tuple y (indicators (vec-length levels) c)))))

;; The k - 1 predictors of the level whose code is `code`, of `count` levels:
;; 1 at the place of its level, and all 0 for the first level.
(: (-> int int (Vec double)))
(defun (indicators count code)
  {vecing (if (= code (+ i 1)) 1.0 0.0) (:for i (range 0 (- count 1)))})

;; The names of those predictors, as R's: the name and the level, for each
;; level but the first.
(: (-> string (Vec string) (Vec string)))
(defun (indicator-names name levels)
  (vec-map (fun (l) (str name l)) (vec-drop levels 1)))

;; ===========================================================================
;; Rows, after the fit
;; ===========================================================================
;;
;; A model does not keep its rows, so what it says of each row is made by a
;; second loop over them, as a column or a statistic:
;;
;;     (loop (:for s* speed) (:for d* dist) (:when-let (Some s) s*) (:when-let (Some d) d*)
;;           (:acc (column-building (model-residual m d [s]))))

;; The predictors with the intercept's 1 first, when the model has one.
(: (-> LinearModel (Vec double) (Vec double)))
(defun (full-row m xs)
  (if (record-ref m intercept?) (vec-add-first xs 1.0) xs))

;; y less the response the model gives for the predictors, R's residuals.
(: (-> LinearModel double (Vec double) double))
(defun (model-residual m y xs) (- y (model-predict m xs)))

;; The leverage of a row of the predictors, x' (X'X)⁻¹ x, R's hatvalues: how
;; much the row's own response moves its fitted value, from 0 to 1.
(: (-> LinearModel (Vec double) double))
(defun (model-leverage m xs)
  (def x (full-row m xs))
  (def c (record-ref m unscaled-covariance))
  (def p (vec-length x))
  (loop (:for i (range 0 p))
        (:acc (summing (* (vec-ref x i)
                          (loop (:for j (range 0 p))
                                (:acc (summing (* (vec-ref c (+ (* i p) j)) (vec-ref x j))))))))))

;; The residual over its standard error, σ √(1 - h), R's rstandard. Of a row
;; of the fit only: a new row has another error.
(: (-> LinearModel double (Vec double) double))
(defun (model-standardized-residual m y xs)
  (/ (model-residual m y xs)
     (* (record-ref m sigma) (sqrt (- 1.0 (model-leverage m xs))))))

(: (-> LinearModel double double))
(defun (t-of m level)
  (t-quantile (/ (- 1.0 level) 2.0) (cast double (record-ref m df)) #:lower? #f))

;; The interval of the mean response at the predictors, R's predict with
;; interval = "confidence": the fit plus and minus t σ √h.
(: (-> LinearModel (Vec double) double (Tuple double double)))
(defun (model-mean-interval m xs level)
  (def fit (model-predict m xs))
  (def half (* (t-of m level) (record-ref m sigma) (sqrt (model-leverage m xs))))
  (Tuple (- fit half) (+ fit half)))

;; The interval of a new response at the predictors, R's predict with
;; interval = "prediction": the fit plus and minus t σ √(1 + h).
(: (-> LinearModel (Vec double) double (Tuple double double)))
(defun (model-prediction-interval m xs level)
  (def fit (model-predict m xs))
  (def half (* (t-of m level) (record-ref m sigma) (sqrt (+ 1.0 (model-leverage m xs)))))
  (Tuple (- fit half) (+ fit half)))

;; y less the mean response of a generalized model, R's residuals of type
;; "response".
(: (-> GeneralizedModel double (Vec double) double))
(defun (glm-residual m y xs) (- y (glm-predict m xs)))

;; Categories as predictors of any of the models above: each element is the
;; response, the predictors of numbers, and the code of each category, and
;; each category is a predictor of its indicators, with R's names.
;;
;;     (def (Ok regions) (category-levels t "region"))
;;     (loop (:for c* (ok (category-codes t "region"))) (:for a* area) (:for y* price)
;;           (:when-let (Some c) c*) (:when-let (Some a) a*) (:when-let (Some y) y*)
;;           (:acc (with-categories linear-model ["area"] [(Tuple "region" regions)]
;;                                  (Tuple y [a] [c]))))
;;
;; `make` is the collector's constructor of names: linear-model,
;; linear-model/origin, logistic-model or poisson-model. Each category is its
;; name and its levels, as category-levels gives them.
(type (: (WithCategories %c) #:opaque (Struct (: inner %c) (: counts (Vec int)))))

(: (-> (-> (Vec string) %c) (Vec string) (Vec (Tuple string (Vec string))) (WithCategories %c)))
(defun (with-categories make names categories)
  (def all (vec-append-all names (loop (:for (Tuple name levels) categories)
                                      (:acc (vecing (indicator-names name levels))))))
  (WithCategories (inner (make all))
                  (counts (vec-map (fun (c) (vec-length (snd c))) categories))))

;; The vectors one after the other.
(: (-> (Vec %a) (Vec (Vec %a)) (Vec %a)))
(defun (vec-append-all first rest)
  (loop (:for v rest)
        (:acc all (folding first (loop (:for x v) (:acc a (folding all (vec-add a x))))))))

;; The predictors of numbers, then the indicators of each category's code.
(: (-> (Vec double) (Vec int) (Vec int) (Vec double)))
(defun (with-indicators xs codes counts)
  (vec-append-all xs {vecing (indicators (vec-ref counts i) (vec-ref codes i)) (:for i (range 0 (vec-length codes)))}))

(impl (Collector (WithCategories %c))
  (where (Collector %c #:elem (Tuple double (Vec double))))
  (type %elem (Tuple double (Vec double) (Vec int)))
  (type %acc (assoc Collector acc %c))
  (type %out (assoc Collector out %c))
  (defun (collector-init c) (collector-init (record-ref c inner)))
  (defun (collector-step c acc e)
    (match e
      ((Tuple y xs codes)
       (collector-step (record-ref c inner) acc (Tuple y (with-indicators xs codes (record-ref c counts)))))))
  (defun (collector-finish c acc) (collector-finish (record-ref c inner) acc)))

;; ===========================================================================
;; The analysis of variance
;; ===========================================================================

;; The terms of model-anova of a model with-categories made: each predictor
;; of numbers one column, and each category one for each level but the first.
(: (-> (Vec string) (Vec (Tuple string (Vec string))) (Vec (Tuple string int))))
(defun (anova-terms names categories)
  (vec-append-all (vec-map (fun (n) (Tuple n 1)) names)
                  [(vec-map (fun (c) (match c ((Tuple name levels) (Tuple name (- (vec-length levels) 1))))) categories)]))

;; R's anova of a linear model: a row for each term, in order, with its
;; degrees of freedom, its sequential sum of squares (what it adds to the
;; terms before it), its mean square, F against the residuals' mean square,
;; and the p-value of F; then the residuals. Each term is its name and how
;; many of the model's columns it is, as anova-terms gives them; they cover
;; the columns after the intercept.
(: (-> LinearModel (Vec (Tuple string int)) (Result ModelError Table)))
(defun (model-anova m terms)
  (def start (if (record-ref m intercept?) 1 0))
  (def columns (- (vec-length (record-ref m estimates)) start))
  (def covered (loop (:for (Tuple _ k) terms) (:acc (summing k))))
  (if (not (= covered columns))
      (Err (ModelError (message (str "the terms are " (int->string covered) " columns, and the model has "
                                     (int->string columns) " after the intercept."))))
      (Ok (anova-table m terms start))))

(: (-> LinearModel (Vec (Tuple string int)) int Table))
(defun (anova-table m terms start)
  (def effects (record-ref m effects))
  (def df (cast double (record-ref m df)))
  (def residual-ms (* (record-ref m sigma) (record-ref m sigma)))
  ;; The first column of each term, after those before it.
  (def firsts (loop (:for (Tuple _ k) terms) (:acc at (folding (vec-add [] start) (vec-add at (+ (vec-ref at (- (vec-length at) 1)) k))))))
  (def squares {vecing (loop (:for j (range (vec-ref firsts i) (vec-ref firsts (+ i 1))))
                             (:acc (summing (* (vec-ref effects j) (vec-ref effects j)))))
                       (:for i (range 0 (vec-length terms)))})
  (def dfs {vecing (cast double k) (:for (Tuple _ k) terms)})
  (def ms {vecing (/ (vec-ref squares i) (vec-ref dfs i)) (:for i (range 0 (vec-length terms)))})
  (def fs (vec-map (fun (x) (/ x residual-ms)) ms))
  (def nan (/ 0.0 0.0))
  (match (make-table
           [(named-strings "term" (array->string-column (vec->array (vec-add (vec-map fst terms) "Residuals"))))
            (named "df" (array->column (vec->array (vec-add dfs df))))
            (named "sum.sq" (array->column (vec->array (vec-add squares (* residual-ms df)))))
            (named "mean.sq" (array->column (vec->array (vec-add ms residual-ms))))
            (named "statistic" (array->column (vec->array (vec-add fs nan))
                                              #:valid (vec->array (vec-add (vec-map (fun (_) #t) fs) #f))))
            (named "p.value" (array->column (vec->array (vec-add {vecing (f-cdf (vec-ref fs i) (vec-ref dfs i) df #:lower? #f)
                                                                         (:for i (range 0 (vec-length terms)))}
                                                                 nan))
                                            #:valid (vec->array (vec-add (vec-map (fun (_) #t) fs) #f))))])
    ((Ok t) t)
    ((Err e) (panic! (displayed e)))))
