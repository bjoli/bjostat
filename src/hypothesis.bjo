;; bjostat/src/hypothesis.bjo — the module (bjostat hypothesis): t-tests as
;; collectors, and the chi-squared test of a table of counts, as R's t.test
;; and chisq.test.
;;
;;     (loop (:for x (skip-nulls weight)) (:acc (one-sample-t-test 70.0 x)))
;;     (loop (:for (Tuple g x) (complete-rows (Tuple group weight)))
;;           (:acc (welch-t-test 0.0 (Tuple (= g "treated") x))))
;;     (chi-squared-test (ok (table-crosstab survey "smoker" "sex")))
;;
;; A t-test gives the p-values of the three alternatives: `p-value` of the
;; two-sided one, R's default, and `p-less` and `p-greater` of the
;; one-sided ones, R's alternative = "less" and "greater". Its confidence
;; interval of any level is t-test-interval.

(export
  TTest TestError ChiSquaredTest
  OneSampleTTest one-sample-t-test PairedTTest paired-t-test
  TwoSampleTTest welch-t-test pooled-t-test
  t-test-interval t-test->string
  chi-squared-test chi-squared-test->string
  ;; Correlation, ranks and Fisher
  CorrelationTest CorrelationTesting
  RankTest RankSumTest SignedRankTest signed-rank-test PairedSignedRankTest
  FisherTest fisher-test
  ;; The accumulators, opaque
  CoSums)

(import (std prelude))
(import (bjostat table))
(import (bjostat stats))
(import (only (bjostat query) table-with ColumnBuilding))
(import (bjostat distributions))
(import (only (std maths) nan? atanh tanh))
(import (std mutable vec))

(import/extern
  (significant (: Bjostat.Regression.Significant (-> double int string)))
  (clr-rank-sum (: Bjostat.Ranks.RankSum (-> (Array double) (Array double) bool (Array double))))
  (clr-signed-rank (: Bjostat.Ranks.SignedRank (-> (Array double) bool (Array double))))
  (clr-fisher (: Bjostat.Ranks.Fisher (-> long long long long (Array double)))))

;; Why a test cannot be made.
(type (: TestError (Record (: message string))))

(impl (Displayed TestError)
  (defun (displayed e) (record-ref e message))
  (defun (display-into e b) (stringbuilder-add-string! b (record-ref e message))))

(: (-> string (Result TestError %a)))
(defun (refuse message) (Err (TestError (message message))))

;; ===========================================================================
;; t-tests
;; ===========================================================================

;; A t-test. `estimate` is the mean, the mean of the differences, or the
;; difference of the two means, and `means` the mean of each sample; `null`
;; is the value the hypothesis gives it. `df` is a double: Welch's degrees of
;; freedom are not whole.
(type (: TTest
         (Record (: method string)
                 (: estimate double)
                 (: means (Vec double))
                 (: counts (Vec long))
                 (: null double)
                 (: standard-error double)
                 (: statistic double)
                 (: df double)
                 (: p-value double)
                 (: p-less double)
                 (: p-greater double))))

(: (-> string double (Vec double) (Vec long) double double double TTest))
(defun (t-test-of method estimate means counts null se df)
  (def t (/ (- estimate null) se))
  (def less (t-cdf t df))
  (def greater (t-cdf t df #:lower? #f))
  (TTest (method method) (estimate estimate) (means means) (counts counts) (null null)
         (standard-error se) (statistic t) (df df)
         (p-value (min 1.0 (* 2.0 (min less greater)))) (p-less less) (p-greater greater)))

;; The interval of the level, as R's conf.int: the estimate plus and minus
;; the t quantile times the standard error.
(: (-> TTest double (Tuple double double)))
(defun (t-test-interval r level)
  (def q (* (t-quantile (/ (- 1.0 level) 2.0) (record-ref r df) #:lower? #f) (record-ref r standard-error)))
  (Tuple (- (record-ref r estimate) q) (+ (record-ref r estimate) q)))

;; A test of one sample, or None of fewer than two values or of values that
;; are all the same, which R refuses too.
(: (-> string Moments double (Result TestError TTest)))
(defun (one-sample method m null)
  (def n (moments-count m))
  (match (moments-variance m)
    ((Some v)
     (if (> v 0.0)
         (Ok (t-test-of method (moments-mean m) [(moments-mean m)] [n] null
                        (sqrt (/ v (cast double n))) (cast double (- n 1L))))
         (refuse "the values are all the same, so the t statistic is not a number.")))
    (None (refuse (str (long->string n) " values are too few: a t-test needs at least 2.")))))

;; R's t.test(x, mu = null): is the mean of the values `null`?
(type (: OneSampleTTest #:opaque (Struct (: null double))))

(: (-> double OneSampleTTest))
(defun (one-sample-t-test null) (OneSampleTTest (null null)))

(impl (Collector OneSampleTTest)
  (type %elem double)
  (type %acc Moments)
  (type %out (Result TestError TTest))
  (defun (collector-init c) no-moments)
  (defun (collector-step c m x) (moments-add m x))
  (defun (collector-finish c m) (one-sample "One Sample t-test" m (record-ref c null))))

;; R's t.test(x, y, paired = TRUE, mu = null): is the mean of x - y `null`?
;; Each element is a pair of x and y.
(type (: PairedTTest #:opaque (Struct (: null double))))

(: (-> double PairedTTest))
(defun (paired-t-test null) (PairedTTest (null null)))

(impl (Collector PairedTTest)
  (type %elem (Tuple double double))
  (type %acc Moments)
  (type %out (Result TestError TTest))
  (defun (collector-init c) no-moments)
  (defun (collector-step c m p) (match p ((Tuple x y) (moments-add m (- x y)))))
  (defun (collector-finish c m) (one-sample "Paired t-test" m (record-ref c null))))

;; Two samples: is the mean of the first less that of the second `null`?
;; Each element is #t for a value of the first sample and #f for one of the
;; second, and the value. Welch's test, R's default, does not take the
;; variances to be equal; the pooled one, R's var.equal = TRUE, does.
(type (: TwoSampleTTest #:opaque (Struct (: null double) (: pooled bool))))

(: (-> double TwoSampleTTest))
(defun (welch-t-test null) (TwoSampleTTest (null null) (pooled #f)))

(: (-> double TwoSampleTTest))
(defun (pooled-t-test null) (TwoSampleTTest (null null) (pooled #t)))

(impl (Collector TwoSampleTTest)
  (type %elem (Tuple bool double))
  (type %acc (Tuple Moments Moments))
  (type %out (Result TestError TTest))
  (defun (collector-init c) (Tuple no-moments no-moments))
  (defun (collector-step c acc e)
    (match (Tuple acc e)
      ((Tuple (Tuple a b) (Tuple first? x))
       (if first? (Tuple (moments-add a x) b) (Tuple a (moments-add b x))))))
  (defun (collector-finish c acc)
    (match acc ((Tuple a b) (two-samples a b (record-ref c null) (record-ref c pooled))))))

(: (-> Moments Moments double bool (Result TestError TTest)))
(defun (two-samples a b null pooled?)
  (match (Tuple (moments-variance a) (moments-variance b))
    ((Tuple (Some va) (Some vb))
     (def na (cast double (moments-count a)))
     (def nb (cast double (moments-count b)))
     (def means [(moments-mean a) (moments-mean b)])
     (def counts [(moments-count a) (moments-count b)])
     (def estimate (- (moments-mean a) (moments-mean b)))
     (if pooled?
         (let ((df (+ na nb -2.0)))
           (def pooled-variance (/ (+ (* (- na 1.0) va) (* (- nb 1.0) vb)) df))
           (if (> pooled-variance 0.0)
               (Ok (t-test-of " Two Sample t-test" estimate means counts null
                              (sqrt (* pooled-variance (+ (/ 1.0 na) (/ 1.0 nb)))) df))
               (refuse "the values are all the same, so the t statistic is not a number.")))
         (let ((ea (/ va na)) (eb (/ vb nb)))
           (def se2 (+ ea eb))
           (if (> se2 0.0)
               (Ok (t-test-of "Welch Two Sample t-test" estimate means counts null (sqrt se2)
                              (/ (* se2 se2) (+ (/ (* ea ea) (- na 1.0)) (/ (* eb eb) (- nb 1.0))))))
               (refuse "the values are all the same, so the t statistic is not a number.")))))
    (_ (refuse (str "the samples have " (long->string (moments-count a)) " and "
                    (long->string (moments-count b)) " values: a t-test needs at least 2 in each.")))))

;; The test as R prints it, in short.
(: (-> TTest string))
(defun (t-test->string r)
  (def (Tuple low high) (t-test-interval r 0.95))
  (str (record-ref r method) "\n"
       "t = " (significant (record-ref r statistic) 4)
       ", df = " (significant (record-ref r df) 5)
       ", p-value = " (significant (record-ref r p-value) 4) "\n"
       "95 percent confidence interval: " (significant low 6) " " (significant high 6) "\n"
       "estimate: " (significant (record-ref r estimate) 6) "\n"))

;; ===========================================================================
;; The chi-squared test of a table of counts
;; ===========================================================================

;; A chi-squared test of independence: `expected` has the counts that rows
;; and columns that do not depend on each other would give, in the shape of
;; the table.
(type (: ChiSquaredTest
         (Record (: statistic double)
                 (: df long)
                 (: p-value double)
                 (: corrected? bool)
                 (: expected Table))))

;; R's chisq.test of a table as table-crosstab makes it: the first column
;; names the rows, and each other column is a column of counts. Of a table of
;; two rows and two columns, Yates's correction is made, as R does, unless
;; `#:correct? #f`. An Err for a table of fewer than two rows or columns of
;; counts, a column that is not of counts, a null, or a negative count.
(: (-> Table (#:correct? bool) (Result TestError ChiSquaredTest)))
(defun (chi-squared-test t #:correct? #t)
  (def names (vec-drop (table-names t) 1))
  (def cols (vec-length names))
  (def rows (table-row-count t))
  (def columns
    (loop (:for name names)
          (:acc (vecing (: (column-as t name) (Result TableError (Cells long)))))))
  (def bad (find (fun (i) (err? (vec-ref columns i))) (range 0 cols)))
  (cond
    ((or (< rows 2) (< cols 2))
     (refuse (str "the table has " (int->string rows) " rows and " (int->string cols)
                  " columns of counts: a test needs at least 2 of each.")))
    ((some? bad)
     (refuse (str "'" (vec-ref names (option-value bad 0)) "' is not a column of counts, which are longs.")))
    (else
     (def counts
       {vecing {vecing (match (cells-get (column-of (vec-ref columns c)) r)
                         ((Some k) (cast double k))
                         (None -1.0))
                       (:for r (range 0 rows))}
               (:for c (range 0 cols))})
     (if (some? (find (fun (col) (some? (find (fun (k) (< k 0.0)) col))) counts))
         (refuse "a count is null or below 0.")
         (Ok (chi-squared-of t names counts rows cols correct?))))))

(: (-> (Result TableError (Cells long)) (Cells long)))
(defun (column-of r)
  (match r ((Ok c) c) ((Err e) (panic! (displayed e)))))

(: (-> Table (Vec string) (Vec (Vec double)) int int bool ChiSquaredTest))
(defun (chi-squared-of t names counts rows cols correct?)
  (def col-sums (vec-map (fun (col) (fold (fun (k s) (+ s k)) 0.0 col)) counts))
  (def row-sums {vecing (loop (:for c (range 0 cols)) (:acc (summing (vec-ref (vec-ref counts c) r))))
                        (:for r (range 0 rows))})
  (def total (fold (fun (k s) (+ s k)) 0.0 col-sums))
  (def expected {vecing {vecing (/ (* (vec-ref row-sums r) (vec-ref col-sums c)) total) (:for r (range 0 rows))}
                        (:for c (range 0 cols))})
  (def yates? (and correct? (= rows 2) (= cols 2)))
  (def statistic
    (loop (:for c (range 0 cols))
          (:acc (summing
                  (loop (:for r (range 0 rows))
                        (:let o (vec-ref (vec-ref counts c) r))
                        (:let e (vec-ref (vec-ref expected c) r))
                        ;; Yates: |O - E| less 1/2, but not below 0, as R's.
                        (:let d (if yates? (max 0.0 (- (abs (- o e)) 0.5)) (abs (- o e))))
                        (:acc (summing (/ (* d d) e))))))))
  (def df (cast long (* (- rows 1) (- cols 1))))
  ;; The table with each column of counts in place of its expected one.
  (def expected-table
    (loop (:for c (range 0 cols))
          (:acc tab (folding t
                             (match (table-with tab (vec-ref names c)
                                                {column-building e (:for e (vec-ref expected c))})
                               ((Ok t2) t2) ((Err e) (panic! (displayed e))))))))
  (ChiSquaredTest (statistic statistic) (df df)
                  (p-value (chi-squared-cdf statistic (cast double df) #:lower? #f))
                  (corrected? yates?) (expected expected-table)))

(: (-> ChiSquaredTest string))
(defun (chi-squared-test->string r)
  (str (if (record-ref r corrected?)
           "Pearson's Chi-squared test with Yates' continuity correction\n"
           "Pearson's Chi-squared test\n")
       "X-squared = " (significant (record-ref r statistic) 5)
       ", df = " (long->string (record-ref r df))
       ", p-value = " (significant (record-ref r p-value) 4) "\n"))

;; ===========================================================================
;; The correlation test
;; ===========================================================================

;; R's cor.test of Pearson's correlation: `estimate` is r, `statistic` its t
;; of n - 2 degrees of freedom, and the interval is of Fisher's z, NaN of
;; fewer than 4 pairs.
(type (: CorrelationTest
         (Record (: estimate double)
                 (: statistic double)
                 (: df long)
                 (: p-value double)
                 (: p-less double)
                 (: p-greater double)
                 (: lower double)
                 (: upper double))))

;; The sums of the pairs, each less the first pair's values.
(type (: CoSums #:opaque (Struct (: n long) (: kx double) (: ky double) (: sx double) (: sy double)
                                 (: sxx double) (: syy double) (: sxy double))))

;; Is the correlation of x and y 0? Each element is a pair; the interval is
;; of the level 0.95, as R's default.
(type (: CorrelationTesting (Union correlation-test)))

(impl (Collector CorrelationTesting)
  (type %elem (Tuple double double))
  (type %acc CoSums)
  (type %out (Result TestError CorrelationTest))
  (defun (collector-init c) (CoSums (n 0L) (kx 0.0) (ky 0.0) (sx 0.0) (sy 0.0) (sxx 0.0) (syy 0.0) (sxy 0.0)))
  (defun (collector-step c acc e)
    (match e
      ((Tuple x y)
       (def first? (= (record-ref acc n) 0L))
       (def kx (if first? x (record-ref acc kx)))
       (def ky (if first? y (record-ref acc ky)))
       (def dx (- x kx))
       (def dy (- y ky))
       (CoSums (n (+ (record-ref acc n) 1L)) (kx kx) (ky ky)
               (sx (+ (record-ref acc sx) dx)) (sy (+ (record-ref acc sy) dy))
               (sxx (+ (record-ref acc sxx) (* dx dx))) (syy (+ (record-ref acc syy) (* dy dy)))
               (sxy (+ (record-ref acc sxy) (* dx dy)))))))
  (defun (collector-finish c acc) (correlation-of acc)))

(: (-> CoSums (Result TestError CorrelationTest)))
(defun (correlation-of acc)
  (def n (cast double (record-ref acc n)))
  (def cxx (- (record-ref acc sxx) (/ (* (record-ref acc sx) (record-ref acc sx)) n)))
  (def cyy (- (record-ref acc syy) (/ (* (record-ref acc sy) (record-ref acc sy)) n)))
  (def cxy (- (record-ref acc sxy) (/ (* (record-ref acc sx) (record-ref acc sy)) n)))
  (cond
    ((< n 3.0) (refuse (str (long->string (record-ref acc n)) " pairs are too few: a correlation test needs at least 3.")))
    ((or (<= cxx 0.0) (<= cyy 0.0)) (refuse "the values of x or of y are all the same, so the correlation is not a number."))
    (else
     (def r (/ cxy (sqrt (* cxx cyy))))
     (def df (- n 2.0))
     (def t (* r (sqrt (/ df (- 1.0 (* r r))))))
     (def less (t-cdf t df))
     (def greater (t-cdf t df #:lower? #f))
     (def half (if (> n 3.0) (/ (normal-quantile 0.025 #:lower? #f) (sqrt (- n 3.0))) (/ 0.0 0.0)))
     (def z (atanh r))
     (Ok (CorrelationTest (estimate r) (statistic t) (df (cast long df))
                          (p-value (min 1.0 (* 2.0 (min less greater)))) (p-less less) (p-greater greater)
                          (lower (tanh (- z half))) (upper (tanh (+ z half))))))))

;; ===========================================================================
;; Wilcoxon's tests
;; ===========================================================================

;; Wilcoxon's rank-sum or signed-rank test: the statistic, W or V as R's, the
;; p-values of the three alternatives, and whether they are exact. As R, they
;; are exact when each sample has fewer than 50 values and none is tied (or 0
;; of a signed-rank test), and otherwise of the normal approximation with
;; the correction of 1/2.
(type (: RankTest
         (Record (: method string)
                 (: statistic double)
                 (: p-value double)
                 (: p-less double)
                 (: p-greater double)
                 (: exact? bool))))

(: (-> string (Array double) RankTest))
(defun (rank-test-of method r)
  (RankTest (method method) (statistic (array-ref r 0)) (p-value (array-ref r 1))
            (p-less (array-ref r 2)) (p-greater (array-ref r 3)) (exact? (= (array-ref r 4) 1.0))))

;; R's wilcox.test(x, y): do the values of the first sample tend to be above
;; or below those of the second? Each element is #t for a value of the first
;; sample and #f for one of the second, and the value.
(type (: RankSumTest (Union rank-sum-test)))

(impl (Collector RankSumTest)
  (type %elem (Tuple bool double))
  (type %acc (Tuple (MutableVec double) (MutableVec double)))
  (type %out (Result TestError RankTest))
  (defun (collector-init c) (Tuple (mutablevec) (mutablevec)))
  (defun (collector-step c acc e)
    (match (Tuple acc e)
      ((Tuple (Tuple a b) (Tuple first? x))
       (if first? (mutablevec-add! a x) (mutablevec-add! b x))
       acc)))
  (defun (collector-finish c acc)
    (match acc
      ((Tuple a b)
       (if (or (= (mutablevec-length a) 0) (= (mutablevec-length b) 0))
           (refuse "a rank-sum test needs a value in each sample.")
           (Ok (rank-test-of "Wilcoxon rank sum test"
                             (clr-rank-sum (mutablevec->array a) (mutablevec->array b) #t))))))))

;; R's wilcox.test(x, mu = null): are the values symmetric about `null`?
(type (: SignedRankTest #:opaque (Struct (: null double) (: paired bool))))

(: (-> double SignedRankTest))
(defun (signed-rank-test null) (SignedRankTest (null null) (paired #f)))

(impl (Collector SignedRankTest)
  (type %elem double)
  (type %acc (MutableVec double))
  (type %out (Result TestError RankTest))
  (defun (collector-init c) (mutablevec))
  (defun (collector-step c acc x) (mutablevec-add! acc (- x (record-ref c null))) acc)
  (defun (collector-finish c acc) (signed-rank-of acc "Wilcoxon signed rank test")))

;; R's wilcox.test(x, y, paired = TRUE): the signed-rank test of x - y.
(type (: PairedSignedRankTest (Union paired-signed-rank-test)))

(impl (Collector PairedSignedRankTest)
  (type %elem (Tuple double double))
  (type %acc (MutableVec double))
  (type %out (Result TestError RankTest))
  (defun (collector-init c) (mutablevec))
  (defun (collector-step c acc p) (match p ((Tuple x y) (mutablevec-add! acc (- x y)) acc)))
  (defun (collector-finish c acc) (signed-rank-of acc "Wilcoxon signed rank test, paired")))

(: (-> (MutableVec double) string (Result TestError RankTest)))
(defun (signed-rank-of d method)
  (def values (mutablevec->array d))
  (if (= 0 (loop (:for i (range 0 (array-length values))) (:when (not (= (array-ref values i) 0.0))) (:acc (counting i))))
      (refuse "a signed-rank test needs a value that is not its null.")
      (Ok (rank-test-of method (clr-signed-rank values #t)))))

;; ===========================================================================
;; Fisher's exact test
;; ===========================================================================

;; R's fisher.test of a 2 × 2 table: the p-values of the three alternatives,
;; of the hypergeometric distribution, and the conditional maximum
;; likelihood estimate of the odds ratio, as R gives it.
(type (: FisherTest
         (Record (: p-value double)
                 (: p-less double)
                 (: p-greater double)
                 (: odds-ratio double))))

;; Of a table as table-crosstab makes it, of two rows and two columns of
;; counts.
(: (-> Table (Result TestError FisherTest)))
(defun (fisher-test t)
  (def names (vec-drop (table-names t) 1))
  (def columns {vecing (: (column-as t name) (Result TableError (Cells long))) (:for name names)})
  (cond
    ((or (not (= (vec-length names) 2)) (not (= (table-row-count t) 2)))
     (refuse (str "Fisher's test here is of a table of 2 rows and 2 columns of counts, and this has "
                  (int->string (table-row-count t)) " and " (int->string (vec-length names)) ".")))
    ((some? (find (fun (c) (err? c)) columns)) (refuse "the columns are not of counts, which are longs."))
    (else
     (: (-> int int long))
     (defun (count c r) (option-value (cells-get (column-of (vec-ref columns c)) r) -1L))
     (def a (count 0 0)) (def b (count 1 0)) (def c (count 0 1)) (def d (count 1 1))
     (if (or (< a 0L) (< b 0L) (< c 0L) (< d 0L))
         (refuse "a count is null or below 0.")
         (let ((r (clr-fisher a b c d)))
           (Ok (FisherTest (p-value (array-ref r 0)) (p-less (array-ref r 1)) (p-greater (array-ref r 2))
                           (odds-ratio (array-ref r 3)))))))))
