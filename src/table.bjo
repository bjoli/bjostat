;; bjostat/src/table.bjo — the module (bjostat table).
;;
;; A table of named columns, held as an Apache Arrow record batch. Its schema
;; is known when the program runs, not when it compiles: a table read from a
;; file has the columns the file has. A column is taken out by name and type,
;; and the type is checked once, there:
;;
;;     (def t (read-arrow "sales.arrow") :propagate)
;;     (def price (doubles t "price") :propagate)   ; (Column double), or an Err
;;     (column-sum price)                           ; vectorized, nulls skipped
;;     (column-values price)                        ; the values, as a span
;;
;; From there on the column is typed, and a loop over its span is as fast as
;; one over an array. A `Table` is Arrow's `RecordBatch` itself, so it goes to
;; and from other Arrow code without a copy.
;;
;; A column may have nulls. Arrow keeps a value at a null too, and that value
;; is unspecified: `column-ref` answers None there, and a loop over
;; `column-values` reads `column-valid?` when `column-null-count` is not 0.

(export
  Table AnyColumn Column StringColumn
  ColumnType TableError NamedColumn

  ;; The schema
  table-names table-schema column-type column-nulls table-row-count table-column-count

  ;; Columns, typed
  doubles floats longs ints strings
  column-values column-length column-null-count column-valid? column-ref
  string-column-length string-column-null-count string-column-ref

  ;; Cells: a column at the type its use gives
  Cells column-as column->cells cells-ref cells-get cells-valid? cells-length cells-null-count cells-slice
  DateCells DateTimeCells InstantCells date-cells datetime-cells instant-cells
  RowSource NotNull skip-nulls CompleteRows RowColumns complete-rows
  cells-window window-rows lowest-bit

  ;; Aggregates
  column-sum column-mean column-min column-max column-count

  ;; Making tables
  array->column array->string-column named named-strings named-any make-table
  table-select table-slice TableRows table-rows
  SortKey table-sort
  inner-join left-join semi-join anti-join
  table-distinct table-append pivot-longer pivot-wider
  table-count table-crosstab

  ;; Categories
  table-categorize category-levels category-codes string-numbers

  ;; Files
  read-arrow write-arrow

  ;; Printing
  table->string

  ;; A script's unwrapper: the value, or the panic of the Err. The `of ...`
  ;; family that once sat here was a stopgap; a `:panic` failure part on `def`
  ;; is where this belongs.
  or-panic)

(import (std prelude))
(import (only (std datetime) Date DateTime Instant unix-days->date unix-microseconds->instant
              instant->utc-datetime))
(import (std parallel))
(import (only (std simd) Simd128 Simd256))
(import (only (std maths) quotient))
(import (only (std atomic) atomic-array-increment!))
(import (only (std array) array-fill!))

;; SimdSource, for the cells of a column of numbers: the re-exported methods
;; carry the trait to importers, as `chunk-size` carries Chunkable.
(re-export simd128-load simd256-load simd128-lanes simd256-lanes simd-source-length)

;; Chunkable, for the parts of tables and cells. A re-exported method carries
;; its trait to importers.
(re-export chunk-size chunks)

(import/extern
  (install-workers (: Bjostat.Workers.Install (-> (-> int (-> int Unit) Unit) int void))))

;; The glue of this module (Categories, Counts, Join, Reshape, Sort) runs its parts on (std parallel)'s compute
;; threads. See glue/Workers.cs.
(: (-> int (-> int Unit) Unit))
(defun (run-on-compute-threads n work)
  (ignore (computing-each n work))
  unit)

(def _workers
  (begin (install-workers run-on-compute-threads (compute-thread-count)) #t))

(import/class
  (Table (: Apache.Arrow.RecordBatch))
  (AnyColumn (: Apache.Arrow.IArrowArray))
  ((Column %a) (: Apache.Arrow.PrimitiveArray))
  (StringColumn (: Apache.Arrow.StringArray))
  ((ClrCells %a) (: Bjostat.Cells))
  (ArrowType (: Apache.Arrow.Types.IArrowType))
  (Schema (: Apache.Arrow.Schema))
  (Field (: Apache.Arrow.Field))
  (ArrayData (: Apache.Arrow.ArrayData)))

(import/extern
  ;; Any column
  (clr-type-name (: Bjostat.Columns.TypeName (-> AnyColumn string)))
  (any-length (: Bjostat.Columns.Length (-> AnyColumn int)))
  (any-null-count (: Bjostat.Columns.NullCount (-> AnyColumn int)))
  (any->string (: Bjostat.Columns.CellText (-> AnyColumn int int string)))
  (column->any (: Bjostat.Columns.Any (-> (Column %a) AnyColumn)))
  (strings->any (: Bjostat.Columns.AnyStrings (-> StringColumn AnyColumn)))

  ;; Typed columns, after the type was checked
  (as-doubles (: Bjostat.Columns.AsDoubles (-> AnyColumn (Column double))))
  (as-floats (: Bjostat.Columns.AsFloats (-> AnyColumn (Column float))))
  (as-longs (: Bjostat.Columns.AsLongs (-> AnyColumn (Column long))))
  (as-ints (: Bjostat.Columns.AsInts (-> AnyColumn (Column int))))
  (as-strings (: Bjostat.Columns.AsStrings (-> AnyColumn StringColumn)))

  (column-values (: Bjostat.Columns.Values (-> (Column %a) (RoSpan %a))))
  (column-length (: Bjostat.Columns.TypedLength (-> (Column %a) int)))
  (column-null-count (: Bjostat.Columns.TypedNullCount (-> (Column %a) int)))
  (column-valid? (: Bjostat.Columns.TypedIsValid (-> (Column %a) int bool)))
  (column-ref (: Bjostat.Columns.Ref (-> (Column %a) int (Option %a))))
  (string-column-length (: Bjostat.Columns.StringsLength (-> StringColumn int)))
  (string-column-null-count (: Bjostat.Columns.StringsNullCount (-> StringColumn int)))
  (string-column-ref (: Bjostat.Columns.StringRef (-> StringColumn int (Option string))))

  ;; Cells, at the type their use gives. #:uses-type: these test typeof(T),
  ;; so a use that does not decide the type is a compile error.
  (clr-cells-of (: Bjostat.CellsOps.Of (-> AnyColumn (Option (ClrCells %a))) #:uses-type))
  (clr-cells-name (: Bjostat.CellsOps.NameOf (-> (Option (ClrCells %a)) string) #:uses-type))
  (clr-cells-ref (: Bjostat.CellsOps.Ref (-> (ClrCells %a) int %a)))
  (clr-cells-get (: Bjostat.CellsOps.Get (-> (ClrCells %a) int (Option %a))))
  (clr-cells-valid? (: Bjostat.CellsOps.IsValid (-> (ClrCells %a) int bool)))
  (clr-cells-set (: Bjostat.CellsOps.Set (-> (ClrCells %a) int %a (ClrCells %a)) #:uses-type))
  (clr-cells-length (: Bjostat.CellsOps.Length (-> (ClrCells %a) int)))
  (clr-cells-slice (: Bjostat.CellsOps.Slice (-> (ClrCells %a) int int (ClrCells %a))))
  (clr-cells-null-count (: Bjostat.CellsOps.NullCount (-> (ClrCells %a) int)))
  (clr-cells-contiguous? (: Bjostat.CellsOps.IsContiguous (-> (ClrCells %a) bool)))
  (clr-cells-values (: Bjostat.CellsOps.Values (-> (ClrCells %a) (RoSpan %a))))
  (clr-cells-valid (: Bjostat.CellsOps.Valid (-> (ClrCells %a) (RoSpan byte))))
  ;; The next row with a value, of one column or of all of 2, 3 or 4, found
  ;; 57 rows at a time in the valid bitmaps.
  (clr-cells-next-valid (: Bjostat.CellsOps.NextValid (-> (ClrCells %a) int int)))
  (clr-cells-window (: Bjostat.CellsOps.Window (-> (ClrCells %a) int int long)))
  (clr-cells-of-column (: Bjostat.CellsOps.OfColumn (-> (Column %a) (ClrCells %a))))
  (clr-cells-load256 (: Bjostat.CellsOps.Load256 (-> (ClrCells %a) int (Simd256 %a))))
  (clr-cells-load128 (: Bjostat.CellsOps.Load128 (-> (ClrCells %a) int (Simd128 %a))))
  (clr-cells-lanes256 (: Bjostat.CellsOps.Lanes256 (-> (ClrCells %a) int)))
  (clr-cells-lanes128 (: Bjostat.CellsOps.Lanes128 (-> (ClrCells %a) int)))
  (lowest-bit (: Bjostat.CellsOps.LowestBit (-> long int)))
  (clr-next-complete-2 (: Bjostat.CellsOps.NextComplete (-> (ClrCells %a) (ClrCells %b) int int int)))
  (clr-next-complete-3 (: Bjostat.CellsOps.NextComplete (-> (ClrCells %a) (ClrCells %b) (ClrCells %c) int int int)))
  (clr-next-complete-4 (: Bjostat.CellsOps.NextComplete
                          (-> (ClrCells %a) (ClrCells %b) (ClrCells %c) (ClrCells %d) int int int)))
  (clr-next-complete-5 (: Bjostat.CellsOps.NextComplete
                          (-> (ClrCells %a) (ClrCells %b) (ClrCells %c) (ClrCells %d) (ClrCells %e) int int int)))
  (clr-next-complete-6 (: Bjostat.CellsOps.NextComplete
                          (-> (ClrCells %a) (ClrCells %b) (ClrCells %c) (ClrCells %d) (ClrCells %e)
                              (ClrCells %f) int int int)))
  (clr-day-cells (: Bjostat.TimeCells.Days (-> AnyColumn (Option (ClrCells int)))))
  (clr-micro-cells (: Bjostat.TimeCells.Micros (-> AnyColumn bool (Option (ClrCells long)))))

  ;; Building. The flags are empty for a column with no nulls, or one for
  ;; each value, #f at a null.
  (clr-from-array (: Bjostat.Columns.FromArray (-> (Array %a) (Array bool) (Column %a)) #:uses-type))
  (clr-from-strings (: Bjostat.Columns.FromStrings (-> (Array string) (Array bool) StringColumn)))

  ;; Aggregates of a span with no nulls, vectorized.
  (tensor-sum (: System.Numerics.Tensors.TensorPrimitives.Sum (-> (RoSpan %a) %a)))
  (tensor-min (: System.Numerics.Tensors.TensorPrimitives.Min (-> (RoSpan %a) %a)))
  (tensor-max (: System.Numerics.Tensors.TensorPrimitives.Max (-> (RoSpan %a) %a)))
  (number->double (: System.Double.CreateChecked (-> %a double)))
  (clr-nan (: System.Double.NaN #:get))

  ;; Tables
  (clr-make-table (: Bjostat.Tables.Make (-> (Array string) (Array AnyColumn) int Table)))
  (clr-names (: Bjostat.Tables.Names (-> Table (Array string))))
  (table-column-count (: Bjostat.Tables.ColumnCount (-> Table int)))
  (table-row-count (: Bjostat.Tables.RowCount (-> Table int)))
  (clr-column (: Bjostat.Tables.Column (-> Table int AnyColumn)))
  (clr-index-of (: Bjostat.Tables.IndexOf (-> Table string int)))
  (clr-slice (: Bjostat.Tables.Slice (-> Table int int Table)))
  (clr-unsortable (: Bjostat.Sorting.Unsortable (-> AnyColumn string)))
  (clr-sort-by (: Bjostat.Sorting.SortBy (-> Table (Array int) (Array bool) Table)))
  (clr-join (: Bjostat.Joins.Join (-> Table Table (Array string) int Table)))
  (clr-key-problem (: Bjostat.Joins.KeyProblem (-> Table Table (Array string) string)))

  ;; Reshaping: the kernels of glue/Reshape.cs and glue/Join.cs.
  (clr-firsts (: Bjostat.ReshapeOps.Firsts (-> (Array AnyColumn) int (Array int))))
  (clr-groups (: Bjostat.ReshapeOps.Groups (-> (Array AnyColumn) int (out (Array int)) (Tuple (Array int) (Array int)))))
  (clr-string-ids (: Bjostat.ReshapeOps.StringIds (-> StringColumn (out (Array int)) (Tuple (Array int) (Array int)))))
  (clr-concat (: Bjostat.ReshapeOps.Concat (-> (Array AnyColumn) ArrowType AnyColumn)))
  (clr-interleavable? (: Bjostat.Reshape.Interleavable (-> ArrowType bool)))
  (clr-interleaved (: Bjostat.Reshape.Interleaved (-> (Array AnyColumn) int AnyColumn)))
  (clr-repeated (: Bjostat.Reshape.Repeated (-> (Array string) int AnyColumn)))
  (clr-select (: Bjostat.Reshape.Select (-> Table (Array int) Table)))
  (clr-take (: Bjostat.Query.Take (-> Table (Array int) int Table)))
  (clr-take-or-null (: Bjostat.Joins.TakeOrNull (-> Table (Array int) (Array AnyColumn))))
  (clr-nulls (: Bjostat.Joins.Nulls (-> ArrowType int AnyColumn)))
  (clr-key-type? (: Bjostat.Joins.KeyType (-> ArrowType bool)))
  (clr-same-type? (: Bjostat.Joins.SameType (-> ArrowType ArrowType bool)))
  (clr-arrow-name (: Bjostat.ColumnTypes.ArrowName (-> ArrowType string)))
  (clr-from-fields (: Bjostat.Tables.FromFields (-> (Array Field) (Array AnyColumn) int Table)))
  (clr-new-field (: Bjostat.Tables.NewField (-> string ArrowType Field)))
  (clr-any-valid? (: Bjostat.Columns.IsValid (-> AnyColumn int bool)))
  (clr-schema (: Apache.Arrow.RecordBatch.Schema (-> Table Schema) #:get))
  (schema-field (: Apache.Arrow.Schema.GetFieldByIndex (-> Schema int Field)))
  (field-name (: Apache.Arrow.Field.Name (-> Field string) #:get))
  (field-type (: Apache.Arrow.Field.DataType (-> Field ArrowType) #:get))
  (clr-string-type (: Apache.Arrow.Types.StringType.Default #:get))
  (clr-data (: Apache.Arrow.IArrowArray.Data (-> AnyColumn ArrayData) #:get))
  (data-type (: Apache.Arrow.ArrayData.DataType (-> ArrayData ArrowType) #:get))

  ;; A TableProblem is a table the arguments cannot make.
  ;; For the counts: the groups of the keys with their order, and the ids of
  ;; a column's values in the order of table-sort.
  (clr-groups-in-order (: Bjostat.ReshapeOps.GroupsInOrder
                          (-> (Array AnyColumn) int (out (Array int)) (out (Array int))
                              (Tuple (Array int) (Array int) (Array int)))))
  (clr-sorted-ids (: Bjostat.ReshapeOps.SortedIds (-> AnyColumn (Option (Tuple (Array int) int)))))
  (clr-dense-limit (: Bjostat.ReshapeOps.DenseLimit long #:get))
  (clr-level-count (: Bjostat.ReshapeOps.LevelCount (-> AnyColumn int)))
  (clr-longs-at (: Bjostat.Columns.FromArrayAt (-> (Array long) (Array int) (Column long))))
  (clr-categorize (: Bjostat.Categories.Categorize (-> Table string (Array string) Table)
                     #:exceptions (Bjostat.TableProblem)))
  (clr-levels (: Bjostat.Categories.Levels (-> AnyColumn (Array string))))
  (clr-codes (: Bjostat.Categories.Codes (-> AnyColumn AnyColumn)))
  (clr-first-seen (: Bjostat.Categories.FirstSeen (-> AnyColumn AnyColumn)))

  ;; Files. Arrow reports a file it cannot read with exceptions of several
  ;; types, so every exception is an Err.
  (clr-read-file (: Bjostat.Tables.ReadFile (-> string Table) #:exceptions (System.Exception)))
  (clr-write-file (: Bjostat.Tables.WriteFile (-> Table string void) #:exceptions (System.Exception))))

;; ===========================================================================
;; Errors and types
;; ===========================================================================

;; What a table refused: a column it does not have, one of another type, or
;; columns that do not make a table.
(type (: TableError (Record (: message string))))

(impl (Displayed TableError)
  (defun (displayed e) (record-ref e message))
  (defun (display-into e b) (stringbuilder-add-string! b (record-ref e message))))

(: (-> string (Result TableError %a)))
(defun (refuse message) (Err (TableError (message message))))

;; The value, or a panic carrying the message the Err would have given: for a
;; script, where a misspelt column is a bug and not a case to handle. A chain
;; of steps that can fail is threaded with `try->` and unwrapped once with
;; this, or a `def` takes the `:panic` failure part, which does the same where
;; the language has it. The message is the one the Err has.
;;
;; Any Result whose error is Displayed: a table's, a model's, a test's. A
;; package that answers a Result of its own error type writes no unwrapper of
;; its own — bjostat-plot's examples each had one before this.
(: (-> (Result %e %a) %a) (where (Displayed %e)))
(defun (or-panic r)
  (match r
    ((Ok v) v)
    ((Err e) (panic! (displayed e)))))

;; The type of a column's values. `Dates`, `DateTimes` and `Instants` are
;; columns of the types Date, DateTime and Instant of (std datetime): Arrow's
;; Date32, timestamps with no time zone, and timestamps with one. `Bool` is
;; Arrow's Boolean, a bit for each value; its cells are bools. `Category` is
;; a column of strings from a small set, as R's factor: an Arrow dictionary
;; of int codes and string levels; its cells are strings. `Other` is any
;; Arrow type this module does not take apart yet, by Arrow's name for it:
;; Decimal and so on. A table holds it, prints it and writes it.
(type (: ColumnType (Union Double Float Long Int Short Byte UShort UInt ULong
                               String Bool Category Dates DateTimes Instants
                               (: Other string))))

(: (-> AnyColumn ColumnType))
(defun (type-of-column c)
  (match (clr-type-name c)
    ("Double" Double)
    ("Float" Float)
    ("Int64" Long)
    ("Int32" Int)
    ("Int16" Short)
    ("UInt8" Byte)
    ("UInt16" UShort)
    ("UInt32" UInt)
    ("UInt64" ULong)
    ("String" String)
    ("Boolean" Bool)
    ("Category" Category)
    ("Date32" Dates)
    ("Timestamp" DateTimes)
    ("TimestampTz" Instants)
    (name (Other name))))

(: (-> ColumnType string))
(defun (type-text t)
  (match t
    (Double "double")
    (Float "float")
    (Long "long")
    (Int "int")
    (Short "short")
    (Byte "byte")
    (UShort "ushort")
    (UInt "uint")
    (ULong "ulong")
    (String "string")
    (Bool "bool")
    (Category "category")
    (Dates "date")
    (DateTimes "datetime")
    (Instants "instant")
    ((Other name) name)))

(impl (Displayed ColumnType)
  (defun (displayed t) (type-text t))
  (defun (display-into t b) (stringbuilder-add-string! b (type-text t))))

;; ===========================================================================
;; The schema
;; ===========================================================================

(: (-> Table (Vec string)))
(defun (table-names t) (array->vec (clr-names t)))

;; Each column's name and type, in order.
(: (-> Table (Vec (Tuple string ColumnType))))
(defun (table-schema t)
  {vecing (Tuple name (type-of-column (clr-column t i)))
          (:for (Tuple i name) (enumerate (table-names t)))})

(: (-> Table string (Option ColumnType)))
(defun (column-type t name)
  (def i (clr-index-of t name))
  (if (< i 0) None (Some (type-of-column (clr-column t i)))))

;; How many nulls the column of the name has, or None when there is none.
(: (-> Table string (Option int)))
(defun (column-nulls t name)
  (def i (clr-index-of t name))
  (if (< i 0) None (Some (any-null-count (clr-column t i)))))

(: (-> Table string (Result TableError AnyColumn)))
(defun (find-column t name)
  (def i (clr-index-of t name))
  (if (< i 0)
      (refuse (str "the table has no column '" name "'. Its columns are: "
                   (string-join (table-names t) ", ") "."))
      (Ok (clr-column t i))))

;; The column `name` as the type `wanted`, through `convert`, or an Err that
;; says what it is instead. The one check of a column's type.
(: (-> Table string ColumnType (-> AnyColumn %c) (Result TableError %c)))
(defun (typed t name wanted convert)
  (def (Ok c) (find-column t name) :propagate)
  (def have (type-of-column c))
  (if (= (type-text have) (type-text wanted))
      (Ok (convert c))
      (refuse (str "'" name "' is a column of " (type-text have) ", not of " (type-text wanted) "."))))

(: (-> Table string (Result TableError (Column double))))
(defun (doubles t name) (typed t name Double as-doubles))

(: (-> Table string (Result TableError (Column float))))
(defun (floats t name) (typed t name Float as-floats))

(: (-> Table string (Result TableError (Column long))))
(defun (longs t name) (typed t name Long as-longs))

(: (-> Table string (Result TableError (Column int))))
(defun (ints t name) (typed t name Int as-ints))

(: (-> Table string (Result TableError StringColumn)))
(defun (strings t name) (typed t name String as-strings))

;; The column `name` as cells of the type the caller uses them at, or an Err
;; that says what the column holds. No type is written: in
;;
;;     (def (Ok price) (column-as t "price") :propagate)
;;     (> (cells-ref price 0) 10.0)
;;
;; the comparison with 10.0 makes them cells of double.
;; A column read at one type. A struct around the cells of the glue, so that
;; it can be Iterable, which a .NET type cannot be outside the prelude.
(type (: (Cells %a) #:opaque (Struct (: clr (ClrCells %a)))))

(: (-> (Cells %a) int %a))
(defun (cells-ref c i) (clr-cells-ref (record-ref c clr) i))

;; The value at row `i`, or None at a null.
(: (-> (Cells %a) int (Option %a)))
(defun (cells-get c i) (clr-cells-get (record-ref c clr) i))

(: (-> (Cells %a) int bool))
(defun (cells-valid? c i) (clr-cells-valid? (record-ref c clr) i))

(: (-> (Cells %a) int))
(defun (cells-length c) (clr-cells-length (record-ref c clr)))

(: (-> (Cells %a) int))
(defun (cells-null-count c) (clr-cells-null-count (record-ref c clr)))

;; The rows from `from` to `to`, over the same Arrow buffers. Raises
;; ArgumentOutOfRangeException when the range is outside the column.
(: (-> (Cells %a) int int (Cells %a)))
(defun (cells-slice c from to) (Cells (clr (clr-cells-slice (record-ref c clr) from to))))

;; A column as a collection `get`, `try-get`, `set` and `update` reach: a row
;; by its index, as a `Vec`'s element is.
;;
;;     (get price 3)             ;; the value of row 3
;;     (try-get price 3)         ;; None at a null
;;     (set price 3 9.5)         ;; a new column with row 3 changed
;;     (update price 3 (fun (p) (* 2.0 p)))
;;
;; `ref` is the unchecked read and `try-ref` the checked one, as they are for
;; a `Vec` and a `Map`: `ref` is `cells-ref`, so it answers whatever Arrow
;; keeps under a null, and `try-ref` is `cells-get`, which answers None there.
;; An Arrow array cannot be written, so `ref-set` answers a new column: the
;; table it came from is untouched.
(impl (Refable (Cells %a))
  (type %index int)
  (type %out %a)
  (defun (ref c i) (cells-ref c i))
  (defun (try-ref c i) (cells-get c i)))

(impl (Settable (Cells %a))
  (type %index int)
  (type %in %a)
  (defun (ref-set c i v) (Cells (clr (clr-cells-set (record-ref c clr) i v)))))

(: (-> (Column %a) (Cells %a)))
(defun (column->cells c) (Cells (clr (clr-cells-of-column c))))

(: (-> Table string (Result TableError (Cells %a))))
(defun (column-as t name)
  (def (Ok c) (find-column t name) :propagate)
  (def found (clr-cells-of c))
  (match found
    ((Some cells) (Ok (Cells (clr cells))))
    (None (refuse (str "'" name "' is a column of " (type-text (type-of-column c))
                       ", not of " (clr-cells-name found) ".")))))

;; A loop over cells has an Option for each row, None at a null, so that two
;; columns walked side by side stay on one row:
;;
;;     (loop (:for p* price) (:for q* qty)
;;           (:when-let (Some p) p*) (:when-let (Some q) q*)
;;           (:acc (summing (* p q))))
;;
;; An Option is a struct, so a null costs a flag, not an allocation.
(impl (Iterable (Cells %a))
  (type %elem (Option %a))
  (type %cursor int)
  (defun (iterable-start c) 0)
  (defun (iterable-done? c i) (>= i (cells-length c)))
  (defun (iterable-current c i) (cells-get c i))
  (defun (iterable-next c i) (+ i 1))
  (defun (count c) (cells-length c)))

;; The cells of a column of numbers are an Arrow buffer and a valid bitmap,
;; so a loop over them can use vector instructions.
(impl (Contiguous (Cells %a))
  (type %value %a)
  (defun (contiguous? c) (clr-cells-contiguous? (record-ref c clr)))
  (defun (contiguous-values c) (clr-cells-values (record-ref c clr)))
  (defun (contiguous-valid c) (clr-cells-valid (record-ref c clr))))

;; The cells of a column of numbers are a source of (std simd)'s vectors:
;; `(simd256-load c i)` is the values of rows i to i + 3 (doubles, longs) or
;; i + 7 (floats, ints). Under a null a lane's value is unspecified; the
;; valid bits are `cells-window`'s. A load has no call that returns, so a
;; loop's vectors stay in registers (glue/Cells.cs).
(impl (SimdSource (Cells %a)) (where (Lane %a))
  (type %elem %a)
  (defun (simd128-load c i) (clr-cells-load128 (record-ref c clr) i))
  (defun (simd256-load c i) (clr-cells-load256 (record-ref c clr) i))
  (defun (simd128-lanes c) (clr-cells-lanes128 (record-ref c clr)))
  (defun (simd256-lanes c) (clr-cells-lanes256 (record-ref c clr)))
  (defun (simd-source-length c) (cells-length c)))

;; Columns of dates and timestamps, as values of (std datetime). A column of
;; dates holds days since 1970-01-01, and one of timestamps microseconds since
;; 1970-01-01T00:00; a loop over their cells gets each as an Option of a Date,
;; a DateTime or an Instant:
;;
;;     (def (Ok days) (date-cells t "day") :propagate)
;;     (loop (:for d* days) (:when-let (Some d) d*) (:acc (counting (->weekday d))))
;;
;; A timestamp with no time zone is a DateTime, a local date and time; one
;; with a time zone is an Instant, a point in time.
(type (: DateCells #:opaque (Struct (: days (ClrCells int)))))
(type (: DateTimeCells #:opaque (Struct (: micros (ClrCells long)))))
(type (: InstantCells #:opaque (Struct (: micros (ClrCells long)))))

(: (-> Table string string (-> AnyColumn (Option %c)) (Result TableError %c)))
(defun (time-cells t name wanted convert)
  (def (Ok c) (find-column t name) :propagate)
  (match (convert c)
    ((Some cells) (Ok cells))
    (None (refuse (str "'" name "' is a column of " (type-text (type-of-column c))
                       ", not of " wanted ".")))))

(: (-> (-> %a %b) (Option %a) (Option %b)))
(defun (map-some f o)
  (match o
    ((Some x) (Some (f x)))
    (None None)))

(: (-> Table string (Result TableError DateCells)))
(defun (date-cells t name)
  (time-cells t name "date" (fun (c) (map-some (fun (d) (DateCells (days d))) (clr-day-cells c)))))

(: (-> Table string (Result TableError DateTimeCells)))
(defun (datetime-cells t name)
  (time-cells t name "datetime" (fun (c) (map-some (fun (m) (DateTimeCells (micros m))) (clr-micro-cells c #f)))))

(: (-> Table string (Result TableError InstantCells)))
(defun (instant-cells t name)
  (time-cells t name "instant" (fun (c) (map-some (fun (m) (InstantCells (micros m))) (clr-micro-cells c #t)))))

;; A value that (std datetime) has, which is each value of years 1 to 9999.
(: (-> (Option %a) %a))
(defun (in-calendar o)
  (match o
    ((Some x) x)
    (None (panic! "(bjostat table): a date or time outside the years 1 to 9999"))))

(: (-> (ClrCells %a) int (-> %a %b) (Option %b)))
(defun (time-cell c i convert)
  (if (clr-cells-valid? c i) (Some (convert (clr-cells-ref c i))) None))

(impl (Iterable DateCells)
  (type %elem (Option Date))
  (type %cursor int)
  (defun (iterable-start c) 0)
  (defun (iterable-done? c i) (>= i (clr-cells-length (record-ref c days))))
  (defun (iterable-current c i)
    (time-cell (record-ref c days) i (fun (n) (in-calendar (unix-days->date (cast long n))))))
  (defun (iterable-next c i) (+ i 1))
  (defun (count c) (clr-cells-length (record-ref c days))))

(impl (Iterable DateTimeCells)
  (type %elem (Option DateTime))
  (type %cursor int)
  (defun (iterable-start c) 0)
  (defun (iterable-done? c i) (>= i (clr-cells-length (record-ref c micros))))
  (defun (iterable-current c i)
    (time-cell (record-ref c micros) i
               (fun (us) (instant->utc-datetime (in-calendar (unix-microseconds->instant us))))))
  (defun (iterable-next c i) (+ i 1))
  (defun (count c) (clr-cells-length (record-ref c micros))))

(impl (Iterable InstantCells)
  (type %elem (Option Instant))
  (type %cursor int)
  (defun (iterable-start c) 0)
  (defun (iterable-done? c i) (>= i (clr-cells-length (record-ref c micros))))
  (defun (iterable-current c i)
    (time-cell (record-ref c micros) i (fun (us) (in-calendar (unix-microseconds->instant us)))))
  (defun (iterable-next c i) (+ i 1))
  (defun (count c) (clr-cells-length (record-ref c micros))))

;; A column of cells of any of the kinds this module reads: the four things a
;; null-skipping walk asks of it. `skip-nulls` and `complete-rows` are written
;; over this, so a column of dates or timestamps is skipped by nulls and joined
;; with the rest of a row as a column of numbers is, and each answers its own
;; kind of value: a double, a Date, a DateTime, an Instant.
;;
;; `source-cells` is the Arrow cells under the kinds that convert, which is
;; what the window-at-a-time walks take: the valid bits do not depend on how a
;; value is read.
(def/trait (RowSource %c)
  (type %cell)
  ;; The Arrow cells under it, and the type of the numbers in them.
  (type %read)
  (: source-length (-> %c int))
  (: source-null-count (-> %c int))
  (: source-valid? (-> %c int bool))
  (: source-ref (-> %c int %cell))
  (: source-next-valid (-> %c int int))
  (: source-cells (-> %c (ClrCells %read)))
  ;; The rows from `from` to `to`, without a copy of the values.
  (: source-slice (-> %c int int %c)))

(impl (RowSource (Cells %a))
  (type %cell %a)
  (type %read %a)
  (defun (source-length c) (cells-length c))
  (defun (source-null-count c) (cells-null-count c))
  (defun (source-valid? c i) (cells-valid? c i))
  (defun (source-ref c i) (cells-ref c i))
  (defun (source-next-valid c i) (clr-cells-next-valid (record-ref c clr) i))
  (defun (source-cells c) (record-ref c clr))
  (defun (source-slice c from to) (cells-slice c from to)))

(impl (RowSource DateCells)
  (type %cell Date)
  (type %read int)
  (defun (source-length c) (clr-cells-length (record-ref c days)))
  (defun (source-null-count c) (clr-cells-null-count (record-ref c days)))
  (defun (source-valid? c i) (clr-cells-valid? (record-ref c days) i))
  (defun (source-ref c i)
    (option-ref (time-cell (record-ref c days) i
                           (fun (n) (in-calendar (unix-days->date (cast long n)))))))
  (defun (source-next-valid c i) (clr-cells-next-valid (record-ref c days) i))
  (defun (source-cells c) (record-ref c days))
  (defun (source-slice c from to) (DateCells (days (clr-cells-slice (record-ref c days) from to)))))

(impl (RowSource DateTimeCells)
  (type %cell DateTime)
  (type %read long)
  (defun (source-length c) (clr-cells-length (record-ref c micros)))
  (defun (source-null-count c) (clr-cells-null-count (record-ref c micros)))
  (defun (source-valid? c i) (clr-cells-valid? (record-ref c micros) i))
  (defun (source-ref c i)
    (option-ref (time-cell (record-ref c micros) i
                           (fun (us) (instant->utc-datetime (in-calendar (unix-microseconds->instant us)))))))
  (defun (source-next-valid c i) (clr-cells-next-valid (record-ref c micros) i))
  (defun (source-cells c) (record-ref c micros))
  (defun (source-slice c from to) (DateTimeCells (micros (clr-cells-slice (record-ref c micros) from to)))))

(impl (RowSource InstantCells)
  (type %cell Instant)
  (type %read long)
  (defun (source-length c) (clr-cells-length (record-ref c micros)))
  (defun (source-null-count c) (clr-cells-null-count (record-ref c micros)))
  (defun (source-valid? c i) (clr-cells-valid? (record-ref c micros) i))
  (defun (source-ref c i)
    (option-ref (time-cell (record-ref c micros) i
                           (fun (us) (in-calendar (unix-microseconds->instant us))))))
  (defun (source-next-valid c i) (clr-cells-next-valid (record-ref c micros) i))
  (defun (source-cells c) (record-ref c micros))
  (defun (source-slice c from to) (InstantCells (micros (clr-cells-slice (record-ref c micros) from to)))))

;; The values of a column that are not null, as Julia's skipmissing: for a loop
;; over one column. Next to another column it would not stay on its row.
(type (: (NotNull %c) #:opaque (Record (: source %c))))

(: (-> %c (NotNull %c)) (where (RowSource %c)))
(defun (skip-nulls c) (NotNull (source c)))

;; The valid bits of the `window-rows` rows from `i` on, of the rows before
;; `length`, as the bits of a long: bit 0 is row i. 0 from `length` on. A loop
;; clause (in-complete, of (bjostat loops)) ANDs the windows of its columns
;; and steps from one set bit to the next with `lowest-bit`.
(: (-> (Cells %a) int int long))
(defun (cells-window c length i) (clr-cells-window (record-ref c clr) length i))

;; How many rows a window holds.
(: window-rows int)
(def window-rows 57)

(impl (Iterable (NotNull %c)) (where (RowSource %c))
  (type %elem (assoc RowSource cell %c))
  (type %cursor int)
  (defun (iterable-start s) (source-next-valid (record-ref s source) 0))
  (defun (iterable-done? s i) (>= i (source-length (record-ref s source))))
  (defun (iterable-current s i) (source-ref (record-ref s source) i))
  (defun (iterable-next s i) (source-next-valid (record-ref s source) (+ i 1)))
  (defun (count s)
    (- (source-length (record-ref s source)) (source-null-count (record-ref s source)))))

;; The rows of several columns where no column is null, as R's
;; complete.cases and na.omit: each row is a Tuple of the values, so that a
;; loop gets the values without Options and stays on one row of all the
;; columns.
;;
;;     (loop (:for (Tuple f m) (complete-rows (Tuple flipper mass)))
;;           (:acc (correlation (Tuple (cast double f) (cast double m)))))
;;
;; It takes a Tuple of 2 to 6 columns: of cells, or of the kinds of cells that
;; convert (`date-cells`, `datetime-cells`, `instant-cells`), mixed freely. Columns of different
;; lengths give the rows of the shortest. The next complete row is found in
;; the valid bitmaps, 57 rows at a time (CellsOps.NextComplete), so many
;; nulls cost little, and a loop over it is as fast as the same loop with
;; :when-let (bench/null-cost.bjo).
(type (: (CompleteRows %t) #:opaque (Record (: columns %t) (: length int))))

;; The columns of a CompleteRows: a Tuple of Cells.
(def/trait (RowColumns %t)
  (type %row)
  ;; The length of the shortest column.
  (: row-columns-length (-> %t int))
  ;; Whether a column has a null.
  (: row-columns-nulls? (-> %t bool))
  ;; Whether no column is null at the row.
  (: row-complete? (-> %t int bool))
  ;; The values of the row, which is complete.
  (: row-values (-> %t int %row))
  ;; The first complete row from `i` on, or `length`, the length of the
  ;; shortest column.
  (: row-next-complete (-> %t int int int))
  ;; Each column's rows from `from` to `to`.
  (: row-columns-slice (-> %t int int %t)))

(impl (RowColumns (Tuple %a %b)) (where (RowSource %a) (RowSource %b))
  (type %row (Tuple (assoc RowSource cell %a) (assoc RowSource cell %b)))
  (defun (row-columns-length t)
    (def (a b) t)
    (min (source-length a) (source-length b)))
  (defun (row-columns-nulls? t)
    (def (a b) t)
    (or (> (source-null-count a) 0) (> (source-null-count b) 0)))
  (defun (row-complete? t i)
    (def (a b) t)
    (and (source-valid? a i) (source-valid? b i)))
  (defun (row-values t i)
    (def (a b) t)
    (Tuple (source-ref a i) (source-ref b i)))
  (defun (row-next-complete t length i)
    (def (a b) t)
    (clr-next-complete-2 (source-cells a) (source-cells b) length i))
  (defun (row-columns-slice t from to)
    (def (a b) t)
    (Tuple (source-slice a from to) (source-slice b from to))))

(impl (RowColumns (Tuple %a %b %c)) (where (RowSource %a) (RowSource %b) (RowSource %c))
  (type %row (Tuple (assoc RowSource cell %a) (assoc RowSource cell %b) (assoc RowSource cell %c)))
  (defun (row-columns-length t)
    (def (a b c) t)
    (min (source-length a) (min (source-length b) (source-length c))))
  (defun (row-columns-nulls? t)
    (def (a b c) t)
    (or (> (source-null-count a) 0) (> (source-null-count b) 0) (> (source-null-count c) 0)))
  (defun (row-complete? t i)
    (def (a b c) t)
    (and (source-valid? a i) (source-valid? b i) (source-valid? c i)))
  (defun (row-values t i)
    (def (a b c) t)
    (Tuple (source-ref a i) (source-ref b i) (source-ref c i)))
  (defun (row-next-complete t length i)
    (def (a b c) t)
    (clr-next-complete-3 (source-cells a) (source-cells b) (source-cells c) length i))
  (defun (row-columns-slice t from to)
    (def (a b c) t)
    (Tuple (source-slice a from to) (source-slice b from to) (source-slice c from to))))

(impl (RowColumns (Tuple %a %b %c %d))
  (where (RowSource %a) (RowSource %b) (RowSource %c) (RowSource %d))
  (type %row (Tuple (assoc RowSource cell %a) (assoc RowSource cell %b)
                    (assoc RowSource cell %c) (assoc RowSource cell %d)))
  (defun (row-columns-length t)
    (def (a b c d) t)
    (min (min (source-length a) (source-length b)) (min (source-length c) (source-length d))))
  (defun (row-columns-nulls? t)
    (def (a b c d) t)
    (or (> (source-null-count a) 0) (> (source-null-count b) 0)
        (> (source-null-count c) 0) (> (source-null-count d) 0)))
  (defun (row-complete? t i)
    (def (a b c d) t)
    (and (source-valid? a i) (source-valid? b i) (source-valid? c i) (source-valid? d i)))
  (defun (row-values t i)
    (def (a b c d) t)
    (Tuple (source-ref a i) (source-ref b i) (source-ref c i) (source-ref d i)))
  (defun (row-next-complete t length i)
    (def (a b c d) t)
    (clr-next-complete-4 (source-cells a) (source-cells b) (source-cells c) (source-cells d) length i))
  (defun (row-columns-slice t from to)
    (def (a b c d) t)
    (Tuple (source-slice a from to) (source-slice b from to) (source-slice c from to) (source-slice d from to))))

(impl (RowColumns (Tuple %a %b %c %d %e))
  (where (RowSource %a) (RowSource %b) (RowSource %c) (RowSource %d) (RowSource %e))
  (type %row (Tuple (assoc RowSource cell %a) (assoc RowSource cell %b)
                    (assoc RowSource cell %c) (assoc RowSource cell %d)
                    (assoc RowSource cell %e)))
  (defun (row-columns-length t)
    (def (a b c d e) t)
    (min (min (source-length a) (source-length b))
         (min (source-length c) (min (source-length d) (source-length e)))))
  (defun (row-columns-nulls? t)
    (def (a b c d e) t)
    (or (> (source-null-count a) 0) (> (source-null-count b) 0)
        (> (source-null-count c) 0) (> (source-null-count d) 0) (> (source-null-count e) 0)))
  (defun (row-complete? t i)
    (def (a b c d e) t)
    (and (source-valid? a i) (source-valid? b i) (source-valid? c i)
         (source-valid? d i) (source-valid? e i)))
  (defun (row-values t i)
    (def (a b c d e) t)
    (Tuple (source-ref a i) (source-ref b i) (source-ref c i) (source-ref d i) (source-ref e i)))
  (defun (row-next-complete t length i)
    (def (a b c d e) t)
    (clr-next-complete-5 (source-cells a) (source-cells b) (source-cells c) (source-cells d)
                         (source-cells e) length i))
  (defun (row-columns-slice t from to)
    (def (a b c d e) t)
    (Tuple (source-slice a from to) (source-slice b from to) (source-slice c from to) (source-slice d from to) (source-slice e from to))))

(impl (RowColumns (Tuple %a %b %c %d %e %f))
  (where (RowSource %a) (RowSource %b) (RowSource %c) (RowSource %d) (RowSource %e) (RowSource %f))
  (type %row (Tuple (assoc RowSource cell %a) (assoc RowSource cell %b)
                    (assoc RowSource cell %c) (assoc RowSource cell %d)
                    (assoc RowSource cell %e) (assoc RowSource cell %f)))
  (defun (row-columns-length t)
    (def (a b c d e f) t)
    (min (min (source-length a) (source-length b))
         (min (min (source-length c) (source-length d))
              (min (source-length e) (source-length f)))))
  (defun (row-columns-nulls? t)
    (def (a b c d e f) t)
    (or (> (source-null-count a) 0) (> (source-null-count b) 0)
        (> (source-null-count c) 0) (> (source-null-count d) 0)
        (> (source-null-count e) 0) (> (source-null-count f) 0)))
  (defun (row-complete? t i)
    (def (a b c d e f) t)
    (and (source-valid? a i) (source-valid? b i) (source-valid? c i)
         (source-valid? d i) (source-valid? e i) (source-valid? f i)))
  (defun (row-values t i)
    (def (a b c d e f) t)
    (Tuple (source-ref a i) (source-ref b i) (source-ref c i) (source-ref d i)
           (source-ref e i) (source-ref f i)))
  (defun (row-next-complete t length i)
    (def (a b c d e f) t)
    (clr-next-complete-6 (source-cells a) (source-cells b) (source-cells c) (source-cells d)
                         (source-cells e) (source-cells f) length i))
  (defun (row-columns-slice t from to)
    (def (a b c d e f) t)
    (Tuple (source-slice a from to) (source-slice b from to) (source-slice c from to) (source-slice d from to) (source-slice e from to) (source-slice f from to))))

(: (-> %t (CompleteRows %t)) (where (RowColumns %t)))
(defun (complete-rows columns)
  (CompleteRows (columns columns) (length (row-columns-length columns))))

;; The first complete row from `i` on, or the length. Without nulls, `i`.
;; Always through the C#, which answers `i` at once for columns without
;; nulls: a branch here around it left the call in the loop when the columns
;; had no nulls, and a call there makes .NET keep the loop's sums in memory
;; (complete-rows took 4.4 ms for a million rows against 2.6 with :when-let).
(: (-> (CompleteRows %t) int int) (where (RowColumns %t)))
(defun (next-complete r i)
  (row-next-complete (record-ref r columns) (record-ref r length) i))

(impl (Iterable (CompleteRows %t))
  (where (RowColumns %t))
  (type %elem (assoc RowColumns row %t))
  (type %cursor int)
  (defun (iterable-start r) (next-complete r 0))
  (defun (iterable-done? r i) (>= i (record-ref r length)))
  (defun (iterable-current r i) (row-values (record-ref r columns) i))
  (defun (iterable-next r i) (next-complete r (+ i 1))))

;; How many values are not null.
(: (-> (Column %a) int))
(defun (column-count c) (- (column-length c) (column-null-count c)))

;; The aggregates of a column of numbers skip the nulls. A column with no
;; nulls goes to TensorPrimitives, which is vectorized. A column with nulls is
;; read with skip-nulls, in the order of its rows.

;; The sum of the values that are not null, or 0 when there are none. A sum
;; of integers wraps when it overflows.
(: (-> (Column %a) %a) (where (Num %a)))
(defun (column-sum c)
  (if (= (column-null-count c) 0)
      (tensor-sum (column-values c))
      (loop (:for x (skip-nulls (column->cells c)))
            (:acc s (folding 0 (+ s x))))))

;; The mean of the values that are not null, or NaN when there are none.
(: (-> (Column %a) double) (where (Num %a)))
(defun (column-mean c)
  (def n (column-count c))
  (if (= n 0)
      clr-nan
      (/ (number->double (column-sum c)) (cast double n))))

;; The first value that is not null, of a column that has one. A fold from it
;; over all the values compares it with itself first, which keeps it.
(: (-> (Column %a) %a))
(defun (first-valid c)
  (def values (column-values c))
  (let go ((i 0))
    (if (column-valid? c i) (ro-span-ref values i) (go (+ i 1)))))

;; The least value that is not null, or None when there is none.
;; - With no nulls, a NaN is the least value, as TensorPrimitives.Min gives it.
;; - With nulls, the values are compared with <: a NaN is the least value only
;;   when it is the first value, and of two equal values the first is kept.
(: (-> (Column %a) (Option %a)) (where (Num %a)))
(defun (column-min c)
  (cond
    ((= (column-count c) 0) None)
    ((= (column-null-count c) 0) (Some (tensor-min (column-values c))))
    (else
     (Some (loop (:for x (skip-nulls (column->cells c)))
                 (:acc m (folding (first-valid c) (if (< x m) x m))))))))

;; The greatest value that is not null, or None when there is none. NaN as
;; for `column-min`.
(: (-> (Column %a) (Option %a)) (where (Num %a)))
(defun (column-max c)
  (cond
    ((= (column-count c) 0) None)
    ((= (column-null-count c) 0) (Some (tensor-max (column-values c))))
    (else
     (Some (loop (:for x (skip-nulls (column->cells c)))
                 (:acc m (folding (first-valid c) (if (> x m) x m))))))))

;; ===========================================================================
;; Making tables
;; ===========================================================================

;; A column holding a copy of the array. With `#:valid`, as long as the array,
;; the value at each #f is a null.
(: (-> (Array %a) (#:valid (Array bool)) (Column %a)))
(defun (array->column a #:valid (make-array 0))
  (clr-from-array a valid))

(: (-> (Array string) (#:valid (Array bool)) StringColumn))
(defun (array->string-column a #:valid (make-array 0))
  (clr-from-strings a valid))

;; A column and the name it has in a table.
(type (: NamedColumn #:opaque (Record (: name string) (: column AnyColumn))))

(: (-> string (Column %a) NamedColumn))
(defun (named name c) (NamedColumn (name name) (column (column->any c))))

(: (-> string StringColumn NamedColumn))
(defun (named-strings name c) (NamedColumn (name name) (column (strings->any c))))

;; A column of any type and its name, for a module that makes Arrow columns
;; itself, as (bjostat csv) does.
(: (-> string AnyColumn NamedColumn))
(defun (named-any name c) (NamedColumn (name name) (column c)))

;; A table of the columns, in order. They have to be of one length and have
;; names that differ.
(: (-> (Vec NamedColumn) (Result TableError Table)))
(defun (make-table cols)
  (def names (vec-map (fun (c) (record-ref c name)) cols))
  (def arrays (vec-map (fun (c) (record-ref c column)) cols))
  (def rows (if (= (vec-length arrays) 0) 0 (any-length (vec-ref arrays 0))))
  (def twice
    (let loop ((i 0) (seen (map-empty)))
      (cond
        ((= i (vec-length names)) None)
        ((map-has-key? seen (vec-ref names i)) (Some (vec-ref names i)))
        (else (loop (+ i 1) (map-set seen (vec-ref names i) #t))))))
  (def uneven
    (find (fun (i) (not (= (any-length (vec-ref arrays i)) rows))) (range 0 (vec-length arrays))))
  (match (Tuple twice uneven)
    ((Tuple (Some name) _) (refuse (str "two columns are named '" name "'.")))
    ((Tuple _ (Some i))
     (refuse (str "'" (vec-ref names i) "' has " (int->string (any-length (vec-ref arrays i)))
                  " rows, and '" (vec-ref names 0) "' has " (int->string rows) ".")))
    (_ (Ok (clr-make-table (vec->array names) (vec->array arrays) rows)))))

;; A table of the named columns, in the order given, without a copy.
(: (-> Table (Vec string) (Result TableError Table)))
(defun (table-select t names)
  (def cols (vec-map (fun (n) (find-column t n)) names))
  (match (find (fun (r) (err? r)) cols)
    ((Some (Err e)) (Err e))
    (_ (Ok (clr-make-table (vec->array names)
                           (vec->array (vec-map (fun (r) (match r ((Ok c) c) ((Err _) (panic! "unreachable")))) cols))
                           (table-row-count t))))))

;; The rows from `#:from` up to `#:to`, without a copy. A range outside the
;; table, or one that ends before it starts, is an Err: Arrow's own slice
;; throws, and every other table operation answers a Result.
(: (-> Table (#:from int) (#:to int) (Result TableError Table)))
(defun (table-slice t #:from 0 #:to (table-row-count t))
  (def n (table-row-count t))
  (cond
    ((< from 0) (refuse (str "a slice from " (int->string from) " starts before the first row.")))
    ((> to n) (refuse (str "a slice to " (int->string to) " ends past the last of " (int->string n) " rows.")))
    ((> from to) (refuse (str "a slice from " (int->string from) " to " (int->string to) " ends before it starts.")))
    (else (Ok (clr-slice t from to)))))

;; ===========================================================================
;; Parts, for (std parallel)
;; ===========================================================================

;; `table-rows` of a table, a column of cells, `skip-nulls` and
;; `complete-rows` are `Chunkable`: `in-parallel` runs a function on parts of their rows.
;;
;; - A part is a slice: no copy of the values. A part's row 0 is the first
;;   row of the part.
;; - Inner cuts are at multiples of 64 rows, so that a part's valid bitmap
;;   starts at a whole byte and a loop over it is a vector loop where the
;;   whole column's is.
;; - The cuts depend only on the number of rows and the number of parts
;;   asked for: with `#:size`, only on the rows.

;; The cuts of `n` rows into about `k` parts: 0, the inner cuts, `n`.
;; Increasing; `[0 0]` for no rows.
(: (-> int int (Vec int)))
(defun (row-cuts n k)
  (def m (max 1 (min k (+ (/ n 64) 1))))
  (let go ((i 1) (last 0) (acc [0]))
    (if (>= i m)
        (vec-add acc n)
        (let ((c (* 64 (/ (cast int (/ (* (cast long n) (cast long i)) (cast long m))) 64))))
          (if (and (> c last) (< c n))
              (go (+ i 1) c (vec-add acc c))
              (go (+ i 1) last acc))))))

;; `(slice from to)` for each part of `n` rows cut into about `k`.
(: (-> int int (-> int int %p) (Vec %p)))
(defun (row-parts n k slice)
  (def cuts (row-cuts n k))
  (loop (:for i (range 0 (- (vec-length cuts) 1)))
        (:acc parts (vecing (slice (vec-ref cuts i) (vec-ref cuts (+ i 1)))))))

;; The rows of a table, for `in-parallel`: a part is a table. `Table` is a
;; .NET type, which cannot be Chunkable itself.
(type (: TableRows #:opaque (Struct (: table Table))))

(: (-> Table TableRows))
(defun (table-rows t) (TableRows (table t)))

(impl (Chunkable TableRows)
  (type %chunk Table)
  (defun (chunk-size r) (table-row-count (record-ref r table)))
  (defun (chunks r k)
    (def t (record-ref r table))
    (row-parts (table-row-count t) k (fun (from to) (clr-slice t from to)))))

(impl (Chunkable (Cells %a))
  (type %chunk (Cells %a))
  (defun (chunk-size c) (cells-length c))
  (defun (chunks c k) (row-parts (cells-length c) k (fun (from to) (cells-slice c from to)))))

(impl (Chunkable DateCells)
  (type %chunk DateCells)
  (defun (chunk-size c) (source-length c))
  (defun (chunks c k) (row-parts (source-length c) k (fun (from to) (source-slice c from to)))))

(impl (Chunkable DateTimeCells)
  (type %chunk DateTimeCells)
  (defun (chunk-size c) (source-length c))
  (defun (chunks c k) (row-parts (source-length c) k (fun (from to) (source-slice c from to)))))

(impl (Chunkable InstantCells)
  (type %chunk InstantCells)
  (defun (chunk-size c) (source-length c))
  (defun (chunks c k) (row-parts (source-length c) k (fun (from to) (source-slice c from to)))))

;; Cut by rows, nulls included: a part holds the values of its rows that are
;; not null.
(impl (Chunkable (NotNull %c)) (where (RowSource %c))
  (type %chunk (NotNull %c))
  (defun (chunk-size s) (source-length (record-ref s source)))
  (defun (chunks s k)
    (def c (record-ref s source))
    (row-parts (source-length c) k (fun (from to) (NotNull (source (source-slice c from to)))))))

;; Cut by rows of the shortest column.
(impl (Chunkable (CompleteRows %t)) (where (RowColumns %t))
  (type %chunk (CompleteRows %t))
  (defun (chunk-size r) (record-ref r length))
  (defun (chunks r k)
    (def cols (record-ref r columns))
    (row-parts (record-ref r length) k
               (fun (from to) (complete-rows (row-columns-slice cols from to))))))

;; A column to sort by, and the direction.
(type (: SortKey (Union (: ascending string) (: descending string))))

(: (-> SortKey string))
(defun (sort-key-name k)
  (match k
    ((ascending name) name)
    ((descending name) name)))

;; The table with its rows in the order of the keys, as R's `order` gives
;; them: by the first key, then by the next among the rows that the first
;; does not tell apart, and so on. Rows that no key tells apart keep their
;; order. A null comes after every value in both directions, and a NaN after
;; every number. Strings are in the order of their code points.
;;
;;     (table-sort t [(descending "price") (ascending "region")])
;;
;; An Err for a column the table does not have, or one of a type that cannot
;; be sorted by.
(: (-> SortKey (Result TableError AnyColumn) (Option TableError)))
(defun (sort-problem k found)
  (match found
    ((Err e) (Some e))
    ((Ok c)
     (def kind (clr-unsortable c))
     (if (= kind "")
         None
         (Some (TableError (message (str "'" (sort-key-name k) "' is a column of " kind
                                         ", which cannot be sorted by."))))))))

(: (-> Table (Vec SortKey) (Result TableError Table)))
(defun (table-sort t keys)
  (def problems
    (loop (:for k keys)
          (:when-let (Some e) (sort-problem k (find-column t (sort-key-name k))))
          (:acc (vecing e))))
  (if (> (vec-length problems) 0)
      (Err (vec-ref problems 0))
      (Ok (clr-sort-by t
                       {arraying (clr-index-of t (sort-key-name k)) (:for k keys)}
                       {arraying (match k ((descending _) #t) (_ #f)) (:for k keys)}))))

;; Joins, as dplyr's: the rows of two tables whose keys, columns of the same
;; names in both, are equal. The rows of the left table keep their order, and
;; for each, the right rows it matches come in their order. Two nulls are
;; equal keys, as in dplyr and R's merge.
;;
;;     (inner-join sales regions ["region"])
;;
;; The columns are the keys, then the other columns of the left table, then
;; those of the right. A name that both tables have for columns that are not
;; keys gets ".x" in the left one and ".y" in the right. An Err for a key that
;; a table does not have, or one of other types in the two tables.
(: (-> Table Table (Vec string) int (Result TableError Table)))
(defun (join left right keys kind)
  (def names (vec->array keys))
  (def problem (clr-key-problem left right names))
  (if (= problem "")
      (Ok (clr-join left right names kind))
      (refuse problem)))

;; The pairs of rows whose keys are equal.
(: (-> Table Table (Vec string) (Result TableError Table)))
(defun (inner-join left right keys) (join left right keys 0))

;; As inner-join, and also each left row that matches none, with nulls in the
;; columns of the right table.
(: (-> Table Table (Vec string) (Result TableError Table)))
(defun (left-join left right keys) (join left right keys 1))

;; The left rows that match a right row, each once, with the columns of the
;; left table only.
(: (-> Table Table (Vec string) (Result TableError Table)))
(defun (semi-join left right keys) (join left right keys 2))

;; The left rows that match no right row, with the columns of the left table
;; only.
(: (-> Table Table (Vec string) (Result TableError Table)))
(defun (anti-join left right keys) (join left right keys 3))

;; ===========================================================================
;; Reshaping
;; ===========================================================================

;; The table of a TableProblem's result, or an Err of its message.
(: (-> (Result System.Exception Table) (Result TableError Table)))
(defun (problem-or r)
  (match r
    ((Ok t) (Ok t))
    ((Err e) (refuse (.-Message e)))))

;; ---------------------------------------------------------------------------
;; What the reshaping shares
;; ---------------------------------------------------------------------------
;;
;; The reshaping is Bjolang over the kernels of glue/Reshape.cs and
;; glue/Join.cs: the groups of equal keys, the copies of columns and the
;; takes of rows.

(: (-> Table int Field))
(defun (field-at t i) (schema-field (clr-schema t) i))

(: (-> Table int ArrowType))
(defun (type-at t i) (field-type (field-at t i)))

(: (-> AnyColumn ArrowType))
(defun (any-type c) (data-type (clr-data c)))

;; The index of the column `name`, or an Err that names the columns.
(: (-> Table string (Result TableError int)))
(defun (column-index t name)
  (def i (clr-index-of t name))
  (if (< i 0)
      (refuse (str "the table has no column '" name "'. Its columns are: "
                   (string-join (table-names t) ", ") "."))
      (Ok i)))

;; Whether a name comes twice.
(: (-> (Vec string) bool))
(defun (repeats? names)
  (let go ((i 0) (seen (: (map-empty) (Map string bool))))
    (cond
      ((= i (vec-length names)) #f)
      ((map-has-key? seen (vec-ref names i)) #t)
      (else (go (+ i 1) (map-set seen (vec-ref names i) #t))))))

;; The index of each column, in order, or an Err for the first that is not
;; there.
(: (-> Table (Vec string) (Result TableError (Array int))))
(defun (column-indices t names)
  (def out (: (make-array (vec-length names)) (Array int)))
  (let go ((i 0))
    (if (= i (vec-length names))
        (Ok out)
        (match (column-index t (vec-ref names i))
          ((Err e) (Err e))
          ((Ok c)
           (array-set! out i c)
           (go (+ i 1)))))))

;; The columns of the names, or an Err for a name given twice, a name the
;; table does not have, or a column that cannot be a key.
(: (-> Table (Vec string) (Result TableError (Array AnyColumn))))
(defun (key-columns t names)
  (def out (: (make-array (vec-length names)) (Array AnyColumn)))
  (if (repeats? names)
      (refuse "a key is named twice.")
      (let go ((i 0))
        (cond
          ((= i (vec-length names)) (Ok out))
          (:def name (vec-ref names i))
          (:def (Ok c) (column-index t name) :propagate)
          (:def type (type-at t c))
          ((not (clr-key-type? type))
           (refuse (str "'" name "' is a column of " (clr-arrow-name type) ", which cannot be a key.")))
          (else
           (array-set! out i (clr-column t c))
           (go (+ i 1)))))))

;; ---------------------------------------------------------------------------
;; Distinct and append
;; ---------------------------------------------------------------------------

;; The first row of each distinct value of the columns `#:by`, in the order
;; of the rows, with all the columns, as dplyr's distinct with .keep_all.
;; With no `#:by`, all the columns are the key, and the result has no row
;; twice. Two nulls are equal, as in a join.
;;
;;     (table-distinct sales #:by ["customer"])
(: (-> Table (#:by (Vec string)) (Result TableError Table)))
(defun (table-distinct t #:by [])
  (def (Ok keys) (key-columns t (if (vec-empty? by) (table-names t) by)) :propagate)
  ;; Empty when each row is distinct: then the table is the result.
  (def firsts (clr-firsts keys (table-row-count t)))
  (Ok (if (= (array-length firsts) 0)
          t
          (clr-take t firsts (array-length firsts)))))

;; The rows of the tables, one table after the other, as dplyr's bind_rows.
;; Columns are matched by name: the columns are those of the first table, then
;; those that each next table adds, and a table without a column has nulls in
;; it. An Err for a name with columns of two types. Each column is made as a
;; part on (std parallel)'s compute threads, when the result has 65 536 cells
;; or more. Below that, the columns are made on this thread: the start of the
;; parts takes longer than the copies, as for Query.Take.
(: (-> (Vec Table) (Result TableError Table)))
(defun (table-append tables)
  (def (Ok fields) (appended-fields tables) :propagate)
  (def rows (loop (:for t tables) (:acc n (folding 0 (+ n (table-row-count t))))))
  (def filled (vec-filter (fun (t) (> (table-row-count t) 0)) tables))
  (def columns
    (if (< (* (cast long rows) (cast long (vec-length fields))) 65536L)
        {vecing (appended-column filled f) (:for f fields)}
        (computing-each (vec-length fields) (fun (c) (appended-column filled (vec-ref fields c))))))
  (Ok (clr-from-fields (vec->array fields) (vec->array columns) rows)))

;; A field of each name, of the type of its first column, in the order the
;; names first come.
(: (-> (Vec Table) (Result TableError (Vec Field))))
(defun (appended-fields tables)
  (let go ((k 0) (i 0) (fields (: [] (Vec Field))) (index (: (map-empty) (Map string int))))
    (cond
      ((= k (vec-length tables)) (Ok fields))
      (:def t (vec-ref tables k))
      ((= i (table-column-count t)) (go (+ k 1) 0 fields index))
      (:def f (field-at t i))
      (:def name (field-name f))
      (else
       (match (map-try-ref index name)
         (None
          (go k (+ i 1) (vec-add fields (clr-new-field name (field-type f))) (map-set index name (vec-length fields))))
         ((Some j)
          (def first (field-type (vec-ref fields j)))
          (if (clr-same-type? first (field-type f))
              (go k (+ i 1) fields index)
              (refuse (str "'" name "' is a column of " (clr-arrow-name first) " in one table and of "
                           (clr-arrow-name (field-type f)) " in another.")))))))))

;; The column of the field: the column of its name of each table, or nulls
;; for a table without one.
(: (-> (Vec Table) Field AnyColumn))
(defun (appended-column tables f)
  (def type (field-type f))
  (def pieces
    {arraying (let ((i (clr-index-of t (field-name f))))
                (if (< i 0) (clr-nulls type (table-row-count t)) (clr-column t i)))
              (:for t tables)})
  (match (array-length pieces)
    (0 (clr-nulls type 0))
    (1 (array-ref pieces 0))
    (_ (clr-concat pieces type))))

;; ---------------------------------------------------------------------------
;; Pivots
;; ---------------------------------------------------------------------------

;; Columns to rows, as tidyr's pivot_longer: each row becomes one row for each
;; of the columns `cols`, with the column's name in `#:names-to` and its value
;; in `#:values-to`. The other columns are repeated. The columns have to be of
;; one type.
;;
;;     ;; country 2024 2025  ->  country year sales
;;     (pivot-longer t ["2024" "2025"] #:names-to "year" #:values-to "sales")
(: (-> Table (Vec string) (#:names-to string) (#:values-to string) (Result TableError Table)))
(defun (pivot-longer t cols #:names-to "name" #:values-to "value")
  (cond
    ((vec-empty? cols) (refuse "pivot-longer needs at least one column."))
    ((repeats? cols) (refuse "a column is named twice."))
    (:def (Ok idx) (column-indices t cols) :propagate)
    (:def type (type-at t (array-ref idx 0)))
    (else
     (match (find (fun (c) (not (clr-same-type? type (type-at t c)))) idx)
       ((Some c)
        (refuse (str "'" (vec-ref cols 0) "' is a column of " (clr-arrow-name type) " and '"
                     (field-name (field-at t c)) "' of " (clr-arrow-name (type-at t c))
                     ": the values of one column have to be of one type.")))
       (None (longer-checked t cols idx type names-to values-to))))))

(: (-> Table (Vec string) (Array int) ArrowType string string (Result TableError Table)))
(defun (longer-checked t cols idx type names-to values-to)
  (def kept {arraying i (:for i (range 0 (table-column-count t))) (:when (not (any? (fun (c) (= c i)) idx)))})
  (def kept-names {vecing (field-name (field-at t i)) (:for i kept)})
  (def n (table-row-count t))
  (def k (array-length idx))
  (cond
    ((= names-to values-to) (refuse (str "the names and the values are both to go in '" names-to "'.")))
    ((any? (fun (s) (= s names-to)) kept-names) (refuse (str "the table has a column '" names-to "' already.")))
    ((any? (fun (s) (= s values-to)) kept-names) (refuse (str "the table has a column '" values-to "' already.")))
    ((> (* (cast long n) (cast long k)) 2147483647L)
     (refuse (str (int->string n) " rows of " (int->string k) " columns are too many rows.")))
    (else (Ok (longer t cols idx kept type names-to values-to n k)))))

;; The rows a pivot to longer takes, at i k + j for row i of `n` and column j
;; of `k`: i, for a kept column.
(: (-> int int (Array int)))
(defun (kept-row-numbers n k)
  (def rows (: (make-array (* n k)) (Array int)))
  (loop (:for i (range 0 n))
        (:do (loop (:for j (range 0 k))
                   (:do (array-set! rows (+ (* i k) j) i)))))
  rows)

;; j n + i, for the values of the columns one after the other.
(: (-> int int (Array int)))
(defun (value-row-numbers n k)
  (def rows (: (make-array (* n k)) (Array int)))
  (loop (:for i (range 0 n))
        (:do (loop (:for j (range 0 k))
                   (:do (array-set! rows (+ (* i k) j) (+ (* j n) i))))))
  rows)

;; Row i, column j of the result is at i k + j. A column of numbers, dates or
;; timestamps is interleaved directly; another is taken through the rows,
;; which are made only when a column needs them.
(: (-> Table (Vec string) (Array int) (Array int) ArrowType string string int int Table))
(defun (longer t cols idx kept type names-to values-to n k)
  (def m (* n k))
  (def nk (array-length kept))
  (def kept-rows
    (if (any? (fun (c) (not (clr-interleavable? (any-type (clr-column t c))))) kept)
        (kept-row-numbers n k)
        (: (make-array 0) (Array int))))
  (def kept-columns
    {arraying (let ((a (clr-column t c)))
                (if (clr-interleavable? (any-type a))
                    (clr-interleaved (make-array k #:fill a) n)
                    (clr-column (clr-take (clr-select t #[c]) kept-rows m) 0)))
              (:for c kept)})
  (def values
    (if (clr-interleavable? type)
        (clr-interleaved {arraying (clr-column t c) (:for c idx)} n)
        (let* ((rows (value-row-numbers n k))
               (whole (if (= k 1)
                          (clr-column t (array-ref idx 0))
                          (clr-concat {arraying (clr-column t c) (:for c idx)} type)))
               (one (clr-from-fields #[(clr-new-field values-to type)] #[whole] (any-length whole))))
          (clr-column (clr-take one rows m) 0))))
  (clr-from-fields
   {arraying (cond
               ((< i nk) (field-at t (array-ref kept i)))
               ((= i nk) (clr-new-field names-to clr-string-type))
               (else (clr-new-field values-to type)))
             (:for i (range 0 (+ nk 2)))}
   {arraying (cond
               ((< i nk) (array-ref kept-columns i))
               ((= i nk) (clr-repeated (vec->array cols) n))
               (else values))
             (:for i (range 0 (+ nk 2)))}
   m))

;; Rows to columns, as tidyr's pivot_wider: a column for each distinct string
;; of `#:names-from`, in the order they first come, with the values of
;; `#:values-from`. The other columns tell the rows apart: one row for each of
;; their distinct values, in the order of the first rows. A cell that no row
;; gives is a null. An Err for two rows with the same values in the other
;; columns and the same name, since a cell holds one value.
;;
;;     ;; country year sales  ->  country 2024 2025
;;     (pivot-wider t #:names-from "year" #:values-from "sales")
(: (-> Table (#:names-from string) (#:values-from string) (Result TableError Table)))
(defun (pivot-wider t #:names-from "name" #:values-from "value")
  (cond
    ((= names-from values-from) (refuse (str "the names and the values are both from '" names-from "'.")))
    (:def (Ok nc) (column-index t names-from) :propagate)
    (:def (Ok vc) (column-index t values-from) :propagate)
    (:def name-col (clr-column t nc))
    (:def strings? (= (clr-type-name name-col) "String"))
    ((not (or strings? (= (clr-type-name name-col) "Category")))
     (refuse (str "'" names-from "' is a column of " (clr-arrow-name (type-at t nc))
                  "; the names of columns have to be strings.")))
    (:def ids {arraying i (:for i (range 0 (table-column-count t))) (:when (not (or (= i nc) (= i vc))))})
    (else
     (match (find (fun (i) (not (clr-key-type? (type-at t i)))) ids)
       ((Some i)
        (refuse (str "'" (field-name (field-at t i)) "' is a column of " (clr-arrow-name (type-at t i))
                     ", which cannot be a key.")))
       (None (wider t names-from vc name-col strings? ids))))))

(: (-> Table string int AnyColumn bool (Array int) (Result TableError Table)))
(defun (wider t names-from vc name-col strings? ids)
  (def n (table-row-count t))
  (def (Tuple group-of firsts) (clr-groups {arraying (clr-column t i) (:for i ids)} n))
  (def rows (array-length firsts))
  (def (Ok (Tuple col-of new-names)) (name-columns names-from name-col strings? n) :propagate)
  (def (Ok cells) (cell-rows names-from group-of col-of new-names rows n) :propagate)
  (def id-names {vecing (field-name (field-at t i)) (:for i ids)})
  (match (find (fun (s) (any? (fun (x) (= x s)) id-names)) new-names)
    ((Some name) (refuse (str "the table has a column '" name "' already.")))
    (None
     (def id-table (clr-take (clr-select t ids) firsts rows))
     (def value-table (clr-select t #[vc]))
     (def type (type-at t vc))
     (def nids (array-length ids))
     (def count (+ nids (array-length new-names)))
     (Ok (clr-from-fields
          {arraying (if (< i nids)
                        (field-at id-table i)
                        (clr-new-field (array-ref new-names (- i nids)) type))
                    (:for i (range 0 count))}
          {arraying (if (< i nids)
                        (clr-column id-table i)
                        (array-ref (clr-take-or-null value-table (array-ref cells (- i nids))) 0))
                    (:for i (range 0 count))}
          rows)))))

;; The new column of each row, and the name of each new column, in the order
;; the names first come. An Err for a null, since a column needs a name.
(: (-> string AnyColumn bool int (Result TableError (Tuple (Array int) (Array string)))))
(defun (name-columns names-from name-col strings? n)
  (cond
    ((> (any-null-count name-col) 0)
     (def r (let go ((r 0)) (if (clr-any-valid? name-col r) (go (+ r 1)) r)))
     (refuse (str "'" names-from "' has a null in row " (int->string r) ", and a column needs a name.")))
    (strings?
     (def s (as-strings name-col))
     (def (Tuple col-of firsts) (clr-string-ids s))
     (Ok (Tuple col-of {arraying (match (string-column-ref s r) ((Some x) x) (None ""))
                                 (:for r firsts)})))
    (else (Ok (category-columns (column-values (as-ints (clr-codes name-col))) (clr-levels name-col) n)))))

;; Of a category: a new column for each code, in the order the codes first
;; come.
(: (-> (RoSpan int) (Array string) int (Tuple (Array int) (Array string))))
(defun (category-columns codes levels n)
  (def code-to-col (make-array (array-length levels) #:fill -1))
  (def col-of (: (make-array n) (Array int)))
  (let go ((r 0) (names (: [] (Vec string))))
    (if (= r n)
        (Tuple col-of (vec->array names))
        (let* ((code (ro-span-ref codes r))
               (c (array-ref code-to-col code)))
          (if (< c 0)
              (begin
                (array-set! code-to-col code (vec-length names))
                (array-set! col-of r (vec-length names))
                (go (+ r 1) (vec-add names (array-ref levels code))))
              (begin
                (array-set! col-of r c)
                (go (+ r 1) names)))))))

;; The row of each cell of each new column, -1 where no row gives one. An Err
;; for two rows of one cell.
(: (-> string (Array int) (Array int) (Array string) int int (Result TableError (Array (Array int)))))
(defun (cell-rows names-from group-of col-of new-names rows n)
  (def cells {arraying (make-array rows #:fill -1) (:for _c (range 0 (array-length new-names)))})
  (let go ((r 0))
    (if (= r n)
        (Ok cells)
        (let* ((c (array-ref col-of r))
               (column (array-ref cells c))
               (g (array-ref group-of r))
               (cell (array-ref column g)))
          (if (>= cell 0)
              (refuse (str "rows " (int->string cell) " and " (int->string r)
                           " have the same values in the other columns, and both '"
                           (array-ref new-names c) "' in '" names-from "': a cell holds one value."))
              (begin
                (array-set! column g r)
                (go (+ r 1))))))))

;; ===========================================================================
;; Counts
;; ===========================================================================

;; The rows are counted in parts on the compute threads once there are two
;; parts of count-part-rows or more. Each part keeps an array of counts when
;; there are at most count-parts-limit values, and the arrays are summed
;; after; with more, the parts add to one array, with atomic-array-increment!.
;;
;; When each key's values can be numbered in the order of table-sort and the
;; numbers of all keys together are at most DenseLimit (Reshape.cs), the
;; numbers of a row are its slot, and the slots that have a count are the
;; result in its order: no groups to find and no sort. A category's codes
;; are such numbers already. Otherwise the groups of the keys are found and
;; put in order (ReshapeOps.GroupsInOrder).

(import/extern
  (uninitialized-ints (: System.GC.AllocateUninitializedArray (-> int bool (Array int)))))

(: int) (def count-part-rows 16384)
(: int) (def count-parts-limit 16384)

;; The number of parts of n rows, and the rows of each but the last.
(: (-> int (Tuple int int)))
(defun (count-parts n)
  (def parts (max 1 (min (quotient n count-part-rows) (compute-thread-count))))
  (Tuple parts (quotient (+ n (- parts 1)) parts)))

;; The first and the end row of part p.
(: (-> int int int (Tuple int int)))
(defun (part-rows p size n) (Tuple (* p size) (min n (* (+ p 1) size))))

(: (-> (Array long) AnyColumn))
(defun (long-column a) (column->any (array->column a)))

;; The elements of `a` at the indices, in their order.
(: (-> (Array %a) (Array int) (Array %a)))
(defun (gathered a indices)
  (def out (: (make-array (array-length indices)) (Array %a)))
  (let go ((i 0))
    (when (< i (array-length indices))
      (array-set! out i (array-ref a (array-ref indices i)))
      (go (+ i 1))))
  out)

;; The table of the keys' columns, with their fields, and the counts after.
(: (-> Table string AnyColumn int Table))
(defun (with-count keys name counts rows)
  (def k (table-column-count keys))
  (clr-from-fields
   {arraying (if (< i k) (field-at keys i) (clr-new-field name (data-type (clr-data counts))))
             (:for i (range 0 (+ k 1)))}
   {arraying (if (< i k) (clr-column keys i) counts) (:for i (range 0 (+ k 1)))}
   rows))

;; How many rows have each value of the columns `keys`, as dplyr's count: a
;; row for each distinct value, with the count in the column `#:name`, in the
;; order of the keys as table-sort gives it. A null is a value. With no keys,
;; one row of the number of rows.
;;
;;     (table-count sales ["region" "product"])
(: (-> Table (Vec string) (#:name string) (Result TableError Table)))
(defun (table-count t keys #:name "n")
  (def n (table-row-count t))
  (cond
    ((some? (find (fun (k) (= k name)) keys))
     (refuse (str "the count and a key are both named '" name "'.")))
    (:def (Ok cols) (key-columns t keys) :propagate)
    (:def (Ok idx) (column-indices t keys) :propagate)
    ((= (array-length cols) 0)
     (def all (long-column (: (make-array 1 #:fill (cast long n)) (Array long))))
     (Ok (clr-from-fields #[(clr-new-field name (data-type (clr-data all)))] #[all] 1)))
    ((and (= (array-length cols) 1) (= (clr-type-name (array-ref cols 0)) "Category"))
     (Ok (count-category t (array-ref idx 0) (array-ref cols 0) name n)))
    (else
     (Ok (match (if (>= n (* 2 count-part-rows)) (count-sorted t idx cols name n) None)
           ((Some counted) counted)
           (None (count-groups t idx cols name n)))))))

;; The counts of the groups of the keys, in the order of the groups' keys.
(: (-> Table (Array int) (Array AnyColumn) string int Table))
(defun (count-groups t idx cols name n)
  (def (Tuple group-of firsts order) (clr-groups-in-order cols n))
  (def counts (group-counts group-of (array-length firsts) n))
  (def rows (array-length order))
  (with-count (clr-take (clr-select t idx) (gathered firsts order) rows) name
              (column->any (clr-longs-at counts order)) rows))

;; The number of rows in each of the groups.
(: (-> (Array int) int int (Array long)))
(defun (group-counts group-of groups n)
  (def counts (: (make-array groups) (Array long)))
  (if (and (>= n (* 2 count-part-rows)) (<= groups count-parts-limit))
      (let ()
        (def (Tuple parts size) (count-parts n))
        (def each (computing-each parts (fun (p)
                                          (def (Tuple from to) (part-rows p size n))
                                          (counted group-of groups from to))))
        (loop (:for pc each) (:do (add-counts! counts pc)))
        counts)
      (let go ((r 0))
        (if (= r n)
            counts
            (let ()
              (def g (array-ref group-of r))
              (array-set! counts g (+ (array-ref counts g) 1L))
              (go (+ r 1)))))))

;; How often each of the ids from 0 to `slots` comes in `ids`, from `from`
;; to `to`.
(: (-> (Array int) int int int (Array int)))
(defun (counted ids slots from to)
  (def pc (: (make-array slots) (Array int)))
  (let go ((r from))
    (when (< r to)
      (def s (array-ref ids r))
      (array-set! pc s (+ (array-ref pc s) 1))
      (go (+ r 1))))
  pc)

(: (-> (Array long) (Array int) Unit))
(defun (add-counts! counts pc)
  (let go ((g 0))
    (when (< g (array-length counts))
      (array-set! counts g (+ (array-ref counts g) (cast long (array-ref pc g))))
      (go (+ g 1)))))

;; The counts by slot, when each key's values can be numbered in the order
;; of table-sort and the slots are at most DenseLimit; or None.
(: (-> Table (Array int) (Array AnyColumn) string int (Option Table)))
(defun (count-sorted t idx cols name n)
  (def k (array-length cols))
  (def col-ids (: (make-array k) (Array (Array int))))
  (def cards (: (make-array k) (Array int)))
  (def slots
    (let go ((c 0) (total 1L))
      (if (= c k)
          (Some total)
          (match (clr-sorted-ids (array-ref cols c))
            (None None)
            ((Some (Tuple ids card))
             (def ck (if (= card 0) 1 card))
             (def more (* total (cast long ck)))
             (array-set! col-ids c ids)
             (array-set! cards c ck)
             (if (> more clr-dense-limit) None (go (+ c 1) more)))))))
  (match slots
    (None None)
    ((Some s) (Some (count-slots t idx col-ids cards (cast int s) name n)))))

;; The slot of each row is its first key's id, times the next key's number
;; of ids, plus its id, and so on. With two keys it is made as each row is
;; counted; with more, first, into the ids of the first key.
(: (-> Table (Array int) (Array (Array int)) (Array int) int string int Table))
(defun (count-slots t idx col-ids cards slots name n)
  (def k (array-length col-ids))
  (def (Tuple parts size) (count-parts n))
  (def ids (array-ref col-ids 0))
  (when (> k 2)
    (ignore (computing-each parts (fun (p)
                                    (def (Tuple from to) (part-rows p size n))
                                    (combine-slots! ids col-ids cards from to)
                                    unit))))
  (def two? (= k 2))
  (def second (if two? (array-ref col-ids 1) ids))
  (def c1 (if two? (array-ref cards 1) 1))
  (def (Tuple slot-counts slot-firsts)
    (if (<= slots count-parts-limit)
        (slot-counts-in-parts ids second c1 two? slots parts size n)
        (slot-counts-atomic ids second c1 two? slots parts size n)))
  (def (Tuple firsts counts)
    (if (>= slots count-part-rows)
        (compacted-in-parts slot-counts slot-firsts parts)
        (compacted slot-counts slot-firsts)))
  (def rows (array-length firsts))
  (with-count (clr-take (clr-select t idx) firsts rows) name (long-column counts) rows))

(: (-> (Array int) (Array (Array int)) (Array int) int int Unit))
(defun (combine-slots! ids col-ids cards from to)
  (def k (array-length col-ids))
  (let go ((r from))
    (when (< r to)
      (def s (let add ((c 1) (s (array-ref ids r)))
               (if (= c k) s (add (+ c 1) (+ (* s (array-ref cards c)) (array-ref (array-ref col-ids c) r))))))
      (array-set! ids r s)
      (go (+ r 1)))))

;; The counts and the first rows of the slots, from one array of each for
;; each part.
(: (-> (Array int) (Array int) int bool int int int int (Tuple (Array int) (Array int))))
(defun (slot-counts-in-parts ids second c1 two? slots parts size n)
  (def each (computing-each parts (fun (p)
                                    (def (Tuple from to) (part-rows p size n))
                                    (slot-part ids second c1 two? slots from to))))
  (def counts (: (make-array slots) (Array int)))
  (def firsts (: (make-array slots #:fill int-max) (Array int)))
  (loop (:for (Tuple pc pf) each) (:do (merge-part! counts firsts pc pf)))
  (Tuple counts firsts))

(: (-> (Array int) (Array int) int bool int int int (Tuple (Array int) (Array int))))
(defun (slot-part ids second c1 two? slots from to)
  (def pc (: (make-array slots) (Array int)))
  (def pf (: (make-array slots #:fill int-max) (Array int)))
  (if two?
      (let go ((r from))
        (when (< r to)
          (def s (+ (* (array-ref ids r) c1) (array-ref second r)))
          (def c (array-ref pc s))
          (when (= c 0) (array-set! pf s r))
          (array-set! pc s (+ c 1))
          (go (+ r 1))))
      (let go ((r from))
        (when (< r to)
          (def s (array-ref ids r))
          (def c (array-ref pc s))
          (when (= c 0) (array-set! pf s r))
          (array-set! pc s (+ c 1))
          (go (+ r 1)))))
  (Tuple pc pf))

(: (-> (Array int) (Array int) (Array int) (Array int) Unit))
(defun (merge-part! counts firsts pc pf)
  (let go ((s 0))
    (when (< s (array-length counts))
      (array-set! counts s (+ (array-ref counts s) (array-ref pc s)))
      (when (< (array-ref pf s) (array-ref firsts s)) (array-set! firsts s (array-ref pf s)))
      (go (+ s 1)))))

;; The counts and a first row of the slots, from one array of counts that
;; the parts add to. A slot's first row is the row of the step that made its
;; count 1; any row of a slot has its keys.
(: (-> (Array int) (Array int) int bool int int int int (Tuple (Array int) (Array int))))
(defun (slot-counts-atomic ids second c1 two? slots parts size n)
  (def counts (: (make-array slots) (Array int)))
  (def firsts (uninitialized-ints slots #f))
  (ignore (computing-each parts (fun (p)
                                  (def (Tuple from to) (part-rows p size n))
                                  (slot-part-atomic! counts firsts ids second c1 two? from to)
                                  unit)))
  (Tuple counts firsts))

(: (-> (Array int) (Array int) (Array int) (Array int) int bool int int Unit))
(defun (slot-part-atomic! counts firsts ids second c1 two? from to)
  (if two?
      (let go ((r from))
        (when (< r to)
          (def s (+ (* (array-ref ids r) c1) (array-ref second r)))
          (when (= (atomic-array-increment! counts s) 1) (array-set! firsts s r))
          (go (+ r 1))))
      (let go ((r from))
        (when (< r to)
          (def s (array-ref ids r))
          (when (= (atomic-array-increment! counts s) 1) (array-set! firsts s r))
          (go (+ r 1))))))

;; The first row and the count of each slot that has a count, in the order
;; of the slots.
(: (-> (Array int) (Array int) (Tuple (Array int) (Array long))))
(defun (compacted counts firsts)
  (def rows (loop (:for c counts) (:acc k (summing (if (> c 0) 1 0)))))
  (def out-firsts (uninitialized-ints rows #f))
  (def out-counts (: (make-array rows) (Array long)))
  (let go ((s 0) (i 0))
    (when (< s (array-length counts))
      (def c (array-ref counts s))
      (if (> c 0)
          (begin
            (array-set! out-firsts i (array-ref firsts s))
            (array-set! out-counts i (cast long c))
            (go (+ s 1) (+ i 1)))
          (go (+ s 1) i))))
  (Tuple out-firsts out-counts))

;; The same, the slots in parts on the compute threads: the slots with a
;; count in each part, then where each part's go, then the copies.
(: (-> (Array int) (Array int) int (Tuple (Array int) (Array long))))
(defun (compacted-in-parts counts firsts parts)
  (def slots (array-length counts))
  (def size (quotient (+ slots (- parts 1)) parts))
  (def in-part (computing-each parts (fun (p)
                                       (def (Tuple from to) (part-rows p size slots))
                                       (loop (:for s (range from to))
                                             (:acc k (summing (if (> (array-ref counts s) 0) 1 0)))))))
  (def starts (: (make-array parts) (Array int)))
  (def rows
    (let go ((p 0) (at 0))
      (if (= p parts)
          at
          (begin (array-set! starts p at) (go (+ p 1) (+ at (vec-ref in-part p)))))))
  (def out-firsts (uninitialized-ints rows #f))
  (def out-counts (: (make-array rows) (Array long)))
  (ignore (computing-each parts (fun (p)
                                  (def (Tuple from to) (part-rows p size slots))
                                  (let go ((s from) (i (array-ref starts p)))
                                    (when (< s to)
                                      (def c (array-ref counts s))
                                      (if (> c 0)
                                          (begin
                                            (array-set! out-firsts i (array-ref firsts s))
                                            (array-set! out-counts i (cast long c))
                                            (go (+ s 1) (+ i 1)))
                                          (go (+ s 1) i))))
                                  unit)))
  (Tuple out-firsts out-counts))

;; The counts of a category's codes, which are in the order of its levels,
;; and a null after them: no groups to find and no sort.
(: (-> Table int AnyColumn string int Table))
(defun (count-category t col cat name n)
  (def levels (clr-level-count cat))
  (def slots (if (= (any-null-count cat) 0) levels (+ levels 1)))
  (def cells (clr-cells-of-column (as-ints (clr-codes cat))))
  (def counts (: (make-array slots) (Array int)))
  (def firsts (: (make-array slots #:fill int-max) (Array int)))
  (if (and (>= n (* 2 count-part-rows)) (<= slots count-parts-limit))
      (let ()
        (def (Tuple parts size) (count-parts n))
        (def each (computing-each parts (fun (p)
                                          (def (Tuple from to) (part-rows p size n))
                                          (code-part cells levels slots from to))))
        (loop (:for (Tuple pc pf) each) (:do (merge-part! counts firsts pc pf))))
      ;; On this thread, into the counts themselves.
      (count-codes-into! cells levels counts firsts 0 n))
  (def (Tuple out-firsts out-counts) (compacted counts firsts))
  (def rows (array-length out-firsts))
  (with-count (clr-take (clr-select t #[col]) out-firsts rows) name (long-column out-counts) rows))

;; The counts and the first rows of the codes from `from` to `to`, a null
;; counted as the code `levels`.
(: (-> (ClrCells int) int int int int (Tuple (Array int) (Array int))))
(defun (code-part cells levels slots from to)
  (def pc (: (make-array slots) (Array int)))
  (def pf (: (make-array slots #:fill int-max) (Array int)))
  (count-codes-into! cells levels pc pf from to)
  (Tuple pc pf))

;; Adds the codes from `from` to `to` to the counts, and their first rows
;; to the first rows that are int-max.
(: (-> (ClrCells int) int (Array int) (Array int) int int Unit))
(defun (count-codes-into! cells levels pc pf from to)
  (if (= (clr-cells-null-count cells) 0)
      (count-codes! (clr-cells-values cells) pc pf from to)
      (count-codes-or-nulls! (clr-cells-values cells) (clr-cells-valid cells) levels pc pf from to)))

(: (-> (RoSpan int) (Array int) (Array int) int int Unit))
(defun (count-codes! codes pc pf from to)
  (let go ((r from))
    (when (< r to)
      (def s (ro-span-ref codes r))
      (def c (array-ref pc s))
      (when (= c 0) (array-set! pf s r))
      (array-set! pc s (+ c 1))
      (go (+ r 1)))))

(: (-> (RoSpan int) (RoSpan byte) int (Array int) (Array int) int int Unit))
(defun (count-codes-or-nulls! codes valid levels pc pf from to)
  (let go ((r from))
    (when (< r to)
      (def bit (bitwise-and (cast int (ro-span-ref valid (shift-right r 3))) (shift-left 1 (bitwise-and r 7))))
      (def s (if (= bit 0) levels (ro-span-ref codes r)))
      (def c (array-ref pc s))
      (when (= c 0) (array-set! pf s r))
      (array-set! pc s (+ c 1))
      (go (+ r 1)))))

;; How many rows have each pair of values of two columns, as R's table(x, y):
;; a row for each value of `row-key`, and a column for each value of
;; `col-key`, named by its text as table->string prints it, with 0 for a
;; pair that no row has. Both are in the order of table-sort, so the levels
;; of a category keep their order. A row with a null in either key is left
;; out, as R does.
;;
;;     (table-crosstab survey "smoker" "sex")
(: (-> Table string string (Result TableError Table)))
(defun (table-crosstab t row-key col-key)
  (cond
    ((= row-key col-key) (refuse (str "the rows and the columns are both of '" row-key "'.")))
    (:def (Ok cols) (key-columns t [row-key col-key]) :propagate)
    (:def (Ok idx) (column-indices t [row-key col-key]) :propagate)
    (else (crosstab-of t (array-ref idx 0) (array-ref cols 0) (array-ref cols 1) row-key col-key))))

;; The counts are kept by the column's group, then the row's: counts[c][r].
;; Without a null they are counted in parts, from one array of each pair for
;; each part or, with more pairs, from one that the parts add to. With a
;; null, on this thread, leaving out each row of a key's null group, and
;; then each group that kept no count.
(: (-> Table int AnyColumn AnyColumn string string (Result TableError Table)))
(defun (crosstab-of t row-idx row-col col-col row-key col-key)
  (def n (table-row-count t))
  (def (Tuple row-of row-firsts row-order) (clr-groups-in-order #[row-col] n))
  (def (Tuple col-of col-firsts col-order) (clr-groups-in-order #[col-col] n))
  (def r-count (array-length row-firsts))
  (def c-count (array-length col-firsts))
  (def nulls? (or (> (any-null-count row-col) 0) (> (any-null-count col-col) 0)))
  (def counts (pair-counts row-of col-of r-count c-count n))
  ;; A row with a null in a key is in that key's null group: its counts are
  ;; made 0, which leaves the counts of the rows with both keys.
  (when nulls?
    (match (null-group row-col row-firsts)
      ((Some rg) (loop (:for cc counts) (:do (array-set! cc rg 0L))))
      (None unit))
    (match (null-group col-col col-firsts)
      ((Some cg) (array-fill! (array-ref counts cg) 0L))
      (None unit)))
  (def active (if nulls? (Some (active-groups counts r-count)) None))
  (def rows (match active ((Some (Tuple ra _)) (kept row-order (fun (rg) (array-ref ra rg)))) (None row-order)))
  (def columns (match active ((Some (Tuple _ ca)) (kept col-order (fun (cg) (array-ref ca cg)))) (None col-order)))
  (def m (array-length rows))
  (def row-table (clr-take (clr-select t #[row-idx]) (gathered row-firsts rows) m))
  (def names {vecing (any->string col-col (array-ref col-firsts cg) -1) (:for cg columns)})
  (match (repeated-name [row-key] names)
    ((Some name)
     (refuse (str "'" col-key "' has the value '" name "', and the table has a column of that name already.")))
    (None
     (def count-columns {arraying (column->any (clr-longs-at (array-ref counts cg) rows)) (:for cg columns)})
     (def k (array-length count-columns))
     (Ok (clr-from-fields
          {arraying (if (= i 0)
                        (field-at row-table 0)
                        (clr-new-field (vec-ref names (- i 1))
                                       (data-type (clr-data (array-ref count-columns (- i 1))))))
                    (:for i (range 0 (+ k 1)))}
          {arraying (if (= i 0) (clr-column row-table 0) (array-ref count-columns (- i 1)))
                    (:for i (range 0 (+ k 1)))}
          m)))))

;; The first of the names that is the row key's or one before it.
(: (-> (Vec string) (Vec string) (Option string)))
(defun (repeated-name taken names)
  (let go ((i 0) (seen (fold (fun (s m) (map-set m s #t)) (: (map-empty) (Map string bool)) taken)))
    (cond
      ((= i (vec-length names)) None)
      ((map-has-key? seen (vec-ref names i)) (Some (vec-ref names i)))
      (else (go (+ i 1) (map-set seen (vec-ref names i) #t))))))

;; The elements of `order` that `keep` keeps, in their order.
(: (-> (Array int) (-> int bool) (Array int)))
(defun (kept order keep)
  {arraying g (:for g order) (:when (keep g))})

;; Which row groups and which column groups kept a count, in one pass.
(: (-> (Array (Array long)) int (Tuple (Array bool) (Array bool))))
(defun (active-groups counts r-count)
  (def ra (: (make-array r-count) (Array bool)))
  (def ca (: (make-array (array-length counts)) (Array bool)))
  (let go ((c 0))
    (when (< c (array-length counts))
      (def cc (array-ref counts c))
      (let each ((rg 0))
        (when (< rg r-count)
          (when (not (= (array-ref cc rg) 0L))
            (array-set! ra rg #t)
            (array-set! ca c #t))
          (each (+ rg 1))))
      (go (+ c 1))))
  (Tuple ra ca))

(: (-> int int (Array (Array long))))
(defun (zero-counts r-count c-count)
  {arraying (: (make-array r-count) (Array long)) (:for _c (range 0 c-count))})

(: (-> (Array int) (Array int) int int int (Array (Array long))))
(defun (pair-counts row-of col-of r-count c-count n)
  (def counts (zero-counts r-count c-count))
  (def pairs (* (cast long c-count) (cast long r-count)))
  (cond
    ((and (>= n (* 2 count-part-rows)) (<= pairs (cast long count-parts-limit)))
     (def (Tuple parts size) (count-parts n))
     (def each (computing-each parts (fun (p)
                                       (def (Tuple from to) (part-rows p size n))
                                       (pair-part row-of col-of r-count (* c-count r-count) from to))))
     (loop (:for pc each) (:do (add-pairs! counts pc r-count)))
     counts)
    ((and (>= n (* 2 count-part-rows)) (<= pairs clr-dense-limit))
     (def (Tuple parts size) (count-parts n))
     (def flat (: (make-array (* c-count r-count)) (Array int)))
     (ignore (computing-each parts (fun (p)
                                     (def (Tuple from to) (part-rows p size n))
                                     (pair-part-atomic! flat row-of col-of r-count from to)
                                     unit)))
     (add-pairs! counts flat r-count)
     counts)
    (else
     (let go ((r 0))
       (when (< r n)
         (def cc (array-ref counts (array-ref col-of r)))
         (def rg (array-ref row-of r))
         (array-set! cc rg (+ (array-ref cc rg) 1L))
         (go (+ r 1))))
     counts)))

;; The count of each pair from `from` to `to`, at column times rows plus row.
(: (-> (Array int) (Array int) int int int int (Array int)))
(defun (pair-part row-of col-of r-count pairs from to)
  (def pc (: (make-array pairs) (Array int)))
  (let go ((r from))
    (when (< r to)
      (def s (+ (* (array-ref col-of r) r-count) (array-ref row-of r)))
      (array-set! pc s (+ (array-ref pc s) 1))
      (go (+ r 1))))
  pc)

(: (-> (Array int) (Array int) (Array int) int int int Unit))
(defun (pair-part-atomic! flat row-of col-of r-count from to)
  (let go ((r from))
    (when (< r to)
      (ignore (atomic-array-increment! flat (+ (* (array-ref col-of r) r-count) (array-ref row-of r))))
      (go (+ r 1)))))

(: (-> (Array (Array long)) (Array int) int Unit))
(defun (add-pairs! counts flat r-count)
  (let go ((c 0))
    (when (< c (array-length counts))
      (def cc (array-ref counts c))
      (def base (* c r-count))
      (let add ((rg 0))
        (when (< rg r-count)
          (array-set! cc rg (+ (array-ref cc rg) (cast long (array-ref flat (+ base rg)))))
          (add (+ rg 1))))
      (go (+ c 1)))))

;; The group of a key's nulls, the one whose first row is a null; None when
;; the key has none.
(: (-> AnyColumn (Array int) (Option int)))
(defun (null-group col firsts)
  (find (fun (g) (not (clr-any-valid? col (array-ref firsts g)))) (range 0 (array-length firsts))))

;; ===========================================================================
;; Categories
;; ===========================================================================
;;
;; A category is a column of strings from a small set, as R's factor: each
;; string, a level, is kept once, and each row has the number of its level,
;; its code. A group-by, a sort or a join on a category works on the codes.
;; Its cells, read as strings, are its levels:
;;
;;     (def (Ok t2) (table-categorize t "region"))
;;     (loop (:for r* (: (ok (column-as t2 "region")) (Cells string))) ...)
;;
;; A sort of a category is in the order of its levels, as in R.

;; The table with the column `name` a category. With no `#:levels`, the
;; levels are its distinct strings in the order of their code points, as R's
;; factor gives them; with `#:levels`, they are those, in that order, and a
;; string that is not one of them is an Err rather than a null, as it would
;; be in R. A null stays a null. A category is given new levels the same way.
;;
;;     (table-categorize t "size" #:levels ["small" "medium" "large"])
(: (-> Table string (#:levels (Vec string)) (Result TableError Table)))
(defun (table-categorize t name #:levels [])
  (problem-or (clr-categorize t name (vec->array levels))))

(: (-> Table string (Result TableError AnyColumn)))
(defun (find-category t name)
  (def (Ok c) (find-column t name) :propagate)
  (match (type-of-column c)
    (Category (Ok c))
    (other (refuse (str "'" name "' is a column of " (type-text other) ", not a category.")))))

;; The levels of the category `name`, in order: level `i` has code `i`.
(: (-> Table string (Result TableError (Vec string))))
(defun (category-levels t name)
  (def (Ok c) (find-category t name) :propagate)
  (Ok (array->vec (clr-levels c))))

;; The codes of the category `name`, as cells of ints, None at a null. A loop
;; over them reads ints from one span, which Bjolang can vectorize.
(: (-> Table string (Result TableError (Cells int))))
(defun (category-codes t name)
  (def (Ok c) (find-category t name) :propagate)
  (codes-of c name))

(: (-> AnyColumn string (Result TableError (Cells int))))
(defun (codes-of c name)
  (match (clr-cells-of (clr-codes c))
    ((Some cells) (Ok (Cells (clr cells))))
    (None (refuse (str "the codes of '" name "' are not ints.")))))

;; The distinct strings of the column of strings `name`, in the order of
;; their first rows, and the number of the string of each row, None at a
;; null: (bjostat query)'s string-groups. Each string is numbered once, in
;; parts on the compute threads.
(: (-> Table string (Result TableError (Tuple (Vec string) (Cells int)))))
(defun (string-numbers t name)
  (def (Ok c) (find-column t name) :propagate)
  (match (type-of-column c)
    (String
     (def numbered (clr-first-seen c))
     (def (Ok codes) (codes-of numbered name) :propagate)
     (Ok (Tuple (array->vec (clr-levels numbered)) codes)))
    (Category (refuse (str "'" name "' is a category: its groups are category-groups, and the group of a row category-codes.")))
    (other (refuse (str "'" name "' is a column of " (type-text other) ", not of strings.")))))

;; ===========================================================================
;; Files
;; ===========================================================================

;; The table of an Arrow IPC file. A file of several record batches is read
;; as one table, each column in one piece, so that it is one span.
(: (-> string (Result TableError Table)))
(defun (read-arrow path)
  (match (clr-read-file path)
    ((Ok t) (Ok t))
    ((Err e) (refuse (str path ": " (.-Message e))))))

(: (-> Table string (Result TableError Unit)))
(defun (write-arrow t path)
  (match (clr-write-file t path)
    ((Ok _) (Ok unit))
    ((Err e) (refuse (str path ": " (.-Message e))))))

;; ===========================================================================
;; Printing
;; ===========================================================================

;; The table as text: the names, the types, and the first `#:rows` rows, each
;; column as wide as its widest cell. With `#:digits`, a double or float is
;; rounded to that many decimals; one that is not 0 and rounds to 0 is
;; written with that many significant digits, as 2.551e-11.
(: (-> Table (#:rows int) (#:digits int) string))
(defun (table->string t #:rows 10 #:digits -1)
  (def shown (min rows (table-row-count t)))
  (def columns {vecing (clr-column t i) (:for i (range 0 (table-column-count t)))})
  (def cells
    (vec-map (fun (i)
               (def c (vec-ref columns i))
               (vec-add-first (vec-add-first {vecing (any->string c r digits) (:for r (range 0 shown))}
                                             (type-text (type-of-column c)))
                              (vec-ref (table-names t) i)))
             (range-vec (vec-length columns))))
  (def widths (vec-map (fun (col) (fold (fun (s w) (max w (string-length s))) 0 col)) cells))
  (def sb (stringbuilder-empty))
  (loop (:for line (range 0 (+ shown 2)))
        (:do (loop (:for i (range 0 (vec-length cells)))
                   (:do (when (> i 0) (stringbuilder-add-string! sb "  "))
                        (stringbuilder-add-string! sb (string-pad-right (vec-ref (vec-ref cells i) line)
                                                                        (vec-ref widths i)))))
             (stringbuilder-add-string! sb "\n")))
  (when (> (table-row-count t) shown)
    (stringbuilder-add-string! sb (str "… " (int->string (- (table-row-count t) shown)) " more rows\n")))
  (stringbuilder->string sb))

(: (-> int (Vec int)))
(defun (range-vec n) {vecing i (:for i (range 0 n))})
