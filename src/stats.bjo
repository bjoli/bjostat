;; bjostat/src/stats.bjo — the module (bjostat stats): statistics as
;; collectors, and the summary of a table.
;;
;; Each statistic is a collector of doubles, so it is a loop like any other:
;;
;;     (loop (:for p (skip-nulls price)) (:acc (standard-deviation p)))
;;     (loop (:for (Tuple p q) (complete-rows (Tuple price qty)))
;;           (:acc (correlation (Tuple p (cast double q)))))
;;
;; A null is left out by the loop, with skip-nulls, complete-rows or
;; :when-let, where R would need `na.rm = TRUE`. A statistic of too few values is None: the mean of none,
;; the variance of fewer than two. The variance and the standard deviation
;; are those of a sample, with n - 1, as R's `var` and `sd`. The mean, the
;; variance and the covariance are computed in one pass, from sums of the
;; differences from the first value: subtracting a value near the mean first
;; keeps the precision that plain sums of squares lose, and needs no division
;; for each value, as Welford's method does.
;;
;; The quantiles keep all the values and sort them, as R's `quantile` does by
;; default (its type 7).

(export
  Mean Variance StandardDeviation Covariance Correlation
  Quantile quantile Quantiles quantiles Median
  Summary Summarizing summary->string
  table-summary
  ;; The accumulators, opaque
  Moments CoMoments SummaryAcc
  ;; Moments, for other modules' collectors
  no-moments moments-add moments-count moments-mean moments-variance
  ;; Results that combine, for loops in parts (std parallel)
  MomentsOf moments-standard-deviation
  CoMomentsOf co-moments-count co-moments-covariance co-moments-correlation
  Values ValuesOf values-count values-quantile values-quantiles values-median values-summary
  ;; Of a whole column at once, with vector instructions
  ColumnNumber cells-moments cells-co-moments column-moments column-variance column-standard-deviation
  column-co-moments column-covariance column-correlation)

(import (std prelude))
(import (std combine))

;; Combinable, for the results of `moments`, `co-moments` and `values`. A
;; re-exported method carries its trait to importers.
(re-export combine combine-all)

(import (std mutable vec))
(import (only (std array) array-fill!))
(import (bjostat table))
(import (bjostat query))
(import (only (std parallel) computing-each))
(import (std simd))
(import (std maths))

;; .NET's Math as it is, for the results of the C# this was, to the last bit.
(import/extern
  (clr-max (: System.Math.Max (-> double double double)))
  (clr-floor (: System.Math.Floor (-> double double)))
  (clr-log (: System.Math.Log (-> double double)))
  (clr-exp (: System.Math.Exp (-> double double)))
  (clr-sqrt (: System.Math.Sqrt (-> double double)))
  (clr-clamp (: System.Math.Clamp (-> int int int int)))
  (clr-nan (: System.Double.NaN #:get))
  ;; An introsort, in place. Not stable; the order of equal doubles does not
  ;; change a quantile.
  (span-sort! (: System.MemoryExtensions.Sort (-> (Span %a) void))))

(import/class
  (ArgumentOutOfRangeException (: System.ArgumentOutOfRangeException
                                  (-> string string ArgumentOutOfRangeException)))
  (InvalidOperationException (: System.InvalidOperationException (-> string InvalidOperationException))))

;; ===========================================================================
;; Mean and variance, in one pass
;; ===========================================================================

;; How many values, the first of them, and the sums of their differences
;; from the first and of the squares of those.
(type (: Moments #:opaque (Struct (: n long) (: k double) (: s1 double) (: s2 double))))

(: Moments)
(def no-moments (Moments (n 0L) (k 0.0) (s1 0.0) (s2 0.0)))

(: (-> Moments double Moments))
(defun (moments-add m x) #:inline
  (def k (if (= (record-ref m n) 0L) x (record-ref m k)))
  (def d (- x k))
  (Moments (n (+ (record-ref m n) 1L)) (k k)
           (s1 (+ (record-ref m s1) d)) (s2 (+ (record-ref m s2) (* d d)))))

(: (-> Moments long))
(defun (moments-count m) (record-ref m n))

;; The mean of the values; NaN of none.
(: (-> Moments double))
(defun (moments-mean m)
  (+ (record-ref m k) (/ (record-ref m s1) (cast double (record-ref m n)))))

(: (-> Moments (Option double)))
(defun (moments-variance m)
  (def n (cast double (record-ref m n)))
  (def s1 (record-ref m s1))
  (if (< n 2.0) None (Some (max 0.0 (/ (- (record-ref m s2) (/ (* s1 s1) n)) (- n 1.0))))))

(: (-> Moments (Option double)))
(defun (moments-standard-deviation m)
  (match (moments-variance m)
    ((Some v) (Some (sqrt v)))
    (None None)))

;; The moments of the values `a` was made of, then those of `b`. `b`'s sums
;; are moved to `a`'s first value: exact, as each is a sum of differences.
(impl (Combinable Moments)
  (defun (combine a b)
    (cond
      ((= (record-ref b n) 0L) a)
      ((= (record-ref a n) 0L) b)
      (else
       (let* ((nb (cast double (record-ref b n)))
              (d (- (record-ref b k) (record-ref a k)))
              (s1b (record-ref b s1)))
         (Moments (n (+ (record-ref a n) (record-ref b n)))
                  (k (record-ref a k))
                  (s1 (+ (record-ref a s1) (+ s1b (* nb d))))
                  (s2 (+ (record-ref a s2)
                         (+ (record-ref b s2) (+ (* 2.0 (* d s1b)) (* nb (* d d))))))))))))

;; The moments themselves, for a loop whose parts are combined: finished by
;; `moments-mean`, `moments-variance` and `moments-standard-deviation`.
(type (: MomentsOf (Union moments)))

(impl (Collector MomentsOf)
  (type %elem double)
  (type %acc Moments)
  (type %out Moments)
  (defun (collector-init c) no-moments)
  (defun (collector-step c m x) (moments-add m x))
  (defun (collector-finish c m) m))

(type (: Mean (Union mean)))

(impl (Collector Mean)
  (type %elem double)
  (type %acc Moments)
  (type %out (Option double))
  (defun (collector-init c) no-moments)
  (defun (collector-step c m x) (moments-add m x))
  (defun (collector-finish c m)
    (if (= (record-ref m n) 0L) None (Some (moments-mean m)))))

(type (: Variance (Union variance)))

(impl (Collector Variance)
  (type %elem double)
  (type %acc Moments)
  (type %out (Option double))
  (defun (collector-init c) no-moments)
  (defun (collector-step c m x) (moments-add m x))
  (defun (collector-finish c m) (moments-variance m)))

(type (: StandardDeviation (Union standard-deviation)))

(impl (Collector StandardDeviation)
  (type %elem double)
  (type %acc Moments)
  (type %out (Option double))
  (defun (collector-init c) no-moments)
  (defun (collector-step c m x) (moments-add m x))
  (defun (collector-finish c m) (moments-standard-deviation m)))

;; ---------------------------------------------------------------------------
;; Whole columns, with vector instructions
;; ---------------------------------------------------------------------------
;;
;; The column functions make the sums of `moments` and `co-moments` of a whole
;; column and finish them with the collectors' own functions, so they differ
;; from a loop only in the order of the additions. The order is fixed, so that
;; a result is the same on every machine: the value of row r goes to lane
;; r % 8, each lane adds its values in row order, and the lanes are added
;; ((0 + 1) + (2 + 3)) + ((4 + 5) + (6 + 7)) (`lanes-total`). Rows in whole
;; blocks of 8 are two `Float64x4`; the rows after the last block, and all of
;; them without AVX2, go to an array of the 8 lanes one at a time: the same
;; additions. A null adds +0.0 to its lane in both.

;; How the values of a column of numbers become doubles: 4 at a time, for a
;; vector, and one at a time. A double is loaded as it is and a long is
;; converted 4 at a time, as (cast double x) converts one; the other types are
;; read one value at a time into the vector.
(def/trait (ColumnNumber %a)
  (: load-doubles (-> (Cells %a) int Float64x4))
  (: cell-double (-> (Cells %a) int double)))

(impl (ColumnNumber double)
  (defun (load-doubles c i) (simd256-load c i))
  (defun (cell-double c i) (cells-ref c i)))

(impl (ColumnNumber long)
  (defun (load-doubles c i) (simd256-int->float (simd256-load c i)))
  (defun (cell-double c i) (cast double (cells-ref c i))))

(impl (ColumnNumber int)
  (defun (load-doubles c i)
    (simd256-of (cast double (cells-ref c i)) (cast double (cells-ref c (+ i 1)))
                (cast double (cells-ref c (+ i 2))) (cast double (cells-ref c (+ i 3)))))
  (defun (cell-double c i) (cast double (cells-ref c i))))

(impl (ColumnNumber float)
  (defun (load-doubles c i)
    (simd256-of (cast double (cells-ref c i)) (cast double (cells-ref c (+ i 1)))
                (cast double (cells-ref c (+ i 2))) (cast double (cells-ref c (+ i 3)))))
  (defun (cell-double c i) (cast double (cells-ref c i))))

;; For each 4 valid bits, the lanes of a Float64x4 that are all ones where the
;; bit is set: `simd-and` with one keeps the lanes of the valid rows.
(: (Array Float64x4))
(def lane-masks
  {arraying (simd-bits->float64
              (: (simd256-of (if (= (bitwise-and m 1) 0) 0L -1L) (if (= (bitwise-and m 2) 0) 0L -1L)
                             (if (= (bitwise-and m 4) 0) 0L -1L) (if (= (bitwise-and m 8) 0) 0L -1L))
                 Int64x4))
            (:for m (range 0 16))})

;; The 8 lanes of an array added in the fixed order.
(: (-> (Array double) double))
(defun (lanes-total s)
  (+ (+ (+ (array-ref s 0) (array-ref s 1)) (+ (array-ref s 2) (array-ref s 3)))
     (+ (+ (array-ref s 4) (array-ref s 5)) (+ (array-ref s 6) (array-ref s 7)))))

;; The rows of the whole blocks of 8, for the vectors: none without AVX2.
(: (-> int int))
(defun (vector-rows n)
  (if simd256-accelerated? (* 8 (/ n 8)) 0))

;; Adds `d` to lane `lane` of `s`.
(: (-> (Array double) int double void))
(defun (lane-add! s lane d) #:inline
  (array-set! s lane (+ (array-ref s lane) d)))

;; The moments of the values of cells of numbers that are not null.
(: (-> (Cells %a) Moments) (where (ColumnNumber %a)))
(defun (cells-moments c)
  (def n (cells-length c))
  (def first (source-next-valid c 0))
  (if (>= first n)
      no-moments
      ;; The arrays are made before the vectors: a vector that lives across a
      ;; call is kept on the stack.
      (let* ((s1 (make-array 8 #:fill 0.0))
             (s2 (make-array 8 #:fill 0.0))
             (k (cell-double c first))
             (kv (simd256-splat k))
             (nulls? (> (cells-null-count c) 0))
             (masks lane-masks)
             (blocks (vector-rows n))
             (in-blocks
              (let go ((i 0) (count 0L)
                       (s1a (simd256-splat 0.0)) (s1b (simd256-splat 0.0))
                       (s2a (simd256-splat 0.0)) (s2b (simd256-splat 0.0)))
                (if (>= i blocks)
                    (begin
                      (simd-store! s1a s1 0) (simd-store! s1b s1 4)
                      (simd-store! s2a s2 0) (simd-store! s2b s2 4)
                      count)
                    (let* ((bits (if nulls? (bitwise-and (cells-window c n i) 255L) 255L))
                           (d0 (simd-sub (load-doubles c i) kv))
                           (d1 (simd-sub (load-doubles c (+ i 4)) kv))
                           (d0 (if nulls? (simd-and d0 (array-ref masks (cast int (bitwise-and bits 15L)))) d0))
                           (d1 (if nulls? (simd-and d1 (array-ref masks (cast int (shift-right bits 4)))) d1)))
                      (go (+ i 8) (+ count (cast long (popcount (cast int bits))))
                          (simd-add s1a d0) (simd-add s1b d1)
                          (simd-add s2a (simd-mul d0 d0)) (simd-add s2b (simd-mul d1 d1))))))))
        (def count
          (let tail ((i blocks) (count 0L))
            (if (>= i n)
                count
                (let* ((lane (bitwise-and i 7))
                       (valid? (cells-valid? c i))
                       (d (if valid? (- (cell-double c i) k) 0.0)))
                  (begin
                    (lane-add! s1 lane d)
                    (lane-add! s2 lane (* d d))
                    (tail (+ i 1) (if valid? (+ count 1L) count)))))))
        (Moments (n (+ in-blocks count)) (k k) (s1 (lanes-total s1)) (s2 (lanes-total s2))))))

;; The moments of the values of a column of numbers that are not null, as
;; `moments` collects them, of the whole column at once:
;;
;;     (column-standard-deviation (or-panic (doubles t "price")))
;;
;; It differs from the loop's only in the order of the additions: in the last
;; digits.
(: (-> (Column %a) Moments) (where (ColumnNumber %a)))
(defun (column-moments c) (cells-moments (column->cells c)))

;; The variance of a sample, as `variance`; None for fewer than two values.
(: (-> (Column %a) (Option double)) (where (ColumnNumber %a)))
(defun (column-variance c) (moments-variance (column-moments c)))

;; As `standard-deviation`; None for fewer than two values.
(: (-> (Column %a) (Option double)) (where (ColumnNumber %a)))
(defun (column-standard-deviation c) (moments-standard-deviation (column-moments c)))

;; ===========================================================================
;; Covariance and correlation, in one pass
;; ===========================================================================

;; Of pairs: the count, the first pair, and the sums of the differences from
;; it, of their squares and of their products.
(type (: CoMoments #:opaque (Struct (: n long) (: kx double) (: ky double)
                                    (: sx double) (: sy double)
                                    (: sxx double) (: syy double) (: sxy double))))

(: CoMoments)
(def no-co-moments (CoMoments (n 0L) (kx 0.0) (ky 0.0) (sx 0.0) (sy 0.0) (sxx 0.0) (syy 0.0) (sxy 0.0)))

;; Written #:inline, as moments-add is, so that a loop of a collector of
;; another module has the step in it and not a call: with a call, .NET
;; inlined the step only with its dynamic profile (bench/null-cost.bjo).
(: (-> CoMoments (Tuple double double) CoMoments))
(defun (co-moments-add m xy) #:inline
  (def (x y) xy)
  (def first? (= (record-ref m n) 0L))
  (def kx (if first? x (record-ref m kx)))
  (def ky (if first? y (record-ref m ky)))
  (def dx (- x kx))
  (def dy (- y ky))
  (CoMoments (n (+ (record-ref m n) 1L)) (kx kx) (ky ky)
             (sx (+ (record-ref m sx) dx)) (sy (+ (record-ref m sy) dy))
             (sxx (+ (record-ref m sxx) (* dx dx)))
             (syy (+ (record-ref m syy) (* dy dy)))
             (sxy (+ (record-ref m sxy) (* dx dy)))))

;; The sums of squares and of products about the means: what the sums about
;; the first pair become.
(: (-> CoMoments (Tuple double double double)))
(defun (centred m)
  (def n (cast double (record-ref m n)))
  (def sx (record-ref m sx))
  (def sy (record-ref m sy))
  (Tuple (max 0.0 (- (record-ref m sxx) (/ (* sx sx) n)))
         (max 0.0 (- (record-ref m syy) (/ (* sy sy) n)))
         (- (record-ref m sxy) (/ (* sx sy) n))))

(: (-> CoMoments long))
(defun (co-moments-count m) (record-ref m n))

;; The covariance of a sample; None for fewer than two pairs.
(: (-> CoMoments (Option double)))
(defun (co-moments-covariance m)
  (def n (record-ref m n))
  (def (_ _ sxy) (centred m))
  (if (< n 2L) None (Some (/ sxy (cast double (- n 1L))))))

;; Pearson's correlation; None for fewer than two pairs, and when one side
;; has the same value in each pair.
(: (-> CoMoments (Option double)))
(defun (co-moments-correlation m)
  (def (sxx syy sxy) (centred m))
  (if (or (< (record-ref m n) 2L) (= sxx 0.0) (= syy 0.0))
      None
      (Some (/ sxy (sqrt (* sxx syy))))))

;; As `Moments`: `b`'s sums moved to `a`'s first pair.
(impl (Combinable CoMoments)
  (defun (combine a b)
    (cond
      ((= (record-ref b n) 0L) a)
      ((= (record-ref a n) 0L) b)
      (else
       (let* ((nb (cast double (record-ref b n)))
              (dx (- (record-ref b kx) (record-ref a kx)))
              (dy (- (record-ref b ky) (record-ref a ky)))
              (sxb (record-ref b sx))
              (syb (record-ref b sy)))
         (CoMoments (n (+ (record-ref a n) (record-ref b n)))
                    (kx (record-ref a kx)) (ky (record-ref a ky))
                    (sx (+ (record-ref a sx) (+ sxb (* nb dx))))
                    (sy (+ (record-ref a sy) (+ syb (* nb dy))))
                    (sxx (+ (record-ref a sxx)
                            (+ (record-ref b sxx) (+ (* 2.0 (* dx sxb)) (* nb (* dx dx))))))
                    (syy (+ (record-ref a syy)
                            (+ (record-ref b syy) (+ (* 2.0 (* dy syb)) (* nb (* dy dy))))))
                    (sxy (+ (record-ref a sxy)
                            (+ (record-ref b sxy)
                               (+ (* dx syb) (+ (* dy sxb) (* nb (* dx dy)))))))))))))

;; The moments of pairs themselves, for a loop whose parts are combined:
;; finished by `co-moments-covariance` and `co-moments-correlation`.
(type (: CoMomentsOf (Union co-moments)))

(impl (Collector CoMomentsOf)
  (type %elem (Tuple double double))
  (type %acc CoMoments)
  (type %out CoMoments)
  (defun (collector-init c) no-co-moments)
  (defun (collector-step c m xy) (co-moments-add m xy))
  (defun (collector-finish c m) m))

(type (: Covariance (Union covariance)))

(impl (Collector Covariance)
  (type %elem (Tuple double double))
  (type %acc CoMoments)
  (type %out (Option double))
  (defun (collector-init c) no-co-moments)
  (defun (collector-step c m xy) (co-moments-add m xy))
  (defun (collector-finish c m) (co-moments-covariance m)))

;; Pearson's correlation. None for fewer than two pairs, and when one side
;; has the same value in each pair, as R's `cor` is NA then.
(type (: Correlation (Union correlation)))

(impl (Collector Correlation)
  (type %elem (Tuple double double))
  (type %acc CoMoments)
  (type %out (Option double))
  (defun (collector-init c) no-co-moments)
  (defun (collector-step c m xy) (co-moments-add m xy))
  (defun (collector-finish c m) (co-moments-correlation m)))

;; The moments of the pairs of cells of numbers where neither is null, of
;; the rows of the shorter: as `cells-moments`, with five sums.
(: (-> (Cells %a) (Cells %b) CoMoments) (where (ColumnNumber %a) (ColumnNumber %b)))
(defun (cells-co-moments x y)
  (def n (min (cells-length x) (cells-length y)))
  (def first
    (let find ((i 0))
      (if (or (>= i n) (and (cells-valid? x i) (cells-valid? y i))) i (find (+ i 1)))))
  (if (>= first n)
      no-co-moments
      ;; The arrays first, as in cells-moments.
      (let* ((sx (make-array 8 #:fill 0.0)) (sy (make-array 8 #:fill 0.0))
             (sxx (make-array 8 #:fill 0.0)) (syy (make-array 8 #:fill 0.0)) (sxy (make-array 8 #:fill 0.0))
             (kx (cell-double x first))
             (ky (cell-double y first))
             (kxv (simd256-splat kx))
             (kyv (simd256-splat ky))
             (x-nulls? (> (cells-null-count x) 0))
             (y-nulls? (> (cells-null-count y) 0))
             (nulls? (or x-nulls? y-nulls?))
             (masks lane-masks)
             (blocks (vector-rows n))
             (zero (simd256-splat 0.0))
             (in-blocks
              (let go ((i 0) (count 0L)
                       (sxa zero) (sxb zero) (sya zero) (syb zero)
                       (sxxa zero) (sxxb zero) (syya zero) (syyb zero) (sxya zero) (sxyb zero))
                (if (>= i blocks)
                    (begin
                      (simd-store! sxa sx 0) (simd-store! sxb sx 4)
                      (simd-store! sya sy 0) (simd-store! syb sy 4)
                      (simd-store! sxxa sxx 0) (simd-store! sxxb sxx 4)
                      (simd-store! syya syy 0) (simd-store! syyb syy 4)
                      (simd-store! sxya sxy 0) (simd-store! sxyb sxy 4)
                      count)
                    (let* ((bits (bitwise-and (if x-nulls? (cells-window x n i) 255L)
                                              (if y-nulls? (cells-window y n i) 255L)
                                              255L))
                           (lo (cast int (bitwise-and bits 15L)))
                           (hi (cast int (shift-right bits 4)))
                           ;; Rows i to i + 3 into lanes 0-3, all five sums,
                           ;; before rows i + 4 to i + 7 are loaded: fewer
                           ;; vectors are live at once than the 16 registers.
                           ;; A mask is read where it is used, for the same
                           ;; reason.
                           (dx0 (simd-sub (load-doubles x i) kxv))
                           (dx0 (if nulls? (simd-and dx0 (array-ref masks lo)) dx0))
                           (dy0 (simd-sub (load-doubles y i) kyv))
                           (dy0 (if nulls? (simd-and dy0 (array-ref masks lo)) dy0))
                           (sxa (simd-add sxa dx0))
                           (sya (simd-add sya dy0))
                           (sxxa (simd-add sxxa (simd-mul dx0 dx0)))
                           (syya (simd-add syya (simd-mul dy0 dy0)))
                           (sxya (simd-add sxya (simd-mul dx0 dy0)))
                           (dx1 (simd-sub (load-doubles x (+ i 4)) kxv))
                           (dx1 (if nulls? (simd-and dx1 (array-ref masks hi)) dx1))
                           (dy1 (simd-sub (load-doubles y (+ i 4)) kyv))
                           (dy1 (if nulls? (simd-and dy1 (array-ref masks hi)) dy1)))
                      (go (+ i 8) (+ count (cast long (popcount (cast int bits))))
                          sxa (simd-add sxb dx1)
                          sya (simd-add syb dy1)
                          sxxa (simd-add sxxb (simd-mul dx1 dx1))
                          syya (simd-add syyb (simd-mul dy1 dy1))
                          sxya (simd-add sxyb (simd-mul dx1 dy1))))))))
        (def count
          (let tail ((i blocks) (count 0L))
            (if (>= i n)
                count
                (let* ((lane (bitwise-and i 7))
                       (valid? (and (cells-valid? x i) (cells-valid? y i)))
                       (dx (if valid? (- (cell-double x i) kx) 0.0))
                       (dy (if valid? (- (cell-double y i) ky) 0.0)))
                  (begin
                    (lane-add! sx lane dx)
                    (lane-add! sy lane dy)
                    (lane-add! sxx lane (* dx dx))
                    (lane-add! syy lane (* dy dy))
                    (lane-add! sxy lane (* dx dy))
                    (tail (+ i 1) (if valid? (+ count 1L) count)))))))
        (CoMoments (n (+ in-blocks count)) (kx kx) (ky ky)
                   (sx (lanes-total sx)) (sy (lanes-total sy))
                   (sxx (lanes-total sxx)) (syy (lanes-total syy)) (sxy (lanes-total sxy))))))

;; The moments of the pairs of two columns of numbers where neither is null,
;; as `co-moments` collects them, of the rows of the shorter column at once,
;; as `column-moments`:
;;
;;     (column-correlation (or-panic (doubles t "price")) (or-panic (longs t "qty")))
(: (-> (Column %a) (Column %b) CoMoments) (where (ColumnNumber %a) (ColumnNumber %b)))
(defun (column-co-moments x y) (cells-co-moments (column->cells x) (column->cells y)))

;; As `covariance`; None for fewer than two pairs.
(: (-> (Column %a) (Column %b) (Option double)) (where (ColumnNumber %a) (ColumnNumber %b)))
(defun (column-covariance x y) (co-moments-covariance (column-co-moments x y)))

;; As `correlation`; None for fewer than two pairs, and when one column has
;; the same value in each pair.
(: (-> (Column %a) (Column %b) (Option double)) (where (ColumnNumber %a) (ColumnNumber %b)))
(defun (column-correlation x y) (co-moments-correlation (column-co-moments x y)))

;; ===========================================================================
;; Quantiles
;; ===========================================================================

;; The values of a quantile collector are kept in a MutableVec, which a
;; vector loop fills a block at a time.
(: (-> (MutableVec double) int (MutableVec double)))
(defun (stats-grow xs n)
  (mutablevec-grow! xs n)
  xs)

;; A value is never None in a vector loop over values that are not null.
(: (-> (MutableVec double) int void))
(defun (stats-no-none! _xs _i)
  (raise (cast Exception (InvalidOperationException. "(bjostat stats): a quantile value cannot be None"))))

;; The quantiles at `ps` of the values, as R's `quantile` gives them by
;; default (its type 7): the value at (n - 1) p in the sorted values, and
;; between two values a straight line between them.
;; - The values are reordered in place. They are not sorted: a selection puts
;;   each value that is necessary at its place in the sorted order.
;; - NaN at each p when a value is NaN or there are no values.
;; - Raises ArgumentOutOfRangeException when a p is not between 0 and 1.
(: (-> (MutableVec double) (Array double) (Array double)))
(defun (quantiles-in-place! values ps)
  (loop (:for p ps)
        (:do (unless (and (>= p 0.0) (<= p 1.0))
               (raise (cast Exception
                            (ArgumentOutOfRangeException.
                             "ps" (str "(bjostat stats): a quantile at " (.ToString p)
                                       ", which is not between 0 and 1")))))))
  (def n (mutablevec-length values))
  (def result (: (make-array (array-length ps)) (Array double)))
  (if (or (= n 0) (any-nan? (mutablevec-span values 0 n)))
      (array-fill! result clr-nan)
      (select-quantiles! (mutablevec-span values 0 n) ps result))
  result)

;; The seven numbers of a summary of the values, which are not empty: min,
;; q1, median, mean, q3, max and sd. The values are reordered in place. Seven
;; NaNs when a value is NaN, or a sum is not a number.
(: (-> (MutableVec double) (Array double)))
(defun (summary-in-place! values)
  (summarize! (mutablevec-span values 0 (mutablevec-length values))))

(: (Array double))
(def summary-ps #[0.0 0.25 0.5 0.75 1.0])

(: (-> (Span double) (Array double)))
(defun (summarize! xs)
  (def len (span-length xs))
  (def k (span-ref xs 0))
  (def (Tuple s1 s2)
    (let go ((i 0) (s1 0.0) (s2 0.0))
      (if (< i len)
          (let ((d (- (span-ref xs i) k)))
            (go (+ i 1) (+ s1 d) (+ s2 (* d d))))
          (Tuple s1 s2))))
  (if (nan? s2)
      (make-array 7 #:fill clr-nan)
      (let* ((n (cast double len))
             (mean (+ k (/ s1 n)))
             (sd (if (< len 2) clr-nan (clr-sqrt (clr-max 0.0 (/ (- s2 (/ (* s1 s1) n)) (- n 1.0))))))
             (qs (: (make-array 5) (Array double))))
        (select-quantiles! xs summary-ps qs)
        #[(array-ref qs 0) (array-ref qs 1) (array-ref qs 2) mean (array-ref qs 3) (array-ref qs 4) sd])))

(: (-> (Span double) bool))
(defun (any-nan? xs)
  (let go ((i 0))
    (cond
      ((= i (span-length xs)) #f)
      ((nan? (span-ref xs i)) #t)
      (else (go (+ i 1))))))

;; The quantiles at `ps` into `result`, of values with no NaN.
;; The places in the sorted order that the quantiles use are found from the
;; least up, so that each selection looks only at the values after the last
;; place.
(: (-> (Span double) (Array double) (Array double) void))
(defun (select-quantiles! xs ps result)
  (def n (span-length xs))
  ;; The places: the index below (n - 1) p, and the one above it when p is
  ;; between two.
  (def places (: (make-array (* 2 (array-length ps))) (Array int)))
  (def count
    (let go ((i 0) (count 0))
      (if (= i (array-length ps))
          count
          (let* ((h (* (cast double (- n 1)) (array-ref ps i)))
                 (lo (cast int (clr-floor h))))
            (array-set! places count lo)
            (if (> h (cast double lo))
                (begin
                  (array-set! places (+ count 1) (+ lo 1))
                  (go (+ i 1) (+ count 2)))
                (go (+ i 1) (+ count 1)))))))
  (span-sort! (array->span places #:to count))
  (def unique
    (let go ((i 0) (u 0))
      (cond
        ((= i count) u)
        ((or (= u 0) (not (= (array-ref places i) (array-ref places (- u 1)))))
         (array-set! places u (array-ref places i))
         (go (+ i 1) (+ u 1)))
        (else (go (+ i 1) u)))))
  (select-all! xs 0 (- n 1) places 0 unique)
  (let go ((i 0))
    (when (< i (array-length ps))
      (let* ((h (* (cast double (- n 1)) (array-ref ps i)))
             (lo (cast int (clr-floor h))))
        (array-set! result i
                    (if (> h (cast double lo))
                        (+ (span-ref xs lo) (* (- h (cast double lo)) (- (span-ref xs (+ lo 1)) (span-ref xs lo))))
                        (span-ref xs lo)))
        (go (+ i 1))))))

;; Each place of `places`, from `from` to `to`, sorted, gets its value in the
;; sorted order of the values from `lo` to `hi`. The middle place first: it
;; splits the values and the other places in two.
(: (-> (Span double) int int (Array int) int int void))
(defun (select-all! xs lo hi places from to)
  (unless (or (= from to) (> lo hi))
    (let* ((mid (+ from (quotient (- to from) 2)))
           (k (array-ref places mid)))
      (select! xs lo hi k)
      (select-all! xs lo (- k 1) places from mid)
      (select-all! xs (+ k 1) hi places (+ mid 1) to))))

;; Puts the value that belongs at `k` in the sorted order of the values from
;; `left` to `right` there, the smaller values before it and the greater
;; after it.
;; - `k` at an end: one scan for the least or the greatest.
;; - 33 values or fewer: a sort.
;; - More than 600: Floyd-Rivest selection. It first selects in a small slice
;;   around `k`, so that the pivot is near the value at `k`, and one pass
;;   makes the range a few thousand values.
;; - Else the median of three is the pivot.
(: (-> (Span double) int int int void))
(defun (select! xs left right k)
  (let go ((left left) (right right))
    (when (> right left)
      (cond
        ((= k left) (swap! xs left (least-at xs left right)))
        ((= k right) (swap! xs right (greatest-at xs left right)))
        ((<= (- right left) 32) (span-sort! (span-slice xs #:from left #:to (+ right 1))))
        (else
         (if (> (- right left) 600)
             (floyd-rivest! xs left right k)
             (median-of-three! xs left right k))
         (def j (partition! xs left right k))
         (go (if (<= j k) (+ j 1) left) (if (<= k j) (- j 1) right)))))))

;; The index of the first least value from `left` to `right`.
(: (-> (Span double) int int int))
(defun (least-at xs left right)
  (let go ((i (+ left 1)) (at left) (least (span-ref xs left)))
    (cond
      ((> i right) at)
      ((< (span-ref xs i) least) (go (+ i 1) i (span-ref xs i)))
      (else (go (+ i 1) at least)))))

;; The index of the greatest value from `left` to `right`: `right`, or the
;; first from `left` that is greater.
(: (-> (Span double) int int int))
(defun (greatest-at xs left right)
  (let go ((i left) (at right) (greatest (span-ref xs right)))
    (cond
      ((>= i right) at)
      ((> (span-ref xs i) greatest) (go (+ i 1) i (span-ref xs i)))
      (else (go (+ i 1) at greatest)))))

(: (-> (Span double) int int void))
(defun (swap! xs a b)
  #:inline
  (let ((t (span-ref xs a)))
    (span-set! xs a (span-ref xs b))
    (span-set! xs b t)))

;; Selects `k` in a slice around it whose size grows as n^(2/3), so that the
;; value at `k` is a good pivot for the whole range.
(: (-> (Span double) int int int void))
(defun (floyd-rivest! xs left right k)
  (def* (n (cast double (+ (- right left) 1)))
        (m (cast double (+ (- k left) 1)))
        (z (clr-log n))
        (s (* 0.5 (clr-exp (/ (* 2.0 z) 3.0))))
        (sd (* (* 0.5 (clr-sqrt (/ (* (* z s) (- n s)) n))) (if (< (- m (/ n 2.0)) 0.0) -1.0 1.0)))
        (new-left (clr-clamp (cast int (+ (- (cast double k) (/ (* m s) n)) sd)) left k))
        (new-right (clr-clamp (cast int (+ (+ (cast double k) (/ (* (- n m) s) n)) sd)) k right)))
  (select! xs new-left new-right k))

;; The median of the values at `left`, the middle and `right`, moved to `k`.
(: (-> (Span double) int int int void))
(defun (median-of-three! xs left right k)
  (def mid (+ left (quotient (- right left) 2)))
  (when (< (span-ref xs mid) (span-ref xs left)) (swap! xs mid left))
  (when (< (span-ref xs right) (span-ref xs left)) (swap! xs right left))
  (when (< (span-ref xs right) (span-ref xs mid)) (swap! xs right mid))
  (swap! xs mid k))

;; Partitions the values from `left` to `right` around the value at `k`,
;; and returns the index where that value is after it.
(: (-> (Span double) int int int int))
(defun (partition! xs left right k)
  (def t (span-ref xs k))
  (swap! xs left k)
  (when (> (span-ref xs right) t) (swap! xs right left))
  (def j
    (let go ((i left) (j right))
      (if (< i j)
          (begin
            (swap! xs i j)
            (go (first-not-below xs (+ i 1) t) (last-not-above xs (- j 1) t)))
          j)))
  ;; == of C#: = of Bjolang is Equals, which is true of two NaNs.
  (if (and (<= (span-ref xs left) t) (>= (span-ref xs left) t))
      (begin
        (swap! xs left j)
        j)
      (begin
        (swap! xs (+ j 1) right)
        (+ j 1))))

(: (-> (Span double) int double int))
(defun (first-not-below xs i t)
  (let go ((i i))
    (if (< (span-ref xs i) t) (go (+ i 1)) i)))

(: (-> (Span double) int double int))
(defun (last-not-above xs j t)
  (let go ((j j))
    (if (> (span-ref xs j) t) (go (- j 1)) j)))

;; The quantile at p, 0 to 1, as R's `quantile` gives it by default: the
;; value at (n - 1) p in the sorted values, and between two values a straight
;; line between them. NaN when a value is NaN; None when there are none.
(type (: Quantile #:opaque (Struct (: p double))))

(: (-> double Quantile))
(defun (quantile p) (Quantile (p p)))

(: (-> (MutableVec double) (Array double) (Option (Array double))))
(defun (quantiles-of values ps)
  (if (= (mutablevec-length values) 0)
      None
      (Some (quantiles-in-place! values ps))))

(impl (Collector Quantile)
  (type %elem double)
  (type %acc (MutableVec double))
  (type %out (Option double))
  (defun (collector-init c) (mutablevec))
  (defun (collector-step c acc x) (mutablevec-add! acc x) acc)
  (defun (collector-finish c acc)
    (match (quantiles-of acc (vec->array [(record-ref c p)]))
      ((Some qs) (Some (array-ref qs 0)))
      (None None))))

(impl (BlockCollector Quantile)
  (type %value double)
  (type %acc (MutableVec double))
  (defun (block-count c acc) (mutablevec-length acc))
  (defun (block-grow c acc n) (stats-grow acc n))
  (defun (block-span c acc start n) (mutablevec-span acc start n))
  (defun (block-none! c acc i) (stats-no-none! acc i)))

;; The quantiles at several p, from one sort.
(type (: Quantiles #:opaque (Struct (: ps (Vec double)))))

(: (-> (Vec double) Quantiles))
(defun (quantiles ps) (Quantiles (ps ps)))

(impl (Collector Quantiles)
  (type %elem double)
  (type %acc (MutableVec double))
  (type %out (Option (Vec double)))
  (defun (collector-init c) (mutablevec))
  (defun (collector-step c acc x) (mutablevec-add! acc x) acc)
  (defun (collector-finish c acc)
    (match (quantiles-of acc (vec->array (record-ref c ps)))
      ((Some qs) (Some (array->vec qs)))
      (None None))))

(impl (BlockCollector Quantiles)
  (type %value double)
  (type %acc (MutableVec double))
  (defun (block-count c acc) (mutablevec-length acc))
  (defun (block-grow c acc n) (stats-grow acc n))
  (defun (block-span c acc start n) (mutablevec-span acc start n))
  (defun (block-none! c acc i) (stats-no-none! acc i)))

;; The median: the quantile at 0.5.
(type (: Median (Union median)))

(impl (Collector Median)
  (type %elem double)
  (type %acc (MutableVec double))
  (type %out (Option double))
  (defun (collector-init c) (mutablevec))
  (defun (collector-step c acc x) (mutablevec-add! acc x) acc)
  (defun (collector-finish c acc)
    (match (quantiles-of acc (vec->array [0.5]))
      ((Some qs) (Some (array-ref qs 0)))
      (None None))))

(impl (BlockCollector Median)
  (type %value double)
  (type %acc (MutableVec double))
  (defun (block-count c acc) (mutablevec-length acc))
  (defun (block-grow c acc n) (stats-grow acc n))
  (defun (block-span c acc start n) (mutablevec-span acc start n))
  (defun (block-none! c acc i) (stats-no-none! acc i)))

;; ===========================================================================
;; Summary
;; ===========================================================================

;; What R's `summary` says of numbers: the least, the quartiles, the mean and
;; the greatest, and here also how many there are and the standard deviation.
(type (: Summary (Record (: count long)
                         (: min double) (: q1 double) (: median double)
                         (: mean double) (: q3 double) (: max double)
                         (: sd (Option double)))))

;; The summary of the values, or None when there are none.
(type (: Summarizing (Union summarizing)))

(type (: SummaryAcc #:opaque (Struct (: values (MutableVec double)))))

(impl (Collector Summarizing)
  (type %elem double)
  (type %acc SummaryAcc)
  (type %out (Option Summary))
  (defun (collector-init c) (SummaryAcc (values (mutablevec))))
  (defun (collector-step c acc x)
    (mutablevec-add! (record-ref acc values) x)
    acc)
  (defun (collector-finish c acc) (summary-of (record-ref acc values))))

;; The summary of the values, reordered in place; None of none.
(: (-> (MutableVec double) (Option Summary)))
(defun (summary-of vs)
  (def n (mutablevec-length vs))
  (if (= n 0)
      None
      (let ((q (summary-in-place! vs)))
        (Some (Summary (count (cast long n))
                       (min (array-ref q 0)) (q1 (array-ref q 1)) (median (array-ref q 2))
                       (mean (array-ref q 3)) (q3 (array-ref q 4)) (max (array-ref q 5))
                       (sd (if (< n 2) None (Some (array-ref q 6)))))))))

(impl (BlockCollector Summarizing)
  (type %value double)
  (type %acc SummaryAcc)
  (defun (block-count c acc) (mutablevec-length (record-ref acc values)))
  (defun (block-grow c acc n) (SummaryAcc (values (stats-grow (record-ref acc values) n))))
  (defun (block-span c acc start n) (mutablevec-span (record-ref acc values) start n))
  (defun (block-none! c acc i) (stats-no-none! (record-ref acc values) i)))

;; ===========================================================================
;; Values, for quantiles of a loop in parts
;; ===========================================================================

;; The values a loop collected, in the order of their rows. Immutable, so
;; that it combines: the values of `a`, then those of `b`.
(type (: Values #:opaque (Struct (: xs (IArray double)))))

(impl (Combinable Values)
  (defun (combine a b) (Values (xs (combine (record-ref a xs) (record-ref b xs)))))
  (defun (combine-all vs) (Values (xs (combine-all (vec-map (fun (v) (record-ref v xs)) vs))))))

;; The values themselves, for a loop whose parts are combined: finished by
;; `values-quantile`, `values-quantiles`, `values-median` and `values-summary`.
(type (: ValuesOf (Union values)))

(impl (Collector ValuesOf)
  (type %elem double)
  (type %acc (MutableVec double))
  (type %out Values)
  (defun (collector-init c) (mutablevec))
  (defun (collector-step c acc x) (mutablevec-add! acc x) acc)
  (defun (collector-finish c acc) (Values (xs (mutablevec->iarray acc)))))

(impl (BlockCollector ValuesOf)
  (type %value double)
  (type %acc (MutableVec double))
  (defun (block-count c acc) (mutablevec-length acc))
  (defun (block-grow c acc n) (stats-grow acc n))
  (defun (block-span c acc start n) (mutablevec-span acc start n))
  (defun (block-none! c acc i) (stats-no-none! acc i)))

(: (-> Values long))
(defun (values-count v) (cast long (iarray-length (record-ref v xs))))

;; A copy, which the selections of the quantiles reorder.
(: (-> Values (MutableVec double)))
(defun (values-copy v)
  (def xs (record-ref v xs))
  (def out (mutablevec-with-capacity (iarray-length xs)))
  (loop (:for i (range 0 (iarray-length xs)))
        (:do (mutablevec-add! out (iarray-ref xs i))))
  out)

;; As `quantile`: at p, 0 to 1; NaN when a value is NaN; None of none.
(: (-> Values double (Option double)))
(defun (values-quantile v p)
  (match (quantiles-of (values-copy v) (vec->array [p]))
    ((Some qs) (Some (array-ref qs 0)))
    (None None)))

(: (-> Values (Vec double) (Option (Vec double))))
(defun (values-quantiles v ps)
  (match (quantiles-of (values-copy v) (vec->array ps))
    ((Some qs) (Some (array->vec qs)))
    (None None)))

(: (-> Values (Option double)))
(defun (values-median v) (values-quantile v 0.5))

(: (-> Values (Option Summary)))
(defun (values-summary v) (summary-of (values-copy v)))

(: (-> double string))
(defun (number-text x) (displayed x))

(: (-> Summary string))
(defun (summary->string s)
  (str "n " (displayed (record-ref s count))
       ", min " (number-text (record-ref s min))
       ", q1 " (number-text (record-ref s q1))
       ", median " (number-text (record-ref s median))
       ", mean " (number-text (record-ref s mean))
       ", q3 " (number-text (record-ref s q3))
       ", max " (number-text (record-ref s max))
       (match (record-ref s sd) ((Some sd) (str ", sd " (number-text sd))) (None ""))))

;; The values of a column of numbers as doubles, nulls left out, or None for
;; a column of another type. A bool is 0 or 1, so that the mean is the share
;; of trues, as R's mean of a logical vector.
(: (-> Table string ColumnType (Option (Option Summary))))
(defun (column-summary t name type)
  (match type
    (Double (Some (loop (:for x* (ok-cells (doubles-of t name))) (:when-let (Some x) x*)
                        (:acc (summarizing x)))))
    (Float (Some (loop (:for x* (ok-cells (floats-of t name))) (:when-let (Some x) x*)
                       (:acc (summarizing (cast double x))))))
    (Long (Some (loop (:for x* (ok-cells (longs-of t name))) (:when-let (Some x) x*)
                      (:acc (summarizing (cast double x))))))
    (Int (Some (loop (:for x* (ok-cells (ints-of t name))) (:when-let (Some x) x*)
                     (:acc (summarizing (cast double x))))))
    (Short (Some (loop (:for x* (ok-cells (: (column-as t name) (Result TableError (Cells short))))) (:when-let (Some x) x*)
                      (:acc (summarizing (cast double x))))))
    (Byte (Some (loop (:for x* (ok-cells (: (column-as t name) (Result TableError (Cells byte))))) (:when-let (Some x) x*)
                     (:acc (summarizing (cast double x))))))
    (UShort (Some (loop (:for x* (ok-cells (: (column-as t name) (Result TableError (Cells ushort))))) (:when-let (Some x) x*)
                        (:acc (summarizing (cast double x))))))
    (UInt (Some (loop (:for x* (ok-cells (: (column-as t name) (Result TableError (Cells uint))))) (:when-let (Some x) x*)
                      (:acc (summarizing (cast double x))))))
    (ULong (Some (loop (:for x* (ok-cells (: (column-as t name) (Result TableError (Cells ulong))))) (:when-let (Some x) x*)
                       (:acc (summarizing (cast double x))))))
    (Bool (Some (loop (:for x* (ok-cells (bools-of t name))) (:when-let (Some x) x*)
                      (:acc (summarizing (if x 1.0 0.0))))))
    (_ None)))

(: (-> (Result TableError %a) %a))
(defun (ok-cells r)
  (match r
    ((Ok c) c)
    ((Err e) (panic! (displayed e)))))

(: (-> Table string (Result TableError (Cells double))))
(defun (doubles-of t name) (column-as t name))
(: (-> Table string (Result TableError (Cells float))))
(defun (floats-of t name) (column-as t name))
(: (-> Table string (Result TableError (Cells long))))
(defun (longs-of t name) (column-as t name))
(: (-> Table string (Result TableError (Cells int))))
(defun (ints-of t name) (column-as t name))
(: (-> Table string (Result TableError (Cells bool))))
(defun (bools-of t name) (column-as t name))

;; A table with a row for each column of `t`, as R's `summary` of a data
;; frame: its name, its type, how many values and nulls it has, and for a
;; column of numbers or bools the least, the quartiles, the mean, the greatest and the
;; standard deviation, which are null for other columns and for a column of
;; nulls only. Each column is summarized as a part on (std parallel)'s
;; compute threads; a bjoroutine waits for them suspended.
(: (-> Table Table))
(defun (table-summary t)
  (def schema (table-schema t))
  (def rows (cast long (table-row-count t)))
  (def stats
    (computing-each (vec-length schema)
                    (fun (k)
                      (match (vec-ref schema k)
                        ((Tuple name type)
                         (match (column-summary t name type)
                           ((Some s) s)
                           (None None)))))))
  (def nulls {arraying (match (column-nulls t name) ((Some n) (cast long n)) (None 0L))
                       (:for (Tuple name _) schema)})
  (: (-> (-> Summary double) AnyColumn))
  (defun (stat f)
    (loop (:for s stats)
          (:acc (column-building/option (match s ((Some x) (Some (f x))) (None None))))))
  (match (make-table
           [(named-strings "column" (array->string-column {arraying name (:for (Tuple name _) schema)}))
            (named-strings "type" (array->string-column {arraying (displayed type) (:for (Tuple _ type) schema)}))
            (named "count" (array->column {arraying (- rows (array-ref nulls i)) (:for i (range 0 (array-length nulls)))}))
            (named "nulls" (array->column nulls))
            (named-any "min" (stat (fun (s) (record-ref s min))))
            (named-any "q1" (stat (fun (s) (record-ref s q1))))
            (named-any "median" (stat (fun (s) (record-ref s median))))
            (named-any "mean" (stat (fun (s) (record-ref s mean))))
            (named-any "q3" (stat (fun (s) (record-ref s q3))))
            (named-any "max" (stat (fun (s) (record-ref s max))))
            (named-any "sd" (loop (:for s stats)
                                  (:acc (column-building/option
                                          (match s ((Some x) (record-ref x sd)) (None None))))))])
    ((Ok summary) summary)
    ((Err e) (panic! (displayed e)))))
