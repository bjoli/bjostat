;; bjostat/tests/table.bjo — tables, their schema, typed columns, nulls,
;; aggregates and Arrow files.
;;
;;     bjo run tests/table.bjo
;;
;; Every line should start with "ok:".

(import (std prelude))
(import (std simpletest))
(import (bjostat table))

(import/extern (temp-dir (: System.IO.Path.GetTempPath (-> string))))

(: (-> (Result TableError %a) %a))
(defun (ok r)
  (match r
    ((Ok v) v)
    ((Err e) (panic! (displayed e)))))

(: (-> (Result TableError %a) string))
(defun (error-of r)
  (match r
    ((Ok _) "no error")
    ((Err e) (displayed e))))

(: (-> int int))
(defun (int-of n) n)

(: (-> Table string (Result TableError (Cells double))))
(defun (double-cells t name) (column-as t name))

(: (-> Table))
(defun (sales)
  (ok (make-table
        [(named-strings "region" (array->string-column (vec->array ["north" "south" "north" "east"])))
         (named "price" (array->column (vec->array [10.5 20.0 7.25 12.0])))
         (named "qty" (array->column (vec->array [3L 1L 4L 2L])))
         (named "rating" (array->column (vec->array [5 0 3 4]) #:valid (vec->array [#t #f #t #t])))])))

;; A loop over a column's span: the revenue, price times quantity.
(: (-> (Column double) (Column long) double))
(defun (revenue price qty)
  (def p (column-values price))
  (def q (column-values qty))
  (let loop ((i 0) (acc 0.0))
    (if (< i (ro-span-length p))
        (loop (+ i 1) (+ acc (* (ro-span-ref p i) (cast double (ro-span-ref q i)))))
        acc)))

;; A column's cells, as Options, in order.
(: (-> Table string (Vec (Option double))))
(defun (prices-of t name)
  {vecing x (:for x (ok (double-cells t name)))})

(: (-> Table string (Vec (Option string))))
(defun (strings-of t name)
  (def c (ok (strings t name)))
  {vecing (string-column-ref c i) (:for i (range 0 (string-column-length c)))})

(: (-> Table string (Vec (Option long))))
(defun (longs-of t name)
  (def c (ok (longs t name)))
  {vecing (column-ref c i) (:for i (range 0 (column-length c)))})

(defun (main)
  (def t (sales))

  ;; The schema
  (expect "the names" (table-names t) ["region" "price" "qty" "rating"])
  (expect "the rows" (table-row-count t) 4)
  (expect "the columns" (table-column-count t) 4)
  (expect "a column's type" (column-type t "qty") (Some Long))
  (expect "no such column" (column-type t "pricee") None)
  (expect "the schema"
          (vec-map (fun (p) (str (fst p) ":" (displayed (snd p)))) (table-schema t))
          ["region:string" "price:double" "qty:long" "rating:int"])

  ;; Typed columns, checked once
  (expect "a misspelt column"
          (error-of (doubles t "pricee"))
          "the table has no column 'pricee'. Its columns are: region, price, qty, rating.")
  (expect "a column of another type"
          (error-of (doubles t "qty"))
          "'qty' is a column of long, not of double.")

  (def price (ok (doubles t "price")))
  (def qty (ok (longs t "qty")))
  (def rating (ok (ints t "rating")))
  (def region (ok (strings t "region")))

  (expect "a value" (column-ref price 1) (Some 20.0))
  (expect "a string" (string-column-ref region 2) (Some "north"))
  (expect "a null" (column-ref rating 1) None)
  (expect "the nulls" (column-null-count rating) 1)
  (expect "valid?" (column-valid? rating 1) #f)

  ;; Cells: the type comes from their use
  (def price-cells (ok (column-as t "price")))
  (expect "cells of double, from a comparison" (> (cells-ref price-cells 1) 15.0) #t)
  (def region-cells (ok (column-as t "region")))
  (expect "cells of string" (string-append (cells-ref region-cells 2) "!") "north!")
  (def rating-cells (ok (column-as t "rating")))
  (expect "cells of int" (+ (cells-ref rating-cells 0) (int-of 1)) 6)
  (expect "a null in cells" (cells-valid? rating-cells 1) #f)
  (expect "the nulls of cells" (cells-null-count rating-cells) 1)
  (expect "the length of cells" (cells-length price-cells) 4)
  (expect "cells of another type"
          (error-of (double-cells t "qty"))
          "'qty' is a column of long, not of double.")
  (expect "cells of a missing column"
          (error-of (double-cells t "pricee"))
          "the table has no column 'pricee'. Its columns are: region, price, qty, rating.")

  ;; Cells in a loop: an Option for each row
  (expect "a loop over cells" (loop (:for r rating-cells) (:acc (listing r)))
          (list (Some 5) None (Some 3) (Some 4)))
  (expect "two columns side by side, the SQL rule by hand"
          (loop (:for p* price-cells) (:for r* rating-cells)
                (:when-let (Some p) p*) (:when-let (Some r) r*)
                (:acc (summing (* p (cast double (: r int))))))
          122.25)
  (expect "skip-nulls" (loop (:for r (skip-nulls rating-cells)) (:acc (listing r))) (list 5 3 4))
  (expect "skip-nulls, a count" (count (skip-nulls rating-cells)) 3)
  (expect "skip-nulls without nulls" (loop (:for p (skip-nulls price-cells)) (:acc (summing p))) 49.75)

  ;; Aggregates: vectorized without nulls, skipping them with
  (expect "sum" (column-sum price) 49.75)
  (expect "sum of longs" (column-sum qty) 10L)
  (expect "mean" (column-mean qty) 2.5)
  (expect "min" (column-min price) (Some 7.25))
  (expect "max" (column-max qty) (Some 4L))
  (expect "sum without the null" (column-sum rating) 12)
  (expect "mean without the null" (column-mean rating) 4.0)
  (expect "min without the null" (column-min rating) (Some 3))
  (expect "count without the null" (column-count rating) 3)

  ;; A loop of one's own over the spans
  (expect "revenue" (revenue price qty) 104.5)

  ;; Selecting and slicing, without copies
  (def picked (ok (table-select t ["qty" "region"])))
  (expect "selected" (table-names picked) ["qty" "region"])
  (expect "selecting a missing column"
          (error-of (table-select t ["qty" "nope"]))
          "the table has no column 'nope'. Its columns are: region, price, qty, rating.")
  (def middle (table-slice t #:from 1 #:to 3))
  (expect "a slice's rows" (table-row-count middle) 2)
  (expect "a slice's values" (column-sum (ok (doubles middle "price"))) 27.25)

  ;; Making tables that cannot be
  (expect "two of one name"
          (error-of (make-table [(named "a" (array->column (vec->array [1 2])))
                                 (named "a" (array->column (vec->array [3 4])))]))
          "two columns are named 'a'.")
  (expect "uneven"
          (error-of (make-table [(named "a" (array->column (vec->array [1 2])))
                                 (named "b" (array->column (vec->array [3])))]))
          "'b' has 1 rows, and 'a' has 2.")

  ;; An Arrow IPC file, there and back
  (def path (path-combine (temp-dir) "bjostat-test.arrow"))
  (expect "written" (write-arrow t path) (Ok unit))
  (def back (ok (read-arrow path)))
  (expect "read back: names" (table-names back) (table-names t))
  (expect "read back: values" (column-sum (ok (doubles back "price"))) 49.75)
  (expect "read back: nulls" (column-null-count (ok (ints back "rating"))) 1)
  (expect "a file that is not there"
          (string-starts-with? (error-of (read-arrow "/nonexistent/x.arrow")) "/nonexistent/x.arrow: ")
          #t)


  ;; Sorted
  (def nan (/ 0.0 0.0))
  (def u (ok (make-table
               [(named-strings "name" (array->string-column (vec->array ["b" "a" "c" "a" "b" "é" "ab"])
                                                             #:valid (vec->array [#t #t #f #t #t #t #t])))
                (named "x" (array->column (vec->array [2.0 nan 1.0 2.0 0.5 2.0 1.0])
                                          #:valid (vec->array [#t #t #t #f #t #t #t])))
                (named "n" (array->column (vec->array [1L 2L 3L 4L 5L 6L 7L])))])))
  (expect "sorted by a number: a NaN, then a null, last; equal ones keep their order"
          (longs-of (ok (table-sort u [(ascending "x")])) "n")
          [(Some 5L) (Some 3L) (Some 7L) (Some 1L) (Some 6L) (Some 2L) (Some 4L)])
  (expect "sorted down: the NaN and the null still last"
          (longs-of (ok (table-sort u [(descending "x")])) "n")
          [(Some 1L) (Some 6L) (Some 3L) (Some 7L) (Some 5L) (Some 2L) (Some 4L)])
  (expect "sorted by strings, by their code points, a null last"
          (strings-of (ok (table-sort u [(ascending "name")])) "name")
          [(Some "a") (Some "a") (Some "ab") (Some "b") (Some "b") (Some "é") None])
  (expect "sorted by two keys"
          (longs-of (ok (table-sort u [(ascending "name") (descending "n")])) "n")
          [(Some 4L) (Some 2L) (Some 7L) (Some 5L) (Some 1L) (Some 6L) (Some 3L)])
  (expect "every column comes along"
          (prices-of (ok (table-sort u [(descending "n")])) "x")
          [(Some 1.0) (Some 2.0) (Some 0.5) None (Some 1.0) (Some nan) (Some 2.0)])
  (expect "sorted by a number with no nulls, fast, down, stable"
          (longs-of (ok (table-sort t [(descending "qty")])) "qty")
          [(Some 4L) (Some 3L) (Some 2L) (Some 1L)])
  (def inf (/ 1.0 0.0))
  (def w (ok (make-table
               [(named "x" (array->column (vec->array [0.0 -5.5 inf -0.0 (- 0.0 inf) 3.0 -5.5])))
                (named "l" (array->column (vec->array [-5L 9223372036854775807L 0L -9223372036854775808L -5L 7L 1L])))
                (named "n" (array->column (vec->array [1L 2L 3L 4L 5L 6L 7L])))])))
  (expect "sorted by doubles: infinities, and -0.0 equal to 0.0"
          (longs-of (ok (table-sort w [(ascending "x")])) "n")
          [(Some 5L) (Some 2L) (Some 7L) (Some 1L) (Some 4L) (Some 6L) (Some 3L)])
  (expect "sorted down by doubles: equal ones keep their order"
          (longs-of (ok (table-sort w [(descending "x")])) "n")
          [(Some 3L) (Some 6L) (Some 1L) (Some 4L) (Some 2L) (Some 7L) (Some 5L)])
  (expect "sorted by longs, the least and the greatest"
          (longs-of (ok (table-sort w [(ascending "l")])) "l")
          [(Some -9223372036854775808L) (Some -5L) (Some -5L) (Some 0L) (Some 1L) (Some 7L) (Some 9223372036854775807L)])
  (expect "sorted by no key" (longs-of (ok (table-sort u [])) "n") (longs-of u "n"))
  (expect "sorted by a column that is not there"
          (string-starts-with? (error-of (table-sort u [(ascending "y")])) "the table has no column 'y'")
          #t)

  ;; Joins
  (def orders (ok (make-table
                    [(named-strings "region" (array->string-column (vec->array ["north" "south" "west" "north" "x"])
                                                                    #:valid (vec->array [#t #t #t #t #f])))
                     (named "qty" (array->column (vec->array [1L 2L 3L 4L 5L])))])))
  (def regions (ok (make-table
                     [(named-strings "region" (array->string-column (vec->array ["south" "north" "east" "north" "y"])
                                                                     #:valid (vec->array [#t #t #t #t #f])))
                      (named "qty" (array->column (vec->array [10L 20L 30L 40L 50L])))
                      (named "rate" (array->column (vec->array [0.5 1.5 2.5 3.5 4.5])))])))
  (def inner (ok (inner-join orders regions ["region"])))
  (expect "inner join: the columns, a shared name with .x and .y"
          (table-names inner) ["region" "qty.x" "qty.y" "rate"])
  (expect "inner join: left order, then right order; two nulls match"
          (longs-of inner "qty.x") [(Some 1L) (Some 1L) (Some 2L) (Some 4L) (Some 4L) (Some 5L)])
  (expect "inner join: the right rows"
          (longs-of inner "qty.y") [(Some 20L) (Some 40L) (Some 10L) (Some 20L) (Some 40L) (Some 50L)])
  (def lefts (ok (left-join orders regions ["region"])))
  (expect "left join: a left row with no match has nulls"
          (longs-of lefts "qty.y") [(Some 20L) (Some 40L) (Some 10L) None (Some 20L) (Some 40L) (Some 50L)])
  (expect "left join: its doubles too"
          (prices-of lefts "rate") [(Some 1.5) (Some 3.5) (Some 0.5) None (Some 1.5) (Some 3.5) (Some 4.5)])
  (expect "semi join: each matching left row once"
          (longs-of (ok (semi-join orders regions ["region"])) "qty") [(Some 1L) (Some 2L) (Some 4L) (Some 5L)])
  (expect "anti join: the left rows with no match"
          (longs-of (ok (anti-join orders regions ["region"])) "qty") [(Some 3L)])
  (expect "a join on two keys"
          (table-row-count (ok (inner-join orders regions ["region" "qty"]))) 0)
  (expect "a left join to an empty table"
          (longs-of (ok (left-join orders (table-slice regions #:from 0 #:to 0) ["region"])) "qty.y")
          [None None None None None])
  (expect "a key of other types"
          (error-of (inner-join orders (ok (make-table [(named "region" (array->column (vec->array [1L])))])) ["region"]))
          "'region' is a column of utf8 in the left table and of int64 in the right.")
  (expect "a key that is not there"
          (error-of (inner-join orders regions ["day"]))
          "the left table has no column 'day'.")

  ;; Printed
  (expect "printed"
          (table->string t #:rows 2)
          (str "region  price   qty   rating\n"
               "string  double  long  int   \n"
               "north   10.5    3     5     \n"
               "south   20      1     null  \n"
               "… 2 more rows\n"))
  0)
