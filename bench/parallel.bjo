;; bjostat/bench/parallel.bjo — a loop over parts of a table on several
;; cores, against the same loop on one thread: the sum of price × qty of
;; 1 000 000 rows. A prototype for the plan's parallel loops.
;;
;;     bjo bench bench/parallel.bjo --all
;;
;; Each part is a slice of the table (table-slice, no copy). Three ways to
;; run the parts:
;; - A, fibers that compute: fast, and wrong. Fibers run on Bjolang's run
;;   queues, one pump for each core; a fiber that computes holds a pump, and
;;   the fibers queued behind it wait.
;; - B, spawn/thread: a thread of its own for each part, which costs more to
;;   make than a part of a millisecond takes.
;; - C, computing: a Task of .NET's pool, as an event. A fiber for each part
;;   waits for its event, suspended, so no pump is held. This is the way.
;;
;; Do not start the parts from a module-level def: they read the module's
;; values while the module is set up, and wait for it, as it waits for them.

(import (std prelude))
(import (std bench))
(import (bjostat table))
(import (bjostat query))


(: int) (def rows 1000000)

(: Table)
(def t
  (match (make-table
           [(named "price" (array->column {arraying (cast double (% (* i 7919) 500)) (:for i (range 0 rows))}))
            (named "qty" (array->column {arraying (cast long (% (* i 31) 40)) (:for i (range 0 rows))}))])
    ((Ok t) t)
    ((Err e) (panic! (displayed e)))))

(: (-> Table double))
(defun (revenue u)
  (def price (: (match (column-as u "price") ((Ok c) c) ((Err e) (panic! (displayed e)))) (Cells double)))
  (def qty (: (match (column-as u "qty") ((Ok c) c) ((Err e) (panic! (displayed e)))) (Cells long)))
  (loop (:for p* price) (:for q* qty) (:when-let (Some p) p*) (:when-let (Some q) q*)
        (:acc (summing (* p (cast double q))))))

(: (-> int int Table))
(defun (part parts k)
  (def size (/ (+ rows (- parts 1)) parts))
  (table-slice t #:from (* k size) #:to (min rows (* (+ k 1) size))))

(: (-> (Result Exception double) double))
(defun (ok-sum r) (match r ((Ok v) v) ((Err e) (raise e))))

(: (-> (Promise %a) %a))
(defun (joined p)
  (by-colour (#:sync (promise-join/sync p))
             (#:bjo (match (sync (promise-join p)) ((Ok v) v) ((Err e) (raise e))))))

;; A: each part a fiber that computes: it holds a pump of the run queues.
(: (-> int double))
(defun (on-fibers parts)
  (with-scope
    (def ps {vecing (spawn-thunk (fun () (revenue (part parts k)))) (:for k (range 0 parts))})
    (loop (:for p ps) (:acc (summing (joined p))))))

;; B: each part on a thread of its own, spawn/thread; a fiber for each waits
;; for its event, suspended.
(: (-> int double))
(defun (on-threads parts)
  (with-scope
    (def ps {vecing (bjo (sync (spawn/thread (fun () (revenue (part parts k)))))) (:for k (range 0 parts))})
    (loop (:for p ps) (:acc (summing (ok-sum (joined p)))))))

;; C: each part a Task of .NET's pool, by computing, which is an event; a
;; fiber for each waits for it, suspended. No pump is held.
(: (-> int double))
(defun (on-pool parts)
  (with-scope
    (def ps {vecing (bjo (sync (computing (fun () (revenue (part parts k))))))
                    (:for k (range 0 parts))})
    (loop (:for p ps) (:acc (summing (ok-sum (joined p)))))))

(def/bench "1 thread" (revenue t))
(def/bench "fibers, 8 parts" (on-fibers 8))
(def/bench "spawn/thread, 8 parts" (on-threads 8))
(def/bench "computing, 8 parts" (on-pool 8))
(def/bench "fibers, 12 parts" (on-fibers 12))
(def/bench "spawn/thread, 12 parts" (on-threads 12))
(def/bench "computing, 12 parts" (on-pool 12))

(run-benches)
