;; bjostat/examples/shop.bjo — a year of orders of a small shop, and the
;; questions its owner asks at the end of the year.
;;
;;     python3 examples/shop-data.py scratch/shop
;;     bjo run examples/shop.bjo scratch/shop
;;
;; Each step is one loop over the cells, or one operation on tables, and the
;; operations that can fail are threaded: `try->` runs a chain of them and
;; stops at the first Err, so a chain is unwrapped once with `or-panic`
;; rather than once a step.

(import (std prelude))
(import (only (std datetime) ->month))
(import (only (std maths) round))
(import (bjostat table))
(import (bjostat csv))
(import (bjostat query))
(import (bjostat stats))
(import (bjostat columns))
(import (bjostat loops))

(defun (main args)
  (analyse (if (> (vec-length args) 0) (vec-ref args 0) "scratch/shop"))
  0)

(: (-> string Unit))
(defun (analyse dir)
  (def orders (or-panic (read-csv (str dir "/orders.csv"))))
  (def customers (or-panic (read-csv (str dir "/customers.csv"))))

  ;; 1. What is in the files: the types read-csv guessed, and a summary of
  ;; each column, as R's summary().
  (println (str (int->string (table-row-count orders)) " orders, "
                (int->string (table-row-count customers)) " customers.\n"))
  (println (-> orders (table->string & #:rows 3)))
  (println (-> orders (table-summary &) (table->string & #:digits 2)))

  ;; 2. A new column: the revenue of each order.
  (columns/panic orders (quantity long) (price "unit_price" double) (customer string))
  (def revenue
    (loop (:for q (skip-nulls quantity)) (:for p (skip-nulls price))
          (:acc (column-building (* (cast double q) p)))))

  ;; 3. Each order with its customer, and the columns the questions read. The
  ;; two steps that can fail, in one chain with one unwrap.
  (def joined
    (or-panic (try-> orders
                     (table-with & "revenue" revenue)
                     (inner-join & customers ["customer"]))))
  (columns/panic joined (revenue) (country string) (product string) (code string)
                    (day "day" date))

  ;; 4. Revenue by country: each order joined to its customer, then grouped
  ;; by the customer's country, the largest first.
  (def by-country
    (or-panic (grouped c "country"
                       (:for (Tuple c r) (complete-rows (Tuple country revenue)))
                       (:acc orders (counting-by r))
                       (:acc revenue (summing-by r)))))
  (println "Revenue by country:")
  (println (table->string (or-panic (table-sort by-country [(descending "revenue")])) #:digits 0))

  ;; 5. Revenue by month, from the column of dates.
  (def by-month
    (or-panic (grouped m "month"
                       (:for (Tuple d r) (complete-rows (Tuple day revenue)))
                       (:let m (->month d))
                       (:acc orders (counting-by r))
                       (:acc revenue (summing-by r)))))
  (println "Revenue by month:")
  (println (table->string (or-panic (table-sort by-month [(ascending "month")]))
                          #:rows 12 #:digits 0))

  ;; 6. A typical order. The mean is above the median when a few large
  ;; orders pull it up.
  (match (loop (:for r (skip-nulls revenue))
               (:acc mean (mean r))
               (:acc qs (quantiles [0.25 0.5 0.75 0.9 0.99] r))
               => (Tuple mean qs))
    ((Tuple (Some m) (Some qs))
     (println (str "\nA typical order: the mean is " (two-decimals m) "."))
     (println (str "Quartiles " (two-decimals (vec-ref qs 0)) ", " (two-decimals (vec-ref qs 1))
                   ", " (two-decimals (vec-ref qs 2)) "; 90% below "
                   (two-decimals (vec-ref qs 3)) ", 99% below " (two-decimals (vec-ref qs 4)) ".")))
    (_ unit))

  ;; 7. Do discount codes make larger orders? An empty cell is a null: the
  ;; order had no code.
  (def by-code
    (loop (:for c* code) (:for r (skip-nulls revenue))
          (:acc (grouping (pairing mean standard-deviation) (Tuple (code-name c*) (Tuple r r))))))
  (println "\nOrder value by discount code (mean, standard deviation):")
  (loop (:for (Tuple disc agg) by-code)
        (:let (Tuple m sd) agg)
        (:do (println (str "  " disc ": " (shown m) ", " (shown sd)))))

  ;; 8. Is a lower price met with a larger quantity, within each product?
  (def by-product
    (loop (:for (Tuple o q p) (complete-rows (Tuple product quantity price)))
          (:acc (grouping correlation (Tuple o (Tuple p (cast double q)))))))
  (println "\nCorrelation of unit price and quantity, by product:")
  (loop (:for (Tuple prod r) by-product)
        (:do (println (str "  " prod ": " (shown r)))))

  ;; 9. The best customers: revenue by customer, the five largest, with their
  ;; country. Three steps that can fail, one chain, one unwrap.
  (def by-customer
    (loop (:for (Tuple c r) (complete-rows (Tuple customer revenue)))
          (:acc (grouping summing (Tuple c r)))))
  (def best
    (or-panic (try-> by-customer
                     (map->table & "customer" "revenue")
                     (table-sort & [(descending "revenue")])
                     (table-slice & #:to 5)
                     (left-join & customers ["customer"]))))
  (println "\nThe five best customers:")
  (println (-> best (table->string & #:digits 0)))

  ;; 10. Customers who signed up and never ordered.
  (def silent (or-panic (anti-join customers orders ["customer"])))
  (println (str (int->string (table-row-count silent)) " customers never ordered. The first:"))
  (println (table->string silent #:rows 5))
  unit)

(: (-> double string))
(defun (two-decimals x) (double->string (/ (round (* x 100.0)) 100.0)))

(: (-> (Option double) string))
(defun (shown x) (match x ((Some v) (two-decimals v)) (None "-")))

(: (-> (Option string) string))
(defun (code-name c*) (match c* ((Some c) c) (None "(none)")))
