;; bjostat/src/table.bjo — the module (bjostat table).
;;
;; A table of named columns, held as an Apache Arrow record batch. Its schema
;; is known when the program runs, not when it compiles: a table read from a
;; file has the columns the file has. A column is taken out by name and type,
;; and the type is checked once, there:
;;
;;     (def t (read-arrow "sales.arrow") :propagate)
;;     (def price (doubles t "price") :propagate)   ; (Column double), or an Err
;;     (column-sum price)                           ; vectorized, nulls skipped
;;     (column-values price)                        ; the values, as a span
;;
;; From there on the column is typed, and a loop over its span is as fast as
;; one over an array. A `Table` is Arrow's `RecordBatch` itself, so it goes to
;; and from other Arrow code without a copy.
;;
;; A column may have nulls. Arrow keeps a value at a null too, and that value
;; is unspecified: `column-ref` answers None there, and a loop over
;; `column-values` reads `column-valid?` when `column-null-count` is not 0.

(export
  Table AnyColumn Column StringColumn
  ColumnType TableError NamedColumn

  ;; The schema
  table-names table-schema column-type column-nulls table-row-count table-column-count

  ;; Columns, typed
  doubles floats longs ints strings
  column-values column-length column-null-count column-valid? column-ref
  string-column-length string-column-null-count string-column-ref

  ;; Cells: a column at the type its use gives
  Cells column-as column->cells cells-ref cells-get cells-valid? cells-length cells-null-count cells-slice
  DateCells DateTimeCells InstantCells date-cells datetime-cells instant-cells
  RowSource NotNull skip-nulls CompleteRows RowColumns complete-rows
  cells-window window-rows lowest-bit

  ;; Aggregates
  column-sum column-mean column-min column-max column-count

  ;; Making tables
  ColumnArray array->column array->string-column named named-strings named-any make-table
  take-rows with-column
  table-select table-slice TableRows table-rows
  SortKey table-sort
  inner-join left-join semi-join anti-join
  table-distinct table-append pivot-longer pivot-wider
  table-count table-crosstab

  ;; Categories
  table-categorize category-levels category-codes string-numbers

  ;; Files
  read-arrow write-arrow

  ;; Printing
  table->string

  ;; A script's unwrapper: the value, or the panic of the Err. The `of ...`
  ;; family that once sat here was a stopgap; a `:panic` failure part on `def`
  ;; is where this belongs.
  or-panic)

(import (std prelude))
(import (only (std datetime) Date DateTime Instant unix-days->date unix-microseconds->instant
              instant->utc-datetime))
(import (std parallel))
(import (only (std simd) Simd128 Simd256))
(import (only (std maths) quotient))
(import (only (std atomic) atomic-array-increment!))
(import (only (std array) array-fill! array-copy!))
(import (only (std interop) clr-default))
(import (only (std mutable vec) MutableVec mutablevec mutablevec-with-capacity mutablevec-add!
              mutablevec-length mutablevec->array))
(import (only (std mutable map) MutableMap mutablemap-with-capacity mutablemap-set! mutablemap-ref-or))

;; SimdSource, for the cells of a column of numbers: the re-exported methods
;; carry the trait to importers, as `chunk-size` carries Chunkable.
(re-export simd128-load simd256-load simd128-lanes simd256-lanes simd-source-length)

;; Chunkable, for the parts of tables and cells. A re-exported method carries
;; its trait to importers.
(re-export chunk-size chunks)

(import/extern
  (install-workers (: Bjostat.Workers.Install (-> (-> int (-> int Unit) Unit) int void))))

;; The glue of this module (Categories, Reshape, Sort) runs its parts on (std parallel)'s compute
;; threads. See glue/Workers.cs.
(: (-> int (-> int Unit) Unit))
(defun (run-on-compute-threads n work)
  (ignore (computing-each n work))
  unit)

(def _workers
  (begin (install-workers run-on-compute-threads (compute-thread-count)) #t))

(import/class
  (Table (: Apache.Arrow.RecordBatch (-> Schema (Array AnyColumn) int Table)))
  (AnyColumn (: Apache.Arrow.IArrowArray))
  ((Column %a) (: Apache.Arrow.PrimitiveArray))
  (StringColumn (: Apache.Arrow.StringArray))
  ((ClrCells %a) (: Bjostat.Cells))
  (ArrowType (: Apache.Arrow.Types.IArrowType))
  (Schema (: Apache.Arrow.Schema))
  (SchemaBuilder (: Apache.Arrow.Schema+Builder (-> SchemaBuilder)))
  ;; The last argument is the field's metadata, null for none.
  (Field (: Apache.Arrow.Field
            (-> string ArrowType bool (ClrEnumerable (ClrPair System.String System.String)) Field)))
  ((ClrEnumerable %a) (: System.Collections.Generic.IEnumerable))
  ((ClrReadOnlyList %a) (: System.Collections.Generic.IReadOnlyList))
  ((ClrPair %k %v) (: System.Collections.Generic.KeyValuePair))
  (ArrayData (: Apache.Arrow.ArrayData))
  (ArrowStringBuilder (: Apache.Arrow.StringArray+Builder (-> ArrowStringBuilder)))
  (MemoryAllocator (: Apache.Arrow.Memory.MemoryAllocator))
  (Encoding (: System.Text.Encoding))
  (ArrowTypeId (: Apache.Arrow.Types.ArrowTypeId))
  (TimestampType (: Apache.Arrow.Types.TimestampType (-> TimeUnit System.String TimestampType)))
  (TimeUnit (: Apache.Arrow.Types.TimeUnit))
  (MidpointRounding (: System.MidpointRounding))
  (FormatProvider (: System.IFormatProvider))
  (ClrDate (: System.DateOnly))
  (ClrDateTime (: System.DateTime (-> long DateTimeKind ClrDateTime)))
  (DateTimeKind (: System.DateTimeKind))
  (Stream (: System.IO.Stream))
  (FileStream (: System.IO.FileStream))
  (ArrowFileReader (: Apache.Arrow.Ipc.ArrowFileReader (-> Stream ArrowFileReader)))
  (ArrowFileWriter (: Apache.Arrow.Ipc.ArrowFileWriter (-> Stream Schema ArrowFileWriter))))

(import/extern
  ;; Any column
  (any-length (: Apache.Arrow.IArrowArray.Length (-> AnyColumn int) #:get))
  (any-null-count (: Apache.Arrow.IArrowArray.NullCount (-> AnyColumn int) #:get))
  (any-null? (: Apache.Arrow.IArrowArray.IsNull (-> AnyColumn int bool)))
  (category? (: Bjostat.Categories.Is (-> AnyColumn bool)))

  ;; Typed columns. The values at a null are unspecified.
  (column-values (: Apache.Arrow.PrimitiveArray.Values (-> (Column %a) (RoSpan %a)) #:get))
  (column-length (: Apache.Arrow.PrimitiveArray.Length (-> (Column %a) int) #:get))
  (column-null-count (: Apache.Arrow.PrimitiveArray.NullCount (-> (Column %a) int) #:get))
  (column-valid? (: Apache.Arrow.PrimitiveArray.IsValid (-> (Column %a) int bool)))
  (string-column-length (: Apache.Arrow.StringArray.Length (-> StringColumn int) #:get))
  (string-column-null-count (: Apache.Arrow.StringArray.NullCount (-> StringColumn int) #:get))
  (string-column-valid? (: Apache.Arrow.StringArray.IsValid (-> StringColumn int bool)))
  (string-column-bytes (: Apache.Arrow.StringArray.GetBytes (-> StringColumn int (RoSpan byte))))
  ;; The encoding is null: Arrow's strings are UTF-8.
  (string-column-text (: Apache.Arrow.StringArray.GetString (-> StringColumn int Encoding string)))
  (utf-8->string (: BjoString.Utf8String.FromUtf8 (-> (RoSpan byte) string)))

  ;; The text of a cell
  (clr-type-id (: Apache.Arrow.Types.IArrowType.TypeId (-> ArrowType ArrowTypeId) #:get))
  (clr-type-name-of (: Apache.Arrow.Types.IArrowType.Name (-> ArrowType string) #:get))
  (timestamp-zone (: Apache.Arrow.Types.TimestampType.Timezone (-> TimestampType System.String) #:get))
  (timestamp-unit (: Apache.Arrow.Types.TimestampType.Unit (-> TimestampType TimeUnit) #:get))
  (clr-null-or-empty? (: System.String.IsNullOrEmpty (-> System.String bool)))
  (dictionary-levels (: Apache.Arrow.DictionaryArray.Dictionary (-> Apache.Arrow.DictionaryArray AnyColumn) #:get))
  (dictionary-codes (: Apache.Arrow.DictionaryArray.Indices (-> Apache.Arrow.DictionaryArray AnyColumn) #:get))
  (invariant-culture (: System.Globalization.CultureInfo.InvariantCulture #:get))
  (double-text (: System.Double.ToString (-> double string FormatProvider string)))
  (double-finite? (: System.Double.IsFinite (-> double bool)))
  (math-round (: System.Math.Round (-> double int MidpointRounding double)))
  (date-of-day-number (: System.DateOnly.FromDayNumber (-> int ClrDate)))
  (date-text (: System.DateOnly.ToString (-> ClrDate string FormatProvider string)))
  (datetime-text (: System.DateTime.ToString (-> ClrDateTime string FormatProvider string)))
  (datetime-ticks (: System.DateTime.Ticks (-> ClrDateTime long) #:get))
  (datetime-second (: System.DateTime.Second (-> ClrDateTime int) #:get))
  (bool-cell (: Apache.Arrow.BooleanArray.GetBoolean (-> Apache.Arrow.BooleanArray int bool)))

  ;; Cells, at the type their use gives. #:uses-type: these test typeof(T),
  ;; so a use that does not decide the type is a compile error.
  (clr-cells-of (: Bjostat.CellsOps.Of (-> AnyColumn (Option (ClrCells %a))) #:uses-type))
  (clr-cells-name (: Bjostat.CellsOps.NameOf (-> (Option (ClrCells %a)) string) #:uses-type))
  (clr-cells-ref (: Bjostat.CellsOps.Ref (-> (ClrCells %a) int %a)))
  (clr-cells-get (: Bjostat.CellsOps.Get (-> (ClrCells %a) int (Option %a))))
  (clr-cells-valid? (: Bjostat.CellsOps.IsValid (-> (ClrCells %a) int bool)))
  (clr-cells-set (: Bjostat.CellsOps.Set (-> (ClrCells %a) int %a (ClrCells %a)) #:uses-type))
  (clr-cells-length (: Bjostat.CellsOps.Length (-> (ClrCells %a) int)))
  (clr-cells-slice (: Bjostat.CellsOps.Slice (-> (ClrCells %a) int int (ClrCells %a))))
  (clr-cells-null-count (: Bjostat.CellsOps.NullCount (-> (ClrCells %a) int)))
  (clr-cells-contiguous? (: Bjostat.CellsOps.IsContiguous (-> (ClrCells %a) bool)))
  (clr-cells-values (: Bjostat.CellsOps.Values (-> (ClrCells %a) (RoSpan %a))))
  (clr-cells-valid (: Bjostat.CellsOps.Valid (-> (ClrCells %a) (RoSpan byte))))
  ;; The next row with a value, of one column or of all of 2, 3 or 4, found
  ;; 57 rows at a time in the valid bitmaps.
  (clr-cells-next-valid (: Bjostat.CellsOps.NextValid (-> (ClrCells %a) int int)))
  (clr-cells-window (: Bjostat.CellsOps.Window (-> (ClrCells %a) int int long)))
  (clr-cells-of-column (: Bjostat.CellsOps.OfColumn (-> (Column %a) (ClrCells %a))))
  (clr-cells-load256 (: Bjostat.CellsOps.Load256 (-> (ClrCells %a) int (Simd256 %a))))
  (clr-cells-load128 (: Bjostat.CellsOps.Load128 (-> (ClrCells %a) int (Simd128 %a))))
  (clr-cells-lanes256 (: Bjostat.CellsOps.Lanes256 (-> (ClrCells %a) int)))
  (clr-cells-lanes128 (: Bjostat.CellsOps.Lanes128 (-> (ClrCells %a) int)))
  (lowest-bit (: Bjostat.CellsOps.LowestBit (-> long int)))
  (clr-next-complete-2 (: Bjostat.CellsOps.NextComplete (-> (ClrCells %a) (ClrCells %b) int int int)))
  (clr-next-complete-3 (: Bjostat.CellsOps.NextComplete (-> (ClrCells %a) (ClrCells %b) (ClrCells %c) int int int)))
  (clr-next-complete-4 (: Bjostat.CellsOps.NextComplete
                          (-> (ClrCells %a) (ClrCells %b) (ClrCells %c) (ClrCells %d) int int int)))
  (clr-next-complete-5 (: Bjostat.CellsOps.NextComplete
                          (-> (ClrCells %a) (ClrCells %b) (ClrCells %c) (ClrCells %d) (ClrCells %e) int int int)))
  (clr-next-complete-6 (: Bjostat.CellsOps.NextComplete
                          (-> (ClrCells %a) (ClrCells %b) (ClrCells %c) (ClrCells %d) (ClrCells %e)
                              (ClrCells %f) int int int)))

  ;; Building. The flags are empty for a column with no nulls, or one for
  ;; each value, #f at a null.
  ;; A string is added as its UTF-8 bytes, which Arrow's strings are. The
  ;; allocator is null: Arrow's default.
  (string-builder-add! (: Apache.Arrow.StringArray+Builder.Append
                          (-> ArrowStringBuilder (RoSpan byte) ArrowStringBuilder)))
  (string-bytes (: BjoString.Utf8String.AsSpan (-> string (RoSpan byte))))
  (string-builder-add-null! (: Apache.Arrow.StringArray+Builder.AppendNull
                               (-> ArrowStringBuilder ArrowStringBuilder)))
  (string-builder-build (: Apache.Arrow.StringArray+Builder.Build
                           (-> ArrowStringBuilder MemoryAllocator StringColumn)))

  ;; Aggregates of a span with no nulls, vectorized.
  (tensor-sum (: System.Numerics.Tensors.TensorPrimitives.Sum (-> (RoSpan %a) %a)))
  (tensor-min (: System.Numerics.Tensors.TensorPrimitives.Min (-> (RoSpan %a) %a)))
  (tensor-max (: System.Numerics.Tensors.TensorPrimitives.Max (-> (RoSpan %a) %a)))
  (number->double (: System.Double.CreateChecked (-> %a double)))
  (clr-nan (: System.Double.NaN #:get))

  ;; Tables
  (table-column-count (: Apache.Arrow.RecordBatch.ColumnCount (-> Table int) #:get))
  (table-row-count (: Apache.Arrow.RecordBatch.Length (-> Table int) #:get))
  (clr-column-at (: Apache.Arrow.RecordBatch.Column (-> Table int AnyColumn)))
  ;; Ordinal, as glue/Columns.cs says. The glue uses it too.
  (clr-index-of (: Bjostat.Tables.IndexOf (-> Table string int)))
  (clr-batch-slice (: Apache.Arrow.RecordBatch.Slice (-> Table int int Table)))
  (schema-builder-add! (: Apache.Arrow.Schema+Builder.Field (-> SchemaBuilder Field SchemaBuilder)))
  (schema-builder-build (: Apache.Arrow.Schema+Builder.Build (-> SchemaBuilder Schema)))
  (clr-unsortable (: Bjostat.Sorting.Unsortable (-> AnyColumn string)))
  (clr-sort-order (: Bjostat.Sorting.SortOrder (-> Table (Array int) (Array bool) (Array int))))

  ;; Reshaping: the kernels of glue/Reshape.cs.
  (clr-firsts (: Bjostat.ReshapeOps.Firsts (-> (Array AnyColumn) int (Array int))))
  (clr-groups (: Bjostat.ReshapeOps.Groups (-> (Array AnyColumn) int (out (Array int)) (Tuple (Array int) (Array int)))))
  (clr-string-ids (: Bjostat.ReshapeOps.StringIds (-> StringColumn (out (Array int)) (Tuple (Array int) (Array int)))))
  (clr-concat (: Bjostat.ReshapeOps.Concat (-> (Array AnyColumn) ArrowType AnyColumn)))
  (clr-interleavable? (: Bjostat.Reshape.Interleavable (-> ArrowType bool)))
  (clr-interleaved (: Bjostat.Reshape.Interleaved (-> (Array AnyColumn) int AnyColumn)))
  (clr-repeated (: Bjostat.Reshape.Repeated (-> (Array string) int AnyColumn)))
  (clr-select (: Bjostat.Reshape.Select (-> Table (Array int) Table)))
  (clr-arrow-name (: Bjostat.ColumnTypes.ArrowName (-> ArrowType string)))
  (clr-any-valid? (: Apache.Arrow.IArrowArray.IsValid (-> AnyColumn int bool)))
  (clr-schema (: Apache.Arrow.RecordBatch.Schema (-> Table Schema) #:get))
  (schema-field (: Apache.Arrow.Schema.GetFieldByIndex (-> Schema int Field)))
  (field-name (: Apache.Arrow.Field.Name (-> Field string) #:get))
  (field-type (: Apache.Arrow.Field.DataType (-> Field ArrowType) #:get))
  (clr-string-type (: Apache.Arrow.Types.StringType.Default #:get))
  (clr-data (: Apache.Arrow.IArrowArray.Data (-> AnyColumn ArrayData) #:get))
  (data-type (: Apache.Arrow.ArrayData.DataType (-> ArrayData ArrowType) #:get))

  ;; A TableProblem is a table the arguments cannot make.
  ;; For the counts: the groups of the keys with their order, and the ids of
  ;; a column's values in the order of table-sort.
  (clr-groups-in-order (: Bjostat.ReshapeOps.GroupsInOrder
                          (-> (Array AnyColumn) int (out (Array int)) (out (Array int))
                              (Tuple (Array int) (Array int) (Array int)))))
  (clr-sorted-ids (: Bjostat.ReshapeOps.SortedIds (-> AnyColumn (Option (Tuple (Array int) int)))))
  (clr-dense-limit (: Bjostat.ReshapeOps.DenseLimit long #:get))
  (clr-level-count (: Bjostat.ReshapeOps.LevelCount (-> AnyColumn int)))
  (clr-categorize (: Bjostat.Categories.Categorize (-> Table string (Array string) AnyColumn)
                     #:exceptions (Bjostat.TableProblem)))
  (clr-levels (: Bjostat.Categories.Levels (-> AnyColumn (Array string))))
  (clr-codes (: Bjostat.Categories.Codes (-> AnyColumn AnyColumn)))
  (clr-first-seen (: Bjostat.Categories.FirstSeen (-> AnyColumn AnyColumn)))

  ;; Files
  (file-open-read (: System.IO.File.OpenRead (-> string FileStream)))
  (file-create (: System.IO.File.Create (-> string FileStream)))
  (reader-schema (: Apache.Arrow.Ipc.ArrowFileReader.Schema (-> ArrowFileReader Schema) #:get))
  (reader-next (: Apache.Arrow.Ipc.ArrowFileReader.ReadNextRecordBatch (-> ArrowFileReader Table)))
  (writer-write! (: Apache.Arrow.Ipc.ArrowFileWriter.WriteRecordBatch (-> ArrowFileWriter Table void)))
  (writer-end! (: Apache.Arrow.Ipc.ArrowFileWriter.WriteEnd (-> ArrowFileWriter void)))
  (concatenate-columns (: Apache.Arrow.ArrowArrayConcatenator.Concatenate
                          (-> (ClrReadOnlyList AnyColumn) MemoryAllocator AnyColumn))))

;; For the joins and for making columns: buffers, array data, hashes.
(import/class
  (HashCode (: System.HashCode (-> HashCode)))
  ((Rom %a) (: System.ReadOnlyMemory (-> (Array %a) (Rom %a))))
  (ArrowBuffer (: Apache.Arrow.ArrowBuffer (-> (Rom byte) ArrowBuffer)))
  (ArrayDataOf (: Apache.Arrow.ArrayData
                  (-> ArrowType int int int (Array ArrowBuffer) (Array ArrayDataOf) ArrayDataOf ArrayDataOf)))
  ;; The typed arrays a column of numbers is, made of its data.
  (DoubleArray (: Apache.Arrow.DoubleArray (-> ArrayDataOf DoubleArray)))
  (FloatArray (: Apache.Arrow.FloatArray (-> ArrayDataOf FloatArray)))
  (Int64Array (: Apache.Arrow.Int64Array (-> ArrayDataOf Int64Array)))
  (Int32Array (: Apache.Arrow.Int32Array (-> ArrayDataOf Int32Array)))
  (Int16Array (: Apache.Arrow.Int16Array (-> ArrayDataOf Int16Array)))
  (UInt8Array (: Apache.Arrow.UInt8Array (-> ArrayDataOf UInt8Array))))

(import/extern
  (double-type (: Apache.Arrow.Types.DoubleType.Default #:get))
  (float-type (: Apache.Arrow.Types.FloatType.Default #:get))
  (int64-type (: Apache.Arrow.Types.Int64Type.Default #:get))
  (int32-type (: Apache.Arrow.Types.Int32Type.Default #:get))
  (int16-type (: Apache.Arrow.Types.Int16Type.Default #:get))
  (uint8-type (: Apache.Arrow.Types.UInt8Type.Default #:get))
  ;; An array whose elements are not zeroed first: for one that is written
  ;; whole before it is read.
  (uninitialized-array (: System.GC.AllocateUninitializedArray (-> int (Array %a))))
  ;; For the copies of rows
  (dictionary-index-type (: Apache.Arrow.Types.DictionaryType.IndexType
                            (-> Apache.Arrow.Types.DictionaryType ArrowType) #:get))
  (ro-span-copy! (: System.ReadOnlySpan.CopyTo (-> (RoSpan %a) (Span %a) void)))
  (load-16 (: System.Runtime.Intrinsics.Vector128.Create (-> (RoSpan byte) (Simd128 byte))))
  (store-16! (: System.Runtime.Intrinsics.Vector128.CopyTo (-> (Simd128 byte) (Span byte) void)))
  ;; The allocator is null: Arrow's default.
  (concatenate-columns (: Apache.Arrow.ArrowArrayConcatenator.Concatenate
                          (-> (ClrReadOnlyList AnyColumn) MemoryAllocator AnyColumn))))

(import/extern
  (hash-add-bytes! (: System.HashCode.AddBytes (-> HashCode (RoSpan byte) void)))
  (hash-value (: System.HashCode.ToHashCode (-> HashCode int)))
  (double-bits (: System.BitConverter.DoubleToUInt64Bits (-> double ulong)))
  (float-bits (: System.BitConverter.SingleToUInt32Bits (-> float uint)))
  (double-nan? (: System.Double.IsNaN (-> double bool)))
  (float-nan? (: System.Single.IsNaN (-> float bool)))
  (bytes-equal? (: System.MemoryExtensions.SequenceEqual (-> (RoSpan %a) (RoSpan %a) bool)))
  (same-object? (: System.Object.ReferenceEquals (-> System.Object System.Object bool)))
  (same-clr-string? (: System.String.Equals (-> System.String System.String bool)))
  (binary-search (: System.Array.BinarySearch (-> (Array %a) %a int)))
  (slice-column (: Apache.Arrow.ArrowArrayFactory.Slice (-> AnyColumn int int AnyColumn)))
  (build-column (: Apache.Arrow.ArrowArrayFactory.BuildArray (-> ArrayDataOf AnyColumn)))
  (level-bytes (: Bjostat.Categories.LevelBytes (-> Apache.Arrow.DictionaryArray int (RoSpan byte))))
  (category-type? (: Bjostat.Categories.IsType (-> ArrowType bool)))
  (category-nulls (: Bjostat.Categories.Nulls (-> int AnyColumn)))
  (column-array-data (: Apache.Arrow.IArrowArray.Data (-> AnyColumn ArrayDataOf) #:get))
  (array-data-type (: Apache.Arrow.ArrayData.DataType (-> ArrayDataOf ArrowType) #:get))
  (array-data-length (: Apache.Arrow.ArrayData.Length (-> ArrayDataOf int) #:get))
  (array-data-null-count (: Apache.Arrow.ArrayData.NullCount (-> ArrayDataOf int) #:get))
  (array-data-offset (: Apache.Arrow.ArrayData.Offset (-> ArrayDataOf int) #:get))
  (array-data-buffers (: Apache.Arrow.ArrayData.Buffers (-> ArrayDataOf (Array ArrowBuffer)) #:get))
  (array-data-children (: Apache.Arrow.ArrayData.Children (-> ArrayDataOf (Array ArrayDataOf)) #:get))
  (array-data-dictionary (: Apache.Arrow.ArrayData.Dictionary (-> ArrayDataOf ArrayDataOf) #:get))
  (buffer-empty? (: Apache.Arrow.ArrowBuffer.IsEmpty (-> ArrowBuffer bool) #:get))
  (buffer-span (: Apache.Arrow.ArrowBuffer.Span (-> ArrowBuffer (RoSpan byte)) #:get))
  (empty-buffer (: Apache.Arrow.ArrowBuffer.Empty #:get))
  (bit-width (: Apache.Arrow.Types.FixedWidthType.BitWidth (-> Apache.Arrow.Types.FixedWidthType int) #:get)))

;; ===========================================================================
;; Columns and tables in Arrow
;; ===========================================================================
;;
;; The members of Arrow that the rest of the module uses. They were
;; glue/Columns.cs while Bjolang could not use the members of a generic .NET
;; type, as PrimitiveArray<T>.

(: (-> (Column %a) AnyColumn))
(defun (column->any c) (cast AnyColumn c))

(: (-> StringColumn AnyColumn))
(defun (strings->any c) (cast AnyColumn c))

;; A column as its typed Arrow array. The caller has checked the type by its
;; name, so another type is a fault of this module.
(: (-> string (Column %a)))
(defun (wrong-column-type wanted)
  (panic! (str "(bjostat table): the column is not a column of " wanted)))

(: (-> AnyColumn (Column double)))
(defun (as-doubles a)
  (match a
    ((:is Apache.Arrow.DoubleArray c) (cast (Column double) c))
    (_ (wrong-column-type "double"))))

(: (-> AnyColumn (Column float)))
(defun (as-floats a)
  (match a
    ((:is Apache.Arrow.FloatArray c) (cast (Column float) c))
    (_ (wrong-column-type "float"))))

(: (-> AnyColumn (Column long)))
(defun (as-longs a)
  (match a
    ((:is Apache.Arrow.Int64Array c) (cast (Column long) c))
    (_ (wrong-column-type "long"))))

(: (-> AnyColumn (Column int)))
(defun (as-ints a)
  (match a
    ((:is Apache.Arrow.Int32Array c) (cast (Column int) c))
    (_ (wrong-column-type "int"))))

(: (-> AnyColumn StringColumn))
(defun (as-strings a)
  (match a
    ((:is Apache.Arrow.StringArray c) c)
    (_ (panic! "(bjostat table): the column is not a column of strings"))))

;; The value at row `i`, or None at a null.
(: (-> (Column %a) int (Option %a)))
(defun (column-ref c i)
  (if (column-valid? c i) (Some (ro-span-ref (column-values c) i)) None))

;; The string at row `i`, or None at a null. The bytes are checked and copied
;; once.
(: (-> StringColumn int (Option string)))
(defun (string-column-ref c i)
  (if (string-column-valid? c i) (Some (utf-8->string (string-column-bytes c i))) None))

;; Arrow's name of the column's type, as `type-of-column` reads it: the name
;; of the type id, as "Double" or "Int64", and "TimestampTz" for a timestamp
;; with a time zone and "Category" for a category.
(: (-> AnyColumn string))
(defun (clr-type-name a)
  (def type (data-type (clr-data a)))
  (cond
    ((zoned-timestamp-type? type) "TimestampTz")
    ((category? a) "Category")
    (else (.ToString (clr-type-id type)))))

;; Whether a column of the type can be a key of a join, a distinct or a count.
(: (-> ArrowType bool))
(defun (key-type? type)
  (def id (clr-type-id type))
  (or (any? (fun (k) (= k id))
            [ArrowTypeId.Double ArrowTypeId.Float ArrowTypeId.Int64 ArrowTypeId.Int32 ArrowTypeId.Int16
             ArrowTypeId.UInt8 ArrowTypeId.UInt16 ArrowTypeId.UInt32 ArrowTypeId.UInt64
             ArrowTypeId.String ArrowTypeId.Boolean ArrowTypeId.Date32 ArrowTypeId.Timestamp])
      (category-type? type)))

(: (-> ArrowType bool))
(defun (zoned-timestamp-type? type)
  (match type
    ((:is Apache.Arrow.Types.TimestampType t) (not (clr-null-or-empty? (timestamp-zone t))))
    (_ #f)))

;; A column of the strings. `valid` is empty for a column with no nulls, or as
;; long as the strings, #f at each null.
(: (-> (Array string) (Array bool) StringColumn))
(defun (clr-from-strings values valid)
  (def n (array-length values))
  (when (and (> (array-length valid) 0) (not (= (array-length valid) n)))
    (panic! (str "(bjostat table): " (int->string (array-length valid)) " validity flags for "
                 (int->string n) " values")))
  (def b (ArrowStringBuilder.))
  (loop (:for i (range 0 n))
        (:do (if (and (> (array-length valid) 0) (not (array-ref valid i)))
                 (ignore (string-builder-add-null! b))
                 (ignore (string-builder-add! b (string-bytes (array-ref values i)))))))
  (string-builder-build b (clr-default)))

;; ---------------------------------------------------------------------------
;; The text of a cell, for a printed table

;; DateOnly.DayNumber of 1970-01-01.
(def epoch-day-number 719162)

;; The ticks of 1970-01-01T00:00.
(def epoch-ticks 621355968000000000L)

;; The text of row `i`: "null" at a null. With `digits` 0 or more, a double
;; or a float is rounded to that many decimals first; below 0, it is all of
;; it. A rounded number is still the shortest text, so 10 stays "10". A
;; number that rounds to 0 and is not 0 keeps that many significant digits.
(: (-> AnyColumn int int string))
(defun (any->string a i digits)
  (if (any-null? a i)
      "null"
      (match a
        ((:is Apache.Arrow.DoubleArray c) (number-text (cell (cast (Column double) c) i) digits))
        ((:is Apache.Arrow.FloatArray c) (number-text (cast double (cell (cast (Column float) c) i)) digits))
        ((:is Apache.Arrow.Int64Array c) (.ToString (cell (cast (Column long) c) i) invariant-culture))
        ((:is Apache.Arrow.Int32Array c) (.ToString (cell (cast (Column int) c) i) invariant-culture))
        ((:is Apache.Arrow.Int16Array c) (.ToString (cell (cast (Column short) c) i) invariant-culture))
        ((:is Apache.Arrow.UInt8Array c) (.ToString (cell (cast (Column byte) c) i) invariant-culture))
        ((:is Apache.Arrow.UInt16Array c) (.ToString (cell (cast (Column ushort) c) i) invariant-culture))
        ((:is Apache.Arrow.UInt32Array c) (.ToString (cell (cast (Column uint) c) i) invariant-culture))
        ((:is Apache.Arrow.UInt64Array c) (.ToString (cell (cast (Column ulong) c) i) invariant-culture))
        ((:is Apache.Arrow.BooleanArray c) (if (bool-cell c i) "#t" "#f"))
        ((:is Apache.Arrow.StringArray c) (string-column-text c i (clr-default)))
        ;; ISO 8601, as (std datetime) writes them.
        ((:is Apache.Arrow.Date32Array c)
         (date-text (date-of-day-number (+ (cell (cast (Column int) c) i) epoch-day-number))
                    "yyyy-MM-dd" invariant-culture))
        ((:is Apache.Arrow.TimestampArray c) (timestamp-text c i))
        ((:is Apache.Arrow.DictionaryArray d)
         (if (category? a) (category-text d i) (unknown-type-text a)))
        (_ (unknown-type-text a)))))

(: (-> (Column %a) int %a))
(defun (cell c i) (ro-span-ref (column-values c) i))

(: (-> AnyColumn string))
(defun (unknown-type-text a)
  (str "<" (clr-type-name-of (data-type (clr-data a))) ">"))

;; The number rounded to `digits` decimals, at most 15, away from 0 at a
;; half. Below 0, the number.
(: (-> double int double))
(defun (rounded x digits)
  (if (< digits 0) x (math-round x (min digits 15) MidpointRounding.AwayFromZero)))

;; The text of a number rounded to `digits` decimals. A number that is not 0
;; and rounds to 0, as a small p-value, is written with `digits` significant
;; digits instead (2.551e-11), so that it does not show as 0.
(: (-> double int string))
(defun (number-text x digits)
  (def r (rounded x digits))
  (if (or (not (= r 0.0)) (= x 0.0) (not (double-finite? x)))
      (double-text r "R" invariant-culture)
      (string-replace (double-text x (str "G" (int->string (max digits 1))) invariant-culture) "E-" "e-")))

;; The ticks of a timestamp of the unit. Nanoseconds are rounded down.
(: (-> long TimeUnit long))
(defun (timestamp-ticks raw unit)
  (+ epoch-ticks
     (cond
       ((= unit TimeUnit.Second) (* raw 10000000L))
       ((= unit TimeUnit.Millisecond) (* raw 10000L))
       ((= unit TimeUnit.Microsecond) (* raw 10L))
       (else (def q (/ raw 100L))
             (if (< (% raw 100L) 0L) (- q 1L) q)))))

;; The microseconds since 1970 of a timestamp of the unit, rounded down.
(: (-> long TimeUnit long))
(defun (timestamp-micros raw unit)
  (def d (- (timestamp-ticks raw unit) epoch-ticks))
  (def q (/ d 10L))
  (if (< (% d 10L) 0L) (- q 1L) q))

;; A timestamp as ISO 8601: the date and the time, with the seconds and their
;; fraction only when they are not 0, and "Z" for one with a time zone.
(: (-> Apache.Arrow.TimestampArray int string))
(defun (timestamp-text c i)
  (match (data-type (clr-data (cast AnyColumn c)))
    ((:is Apache.Arrow.Types.TimestampType type)
     (def dt (ClrDateTime. (timestamp-ticks (cell (cast (Column long) c) i) (timestamp-unit type))
                           DateTimeKind.Unspecified))
     (def format
       (cond
         ((not (= 0L (% (datetime-ticks dt) 10000000L))) "yyyy-MM-ddTHH:mm:ss.FFFFFFF")
         ((not (= 0 (datetime-second dt))) "yyyy-MM-ddTHH:mm:ss")
         (else "yyyy-MM-ddTHH:mm")))
     (str (datetime-text dt format invariant-culture)
          (if (clr-null-or-empty? (timestamp-zone type)) "" "Z")))
    (_ (panic! "(bjostat table): a timestamp column without a timestamp type"))))

;; The level of row `i` of a category, which is not null.
(: (-> Apache.Arrow.DictionaryArray int string))
(defun (category-text d i)
  (match (dictionary-levels d)
    ((:is Apache.Arrow.StringArray levels)
     (match (dictionary-codes d)
       ((:is Apache.Arrow.Int32Array codes)
        (string-column-text levels (cell (cast (Column int) codes) i) (clr-default)))
       (_ (panic! "(bjostat table): a category without int codes"))))
    (_ (panic! "(bjostat table): a category without string levels"))))

;; ---------------------------------------------------------------------------
;; Tables

;; A table of the columns, all of one length, under the names.
(: (-> (Array string) (Array AnyColumn) int Table))
(defun (clr-make-table names columns length)
  (clr-from-fields
   {arraying (clr-new-field (array-ref names i) (data-type (clr-data (array-ref columns i))))
             (:for i (range 0 (array-length names)))}
   columns
   length))

;; A table of the columns under the fields, which keep their nullability and
;; metadata.
(: (-> (Array Field) (Array AnyColumn) int Table))
(defun (clr-from-fields fields columns length)
  (def b (SchemaBuilder.))
  (loop (:for f fields) (:do (ignore (schema-builder-add! b f))))
  (Table. (schema-builder-build b) columns length))

;; A field of the name and type that can hold nulls.
(: (-> string ArrowType Field))
(defun (clr-new-field name type) (Field. name type #t (clr-default)))

;; The table with the column under the name: in place of the column of that
;; name, or after the others when there is none.
(: (-> Table string AnyColumn Table))
(defun (with-column t name column)
  (def schema (clr-schema t))
  (def ncols (table-column-count t))
  (def at (clr-index-of t name))
  (def n (if (< at 0) (+ ncols 1) ncols))
  (def place (if (< at 0) ncols at))
  (def field (clr-new-field name (data-type (clr-data column))))
  (def fields (: (make-array n) (Array Field)))
  (def columns (: (make-array n) (Array AnyColumn)))
  (loop (:for i (range 0 ncols))
        (:do (array-set! fields i (schema-field schema i))
             (array-set! columns i (clr-column t i))))
  (array-set! fields place field)
  (array-set! columns place column)
  (clr-from-fields fields columns (table-row-count t)))

(: (-> Table (Array string)))
(defun (clr-names t)
  (def schema (clr-schema t))
  {arraying (field-name (schema-field schema i)) (:for i (range 0 (table-column-count t)))})

;; The column at the index. Typed here: Arrow has a Column of a name too.
(: (-> Table int AnyColumn))
(defun (clr-column t i) (clr-column-at t i))

;; The rows from `from` up to `to`, without a copy.
(: (-> Table int int Table))
(defun (clr-slice t from to) (clr-batch-slice t from (- to from)))

;; ---------------------------------------------------------------------------
;; Arrow IPC files

;; The record batches of the reader, in order. The reader returns null after
;; the last.
(: (-> ArrowFileReader (Vec Table)))
(defun (read-batches reader)
  (let loop ((acc []))
    (match (cast System.Object (reader-next reader))
      ((:is Apache.Arrow.RecordBatch b) (loop (vec-add acc b)))
      (_ acc))))

;; The record batches of an Arrow IPC file as one table: each column's pieces
;; are concatenated, so that a column is one span. None for a file with a
;; schema and no batch. Arrow reports a file it cannot read with exceptions
;; of several types, so every exception is an Err.
(: (-> string (Result System.Exception (Option Table))))
(defun (clr-read-file path)
  (try
    (with-open ((s (file-open-read path))
                (r (ArrowFileReader. s)))
      (def batches (read-batches r))
      (cond
        ((= (vec-length batches) 0) None)
        ((= (vec-length batches) 1) (Some (vec-ref batches 0)))
        (else
         (def schema (reader-schema r))
         (def columns
           {arraying (concatenate-columns (vec->array (vec-map (fun (b) (clr-column b i)) batches))
                                          (clr-default))
                     (:for i (range 0 (table-column-count (vec-ref batches 0))))})
         (Some (Table. schema columns (fold (fun (b n) (+ n (table-row-count b))) 0 batches))))))
    #:catch (System.Exception)))

(: (-> Table string (Result System.Exception Unit)))
(defun (clr-write-file t path)
  (try
    (with-open ((s (file-create path))
                (w (ArrowFileWriter. s (clr-schema t))))
      (writer-write! w t)
      (writer-end! w)
      unit)
    #:catch (System.Exception)))

;; ===========================================================================
;; Errors and types
;; ===========================================================================

;; What a table refused: a column it does not have, one of another type, or
;; columns that do not make a table.
(type (: TableError (Record (: message string))))

(impl (Displayed TableError)
  (defun (displayed e) (record-ref e message))
  (defun (display-into e b) (stringbuilder-add-string! b (record-ref e message))))

(: (-> string (Result TableError %a)))
(defun (refuse message) (Err (TableError (message message))))

;; The value, or a panic carrying the message the Err would have given: for a
;; script, where a misspelt column is a bug and not a case to handle. A chain
;; of steps that can fail is threaded with `try->` and unwrapped once with
;; this, or a `def` takes the `:panic` failure part, which does the same where
;; the language has it. The message is the one the Err has.
;;
;; Any Result whose error is Displayed: a table's, a model's, a test's. A
;; package that answers a Result of its own error type writes no unwrapper of
;; its own — bjostat-plot's examples each had one before this.
(: (-> (Result %e %a) %a) (where (Displayed %e)))
(defun (or-panic r)
  (match r
    ((Ok v) v)
    ((Err e) (panic! (displayed e)))))

;; The type of a column's values. `Dates`, `DateTimes` and `Instants` are
;; columns of the types Date, DateTime and Instant of (std datetime): Arrow's
;; Date32, timestamps with no time zone, and timestamps with one. `Bool` is
;; Arrow's Boolean, a bit for each value; its cells are bools. `Category` is
;; a column of strings from a small set, as R's factor: an Arrow dictionary
;; of int codes and string levels; its cells are strings. `Other` is any
;; Arrow type this module does not take apart yet, by Arrow's name for it:
;; Decimal and so on. A table holds it, prints it and writes it.
(type (: ColumnType (Union Double Float Long Int Short Byte UShort UInt ULong
                               String Bool Category Dates DateTimes Instants
                               (: Other string))))

(: (-> AnyColumn ColumnType))
(defun (type-of-column c)
  (match (clr-type-name c)
    ("Double" Double)
    ("Float" Float)
    ("Int64" Long)
    ("Int32" Int)
    ("Int16" Short)
    ("UInt8" Byte)
    ("UInt16" UShort)
    ("UInt32" UInt)
    ("UInt64" ULong)
    ("String" String)
    ("Boolean" Bool)
    ("Category" Category)
    ("Date32" Dates)
    ("Timestamp" DateTimes)
    ("TimestampTz" Instants)
    (name (Other name))))

(: (-> ColumnType string))
(defun (type-text t)
  (match t
    (Double "double")
    (Float "float")
    (Long "long")
    (Int "int")
    (Short "short")
    (Byte "byte")
    (UShort "ushort")
    (UInt "uint")
    (ULong "ulong")
    (String "string")
    (Bool "bool")
    (Category "category")
    (Dates "date")
    (DateTimes "datetime")
    (Instants "instant")
    ((Other name) name)))

(impl (Displayed ColumnType)
  (defun (displayed t) (type-text t))
  (defun (display-into t b) (stringbuilder-add-string! b (type-text t))))

;; ===========================================================================
;; The schema
;; ===========================================================================

(: (-> Table (Vec string)))
(defun (table-names t) (array->vec (clr-names t)))

;; Each column's name and type, in order.
(: (-> Table (Vec (Tuple string ColumnType))))
(defun (table-schema t)
  {vecing (Tuple name (type-of-column (clr-column t i)))
          (:for (Tuple i name) (enumerate (table-names t)))})

(: (-> Table string (Option ColumnType)))
(defun (column-type t name)
  (def i (clr-index-of t name))
  (if (< i 0) None (Some (type-of-column (clr-column t i)))))

;; How many nulls the column of the name has, or None when there is none.
(: (-> Table string (Option int)))
(defun (column-nulls t name)
  (def i (clr-index-of t name))
  (if (< i 0) None (Some (any-null-count (clr-column t i)))))

(: (-> Table string (Result TableError AnyColumn)))
(defun (find-column t name)
  (def i (clr-index-of t name))
  (if (< i 0)
      (refuse (str "the table has no column '" name "'. Its columns are: "
                   (string-join (table-names t) ", ") "."))
      (Ok (clr-column t i))))

;; The column `name` as the type `wanted`, through `convert`, or an Err that
;; says what it is instead. The one check of a column's type.
(: (-> Table string ColumnType (-> AnyColumn %c) (Result TableError %c)))
(defun (typed t name wanted convert)
  (def (Ok c) (find-column t name) :propagate)
  (def have (type-of-column c))
  (if (= (type-text have) (type-text wanted))
      (Ok (convert c))
      (refuse (str "'" name "' is a column of " (type-text have) ", not of " (type-text wanted) "."))))

(: (-> Table string (Result TableError (Column double))))
(defun (doubles t name) (typed t name Double as-doubles))

(: (-> Table string (Result TableError (Column float))))
(defun (floats t name) (typed t name Float as-floats))

(: (-> Table string (Result TableError (Column long))))
(defun (longs t name) (typed t name Long as-longs))

(: (-> Table string (Result TableError (Column int))))
(defun (ints t name) (typed t name Int as-ints))

(: (-> Table string (Result TableError StringColumn)))
(defun (strings t name) (typed t name String as-strings))

;; The column `name` as cells of the type the caller uses them at, or an Err
;; that says what the column holds. No type is written: in
;;
;;     (def (Ok price) (column-as t "price") :propagate)
;;     (> (cells-ref price 0) 10.0)
;;
;; the comparison with 10.0 makes them cells of double.
;; A column read at one type. A struct around the cells of the glue, so that
;; it can be Iterable, which a .NET type cannot be outside the prelude.
(type (: (Cells %a) #:opaque (Struct (: clr (ClrCells %a)))))

(: (-> (Cells %a) int %a))
(defun (cells-ref c i) (clr-cells-ref (record-ref c clr) i))

;; The value at row `i`, or None at a null.
(: (-> (Cells %a) int (Option %a)))
(defun (cells-get c i) (clr-cells-get (record-ref c clr) i))

(: (-> (Cells %a) int bool))
(defun (cells-valid? c i) (clr-cells-valid? (record-ref c clr) i))

(: (-> (Cells %a) int))
(defun (cells-length c) (clr-cells-length (record-ref c clr)))

(: (-> (Cells %a) int))
(defun (cells-null-count c) (clr-cells-null-count (record-ref c clr)))

;; The rows from `from` to `to`, over the same Arrow buffers. Raises
;; ArgumentOutOfRangeException when the range is outside the column.
(: (-> (Cells %a) int int (Cells %a)))
(defun (cells-slice c from to) (Cells (clr (clr-cells-slice (record-ref c clr) from to))))

;; A column as a collection `get`, `try-get`, `set` and `update` reach: a row
;; by its index, as a `Vec`'s element is.
;;
;;     (get price 3)             ;; the value of row 3
;;     (try-get price 3)         ;; None at a null
;;     (set price 3 9.5)         ;; a new column with row 3 changed
;;     (update price 3 (fun (p) (* 2.0 p)))
;;
;; `ref` is the unchecked read and `try-ref` the checked one, as they are for
;; a `Vec` and a `Map`: `ref` is `cells-ref`, so it answers whatever Arrow
;; keeps under a null, and `try-ref` is `cells-get`, which answers None there.
;; An Arrow array cannot be written, so `ref-set` answers a new column: the
;; table it came from is untouched.
(impl (Refable (Cells %a))
  (type %index int)
  (type %out %a)
  (defun (ref c i) (cells-ref c i))
  (defun (try-ref c i) (cells-get c i)))

(impl (Settable (Cells %a))
  (type %index int)
  (type %in %a)
  (defun (ref-set c i v) (Cells (clr (clr-cells-set (record-ref c clr) i v)))))

(: (-> (Column %a) (Cells %a)))
(defun (column->cells c) (Cells (clr (clr-cells-of-column c))))

(: (-> Table string (Result TableError (Cells %a))))
(defun (column-as t name)
  (def (Ok c) (find-column t name) :propagate)
  (def found (clr-cells-of c))
  (match found
    ((Some cells) (Ok (Cells (clr cells))))
    (None (refuse (str "'" name "' is a column of " (type-text (type-of-column c))
                       ", not of " (clr-cells-name found) ".")))))

;; A loop over cells has an Option for each row, None at a null, so that two
;; columns walked side by side stay on one row:
;;
;;     (loop (:for p* price) (:for q* qty)
;;           (:when-let (Some p) p*) (:when-let (Some q) q*)
;;           (:acc (summing (* p q))))
;;
;; An Option is a struct, so a null costs a flag, not an allocation.
(impl (Iterable (Cells %a))
  (type %elem (Option %a))
  (type %cursor int)
  (defun (iterable-start c) 0)
  (defun (iterable-done? c i) (>= i (cells-length c)))
  (defun (iterable-current c i) (cells-get c i))
  (defun (iterable-next c i) (+ i 1))
  (defun (count c) (cells-length c)))

;; The cells of a column of numbers are an Arrow buffer and a valid bitmap,
;; so a loop over them can use vector instructions.
(impl (Contiguous (Cells %a))
  (type %value %a)
  (defun (contiguous? c) (clr-cells-contiguous? (record-ref c clr)))
  (defun (contiguous-values c) (clr-cells-values (record-ref c clr)))
  (defun (contiguous-valid c) (clr-cells-valid (record-ref c clr))))

;; The cells of a column of numbers are a source of (std simd)'s vectors:
;; `(simd256-load c i)` is the values of rows i to i + 3 (doubles, longs) or
;; i + 7 (floats, ints). Under a null a lane's value is unspecified; the
;; valid bits are `cells-window`'s. A load has no call that returns, so a
;; loop's vectors stay in registers (glue/Cells.cs).
(impl (SimdSource (Cells %a)) (where (Lane %a))
  (type %elem %a)
  (defun (simd128-load c i) (clr-cells-load128 (record-ref c clr) i))
  (defun (simd256-load c i) (clr-cells-load256 (record-ref c clr) i))
  (defun (simd128-lanes c) (clr-cells-lanes128 (record-ref c clr)))
  (defun (simd256-lanes c) (clr-cells-lanes256 (record-ref c clr)))
  (defun (simd-source-length c) (cells-length c)))

;; Columns of dates and timestamps, as values of (std datetime). A column of
;; dates holds days since 1970-01-01, and one of timestamps microseconds since
;; 1970-01-01T00:00; a loop over their cells gets each as an Option of a Date,
;; a DateTime or an Instant:
;;
;;     (def (Ok days) (date-cells t "day") :propagate)
;;     (loop (:for d* days) (:when-let (Some d) d*) (:acc (counting (->weekday d))))
;;
;; A timestamp with no time zone is a DateTime, a local date and time; one
;; with a time zone is an Instant, a point in time.
(type (: DateCells #:opaque (Struct (: days (ClrCells int)))))
(type (: DateTimeCells #:opaque (Struct (: micros (ClrCells long)))))
(type (: InstantCells #:opaque (Struct (: micros (ClrCells long)))))

(: (-> Table string string (-> AnyColumn (Option %c)) (Result TableError %c)))
(defun (time-cells t name wanted convert)
  (def (Ok c) (find-column t name) :propagate)
  (match (convert c)
    ((Some cells) (Ok cells))
    (None (refuse (str "'" name "' is a column of " (type-text (type-of-column c))
                       ", not of " wanted ".")))))

(: (-> (-> %a %b) (Option %a) (Option %b)))
(defun (map-some f o)
  (match o
    ((Some x) (Some (f x)))
    (None None)))

;; The days since 1970 of a column of dates, or None for a column of another
;; type.
(: (-> AnyColumn (Option (ClrCells int))))
(defun (day-cells c)
  (match c
    ((:is Apache.Arrow.Date32Array d) (Some (clr-cells-of-column (cast (Column int) d))))
    (_ None)))

;; The microseconds since 1970 of a column of timestamps with a time zone when
;; `zoned`, or with none when not; None for a column of another type. A column
;; of another unit is made one of microseconds first, rounded down.
(: (-> AnyColumn bool (Option (ClrCells long))))
(defun (micro-cells c zoned)
  (match (data-type (clr-data c))
    ((:is Apache.Arrow.Types.TimestampType ts)
     (cond
       ((= (clr-null-or-empty? (timestamp-zone ts)) zoned) None)
       ((= (timestamp-unit ts) TimeUnit.Microsecond) (Some (clr-cells-of-column (cast (Column long) c))))
       (else (Some (clr-cells-of-column (cast (Column long) (in-micros c ts)))))))
    (_ None)))

;; A column of timestamps of the type `ts`, as one of microseconds. Its
;; validity bitmap is the same, and so is its offset: the values before it are
;; 0.
(: (-> AnyColumn TimestampType AnyColumn))
(defun (in-micros c ts)
  (def data (column-array-data c))
  (def end (+ (array-data-offset data) (array-data-length data)))
  (def unit (timestamp-unit ts))
  (: (RoSpan long))
  (def raw (ro-span-> (ro-span-slice (buffer-span (array-ref (array-data-buffers data) 1)) #:to (* end 8))))
  (def bytes (: (make-array (* end 8)) (Array byte)))
  (: (Span long))
  (def micros (span-> (array->span bytes)))
  (loop (:for i (range (array-data-offset data) end))
        (:do (span-set! micros i (timestamp-micros (ro-span-ref raw i) unit))))
  (build-column (ArrayDataOf. (cast ArrowType (TimestampType. TimeUnit.Microsecond (timestamp-zone ts)))
                              (array-data-length data) (array-data-null-count data) (array-data-offset data)
                              #[(array-ref (array-data-buffers data) 0) (ArrowBuffer. (Rom. bytes))]
                              (: (clr-default) (Array ArrayDataOf)) (: (clr-default) ArrayDataOf))))

(: (-> Table string (Result TableError DateCells)))
(defun (date-cells t name)
  (time-cells t name "date" (fun (c) (map-some (fun (d) (DateCells (days d))) (day-cells c)))))

(: (-> Table string (Result TableError DateTimeCells)))
(defun (datetime-cells t name)
  (time-cells t name "datetime" (fun (c) (map-some (fun (m) (DateTimeCells (micros m))) (micro-cells c #f)))))

(: (-> Table string (Result TableError InstantCells)))
(defun (instant-cells t name)
  (time-cells t name "instant" (fun (c) (map-some (fun (m) (InstantCells (micros m))) (micro-cells c #t)))))

;; A value that (std datetime) has, which is each value of years 1 to 9999.
(: (-> (Option %a) %a))
(defun (in-calendar o)
  (match o
    ((Some x) x)
    (None (panic! "(bjostat table): a date or time outside the years 1 to 9999"))))

(: (-> (ClrCells %a) int (-> %a %b) (Option %b)))
(defun (time-cell c i convert)
  (if (clr-cells-valid? c i) (Some (convert (clr-cells-ref c i))) None))

(impl (Iterable DateCells)
  (type %elem (Option Date))
  (type %cursor int)
  (defun (iterable-start c) 0)
  (defun (iterable-done? c i) (>= i (clr-cells-length (record-ref c days))))
  (defun (iterable-current c i)
    (time-cell (record-ref c days) i (fun (n) (in-calendar (unix-days->date (cast long n))))))
  (defun (iterable-next c i) (+ i 1))
  (defun (count c) (clr-cells-length (record-ref c days))))

(impl (Iterable DateTimeCells)
  (type %elem (Option DateTime))
  (type %cursor int)
  (defun (iterable-start c) 0)
  (defun (iterable-done? c i) (>= i (clr-cells-length (record-ref c micros))))
  (defun (iterable-current c i)
    (time-cell (record-ref c micros) i
               (fun (us) (instant->utc-datetime (in-calendar (unix-microseconds->instant us))))))
  (defun (iterable-next c i) (+ i 1))
  (defun (count c) (clr-cells-length (record-ref c micros))))

(impl (Iterable InstantCells)
  (type %elem (Option Instant))
  (type %cursor int)
  (defun (iterable-start c) 0)
  (defun (iterable-done? c i) (>= i (clr-cells-length (record-ref c micros))))
  (defun (iterable-current c i)
    (time-cell (record-ref c micros) i (fun (us) (in-calendar (unix-microseconds->instant us)))))
  (defun (iterable-next c i) (+ i 1))
  (defun (count c) (clr-cells-length (record-ref c micros))))

;; A column of cells of any of the kinds this module reads: the four things a
;; null-skipping walk asks of it. `skip-nulls` and `complete-rows` are written
;; over this, so a column of dates or timestamps is skipped by nulls and joined
;; with the rest of a row as a column of numbers is, and each answers its own
;; kind of value: a double, a Date, a DateTime, an Instant.
;;
;; `source-cells` is the Arrow cells under the kinds that convert, which is
;; what the window-at-a-time walks take: the valid bits do not depend on how a
;; value is read.
(def/trait (RowSource %c)
  (type %cell)
  ;; The Arrow cells under it, and the type of the numbers in them.
  (type %read)
  (: source-length (-> %c int))
  (: source-null-count (-> %c int))
  (: source-valid? (-> %c int bool))
  (: source-ref (-> %c int %cell))
  (: source-next-valid (-> %c int int))
  (: source-cells (-> %c (ClrCells %read)))
  ;; The rows from `from` to `to`, without a copy of the values.
  (: source-slice (-> %c int int %c)))

(impl (RowSource (Cells %a))
  (type %cell %a)
  (type %read %a)
  (defun (source-length c) (cells-length c))
  (defun (source-null-count c) (cells-null-count c))
  (defun (source-valid? c i) (cells-valid? c i))
  (defun (source-ref c i) (cells-ref c i))
  (defun (source-next-valid c i) (clr-cells-next-valid (record-ref c clr) i))
  (defun (source-cells c) (record-ref c clr))
  (defun (source-slice c from to) (cells-slice c from to)))

(impl (RowSource DateCells)
  (type %cell Date)
  (type %read int)
  (defun (source-length c) (clr-cells-length (record-ref c days)))
  (defun (source-null-count c) (clr-cells-null-count (record-ref c days)))
  (defun (source-valid? c i) (clr-cells-valid? (record-ref c days) i))
  (defun (source-ref c i)
    (option-ref (time-cell (record-ref c days) i
                           (fun (n) (in-calendar (unix-days->date (cast long n)))))))
  (defun (source-next-valid c i) (clr-cells-next-valid (record-ref c days) i))
  (defun (source-cells c) (record-ref c days))
  (defun (source-slice c from to) (DateCells (days (clr-cells-slice (record-ref c days) from to)))))

(impl (RowSource DateTimeCells)
  (type %cell DateTime)
  (type %read long)
  (defun (source-length c) (clr-cells-length (record-ref c micros)))
  (defun (source-null-count c) (clr-cells-null-count (record-ref c micros)))
  (defun (source-valid? c i) (clr-cells-valid? (record-ref c micros) i))
  (defun (source-ref c i)
    (option-ref (time-cell (record-ref c micros) i
                           (fun (us) (instant->utc-datetime (in-calendar (unix-microseconds->instant us)))))))
  (defun (source-next-valid c i) (clr-cells-next-valid (record-ref c micros) i))
  (defun (source-cells c) (record-ref c micros))
  (defun (source-slice c from to) (DateTimeCells (micros (clr-cells-slice (record-ref c micros) from to)))))

(impl (RowSource InstantCells)
  (type %cell Instant)
  (type %read long)
  (defun (source-length c) (clr-cells-length (record-ref c micros)))
  (defun (source-null-count c) (clr-cells-null-count (record-ref c micros)))
  (defun (source-valid? c i) (clr-cells-valid? (record-ref c micros) i))
  (defun (source-ref c i)
    (option-ref (time-cell (record-ref c micros) i
                           (fun (us) (in-calendar (unix-microseconds->instant us))))))
  (defun (source-next-valid c i) (clr-cells-next-valid (record-ref c micros) i))
  (defun (source-cells c) (record-ref c micros))
  (defun (source-slice c from to) (InstantCells (micros (clr-cells-slice (record-ref c micros) from to)))))

;; The values of a column that are not null, as Julia's skipmissing: for a loop
;; over one column. Next to another column it would not stay on its row.
(type (: (NotNull %c) #:opaque (Record (: source %c))))

(: (-> %c (NotNull %c)) (where (RowSource %c)))
(defun (skip-nulls c) (NotNull (source c)))

;; The valid bits of the `window-rows` rows from `i` on, of the rows before
;; `length`, as the bits of a long: bit 0 is row i. 0 from `length` on. A loop
;; clause (in-complete, of (bjostat loops)) ANDs the windows of its columns
;; and steps from one set bit to the next with `lowest-bit`.
(: (-> (Cells %a) int int long))
(defun (cells-window c length i) (clr-cells-window (record-ref c clr) length i))

;; How many rows a window holds.
(: window-rows int)
(def window-rows 57)

(impl (Iterable (NotNull %c)) (where (RowSource %c))
  (type %elem (assoc RowSource cell %c))
  (type %cursor int)
  (defun (iterable-start s) (source-next-valid (record-ref s source) 0))
  (defun (iterable-done? s i) (>= i (source-length (record-ref s source))))
  (defun (iterable-current s i) (source-ref (record-ref s source) i))
  (defun (iterable-next s i) (source-next-valid (record-ref s source) (+ i 1)))
  (defun (count s)
    (- (source-length (record-ref s source)) (source-null-count (record-ref s source)))))

;; The rows of several columns where no column is null, as R's
;; complete.cases and na.omit: each row is a Tuple of the values, so that a
;; loop gets the values without Options and stays on one row of all the
;; columns.
;;
;;     (loop (:for (Tuple f m) (complete-rows (Tuple flipper mass)))
;;           (:acc (correlation (Tuple (cast double f) (cast double m)))))
;;
;; It takes a Tuple of 2 to 6 columns: of cells, or of the kinds of cells that
;; convert (`date-cells`, `datetime-cells`, `instant-cells`), mixed freely. Columns of different
;; lengths give the rows of the shortest. The next complete row is found in
;; the valid bitmaps, 57 rows at a time (CellsOps.NextComplete), so many
;; nulls cost little, and a loop over it is as fast as the same loop with
;; :when-let (bench/null-cost.bjo).
(type (: (CompleteRows %t) #:opaque (Record (: columns %t) (: length int))))

;; The columns of a CompleteRows: a Tuple of Cells.
(def/trait (RowColumns %t)
  (type %row)
  ;; The length of the shortest column.
  (: row-columns-length (-> %t int))
  ;; Whether a column has a null.
  (: row-columns-nulls? (-> %t bool))
  ;; Whether no column is null at the row.
  (: row-complete? (-> %t int bool))
  ;; The values of the row, which is complete.
  (: row-values (-> %t int %row))
  ;; The first complete row from `i` on, or `length`, the length of the
  ;; shortest column.
  (: row-next-complete (-> %t int int int))
  ;; Each column's rows from `from` to `to`.
  (: row-columns-slice (-> %t int int %t)))

(impl (RowColumns (Tuple %a %b)) (where (RowSource %a) (RowSource %b))
  (type %row (Tuple (assoc RowSource cell %a) (assoc RowSource cell %b)))
  (defun (row-columns-length t)
    (def (a b) t)
    (min (source-length a) (source-length b)))
  (defun (row-columns-nulls? t)
    (def (a b) t)
    (or (> (source-null-count a) 0) (> (source-null-count b) 0)))
  (defun (row-complete? t i)
    (def (a b) t)
    (and (source-valid? a i) (source-valid? b i)))
  (defun (row-values t i)
    (def (a b) t)
    (Tuple (source-ref a i) (source-ref b i)))
  (defun (row-next-complete t length i)
    (def (a b) t)
    (clr-next-complete-2 (source-cells a) (source-cells b) length i))
  (defun (row-columns-slice t from to)
    (def (a b) t)
    (Tuple (source-slice a from to) (source-slice b from to))))

(impl (RowColumns (Tuple %a %b %c)) (where (RowSource %a) (RowSource %b) (RowSource %c))
  (type %row (Tuple (assoc RowSource cell %a) (assoc RowSource cell %b) (assoc RowSource cell %c)))
  (defun (row-columns-length t)
    (def (a b c) t)
    (min (source-length a) (min (source-length b) (source-length c))))
  (defun (row-columns-nulls? t)
    (def (a b c) t)
    (or (> (source-null-count a) 0) (> (source-null-count b) 0) (> (source-null-count c) 0)))
  (defun (row-complete? t i)
    (def (a b c) t)
    (and (source-valid? a i) (source-valid? b i) (source-valid? c i)))
  (defun (row-values t i)
    (def (a b c) t)
    (Tuple (source-ref a i) (source-ref b i) (source-ref c i)))
  (defun (row-next-complete t length i)
    (def (a b c) t)
    (clr-next-complete-3 (source-cells a) (source-cells b) (source-cells c) length i))
  (defun (row-columns-slice t from to)
    (def (a b c) t)
    (Tuple (source-slice a from to) (source-slice b from to) (source-slice c from to))))

(impl (RowColumns (Tuple %a %b %c %d))
  (where (RowSource %a) (RowSource %b) (RowSource %c) (RowSource %d))
  (type %row (Tuple (assoc RowSource cell %a) (assoc RowSource cell %b)
                    (assoc RowSource cell %c) (assoc RowSource cell %d)))
  (defun (row-columns-length t)
    (def (a b c d) t)
    (min (min (source-length a) (source-length b)) (min (source-length c) (source-length d))))
  (defun (row-columns-nulls? t)
    (def (a b c d) t)
    (or (> (source-null-count a) 0) (> (source-null-count b) 0)
        (> (source-null-count c) 0) (> (source-null-count d) 0)))
  (defun (row-complete? t i)
    (def (a b c d) t)
    (and (source-valid? a i) (source-valid? b i) (source-valid? c i) (source-valid? d i)))
  (defun (row-values t i)
    (def (a b c d) t)
    (Tuple (source-ref a i) (source-ref b i) (source-ref c i) (source-ref d i)))
  (defun (row-next-complete t length i)
    (def (a b c d) t)
    (clr-next-complete-4 (source-cells a) (source-cells b) (source-cells c) (source-cells d) length i))
  (defun (row-columns-slice t from to)
    (def (a b c d) t)
    (Tuple (source-slice a from to) (source-slice b from to) (source-slice c from to) (source-slice d from to))))

(impl (RowColumns (Tuple %a %b %c %d %e))
  (where (RowSource %a) (RowSource %b) (RowSource %c) (RowSource %d) (RowSource %e))
  (type %row (Tuple (assoc RowSource cell %a) (assoc RowSource cell %b)
                    (assoc RowSource cell %c) (assoc RowSource cell %d)
                    (assoc RowSource cell %e)))
  (defun (row-columns-length t)
    (def (a b c d e) t)
    (min (min (source-length a) (source-length b))
         (min (source-length c) (min (source-length d) (source-length e)))))
  (defun (row-columns-nulls? t)
    (def (a b c d e) t)
    (or (> (source-null-count a) 0) (> (source-null-count b) 0)
        (> (source-null-count c) 0) (> (source-null-count d) 0) (> (source-null-count e) 0)))
  (defun (row-complete? t i)
    (def (a b c d e) t)
    (and (source-valid? a i) (source-valid? b i) (source-valid? c i)
         (source-valid? d i) (source-valid? e i)))
  (defun (row-values t i)
    (def (a b c d e) t)
    (Tuple (source-ref a i) (source-ref b i) (source-ref c i) (source-ref d i) (source-ref e i)))
  (defun (row-next-complete t length i)
    (def (a b c d e) t)
    (clr-next-complete-5 (source-cells a) (source-cells b) (source-cells c) (source-cells d)
                         (source-cells e) length i))
  (defun (row-columns-slice t from to)
    (def (a b c d e) t)
    (Tuple (source-slice a from to) (source-slice b from to) (source-slice c from to) (source-slice d from to) (source-slice e from to))))

(impl (RowColumns (Tuple %a %b %c %d %e %f))
  (where (RowSource %a) (RowSource %b) (RowSource %c) (RowSource %d) (RowSource %e) (RowSource %f))
  (type %row (Tuple (assoc RowSource cell %a) (assoc RowSource cell %b)
                    (assoc RowSource cell %c) (assoc RowSource cell %d)
                    (assoc RowSource cell %e) (assoc RowSource cell %f)))
  (defun (row-columns-length t)
    (def (a b c d e f) t)
    (min (min (source-length a) (source-length b))
         (min (min (source-length c) (source-length d))
              (min (source-length e) (source-length f)))))
  (defun (row-columns-nulls? t)
    (def (a b c d e f) t)
    (or (> (source-null-count a) 0) (> (source-null-count b) 0)
        (> (source-null-count c) 0) (> (source-null-count d) 0)
        (> (source-null-count e) 0) (> (source-null-count f) 0)))
  (defun (row-complete? t i)
    (def (a b c d e f) t)
    (and (source-valid? a i) (source-valid? b i) (source-valid? c i)
         (source-valid? d i) (source-valid? e i) (source-valid? f i)))
  (defun (row-values t i)
    (def (a b c d e f) t)
    (Tuple (source-ref a i) (source-ref b i) (source-ref c i) (source-ref d i)
           (source-ref e i) (source-ref f i)))
  (defun (row-next-complete t length i)
    (def (a b c d e f) t)
    (clr-next-complete-6 (source-cells a) (source-cells b) (source-cells c) (source-cells d)
                         (source-cells e) (source-cells f) length i))
  (defun (row-columns-slice t from to)
    (def (a b c d e f) t)
    (Tuple (source-slice a from to) (source-slice b from to) (source-slice c from to) (source-slice d from to) (source-slice e from to) (source-slice f from to))))

(: (-> %t (CompleteRows %t)) (where (RowColumns %t)))
(defun (complete-rows columns)
  (CompleteRows (columns columns) (length (row-columns-length columns))))

;; The first complete row from `i` on, or the length. Without nulls, `i`.
;; Always through the C#, which answers `i` at once for columns without
;; nulls: a branch here around it left the call in the loop when the columns
;; had no nulls, and a call there makes .NET keep the loop's sums in memory
;; (complete-rows took 4.4 ms for a million rows against 2.6 with :when-let).
(: (-> (CompleteRows %t) int int) (where (RowColumns %t)))
(defun (next-complete r i)
  (row-next-complete (record-ref r columns) (record-ref r length) i))

(impl (Iterable (CompleteRows %t))
  (where (RowColumns %t))
  (type %elem (assoc RowColumns row %t))
  (type %cursor int)
  (defun (iterable-start r) (next-complete r 0))
  (defun (iterable-done? r i) (>= i (record-ref r length)))
  (defun (iterable-current r i) (row-values (record-ref r columns) i))
  (defun (iterable-next r i) (next-complete r (+ i 1))))

;; How many values are not null.
(: (-> (Column %a) int))
(defun (column-count c) (- (column-length c) (column-null-count c)))

;; The aggregates of a column of numbers skip the nulls. A column with no
;; nulls goes to TensorPrimitives, which is vectorized. A column with nulls is
;; read with skip-nulls, in the order of its rows.

;; The sum of the values that are not null, or 0 when there are none. A sum
;; of integers wraps when it overflows.
(: (-> (Column %a) %a) (where (Num %a)))
(defun (column-sum c)
  (if (= (column-null-count c) 0)
      (tensor-sum (column-values c))
      (loop (:for x (skip-nulls (column->cells c)))
            (:acc s (folding 0 (+ s x))))))

;; The mean of the values that are not null, or NaN when there are none.
(: (-> (Column %a) double) (where (Num %a)))
(defun (column-mean c)
  (def n (column-count c))
  (if (= n 0)
      clr-nan
      (/ (number->double (column-sum c)) (cast double n))))

;; The first value that is not null, of a column that has one. A fold from it
;; over all the values compares it with itself first, which keeps it.
(: (-> (Column %a) %a))
(defun (first-valid c)
  (def values (column-values c))
  (let go ((i 0))
    (if (column-valid? c i) (ro-span-ref values i) (go (+ i 1)))))

;; The least value that is not null, or None when there is none.
;; - With no nulls, a NaN is the least value, as TensorPrimitives.Min gives it.
;; - With nulls, the values are compared with <: a NaN is the least value only
;;   when it is the first value, and of two equal values the first is kept.
(: (-> (Column %a) (Option %a)) (where (Num %a)))
(defun (column-min c)
  (cond
    ((= (column-count c) 0) None)
    ((= (column-null-count c) 0) (Some (tensor-min (column-values c))))
    (else
     (Some (loop (:for x (skip-nulls (column->cells c)))
                 (:acc m (folding (first-valid c) (if (< x m) x m))))))))

;; The greatest value that is not null, or None when there is none. NaN as
;; for `column-min`.
(: (-> (Column %a) (Option %a)) (where (Num %a)))
(defun (column-max c)
  (cond
    ((= (column-count c) 0) None)
    ((= (column-null-count c) 0) (Some (tensor-max (column-values c))))
    (else
     (Some (loop (:for x (skip-nulls (column->cells c)))
                 (:acc m (folding (first-valid c) (if (> x m) x m))))))))

;; ===========================================================================
;; Making tables
;; ===========================================================================

;; The numbers a column can be made of with `array->column`: Arrow's typed
;; array of each, made of its data. The array is only there to say the type.
(def/trait (ColumnArray %a)
  (: primitive-column (-> (Array %a) ArrowBuffer ArrowBuffer int int (Column %a))))

;; The data of a column of `type`: its validity bitmap and its values' bytes.
(: (-> ArrowType ArrowBuffer ArrowBuffer int int ArrayDataOf))
(defun (primitive-data type bitmap data n nulls)
  (ArrayDataOf. type n nulls 0 #[bitmap data] (: (clr-default) (Array ArrayDataOf)) (: (clr-default) ArrayDataOf)))

(impl (ColumnArray double)
  (defun (primitive-column _ bitmap data n nulls)
    (cast (Column double) (DoubleArray. (primitive-data (cast ArrowType double-type) bitmap data n nulls)))))
(impl (ColumnArray float)
  (defun (primitive-column _ bitmap data n nulls)
    (cast (Column float) (FloatArray. (primitive-data (cast ArrowType float-type) bitmap data n nulls)))))
(impl (ColumnArray long)
  (defun (primitive-column _ bitmap data n nulls)
    (cast (Column long) (Int64Array. (primitive-data (cast ArrowType int64-type) bitmap data n nulls)))))
(impl (ColumnArray int)
  (defun (primitive-column _ bitmap data n nulls)
    (cast (Column int) (Int32Array. (primitive-data (cast ArrowType int32-type) bitmap data n nulls)))))
(impl (ColumnArray short)
  (defun (primitive-column _ bitmap data n nulls)
    (cast (Column short) (Int16Array. (primitive-data (cast ArrowType int16-type) bitmap data n nulls)))))
(impl (ColumnArray byte)
  (defun (primitive-column _ bitmap data n nulls)
    (cast (Column byte) (UInt8Array. (primitive-data (cast ArrowType uint8-type) bitmap data n nulls)))))

;; A column holding a copy of the array. With `#:valid`, as long as the array,
;; the value at each #f is a null. The values are copied as their bytes, once,
;; and the buffers are managed arrays.
(: (-> (Array %a) (#:valid (Array bool)) (Column %a)) (where (ColumnArray %a) (Num %a)))
(defun (array->column a #:valid (make-array 0))
  (def n (array-length a))
  (def flags (array-length valid))
  (when (and (> flags 0) (not (= flags n)))
    (panic! (str "(bjostat table): " (int->string flags) " validity flags for " (int->string n) " values")))
  (: (RoSpan byte))
  (def bytes (ro-span-> (array->ro-span a)))
  (def data (ArrowBuffer. (Rom. (ro-span->array bytes))))
  (if (= flags 0)
      (primitive-column a empty-buffer data n 0)
      (begin
        (def bits (: (make-array (quotient (+ n 7) 8)) (Array byte)))
        (def nulls
          (let mark ((i 0) (nulls 0))
            (cond
              ((= i n) nulls)
              ((array-ref valid i) (set-bit! bits i) (mark (+ i 1) nulls))
              (else (mark (+ i 1) (+ nulls 1))))))
        (primitive-column a (ArrowBuffer. (Rom. bits)) data n nulls))))

;; A column of values[at[i]] for each i, with no nulls: one pass, into the
;; column's buffer.
(: (-> (Array long) (Array int) (Column long)))
(defun (clr-longs-at values at)
  (def n (array-length at))
  (def bytes (: (uninitialized-array (* n 8)) (Array byte)))
  (: (Span long))
  (def out (span-> (array->span bytes)))
  (loop (:for i (range 0 n)) (:do (span-set! out i (array-ref values (array-ref at i)))))
  (primitive-column values empty-buffer (ArrowBuffer. (Rom. bytes)) n 0))

(: (-> (Array string) (#:valid (Array bool)) StringColumn))
(defun (array->string-column a #:valid (make-array 0))
  (clr-from-strings a valid))

;; A column and the name it has in a table.
(type (: NamedColumn #:opaque (Record (: name string) (: column AnyColumn))))

(: (-> string (Column %a) NamedColumn))
(defun (named name c) (NamedColumn (name name) (column (column->any c))))

(: (-> string StringColumn NamedColumn))
(defun (named-strings name c) (NamedColumn (name name) (column (strings->any c))))

;; A column of any type and its name, for a module that makes Arrow columns
;; itself, as (bjostat csv) does.
(: (-> string AnyColumn NamedColumn))
(defun (named-any name c) (NamedColumn (name name) (column c)))

;; A table of the columns, in order. They have to be of one length and have
;; names that differ.
(: (-> (Vec NamedColumn) (Result TableError Table)))
(defun (make-table cols)
  (def names (vec-map (fun (c) (record-ref c name)) cols))
  (def arrays (vec-map (fun (c) (record-ref c column)) cols))
  (def rows (if (= (vec-length arrays) 0) 0 (any-length (vec-ref arrays 0))))
  (def twice
    (let loop ((i 0) (seen (map-empty)))
      (cond
        ((= i (vec-length names)) None)
        ((map-has-key? seen (vec-ref names i)) (Some (vec-ref names i)))
        (else (loop (+ i 1) (map-set seen (vec-ref names i) #t))))))
  (def uneven
    (find (fun (i) (not (= (any-length (vec-ref arrays i)) rows))) (range 0 (vec-length arrays))))
  (match (Tuple twice uneven)
    ((Tuple (Some name) _) (refuse (str "two columns are named '" name "'.")))
    ((Tuple _ (Some i))
     (refuse (str "'" (vec-ref names i) "' has " (int->string (any-length (vec-ref arrays i)))
                  " rows, and '" (vec-ref names 0) "' has " (int->string rows) ".")))
    (_ (Ok (clr-make-table (vec->array names) (vec->array arrays) rows)))))

;; A table of the named columns, in the order given, without a copy.
(: (-> Table (Vec string) (Result TableError Table)))
(defun (table-select t names)
  (def cols (vec-map (fun (n) (find-column t n)) names))
  (match (find (fun (r) (err? r)) cols)
    ((Some (Err e)) (Err e))
    (_ (Ok (clr-make-table (vec->array names)
                           (vec->array (vec-map (fun (r) (match r ((Ok c) c) ((Err _) (panic! "unreachable")))) cols))
                           (table-row-count t))))))

;; The rows from `#:from` up to `#:to`, without a copy. A range outside the
;; table, or one that ends before it starts, is an Err: Arrow's own slice
;; throws, and every other table operation answers a Result.
(: (-> Table (#:from int) (#:to int) (Result TableError Table)))
(defun (table-slice t #:from 0 #:to (table-row-count t))
  (def n (table-row-count t))
  (cond
    ((< from 0) (refuse (str "a slice from " (int->string from) " starts before the first row.")))
    ((> to n) (refuse (str "a slice to " (int->string to) " ends past the last of " (int->string n) " rows.")))
    ((> from to) (refuse (str "a slice from " (int->string from) " to " (int->string to) " ends before it starts.")))
    (else (Ok (clr-slice t from to)))))

;; ===========================================================================
;; Parts, for (std parallel)
;; ===========================================================================

;; `table-rows` of a table, a column of cells, `skip-nulls` and
;; `complete-rows` are `Chunkable`: `in-parallel` runs a function on parts of their rows.
;;
;; - A part is a slice: no copy of the values. A part's row 0 is the first
;;   row of the part.
;; - Inner cuts are at multiples of 64 rows, so that a part's valid bitmap
;;   starts at a whole byte and a loop over it is a vector loop where the
;;   whole column's is.
;; - The cuts depend only on the number of rows and the number of parts
;;   asked for: with `#:size`, only on the rows.

;; The cuts of `n` rows into about `k` parts: 0, the inner cuts, `n`.
;; Increasing; `[0 0]` for no rows.
(: (-> int int (Vec int)))
(defun (row-cuts n k)
  (def m (max 1 (min k (+ (/ n 64) 1))))
  (let go ((i 1) (last 0) (acc [0]))
    (if (>= i m)
        (vec-add acc n)
        (let ((c (* 64 (/ (cast int (/ (* (cast long n) (cast long i)) (cast long m))) 64))))
          (if (and (> c last) (< c n))
              (go (+ i 1) c (vec-add acc c))
              (go (+ i 1) last acc))))))

;; `(slice from to)` for each part of `n` rows cut into about `k`.
(: (-> int int (-> int int %p) (Vec %p)))
(defun (row-parts n k slice)
  (def cuts (row-cuts n k))
  (loop (:for i (range 0 (- (vec-length cuts) 1)))
        (:acc parts (vecing (slice (vec-ref cuts i) (vec-ref cuts (+ i 1)))))))

;; The rows of a table, for `in-parallel`: a part is a table. `Table` is a
;; .NET type, which cannot be Chunkable itself.
(type (: TableRows #:opaque (Struct (: table Table))))

(: (-> Table TableRows))
(defun (table-rows t) (TableRows (table t)))

(impl (Chunkable TableRows)
  (type %chunk Table)
  (defun (chunk-size r) (table-row-count (record-ref r table)))
  (defun (chunks r k)
    (def t (record-ref r table))
    (row-parts (table-row-count t) k (fun (from to) (clr-slice t from to)))))

(impl (Chunkable (Cells %a))
  (type %chunk (Cells %a))
  (defun (chunk-size c) (cells-length c))
  (defun (chunks c k) (row-parts (cells-length c) k (fun (from to) (cells-slice c from to)))))

(impl (Chunkable DateCells)
  (type %chunk DateCells)
  (defun (chunk-size c) (source-length c))
  (defun (chunks c k) (row-parts (source-length c) k (fun (from to) (source-slice c from to)))))

(impl (Chunkable DateTimeCells)
  (type %chunk DateTimeCells)
  (defun (chunk-size c) (source-length c))
  (defun (chunks c k) (row-parts (source-length c) k (fun (from to) (source-slice c from to)))))

(impl (Chunkable InstantCells)
  (type %chunk InstantCells)
  (defun (chunk-size c) (source-length c))
  (defun (chunks c k) (row-parts (source-length c) k (fun (from to) (source-slice c from to)))))

;; Cut by rows, nulls included: a part holds the values of its rows that are
;; not null.
(impl (Chunkable (NotNull %c)) (where (RowSource %c))
  (type %chunk (NotNull %c))
  (defun (chunk-size s) (source-length (record-ref s source)))
  (defun (chunks s k)
    (def c (record-ref s source))
    (row-parts (source-length c) k (fun (from to) (NotNull (source (source-slice c from to)))))))

;; Cut by rows of the shortest column.
(impl (Chunkable (CompleteRows %t)) (where (RowColumns %t))
  (type %chunk (CompleteRows %t))
  (defun (chunk-size r) (record-ref r length))
  (defun (chunks r k)
    (def cols (record-ref r columns))
    (row-parts (record-ref r length) k
               (fun (from to) (complete-rows (row-columns-slice cols from to))))))

;; A column to sort by, and the direction.
(type (: SortKey (Union (: ascending string) (: descending string))))

(: (-> SortKey string))
(defun (sort-key-name k)
  (match k
    ((ascending name) name)
    ((descending name) name)))

;; The table with its rows in the order of the keys, as R's `order` gives
;; them: by the first key, then by the next among the rows that the first
;; does not tell apart, and so on. Rows that no key tells apart keep their
;; order. A null comes after every value in both directions, and a NaN after
;; every number. Strings are in the order of their code points.
;;
;;     (table-sort t [(descending "price") (ascending "region")])
;;
;; An Err for a column the table does not have, or one of a type that cannot
;; be sorted by.
(: (-> SortKey (Result TableError AnyColumn) (Option TableError)))
(defun (sort-problem k found)
  (match found
    ((Err e) (Some e))
    ((Ok c)
     (def kind (clr-unsortable c))
     (if (= kind "")
         None
         (Some (TableError (message (str "'" (sort-key-name k) "' is a column of " kind
                                         ", which cannot be sorted by."))))))))

(: (-> Table (Vec SortKey) (Result TableError Table)))
(defun (table-sort t keys)
  (def problems
    (loop (:for k keys)
          (:when-let (Some e) (sort-problem k (find-column t (sort-key-name k))))
          (:acc (vecing e))))
  (if (> (vec-length problems) 0)
      (Err (vec-ref problems 0))
      (Ok (take-rows t
                     (clr-sort-order t
                                     {arraying (clr-index-of t (sort-key-name k)) (:for k keys)}
                                     {arraying (match k ((descending _) #t) (_ #f)) (:for k keys)})
                     (table-row-count t)))))

;; ===========================================================================
;; Joins: the rows that match
;; ===========================================================================
;;
;; The right rows are found for each left row in one of four ways:
;; - One key that is a category in both tables: by codes, in an array.
;; - One key of integers, dates or timestamps whose right keys are dense: in
;;   an array by the key's distance from the least.
;; - One such key, both sides sorted, the right keys unique and neither with
;;   nulls: the two are merged.
;; - Else by the hash of the keys, in a hash table of the right rows in 64
;;   parts by the top bits of the hash.
;; The left rows are matched in parts of `join-part-rows` on the compute
;; threads, each part with lists of its own, put one after the other in the
;; order of the parts. So the left rows keep their order, and the right rows
;; of each are in their order. Two nulls are equal keys, and so are two NaNs.

;; The rows of a part of a join's left table.
(def join-part-rows 65536)

;; The parts of a join's hash table: 64, by the top 6 bits of the hash.
(def hash-parts 64)
(def hash-part-shift 58)

;; The rows that match, as the row of the left table and the row of the
;; right one, -1 where a left join found none. A semi or an anti join has
;; only the left rows.
(type (: Matches (Record (: left (MutableVec int)) (: right (MutableVec int)))))

(: (-> int int Matches))
(defun (new-matches left-capacity right-capacity)
  (Matches (left (mutablevec-with-capacity left-capacity))
           (right (mutablevec-with-capacity right-capacity))))

(: (-> Matches int int void))
(defun (add-match! m l r)
  (mutablevec-add! (record-ref m left) l)
  (mutablevec-add! (record-ref m right) r))

;; A left row with no match in a left join, or one that a semi or an anti
;; join keeps.
(: (-> Matches int bool int void))
(defun (add-unmatched! m l found kind)
  (when (and (= kind 1) (not found)) (add-match! m l -1))
  (when (or (and (= kind 2) found) (and (= kind 3) (not found)))
    (mutablevec-add! (record-ref m left) l)))

;; The matches of the parts one after the other: the left rows and the
;; right rows.
(: (-> (Vec Matches) (Tuple (Array int) (Array int))))
(defun (matches->arrays parts)
  (: (-> (Vec (MutableVec int)) (Array int)))
  (defun (joined lists)
    (def out (: (make-array (fold (fun (l n) (+ n (mutablevec-length l))) 0 lists)) (Array int)))
    (ignore (fold (fun (l at)
                    (array-copy! (mutablevec->array l) 0 out at (mutablevec-length l))
                    (+ at (mutablevec-length l)))
                  0 lists))
    out)
  (if (= (vec-length parts) 1)
      (Tuple (mutablevec->array (record-ref (vec-ref parts 0) left))
             (mutablevec->array (record-ref (vec-ref parts 0) right)))
      (Tuple (joined (vec-map (fun (m) (record-ref m left)) parts))
             (joined (vec-map (fun (m) (record-ref m right)) parts)))))

;; Runs `match` on the left rows in parts on the compute threads, each part
;; with matches of its own, in the order of the parts.
(: (-> int int (-> int int Matches void) (Vec Matches)))
(defun (in-left-parts ln kind match-part)
  (def parts (quotient (+ ln (- join-part-rows 1)) join-part-rows))
  (computing-each parts (fun (p)
                          (def from (* p join-part-rows))
                          (def to (min ln (+ from join-part-rows)))
                          (def m (new-matches (- to from) (if (< kind 2) (- to from) 0)))
                          (match-part from to m)
                          m)))

;; Whether the rows are each row of a table of n rows, once and in order:
;; then the table's columns are the result's as they are.
(: (-> (Array int) int bool))
(defun (in-order? rows n)
  (and (= (array-length rows) n)
       (let check ((i 0))
         (cond
           ((= i n) #t)
           ((= (array-ref rows i) i) (check (+ i 1)))
           (else #f)))))

;; ---------------------------------------------------------------------------
;; By codes: one key that is a category in both tables

(: (-> AnyColumn AnyColumn bool))
(defun (both-categories? a b) (and (category? a) (category? b)))

(: (-> AnyColumn Apache.Arrow.DictionaryArray))
(defun (as-dictionary a)
  (match a
    ((:is Apache.Arrow.DictionaryArray d) d)
    (_ (panic! "(bjostat table): a category that is not a dictionary"))))

(: (-> AnyColumn StringColumn))
(defun (levels-of d) (as-strings (dictionary-levels (as-dictionary d))))

(: (-> AnyColumn (Column int)))
(defun (category-codes-of d) (as-ints (dictionary-codes (as-dictionary d))))

;; Each right level is given the left code of the same string once, and the
;; right rows are then in chains by left code, in an array. The slot after
;; the last code is the nulls'.
(: (-> AnyColumn AnyColumn int (Vec Matches)))
(defun (match-categories left right kind)
  (def left-levels (levels-of left))
  (def right-levels (levels-of right))
  (def null-slot (string-column-length left-levels))
  (def left-code (: (mutablemap-with-capacity null-slot) (MutableMap string int)))
  (loop (:for c (range 0 null-slot))
        (:do (mutablemap-set! left-code (utf-8->string (string-column-bytes left-levels c)) c)))
  ;; -1 for a right level that the left table does not have.
  (def code-of
    {arraying (mutablemap-ref-or left-code (utf-8->string (string-column-bytes right-levels c)) -1)
              (:for c (range 0 (string-column-length right-levels)))})
  (def rn (any-length right))
  (def next (: (make-array rn) (Array int)))
  (def heads (: (make-array (+ null-slot 1)) (Array int)))
  (array-fill! heads -1)
  (def rcodes (column-values (category-codes-of right)))
  (let chain ((r (- rn 1)))
    (when (>= r 0)
      (def slot (if (any-null? right r) null-slot (array-ref code-of (ro-span-ref rcodes r))))
      (when (>= slot 0)
        (array-set! next r (array-ref heads slot))
        (array-set! heads slot r))
      (chain (- r 1))))
  (def ln (any-length left))
  (def lcodes (column-values (category-codes-of left)))
  (def nulls? (> (any-null-count left) 0))
  (def m (new-matches ln (if (< kind 2) ln 0)))
  (loop (:for l (range 0 ln))
        (:do (def first (array-ref heads (if (and nulls? (any-null? left l)) null-slot (ro-span-ref lcodes l))))
             (when (< kind 2)
               (let walk ((r first))
                 (when (>= r 0)
                   (add-match! m l r)
                   (walk (array-ref next r)))))
             (add-unmatched! m l (>= first 0) kind)))
  [m])

;; ---------------------------------------------------------------------------
;; One key of integers

;; The keys as longs, when they are integers, dates or timestamps: the types
;; whose equal keys are equal numbers.
(: (-> AnyColumn (Option (Array long))))
(defun (integer-keys a)
  (def n (any-length a))
  (match a
    ((:is Apache.Arrow.Int64Array c)
     (def vals (column-values (cast (Column long) c)))
     (def out (: (make-array n) (Array long)))
     (loop (:for i (range 0 n)) (:do (array-set! out i (ro-span-ref vals i))))
     (Some out))
    ((:is Apache.Arrow.Int32Array c)
     (def vals (column-values (cast (Column int) c)))
     (def out (: (make-array n) (Array long)))
     (loop (:for i (range 0 n)) (:do (array-set! out i (cast long (ro-span-ref vals i)))))
     (Some out))
    ((:is Apache.Arrow.Int16Array c)
     (def vals (column-values (cast (Column short) c)))
     (def out (: (make-array n) (Array long)))
     (loop (:for i (range 0 n)) (:do (array-set! out i (cast long (ro-span-ref vals i)))))
     (Some out))
    ((:is Apache.Arrow.UInt8Array c)
     (def vals (column-values (cast (Column byte) c)))
     (def out (: (make-array n) (Array long)))
     (loop (:for i (range 0 n)) (:do (array-set! out i (cast long (ro-span-ref vals i)))))
     (Some out))
    ((:is Apache.Arrow.UInt16Array c)
     (def vals (column-values (cast (Column ushort) c)))
     (def out (: (make-array n) (Array long)))
     (loop (:for i (range 0 n)) (:do (array-set! out i (cast long (ro-span-ref vals i)))))
     (Some out))
    ((:is Apache.Arrow.UInt32Array c)
     (def vals (column-values (cast (Column uint) c)))
     (def out (: (make-array n) (Array long)))
     (loop (:for i (range 0 n)) (:do (array-set! out i (cast long (ro-span-ref vals i)))))
     (Some out))
    ((:is Apache.Arrow.UInt64Array c)
     (def vals (column-values (cast (Column ulong) c)))
     (def out (: (make-array n) (Array long)))
     (loop (:for i (range 0 n)) (:do (array-set! out i (cast long (ro-span-ref vals i)))))
     (Some out))
    ((:is Apache.Arrow.Date32Array c)
     (def vals (column-values (cast (Column int) c)))
     (def out (: (make-array n) (Array long)))
     (loop (:for i (range 0 n)) (:do (array-set! out i (cast long (ro-span-ref vals i)))))
     (Some out))
    ((:is Apache.Arrow.TimestampArray c)
     (def vals (column-values (cast (Column long) c)))
     (def out (: (make-array n) (Array long)))
     (loop (:for i (range 0 n)) (:do (array-set! out i (ro-span-ref vals i))))
     (Some out))
    (_ None)))

;; The matches by one key of integers, without hashes, or None when the keys
;; are neither dense nor sorted and unique, and the hashes are to be used.
(: (-> AnyColumn AnyColumn int (Option (Vec Matches))))
(defun (match-integers lk rk kind)
  (match (Tuple (integer-keys lk) (integer-keys rk))
    ((Tuple (Some lv) (Some rv))
     (def rn (array-length rv))
     (def right-nulls? (> (any-null-count rk) 0))
     (def left-nulls? (> (any-null-count lk) 0))
     ;; The least and the greatest right key, and whether the right keys
     ;; are ascending and unique with no null.
     (def (Tuple least greatest sorted? seen?)
       (let scan ((r 0) (least 9223372036854775807L) (greatest (- -9223372036854775807L 1L))
                  (sorted? #t) (previous 0L) (seen? #f))
         (cond
           ((= r rn) (Tuple least greatest sorted? seen?))
           ((and right-nulls? (any-null? rk r)) (scan (+ r 1) least greatest #f previous seen?))
           (else
            (def v (array-ref rv r))
            (scan (+ r 1) (min least v) (max greatest v)
                  (and sorted? (or (not seen?) (> v previous))) v #t)))))
     (cond
       ;; Dense: room for each key from the least to the greatest, at most
       ;; twice the right rows and some more.
       ((and (> rn 0) seen?
             (<= (cast ulong (- greatest least)) (+ (* 2UL (cast ulong rn)) 1024UL)))
        (Some (match-dense lk rk lv rv least (+ (cast int (- greatest least)) 1) kind)))
       ((and (> rn 0) sorted? (not right-nulls?) (not left-nulls?) (ascending? lv))
        (Some (match-merged lv rv kind)))
       (else None)))
    (_ None)))

(: (-> (Array long) bool))
(defun (ascending? v)
  (let check ((i 1))
    (cond
      ((>= i (array-length v)) #t)
      ((< (array-ref v i) (array-ref v (- i 1))) #f)
      (else (check (+ i 1))))))

;; The right rows in chains by the key's distance from the least, in an
;; array, from the last row so that each chain is in the order of the rows.
;; The slot after the last key is the nulls'.
(: (-> AnyColumn AnyColumn (Array long) (Array long) long int int (Vec Matches)))
(defun (match-dense lk rk lv rv least slots kind)
  (def rn (array-length rv))
  (def null-slot slots)
  (def heads (: (make-array (+ slots 1)) (Array int)))
  (array-fill! heads -1)
  (def next (: (make-array rn) (Array int)))
  (def right-nulls? (> (any-null-count rk) 0))
  (def left-nulls? (> (any-null-count lk) 0))
  (let chain ((r (- rn 1)))
    (when (>= r 0)
      (def slot (if (and right-nulls? (any-null? rk r)) null-slot (cast int (- (array-ref rv r) least))))
      (array-set! next r (array-ref heads slot))
      (array-set! heads slot r)
      (chain (- r 1))))
  (in-left-parts (array-length lv) kind
                 (fun (from to m)
                   (loop (:for l (range from to))
                         (:do (def first
                                (if (and left-nulls? (any-null? lk l))
                                    (array-ref heads null-slot)
                                    (begin
                                      (def d (- (array-ref lv l) least))
                                      (if (< (cast ulong d) (cast ulong slots)) (array-ref heads (cast int d)) -1))))
                              (when (< kind 2)
                                (let walk ((r first))
                                  (when (>= r 0)
                                    (add-match! m l r)
                                    (walk (array-ref next r)))))
                              (add-unmatched! m l (>= first 0) kind))))))

;; Both keys ascending, the right ones unique and neither null: each left row
;; has at most one right row, found by walking both in order. A part of the
;; left rows finds where to start in the right rows by halving.
(: (-> (Array long) (Array long) int (Vec Matches)))
(defun (match-merged lv rv kind)
  (def rn (array-length rv))
  (in-left-parts (array-length lv) kind
                 (fun (from to m)
                   (when (< from to)
                     (def start (binary-search rv (array-ref lv from)))
                     (ignore
                      (fold (fun (l r0)
                              (def v (array-ref lv l))
                              (def r (let skip ((r r0)) (if (and (< r rn) (< (array-ref rv r) v)) (skip (+ r 1)) r)))
                              (def found (and (< r rn) (= (array-ref rv r) v)))
                              (when (and found (< kind 2)) (add-match! m l r))
                              (add-unmatched! m l found kind)
                              r)
                            (if (< start 0) (- -1 start) start)
                            (range from to)))))))

;; ---------------------------------------------------------------------------
;; By the hashes of the keys

;; The matches by the hash of the keys. The right rows are put in a hash
;; table of the first row of each hash, and the next row of each row with the
;; same hash. The rows are put in from the last, each before the ones there,
;; so each chain is in the order of the rows. The table is in parts by the
;; top bits of the hash, each built on a compute thread. A row is in one
;; part, so the parts write `next` at other rows.
(: (-> (Array AnyColumn) (Array AnyColumn) int (Vec Matches)))
(defun (match-hashes lk rk kind)
  (def rn (any-length (array-ref rk 0)))
  (def next (: (make-array rn) (Array int)))
  (def rh (hashes-in-parts rk rn))
  (def by-part {vecing (: (mutablevec) (MutableVec int)) (:for _q (range 0 hash-parts))})
  (loop (:for r (range 0 rn))
        (:do (mutablevec-add! (vec-ref by-part (hash-part (array-ref rh r))) r)))
  (def tables
    (computing-each hash-parts
                    (fun (q)
                      (def rows (mutablevec->array (vec-ref by-part q)))
                      (def heads (: (mutablemap-with-capacity (array-length rows)) (MutableMap ulong int)))
                      (let put ((i (- (array-length rows) 1)))
                        (when (>= i 0)
                          (def r (array-ref rows i))
                          (def h (array-ref rh r))
                          (array-set! next r (mutablemap-ref-or heads h -1))
                          (mutablemap-set! heads h r)
                          (put (- i 1))))
                      heads)))
  (def same {arraying (key-equality (array-ref lk k) (array-ref rk k)) (:for k (range 0 (array-length lk)))})
  (def ln (any-length (array-ref lk 0)))
  ;; The hash table is only read here, which a Dictionary allows on many
  ;; threads.
  (in-left-parts ln kind
                 (fun (from to m)
                   (def lh (hashes {arraying (slice-column a from (- to from)) (:for a lk)} (- to from)))
                   (loop (:for l (range from to))
                         (:do (def h (array-ref lh (- l from)))
                              (def found
                                (let walk ((r (mutablemap-ref-or (vec-ref tables (hash-part h)) h -1)) (found #f))
                                  (cond
                                    ((< r 0) found)
                                    ((not (same-keys? same l r)) (walk (array-ref next r) found))
                                    ((>= kind 2) #t)
                                    (else (add-match! m l r) (walk (array-ref next r) #t)))))
                              (add-unmatched! m l found kind))))))

(: (-> ulong int))
(defun (hash-part h) (cast int (shift-right h hash-part-shift)))

;; The hashes of the rows, in parts on the compute threads.
(: (-> (Array AnyColumn) int (Array ulong)))
(defun (hashes-in-parts keys n)
  (if (< n (* 2 join-part-rows))
      (hashes keys n)
      (begin
        (def h (: (make-array n) (Array ulong)))
        (def parts (quotient (+ n (- join-part-rows 1)) join-part-rows))
        (ignore (computing-each parts
                                (fun (p)
                                  (def from (* p join-part-rows))
                                  (def to (min n (+ from join-part-rows)))
                                  (def part (hashes {arraying (slice-column a from (- to from)) (:for a keys)} (- to from)))
                                  (array-copy! part 0 h from (- to from))
                                  unit)))
        h)))

;; The hash of each row's keys. A null and a NaN each have one hash, and
;; -0.0 has that of 0.0, since they are equal keys.
(: (-> (Array AnyColumn) int (Array ulong)))
(defun (hashes keys n)
  (def h (: (make-array n) (Array ulong)))
  (array-fill! h 14695981039346656037UL)
  ;; The value of each row in one key, then mixed into its hash.
  (def v (: (make-array n) (Array ulong)))
  (loop (:for a keys)
        (:do (key-values! v a n)
             ;; A null has one hash, whatever value is under it: after a left
             ;; join, that is the value of another row.
             (when (> (any-null-count a) 0)
               (loop (:for i (range 0 n))
                     (:do (when (any-null? a i) (array-set! v i 0x9E3779B97F4A7C15UL)))))
             (loop (:for i (range 0 n))
                   (:do (array-set! h i (hash-step (array-ref h i) (array-ref v i)))))))
  h)

(: (-> ulong ulong ulong))
(defun (hash-step h v)
  (def x (* (bitwise-xor h v) 1099511628211UL))
  (bitwise-xor x (shift-right x 29)))

(: (-> (RoSpan byte) ulong))
(defun (bytes-hash bytes)
  (def hc (HashCode.))
  (hash-add-bytes! hc bytes)
  (* (cast ulong (cast uint (hash-value hc))) 0x9E3779B97F4A7C15UL))

;; The value of each row of a key, for its hash.
(: (-> (Array ulong) AnyColumn int void))
(defun (key-values! v a n)
  (match a
    ((:is Apache.Arrow.DoubleArray c)
     (def vals (column-values (cast (Column double) c)))
     (loop (:for i (range 0 n))
           (:do (def x (ro-span-ref vals i))
                (array-set! v i (if (double-nan? x) 0x7FF8000000000001UL (double-bits (if (= x 0.0) 0.0 x)))))))
    ((:is Apache.Arrow.FloatArray c)
     (def vals (column-values (cast (Column float) c)))
     (loop (:for i (range 0 n))
           (:do (def x (ro-span-ref vals i))
                (array-set! v i (if (float-nan? x)
                                    0x7FC00001UL
                                    (cast ulong (float-bits (if (= x (cast float 0.0)) (cast float 0.0) x))))))))
    ((:is Apache.Arrow.Int64Array c)
     (def vals (column-values (cast (Column long) c)))
     (loop (:for i (range 0 n)) (:do (array-set! v i (cast ulong (ro-span-ref vals i))))))
    ((:is Apache.Arrow.Int32Array c)
     (def vals (column-values (cast (Column int) c)))
     (loop (:for i (range 0 n)) (:do (array-set! v i (cast ulong (ro-span-ref vals i))))))
    ((:is Apache.Arrow.Int16Array c)
     (def vals (column-values (cast (Column short) c)))
     (loop (:for i (range 0 n)) (:do (array-set! v i (cast ulong (ro-span-ref vals i))))))
    ((:is Apache.Arrow.UInt8Array c)
     (def vals (column-values (cast (Column byte) c)))
     (loop (:for i (range 0 n)) (:do (array-set! v i (cast ulong (ro-span-ref vals i))))))
    ((:is Apache.Arrow.UInt16Array c)
     (def vals (column-values (cast (Column ushort) c)))
     (loop (:for i (range 0 n)) (:do (array-set! v i (cast ulong (ro-span-ref vals i))))))
    ((:is Apache.Arrow.UInt32Array c)
     (def vals (column-values (cast (Column uint) c)))
     (loop (:for i (range 0 n)) (:do (array-set! v i (cast ulong (ro-span-ref vals i))))))
    ((:is Apache.Arrow.UInt64Array c)
     (def vals (column-values (cast (Column ulong) c)))
     (loop (:for i (range 0 n)) (:do (array-set! v i (ro-span-ref vals i)))))
    ((:is Apache.Arrow.Date32Array c)
     (def vals (column-values (cast (Column int) c)))
     (loop (:for i (range 0 n)) (:do (array-set! v i (cast ulong (ro-span-ref vals i))))))
    ((:is Apache.Arrow.TimestampArray c)
     (def vals (column-values (cast (Column long) c)))
     (loop (:for i (range 0 n)) (:do (array-set! v i (cast ulong (ro-span-ref vals i))))))
    ((:is Apache.Arrow.BooleanArray c)
     (loop (:for i (range 0 n)) (:do (array-set! v i (if (bool-cell c i) 1UL 2UL)))))
    ((:is Apache.Arrow.StringArray c)
     (loop (:for i (range 0 n)) (:do (array-set! v i (bytes-hash (string-column-bytes c i))))))
    ((:is Apache.Arrow.DictionaryArray d)
     (if (category? a)
         (begin
           ;; The hash of each level once; a row's is that of its level, so
           ;; two categories of other levels agree.
           (def levels (levels-of a))
           (def nl (string-column-length levels))
           (def level-hash (: (make-array (+ nl 1)) (Array ulong)))
           (loop (:for l (range 0 nl)) (:do (array-set! level-hash l (bytes-hash (string-column-bytes levels l)))))
           (def codes (column-values (category-codes-of a)))
           (loop (:for i (range 0 n))
                 (:do (def code (ro-span-ref codes i))
                      (array-set! v i (array-ref level-hash (if (and (>= code 0) (< code nl)) code nl))))))
         (not-a-key a)))
    (_ (not-a-key a))))

(: (-> AnyColumn %a))
(defun (not-a-key a)
  (panic! (str "(bjostat table): a column of " (clr-type-name-of (data-type (clr-data a))) " cannot be a key")))

(: (-> (Array (-> int int bool)) int int bool))
(defun (same-keys? same l r)
  (let check ((k 0))
    (cond
      ((= k (array-length same)) #t)
      (((array-ref same k) l r) (check (+ k 1)))
      (else #f))))

;; Whether row i of x and row j of y have equal values.
(: (-> (Column %v) (Column %v) (-> int int bool)) (where (Eq %v)))
(defun (column-cells-equal x y)
  (fun (i j) (= (cell x i) (cell y j))))

;; Whether row i of a and row j of b have the same key, two nulls and two
;; NaNs being the same. The `=` of doubles is .NET's Equals, which says that
;; of two NaNs, and of -0.0 and 0.0.
(: (-> AnyColumn AnyColumn (-> int int bool)))
(defun (key-equality a b)
  (def values (value-equality a b))
  (if (and (= (any-null-count a) 0) (= (any-null-count b) 0))
      values
      (fun (i j)
        (def na (any-null? a i))
        (def nb (any-null? b j))
        (if (or na nb) (and na nb) (values i j)))))

(: (-> AnyColumn AnyColumn (-> int int bool)))
(defun (value-equality a b)
  (match (Tuple (clr-type-name a) (clr-type-name b))
    ((Tuple "Double" "Double") (column-cells-equal (as-doubles a) (as-doubles b)))
    ((Tuple "Float" "Float") (column-cells-equal (as-floats a) (as-floats b)))
    ((Tuple "Int64" "Int64") (column-cells-equal (as-longs a) (as-longs b)))
    ((Tuple "Int32" "Int32") (column-cells-equal (as-ints a) (as-ints b)))
    ((Tuple "Int16" "Int16") (column-cells-equal (as-shorts a) (as-shorts b)))
    ((Tuple "UInt8" "UInt8") (column-cells-equal (as-bytes a) (as-bytes b)))
    ((Tuple "UInt16" "UInt16") (column-cells-equal (as-ushorts a) (as-ushorts b)))
    ((Tuple "UInt32" "UInt32") (column-cells-equal (as-uints a) (as-uints b)))
    ((Tuple "UInt64" "UInt64") (column-cells-equal (as-ulongs a) (as-ulongs b)))
    ((Tuple "Date32" "Date32") (column-cells-equal (as-days a) (as-days b)))
    ((Tuple "Timestamp" "Timestamp") (column-cells-equal (timestamps-of a) (timestamps-of b)))
    ((Tuple "TimestampTz" "TimestampTz") (column-cells-equal (timestamps-of a) (timestamps-of b)))
    ((Tuple "Boolean" "Boolean")
     (def x (bools-of a))
     (def y (bools-of b))
     (fun (i j) (= (bool-cell x i) (bool-cell y j))))
    ((Tuple "String" "String")
     (def x (as-strings a))
     (def y (as-strings b))
     (fun (i j) (bytes-equal? (string-column-bytes x i) (string-column-bytes y j))))
    ;; Two categories of the same levels compare codes; others, the levels'
    ;; strings.
    ((Tuple "Category" "Category")
     (def x (as-dictionary a))
     (def y (as-dictionary b))
     (if (same-object? (cast System.Object (dictionary-levels x)) (cast System.Object (dictionary-levels y)))
         (column-cells-equal (category-codes-of a) (category-codes-of b))
         (fun (i j) (bytes-equal? (level-bytes x i) (level-bytes y j)))))
    (_ (not-a-key a))))

(: (-> AnyColumn (Column short)))
(defun (as-shorts c) (match c ((:is Apache.Arrow.Int16Array x) (cast (Column short) x)) (_ (not-a-key c))))

(: (-> AnyColumn (Column byte)))
(defun (as-bytes c) (match c ((:is Apache.Arrow.UInt8Array x) (cast (Column byte) x)) (_ (not-a-key c))))

(: (-> AnyColumn (Column ushort)))
(defun (as-ushorts c) (match c ((:is Apache.Arrow.UInt16Array x) (cast (Column ushort) x)) (_ (not-a-key c))))

(: (-> AnyColumn (Column uint)))
(defun (as-uints c) (match c ((:is Apache.Arrow.UInt32Array x) (cast (Column uint) x)) (_ (not-a-key c))))

(: (-> AnyColumn (Column ulong)))
(defun (as-ulongs c) (match c ((:is Apache.Arrow.UInt64Array x) (cast (Column ulong) x)) (_ (not-a-key c))))

;; The days since 1970 of a column of dates.
(: (-> AnyColumn (Column int)))
(defun (as-days c) (match c ((:is Apache.Arrow.Date32Array x) (cast (Column int) x)) (_ (not-a-key c))))

(: (-> AnyColumn (Column long)))
(defun (timestamps-of c)
  (match c
    ((:is Apache.Arrow.TimestampArray x) (cast (Column long) x))
    (_ (not-a-key c))))

(: (-> AnyColumn Apache.Arrow.BooleanArray))
(defun (bools-of c)
  (match c
    ((:is Apache.Arrow.BooleanArray x) x)
    (_ (not-a-key c))))

;; ---------------------------------------------------------------------------
;; The table of the matches

;; What a join keeps: 0 inner, 1 left, 2 semi, 3 anti.
(: (-> Table Table (Array string) int Table))
(defun (join-tables left right keys kind)
  (def lk {arraying (clr-column left (clr-index-of left k)) (:for k keys)})
  (def rk {arraying (clr-column right (clr-index-of right k)) (:for k keys)})
  (def one-key? (= (array-length lk) 1))
  (def parts
    (cond
      ((and one-key? (both-categories? (array-ref lk 0) (array-ref rk 0)))
       (match-categories (array-ref lk 0) (array-ref rk 0) kind))
      (else
       (match (if one-key? (match-integers (array-ref lk 0) (array-ref rk 0) kind) None)
         ((Some parts) parts)
         (None (match-hashes lk rk kind))))))
  (def (Tuple lrows rrows) (matches->arrays parts))
  (def n (array-length lrows))
  (def ln (table-row-count left))
  (def taken-left (if (in-order? lrows ln) left (take-rows left lrows n)))
  (if (>= kind 2)
      taken-left
      (joined-columns left right keys taken-left rrows n)))

;; The keys, from the left table, then the other columns of the left table,
;; then those of the right. A name that both tables have for columns that
;; are not keys gets ".x" in the left one and ".y" in the right.
(: (-> Table Table (Array string) Table (Array int) int Table))
(defun (joined-columns left right keys taken-left rrows n)
  (: (-> string bool))
  (defun (key? name) (any? (fun (k) (= k name)) keys))
  (def left-names (clr-names left))
  (def right-names (clr-names right))
  (: (-> (Array string) string bool))
  (defun (other-column? names name) (and (not (key? name)) (any? (fun (x) (= x name)) names)))
  (def left-schema (clr-schema left))
  (def right-schema (clr-schema right))
  (def taken-right
    (if (in-order? rrows (table-row-count right))
        {arraying (clr-column right i) (:for i (range 0 (table-column-count right)))}
        (clr-take-or-null right rrows)))
  (def key-columns
    {vecing (begin
              (def i (clr-index-of left k))
              (Tuple (schema-field left-schema i) (clr-column taken-left i)))
            (:for k keys)})
  (def left-columns
    {vecing (begin
              (def f (schema-field left-schema i))
              (def name (field-name f))
              (Tuple (if (other-column? right-names name) (clr-new-field (str name ".x") (field-type f)) f)
                     (clr-column taken-left i)))
            (:for i (range 0 (table-column-count left)))
            (:when (not (key? (field-name (schema-field left-schema i)))))})
  (def right-columns
    {vecing (begin
              (def f (schema-field right-schema i))
              (def name (field-name f))
              (Tuple (clr-new-field (if (other-column? left-names name) (str name ".y") name) (field-type f))
                     (array-ref taken-right i)))
            (:for i (range 0 (table-column-count right)))
            (:when (not (key? (field-name (schema-field right-schema i)))))})
  (def all (vec-merge key-columns left-columns right-columns))
  (clr-from-fields {arraying (match c ((Tuple f _) f)) (:for c all)}
                   {arraying (match c ((Tuple _ col) col)) (:for c all)}
                   n))

;; The text of the first problem with the keys, or the empty string: a key
;; that a table does not have, a key of other types in the two tables, a type
;; that cannot be a key, or a name that is a key twice.
(: (-> Table Table (Array string) string))
(defun (join-key-problem left right keys)
  (: (-> string string))
  (defun (problem-of k)
    (def li (clr-index-of left k))
    (def ri (clr-index-of right k))
    (cond
      ((< li 0) (str "the left table has no column '" k "'."))
      ((< ri 0) (str "the right table has no column '" k "'."))
      (else
       (def lt (field-type (schema-field (clr-schema left) li)))
       (def rt (field-type (schema-field (clr-schema right) ri)))
       (cond
         ((not (key-type? lt)) (str "'" k "' is a column of " (clr-arrow-name lt) ", which cannot be a key."))
         ((not (clr-same-type? lt rt))
          (str "'" k "' is a column of " (clr-arrow-name lt) " in the left table and of "
               (clr-arrow-name rt) " in the right."))
         (else "")))))
  (cond
    ((= (array-length keys) 0) "a join needs at least one key.")
    ((let twice ((i 0))
       (cond
         ((= i (array-length keys)) #f)
         ((any? (fun (j) (= (array-ref keys j) (array-ref keys i))) (range 0 i)) #t)
         (else (twice (+ i 1)))))
     "a key is named twice.")
    (else
     (let first ((i 0))
       (cond
         ((= i (array-length keys)) "")
         (else
          (def p (problem-of (array-ref keys i)))
          (if (= p "") (first (+ i 1)) p)))))))

;; Whether columns of the two types are of one type: a timestamp's unit and
;; time zone too, and a dictionary only when both are categories.
(: (-> ArrowType ArrowType bool))
(defun (clr-same-type? a b)
  (and (= (clr-type-id a) (clr-type-id b))
       (match a
         ((:is Apache.Arrow.Types.TimestampType ta)
          (match b
            ((:is Apache.Arrow.Types.TimestampType tb)
             (and (= (timestamp-unit ta) (timestamp-unit tb))
                  (same-clr-string? (timestamp-zone ta) (timestamp-zone tb))))
            (_ #f)))
         (_ #t))
       (match a
         ((:is Apache.Arrow.Types.DictionaryType) (and (category-type? a) (category-type? b)))
         (_ #t))))

;; ---------------------------------------------------------------------------
;; Copies of rows
;;
;; The rows of a table at indices, in that order, in every column: what a
;; `where`, a sort, a join, a distinct and a count keep. A column of numbers,
;; codes, bools or strings is copied as its buffers, read directly; a column
;; of another type is made of slices of its runs of rows.
;;
;; Many rows are copied on the compute threads, each column in parts of
;; `take-part` rows, so that one long column of strings does not take as long
;; as all the others. Most of the time of a copy is spent to get new memory:
;; the operating system gives each page of a new array when it is first
;; written, and the threads get their pages at the same time. The numbers and
;; the bits of all the parts of all the columns are one pass; strings are two,
;; the lengths of each part's strings and then the copy, since a part's
;; strings start where the ones before end. Not one `computing-each` inside
;; another: a thread that waits there could wait for threads that wait too.

;; The rows of a part of a copy: a multiple of 8, so that each part writes
;; whole bytes of a bitmap.
(: take-part int)
(def take-part 65536)

;; Below this many cells, a copy on one thread is faster than the start of the
;; others.
(: take-parallel-cells long)
(def take-parallel-cells 65536L)

;; The table of the rows at the first `count` indices of `rows`, in that order.
(: (-> Table (Array int) int Table))
(defun (take-rows t rows count)
  (check-rows rows count (table-row-count t))
  (def ncols (table-column-count t))
  (def columns
    (cond
      ((>= count (* 2 take-part)) (take-in-parts t rows count))
      ((and (> ncols 1) (>= (* (cast long count) (cast long ncols)) take-parallel-cells))
       (take-each-column t rows count))
      (else
       (def out (: (make-array ncols) (Array AnyColumn)))
       (loop (:for c (range 0 ncols)) (:do (array-set! out c (take-column (clr-column t c) rows 0 count))))
       out)))
  (Table. (clr-schema t) columns count))

;; The columns at the rows, a column on each compute thread.
(: (-> Table (Array int) int (Array AnyColumn)))
(defun (take-each-column t rows count)
  (def taken (computing-each (table-column-count t) (fun (c) (take-column (clr-column t c) rows 0 count))))
  (vec->array taken))

;; Each row is checked once, here, before the copies read the buffers.
(: (-> (Array int) int int void))
(defun (check-rows rows count n)
  (loop (:for i (range 0 count))
        (:do (def r (array-ref rows i))
             (when (or (< r 0) (>= r n))
               (panic! (str "(bjostat query): row " (int->string r) " of a table of " (int->string n)))))))

(: (-> (RoSpan byte) long void))
(defun (check-buffer buffer needed)
  (when (< (cast long (ro-span-length buffer)) needed)
    (panic! "(bjostat query): a column's buffer is shorter than its length says")))

(: (-> ArrayDataOf int ArrowBuffer))
(defun (buffer-of data i) (array-ref (array-data-buffers data) i))

;; How a column of the type is copied: 1 as bits, 2 as strings, 3 as values
;; of a width in bytes, which is the second; 0 as slices.
(: (-> ArrowType (Tuple int int)))
(defun (copy-kind type)
  (: (-> ArrowType (Tuple int int)))
  (defun (whole-bytes t)
    (match t
      ((:is Apache.Arrow.Types.FixedWidthType fw)
       (def bits (bit-width fw))
       (if (and (> bits 0) (= (bitwise-and bits 7) 0)) (Tuple 3 (shift-right bits 3)) (Tuple 0 0)))
      (_ (Tuple 0 0))))
  (match type
    ((:is Apache.Arrow.Types.BooleanType _) (Tuple 1 0))
    ((:is Apache.Arrow.Types.StringType _) (Tuple 2 0))
    ((:is Apache.Arrow.Types.BinaryType _) (Tuple 2 0))
    ;; A category: its codes, with the same levels. A DictionaryType is a
    ;; FixedWidthType too, so this comes first.
    ((:is Apache.Arrow.Types.DictionaryType d) (whole-bytes (dictionary-index-type d)))
    (_ (whole-bytes type))))

;; The column at rows[from] to rows[to - 1].
(: (-> AnyColumn (Array int) int int AnyColumn))
(defun (take-column a rows from to)
  (def data (column-array-data a))
  (def n (- to from))
  (def type (array-data-type data))
  (match (copy-kind type)
    ((Tuple 0 _) (taken-by-slices a rows from to))
    ((Tuple kind width)
     (def (Tuple bitmap nulls) (taken-validity data rows from to))
     (build-column
       (cond
         ((= kind 1)
          (def values (buffer-span (buffer-of data 1)))
          (check-buffer values (quotient (+ (cast long (array-data-offset data)) (cast long (array-data-length data)) 7L) 8L))
          (def (Tuple bits _) (taken-bits values (array-data-offset data) rows from to))
          (data-of type n nulls #[bitmap (ArrowBuffer. (Rom. bits))] (clr-default)))
         ((= kind 2) (taken-strings data rows from to nulls bitmap))
         (else
          (data-of type n nulls #[bitmap (ArrowBuffer. (Rom. (taken-values data width rows from to)))]
                   (array-data-dictionary data))))))))

(: (-> ArrowType int int (Array ArrowBuffer) ArrayDataOf ArrayDataOf))
(defun (data-of type n nulls buffers dictionary)
  (ArrayDataOf. type n nulls 0 buffers (: (clr-default) (Array ArrayDataOf)) dictionary))

;; The validity bitmap of the rows and their number of nulls, read from the
;; bitmap itself. Empty when there are none.
(: (-> ArrayDataOf (Array int) int int (Tuple ArrowBuffer int)))
(defun (taken-validity data rows from to)
  (if (or (= (array-data-null-count data) 0) (buffer-empty? (buffer-of data 0)))
      (Tuple empty-buffer 0)
      (begin
        (def valid (buffer-span (buffer-of data 0)))
        (check-buffer valid (quotient (+ (cast long (array-data-offset data)) (cast long (array-data-length data)) 7L) 8L))
        (def (Tuple bits set) (taken-bits valid (array-data-offset data) rows from to))
        (def nulls (- (- to from) set))
        (Tuple (if (= nulls 0) empty-buffer (ArrowBuffer. (Rom. bits))) nulls))))

;; The bits at the rows, and how many of them are set. Each bit is added to a
;; byte with no jump that depends on it, so a bitmap that is set at random
;; costs no mispredicted jumps. Each byte is written once, when it is full, so
;; the array need not be zeroed first.
(: (-> (RoSpan byte) int (Array int) int int (Tuple (Array byte) int)))
(defun (taken-bits bitmap offset rows from to)
  (def n (- to from))
  (def bits (: (uninitialized-array (shift-right (+ n 7) 3)) (Array byte)))
  (let go ((i 0) (acc 0) (set 0))
    (if (< i n)
        (begin
          (def j (+ offset (array-ref rows (+ from i))))
          (def b (bitwise-and (shift-right (cast int (ro-span-ref bitmap (shift-right j 3))) (bitwise-and j 7)) 1))
          (def now (bitwise-ior acc (shift-left b (bitwise-and i 7))))
          (if (= (bitwise-and i 7) 7)
              (begin (array-set! bits (shift-right i 3) (cast byte now)) (go (+ i 1) 0 (+ set b)))
              (go (+ i 1) now (+ set b))))
        (begin
          (unless (= (bitwise-and n 7) 0) (array-set! bits (shift-right n 3) (cast byte acc)))
          (Tuple bits set)))))

;; The values of `width` bytes at the rows.
(: (-> ArrayDataOf int (Array int) int int (Array byte)))
(defun (taken-values data width rows from to)
  (def bytes (: (uninitialized-array (* (- to from) width)) (Array byte)))
  (gather-values! data width rows from to (array->span bytes))
  bytes)

;; The values of `width` bytes at rows[from] to rows[to - 1], into `into`.
(: (-> ArrayDataOf int (Array int) int int (Span byte) void))
(defun (gather-values! data width rows from to into)
  (def offset (array-data-offset data))
  (def whole (* (+ (cast long offset) (cast long (array-data-length data))) (cast long width)))
  (def values (buffer-span (buffer-of data 1)))
  (check-buffer values whole)
  (def used (ro-span-slice values #:to (cast int whole)))
  (cond
    ((= width 8) (gather! (: (ro-span-> used) (RoSpan long)) offset rows from to (: (span-> into) (Span long))))
    ((= width 4) (gather! (: (ro-span-> used) (RoSpan int)) offset rows from to (: (span-> into) (Span int))))
    ((= width 2) (gather! (: (ro-span-> used) (RoSpan short)) offset rows from to (: (span-> into) (Span short))))
    ((= width 1) (gather! used offset rows from to into))
    (else
     (loop (:for i (range 0 (- to from)))
           (:do (def at (* (+ offset (array-ref rows (+ from i))) width))
                (ro-span-copy! (ro-span-slice used #:from at #:to (+ at width))
                               (span-slice into #:from (* i width) #:to (* (+ i 1) width))))))))

(: (-> (RoSpan %a) int (Array int) int int (Span %a) void))
(defun (gather! values offset rows from to into)
  (loop (:for i (range 0 (- to from)))
        (:do (span-set! into i (ro-span-ref values (+ offset (array-ref rows (+ from i))))))))

;; The offsets of a column of strings, from its offset on: one more than its
;; length. Checked against the buffers.
(: (-> ArrayDataOf (RoSpan int)))
(defun (string-offsets data)
  (def offset (array-data-offset data))
  (def length (array-data-length data))
  (def bytes (buffer-span (buffer-of data 1)))
  (check-buffer bytes (* (+ (cast long offset) (cast long length) 1L) 4L))
  (: (RoSpan int))
  (def offsets (ro-span-> (ro-span-slice bytes #:from (* offset 4) #:to (* (+ offset length 1) 4))))
  (check-buffer (buffer-span (buffer-of data 2)) (cast long (ro-span-ref offsets length)))
  offsets)

;; The strings at the rows: the new offsets first, which give the size of the
;; bytes, and then each string's bytes.
(: (-> ArrayDataOf (Array int) int int int ArrowBuffer ArrayDataOf))
(defun (taken-strings data rows from to nulls bitmap)
  (def offsets (string-offsets data))
  (def n (- to from))
  (def offset-bytes (: (uninitialized-array (* (+ n 1) 4)) (Array byte)))
  (: (Span int))
  (def new-offsets (span-> (array->span offset-bytes)))
  (span-set! new-offsets 0 0)
  (def total
    (let sum ((i 0) (total 0))
      (if (< i n)
          (begin
            (def r (array-ref rows (+ from i)))
            (def next (+ total (- (ro-span-ref offsets (+ r 1)) (ro-span-ref offsets r))))
            (span-set! new-offsets (+ i 1) next)
            (sum (+ i 1) next))
          total)))
  (def bytes (: (uninitialized-array (+ total 16)) (Array byte)))
  (copy-strings! offsets (buffer-span (buffer-of data 2)) rows from to offset-bytes bytes 0 (+ total 16))
  (data-of (array-data-type data) n nulls
           #[bitmap (ArrowBuffer. (Rom. offset-bytes)) (ArrowBuffer. (Rom. bytes 0 total))]
           (clr-default)))

;; The bytes of the strings at rows[from] to rows[to - 1], into `into` from
;; `at` on, each new offset written into `offset-bytes` at its row's place. A
;; string of at most 16 bytes is copied as 16 bytes, with one load and one
;; store: the bytes after it are written over by the next string, or are in
;; the 16 after the end, which the column leaves out. Not when the 16 bytes
;; would end after `end`, where the next part's strings start, which another
;; thread may have written; nor when they would be read past the bytes.
(: (-> (RoSpan int) (RoSpan byte) (Array int) int int (Array byte) (Array byte) int int void))
(defun (copy-strings! offsets bytes rows from to offset-bytes into at end)
  (: (Span int))
  (def new-offsets (span-> (array->span offset-bytes)))
  (def out (array->span into))
  (def last-whole (- (ro-span-length bytes) 16))
  (let copy ((i from) (at at))
    (when (< i to)
      (def r (array-ref rows i))
      (def start (ro-span-ref offsets r))
      (def length (- (ro-span-ref offsets (+ r 1)) start))
      (span-set! new-offsets i at)
      (if (and (<= length 16) (<= start last-whole) (<= (+ at 16) end))
          (store-16! (load-16 (ro-span-slice bytes #:from start #:to (+ start 16)))
                     (span-slice out #:from at #:to (+ at 16)))
          (ro-span-copy! (ro-span-slice bytes #:from start #:to (+ start length))
                         (span-slice out #:from at #:to (+ at length))))
      (copy (+ i 1) (+ at length)))))

;; Any other type: each run of rows that follow one another is a slice, and
;; the slices are put end to end. Fast when the runs are long.
(: (-> AnyColumn (Array int) int int AnyColumn))
(defun (taken-by-slices a rows from to)
  (def slices (: (mutablevec) (MutableVec AnyColumn)))
  (let run ((i from))
    (when (< i to)
      (def start (array-ref rows i))
      (def n (let more ((n 1))
               (if (and (< (+ i n) to) (= (array-ref rows (+ i n)) (+ start n))) (more (+ n 1)) n)))
      (mutablevec-add! slices (slice-column a start n))
      (run (+ i n))))
  (if (= (mutablevec-length slices) 0)
      (slice-column a 0 0)
      (concatenate-columns (cast (ClrReadOnlyList AnyColumn) (mutablevec->array slices)) (clr-default))))

;; A copy of one column at the rows, in parts of `take-part` rows: `kind` and
;; `width` as `copy-kind` says, and a column copied whole when it is 0 or 1.
;; Each part writes its own range of the new arrays.
(type (: TakePlan (Record (: column AnyColumn)
                          (: data ArrayDataOf)
                          (: kind int)
                          (: width int)
                          (: count int)
                          (: parts int)
                          (: values (Array byte))
                          (: offset-bytes (Array byte))
                          ;; The bytes of each part's strings, then where they start.
                          (: part-bytes (Array int))
                          (: bytes (Array byte) #:mutable)
                          (: total int #:mutable)
                          (: valid (Option (Array byte)))
                          ;; The valid bits of each part.
                          (: set (Array int))
                          (: whole (Option AnyColumn) #:mutable))))

(: (-> AnyColumn int int TakePlan))
(defun (take-plan a count parts)
  (def data (column-array-data a))
  (def (Tuple k w) (copy-kind (array-data-type data)))
  (def kind (if (< k 2) 0 k))
  (def length (+ (cast long (array-data-offset data)) (cast long (array-data-length data))))
  (def valid
    (if (or (= kind 0) (= (array-data-null-count data) 0) (buffer-empty? (buffer-of data 0)))
        None
        (begin
          (check-buffer (buffer-span (buffer-of data 0)) (quotient (+ length 7L) 8L))
          (Some (: (uninitialized-array (shift-right (+ count 7) 3)) (Array byte))))))
  (def none (: (make-array 0) (Array byte)))
  (when (= kind 3) (check-buffer (buffer-span (buffer-of data 1)) (* length (cast long w))))
  (when (= kind 2) (ignore (string-offsets data)))
  (TakePlan (column a) (data data) (kind kind) (width w) (count count) (parts parts)
            (values (if (= kind 3) (: (uninitialized-array (* count w)) (Array byte)) none))
            (offset-bytes (if (= kind 2) (: (uninitialized-array (* (+ count 1) 4)) (Array byte)) none))
            (part-bytes (: (make-array (if (= kind 2) parts 0)) (Array int)))
            (bytes none) (total 0) (valid valid)
            (set (: (make-array parts) (Array int)))
            (whole None)))

;; The rows of part p of a plan.
(: (-> TakePlan int (Tuple int int)))
(defun (part-range plan p)
  (Tuple (* p take-part) (min (record-ref plan count) (* (+ p 1) take-part))))

;; The bits and the values of part p, or the bytes of its strings.
(: (-> TakePlan (Array int) int void))
(defun (take-first! plan rows p)
  (def data (record-ref plan data))
  (def kind (record-ref plan kind))
  (def (Tuple from to) (part-range plan p))
  (cond
    ((= kind 0)
     (when (= p 0)
       (record-set! plan (whole (Some (take-column (record-ref plan column) rows 0 (record-ref plan count)))))))
    (else
     (match (record-ref plan valid)
       ((Some valid)
        (def (Tuple bits set) (taken-bits (buffer-span (buffer-of data 0)) (array-data-offset data) rows from to))
        (array-copy! bits 0 valid (shift-right from 3) (array-length bits))
        (array-set! (record-ref plan set) p set))
       (None unit))
     (if (= kind 3)
         (begin
           (def w (record-ref plan width))
           (gather-values! data w rows from to
                           (span-slice (array->span (record-ref plan values)) #:from (* from w) #:to (* to w))))
         (begin
           (def offsets (string-offsets data))
           (def sum (let add ((i from) (sum 0))
                      (if (< i to)
                          (begin
                            (def r (array-ref rows i))
                            (add (+ i 1) (+ sum (- (ro-span-ref offsets (+ r 1)) (ro-span-ref offsets r)))))
                          sum)))
           (array-set! (record-ref plan part-bytes) p sum))))))

;; For strings: where each part's bytes start, and the array of them. Whether
;; the plan is one of strings.
(: (-> TakePlan bool))
(defun (take-between! plan)
  (if (not (= (record-ref plan kind) 2))
      #f
      (begin
        (def part-bytes (record-ref plan part-bytes))
        (def total
          (let start ((p 0) (total 0L))
            (if (< p (record-ref plan parts))
                (begin
                  (def bytes (array-ref part-bytes p))
                  (array-set! part-bytes p (cast int total))
                  (start (+ p 1) (+ total (cast long bytes))))
                total)))
        (when (> total 2147483647L)
          (panic! "(bjostat query): the strings are too many bytes for one column"))
        (record-set! plan (total (cast int total)))
        (record-set! plan (bytes (: (uninitialized-array (+ (cast int total) 16)) (Array byte))))
        (: (Span int))
        (def new-offsets (span-> (array->span (record-ref plan offset-bytes))))
        (span-set! new-offsets (record-ref plan count) (cast int total))
        #t)))

;; For strings: the offsets and the bytes of part p.
(: (-> TakePlan (Array int) int void))
(defun (take-second! plan rows p)
  (when (= (record-ref plan kind) 2)
    (def data (record-ref plan data))
    (def (Tuple from to) (part-range plan p))
    (def part-bytes (record-ref plan part-bytes))
    (def end (if (< (+ p 1) (record-ref plan parts))
                 (array-ref part-bytes (+ p 1))
                 (+ (record-ref plan total) 16)))
    (copy-strings! (string-offsets data) (buffer-span (buffer-of data 2)) rows from to
                   (record-ref plan offset-bytes) (record-ref plan bytes) (array-ref part-bytes p) end)))

(: (-> TakePlan AnyColumn))
(defun (take-result plan)
  (match (record-ref plan whole)
    ((Some c) c)
    (None
     (def data (record-ref plan data))
     (def count (record-ref plan count))
     (def set (loop (:for s (record-ref plan set)) (:acc (summing s))))
     (def nulls (match (record-ref plan valid) ((Some _) (- count set)) (None 0)))
     (def bitmap (match (record-ref plan valid)
                   ((Some valid) (if (= nulls 0) empty-buffer (ArrowBuffer. (Rom. valid))))
                   (None empty-buffer)))
     (build-column
       (if (= (record-ref plan kind) 2)
           (data-of (array-data-type data) count nulls
                    #[bitmap (ArrowBuffer. (Rom. (record-ref plan offset-bytes)))
                      (ArrowBuffer. (Rom. (record-ref plan bytes) 0 (record-ref plan total)))]
                    (clr-default))
           (data-of (array-data-type data) count nulls
                    #[bitmap (ArrowBuffer. (Rom. (record-ref plan values)))]
                    (array-data-dictionary data)))))))

;; The columns at the rows, each in parts of rows.
(: (-> Table (Array int) int (Array AnyColumn)))
(defun (take-in-parts t rows count)
  (def parts (quotient (+ count (- take-part 1)) take-part))
  (def ncols (table-column-count t))
  (def plans (: (make-array ncols) (Array TakePlan)))
  (loop (:for c (range 0 ncols)) (:do (array-set! plans c (take-plan (clr-column t c) count parts))))
  (ignore (computing-each (* ncols parts)
                          (fun (u) (take-first! (array-ref plans (quotient u parts)) rows (% u parts)))))
  (def strings? (loop (:for plan plans) (:acc (summing (if (take-between! plan) 1 0)))))
  (def _copied
    (if (> strings? 0)
        (computing-each (* ncols parts) (fun (u) (take-second! (array-ref plans (quotient u parts)) rows (% u parts))))
        []))
  (def out (: (make-array ncols) (Array AnyColumn)))
  (loop (:for c (range 0 ncols)) (:do (array-set! out c (take-result (array-ref plans c)))))
  out)

;; ---------------------------------------------------------------------------
;; Rows taken with nulls

;; The columns of `t` at the rows; a row of -1 is a null in each column.
(: (-> Table (Array int) (Array AnyColumn)))
(defun (clr-take-or-null t rows)
  (def n (array-length rows))
  (def columns (range 0 (table-column-count t)))
  (cond
    ((not (let missing? ((i 0)) (and (< i n) (or (< (array-ref rows i) 0) (missing? (+ i 1))))))
     (def taken (take-rows t rows n))
     {arraying (clr-column taken c) (:for c columns)})
    ((= (table-row-count t) 0)
     {arraying (clr-nulls (field-type (schema-field (clr-schema t) c)) n) (:for c columns)})
    (else
     ;; The rows that are there, at their places; a missing row takes row 0,
     ;; whose value is then hidden by a null.
     (def fixed-rows (: (make-array n) (Array int)))
     (loop (:for i (range 0 n)) (:do (array-set! fixed-rows i (max (array-ref rows i) 0))))
     (def taken (take-rows t fixed-rows n))
     {arraying (hide-missing (clr-column taken c) rows) (:for c columns)})))

;; The column with a null at each place whose row is -1.
(: (-> AnyColumn (Array int) AnyColumn))
(defun (hide-missing a rows)
  (def data (column-array-data a))
  (def buffers (array-data-buffers data))
  (def offset (array-data-offset data))
  (def has-valid? (not (or (= (array-data-null-count data) 0) (buffer-empty? (array-ref buffers 0)))))
  (def n (array-length rows))
  (def bits (: (make-array (quotient (+ n 7) 8)) (Array byte)))
  (def nulls
    (if has-valid?
        (hidden-bits! bits rows offset (buffer-span (array-ref buffers 0)))
        (hidden-bits-all-valid! bits rows)))
  (def new-buffers {arraying (if (= i 0) (ArrowBuffer. (Rom. bits)) (array-ref buffers i))
                             (:for i (range 0 (array-length buffers)))})
  (build-column (ArrayDataOf. (array-data-type data) (array-data-length data) nulls offset new-buffers
                              (array-data-children data) (array-data-dictionary data))))

;; The bits of the rows that are there and valid in `valid`; the number of
;; the others.
(: (-> (Array byte) (Array int) int (RoSpan byte) int))
(defun (hidden-bits! bits rows offset valid)
  (let set-bits ((i 0) (nulls 0))
    (if (= i (array-length rows))
        nulls
        (begin
          (def bit (+ offset i))
          (if (and (>= (array-ref rows i) 0)
                   (not (= 0 (bitwise-and (cast int (ro-span-ref valid (shift-right bit 3)))
                                          (shift-left 1 (bitwise-and bit 7))))))
              (begin (set-bit! bits i) (set-bits (+ i 1) nulls))
              (set-bits (+ i 1) (+ nulls 1)))))))

(: (-> (Array byte) (Array int) int))
(defun (hidden-bits-all-valid! bits rows)
  (let set-bits ((i 0) (nulls 0))
    (cond
      ((= i (array-length rows)) nulls)
      ((>= (array-ref rows i) 0) (set-bit! bits i) (set-bits (+ i 1) nulls))
      (else (set-bits (+ i 1) (+ nulls 1))))))

(: (-> (Array byte) int void))
(defun (set-bit! bits i)
  (def at (shift-right i 3))
  (array-set! bits at (cast byte (bitwise-ior (cast int (array-ref bits at)) (shift-left 1 (bitwise-and i 7))))))

;; A column of n nulls of the type.
(: (-> ArrowType int AnyColumn))
(defun (clr-nulls type n)
  (: (-> int ArrowBuffer))
  (defun (zeros k) (ArrowBuffer. (Rom. (: (make-array k) (Array byte)))))
  (def bits (zeros (quotient (+ n 7) 8)))
  (: (-> (Array ArrowBuffer) AnyColumn))
  (defun (column-of buffers) (build-column (ArrayDataOf. type n n 0 buffers (: (clr-default) (Array ArrayDataOf)) (: (clr-default) ArrayDataOf))))
  (cond
    ((category-type? type) (category-nulls n))
    (else
     (match type
       ((:is Apache.Arrow.Types.StringType) (column-of #[bits (zeros (* (+ n 1) 4)) empty-buffer]))
       ((:is Apache.Arrow.Types.BinaryType) (column-of #[bits (zeros (* (+ n 1) 4)) empty-buffer]))
       ((:is Apache.Arrow.Types.BooleanType) (column-of #[bits (zeros (quotient (+ n 7) 8))]))
       ((:is Apache.Arrow.Types.FixedWidthType fw) (column-of #[bits (zeros (quotient (* n (bit-width fw)) 8))]))
       (_ (panic! (str "(bjostat table): a column of " (clr-type-name-of type) " cannot be made of nulls")))))))

;; Joins, as dplyr's: the rows of two tables whose keys, columns of the same
;; names in both, are equal. The rows of the left table keep their order, and
;; for each, the right rows it matches come in their order. Two nulls are
;; equal keys, as in dplyr and R's merge.
;;
;;     (inner-join sales regions ["region"])
;;
;; The columns are the keys, then the other columns of the left table, then
;; those of the right. A name that both tables have for columns that are not
;; keys gets ".x" in the left one and ".y" in the right. An Err for a key that
;; a table does not have, or one of other types in the two tables.
(: (-> Table Table (Vec string) int (Result TableError Table)))
(defun (join left right keys kind)
  (def names (vec->array keys))
  (def problem (join-key-problem left right names))
  (if (= problem "")
      (Ok (join-tables left right names kind))
      (refuse problem)))

;; The pairs of rows whose keys are equal.
(: (-> Table Table (Vec string) (Result TableError Table)))
(defun (inner-join left right keys) (join left right keys 0))

;; As inner-join, and also each left row that matches none, with nulls in the
;; columns of the right table.
(: (-> Table Table (Vec string) (Result TableError Table)))
(defun (left-join left right keys) (join left right keys 1))

;; The left rows that match a right row, each once, with the columns of the
;; left table only.
(: (-> Table Table (Vec string) (Result TableError Table)))
(defun (semi-join left right keys) (join left right keys 2))

;; The left rows that match no right row, with the columns of the left table
;; only.
(: (-> Table Table (Vec string) (Result TableError Table)))
(defun (anti-join left right keys) (join left right keys 3))

;; ===========================================================================
;; Reshaping
;; ===========================================================================

;; ---------------------------------------------------------------------------
;; What the reshaping shares
;; ---------------------------------------------------------------------------
;;
;; The reshaping is Bjolang over the kernels of glue/Reshape.cs and
;; glue/Join.cs: the groups of equal keys, the copies of columns and the
;; takes of rows.

(: (-> Table int Field))
(defun (field-at t i) (schema-field (clr-schema t) i))

(: (-> Table int ArrowType))
(defun (type-at t i) (field-type (field-at t i)))

(: (-> AnyColumn ArrowType))
(defun (any-type c) (data-type (clr-data c)))

;; The index of the column `name`, or an Err that names the columns.
(: (-> Table string (Result TableError int)))
(defun (column-index t name)
  (def i (clr-index-of t name))
  (if (< i 0)
      (refuse (str "the table has no column '" name "'. Its columns are: "
                   (string-join (table-names t) ", ") "."))
      (Ok i)))

;; Whether a name comes twice.
(: (-> (Vec string) bool))
(defun (repeats? names)
  (let go ((i 0) (seen (: (map-empty) (Map string bool))))
    (cond
      ((= i (vec-length names)) #f)
      ((map-has-key? seen (vec-ref names i)) #t)
      (else (go (+ i 1) (map-set seen (vec-ref names i) #t))))))

;; The index of each column, in order, or an Err for the first that is not
;; there.
(: (-> Table (Vec string) (Result TableError (Array int))))
(defun (column-indices t names)
  (def out (: (make-array (vec-length names)) (Array int)))
  (let go ((i 0))
    (if (= i (vec-length names))
        (Ok out)
        (match (column-index t (vec-ref names i))
          ((Err e) (Err e))
          ((Ok c)
           (array-set! out i c)
           (go (+ i 1)))))))

;; The columns of the names, or an Err for a name given twice, a name the
;; table does not have, or a column that cannot be a key.
(: (-> Table (Vec string) (Result TableError (Array AnyColumn))))
(defun (key-columns t names)
  (def out (: (make-array (vec-length names)) (Array AnyColumn)))
  (if (repeats? names)
      (refuse "a key is named twice.")
      (let go ((i 0))
        (cond
          ((= i (vec-length names)) (Ok out))
          (:def name (vec-ref names i))
          (:def (Ok c) (column-index t name) :propagate)
          (:def type (type-at t c))
          ((not (key-type? type))
           (refuse (str "'" name "' is a column of " (clr-arrow-name type) ", which cannot be a key.")))
          (else
           (array-set! out i (clr-column t c))
           (go (+ i 1)))))))

;; ---------------------------------------------------------------------------
;; Distinct and append
;; ---------------------------------------------------------------------------

;; The first row of each distinct value of the columns `#:by`, in the order
;; of the rows, with all the columns, as dplyr's distinct with .keep_all.
;; With no `#:by`, all the columns are the key, and the result has no row
;; twice. Two nulls are equal, as in a join.
;;
;;     (table-distinct sales #:by ["customer"])
(: (-> Table (#:by (Vec string)) (Result TableError Table)))
(defun (table-distinct t #:by [])
  (def (Ok keys) (key-columns t (if (vec-empty? by) (table-names t) by)) :propagate)
  ;; Empty when each row is distinct: then the table is the result.
  (def firsts (clr-firsts keys (table-row-count t)))
  (Ok (if (= (array-length firsts) 0)
          t
          (take-rows t firsts (array-length firsts)))))

;; The rows of the tables, one table after the other, as dplyr's bind_rows.
;; Columns are matched by name: the columns are those of the first table, then
;; those that each next table adds, and a table without a column has nulls in
;; it. An Err for a name with columns of two types. Each column is made as a
;; part on (std parallel)'s compute threads, when the result has 65 536 cells
;; or more. Below that, the columns are made on this thread: the start of the
;; parts takes longer than the copies, as for take-rows.
(: (-> (Vec Table) (Result TableError Table)))
(defun (table-append tables)
  (def (Ok fields) (appended-fields tables) :propagate)
  (def rows (loop (:for t tables) (:acc n (folding 0 (+ n (table-row-count t))))))
  (def filled (vec-filter (fun (t) (> (table-row-count t) 0)) tables))
  (def columns
    (if (< (* (cast long rows) (cast long (vec-length fields))) 65536L)
        {vecing (appended-column filled f) (:for f fields)}
        (computing-each (vec-length fields) (fun (c) (appended-column filled (vec-ref fields c))))))
  (Ok (clr-from-fields (vec->array fields) (vec->array columns) rows)))

;; A field of each name, of the type of its first column, in the order the
;; names first come.
(: (-> (Vec Table) (Result TableError (Vec Field))))
(defun (appended-fields tables)
  (let go ((k 0) (i 0) (fields (: [] (Vec Field))) (index (: (map-empty) (Map string int))))
    (cond
      ((= k (vec-length tables)) (Ok fields))
      (:def t (vec-ref tables k))
      ((= i (table-column-count t)) (go (+ k 1) 0 fields index))
      (:def f (field-at t i))
      (:def name (field-name f))
      (else
       (match (map-try-ref index name)
         (None
          (go k (+ i 1) (vec-add fields (clr-new-field name (field-type f))) (map-set index name (vec-length fields))))
         ((Some j)
          (def first (field-type (vec-ref fields j)))
          (if (clr-same-type? first (field-type f))
              (go k (+ i 1) fields index)
              (refuse (str "'" name "' is a column of " (clr-arrow-name first) " in one table and of "
                           (clr-arrow-name (field-type f)) " in another.")))))))))

;; The column of the field: the column of its name of each table, or nulls
;; for a table without one.
(: (-> (Vec Table) Field AnyColumn))
(defun (appended-column tables f)
  (def type (field-type f))
  (def pieces
    {arraying (let ((i (clr-index-of t (field-name f))))
                (if (< i 0) (clr-nulls type (table-row-count t)) (clr-column t i)))
              (:for t tables)})
  (match (array-length pieces)
    (0 (clr-nulls type 0))
    (1 (array-ref pieces 0))
    (_ (clr-concat pieces type))))

;; ---------------------------------------------------------------------------
;; Pivots
;; ---------------------------------------------------------------------------

;; Columns to rows, as tidyr's pivot_longer: each row becomes one row for each
;; of the columns `cols`, with the column's name in `#:names-to` and its value
;; in `#:values-to`. The other columns are repeated. The columns have to be of
;; one type.
;;
;;     ;; country 2024 2025  ->  country year sales
;;     (pivot-longer t ["2024" "2025"] #:names-to "year" #:values-to "sales")
(: (-> Table (Vec string) (#:names-to string) (#:values-to string) (Result TableError Table)))
(defun (pivot-longer t cols #:names-to "name" #:values-to "value")
  (cond
    ((vec-empty? cols) (refuse "pivot-longer needs at least one column."))
    ((repeats? cols) (refuse "a column is named twice."))
    (:def (Ok idx) (column-indices t cols) :propagate)
    (:def type (type-at t (array-ref idx 0)))
    (else
     (match (find (fun (c) (not (clr-same-type? type (type-at t c)))) idx)
       ((Some c)
        (refuse (str "'" (vec-ref cols 0) "' is a column of " (clr-arrow-name type) " and '"
                     (field-name (field-at t c)) "' of " (clr-arrow-name (type-at t c))
                     ": the values of one column have to be of one type.")))
       (None (longer-checked t cols idx type names-to values-to))))))

(: (-> Table (Vec string) (Array int) ArrowType string string (Result TableError Table)))
(defun (longer-checked t cols idx type names-to values-to)
  (def kept {arraying i (:for i (range 0 (table-column-count t))) (:when (not (any? (fun (c) (= c i)) idx)))})
  (def kept-names {vecing (field-name (field-at t i)) (:for i kept)})
  (def n (table-row-count t))
  (def k (array-length idx))
  (cond
    ((= names-to values-to) (refuse (str "the names and the values are both to go in '" names-to "'.")))
    ((any? (fun (s) (= s names-to)) kept-names) (refuse (str "the table has a column '" names-to "' already.")))
    ((any? (fun (s) (= s values-to)) kept-names) (refuse (str "the table has a column '" values-to "' already.")))
    ((> (* (cast long n) (cast long k)) 2147483647L)
     (refuse (str (int->string n) " rows of " (int->string k) " columns are too many rows.")))
    (else (Ok (longer t cols idx kept type names-to values-to n k)))))

;; The rows a pivot to longer takes, at i k + j for row i of `n` and column j
;; of `k`: i, for a kept column.
(: (-> int int (Array int)))
(defun (kept-row-numbers n k)
  (def rows (: (make-array (* n k)) (Array int)))
  (loop (:for i (range 0 n))
        (:do (loop (:for j (range 0 k))
                   (:do (array-set! rows (+ (* i k) j) i)))))
  rows)

;; j n + i, for the values of the columns one after the other.
(: (-> int int (Array int)))
(defun (value-row-numbers n k)
  (def rows (: (make-array (* n k)) (Array int)))
  (loop (:for i (range 0 n))
        (:do (loop (:for j (range 0 k))
                   (:do (array-set! rows (+ (* i k) j) (+ (* j n) i))))))
  rows)

;; Row i, column j of the result is at i k + j. A column of numbers, dates or
;; timestamps is interleaved directly; another is taken through the rows,
;; which are made only when a column needs them.
(: (-> Table (Vec string) (Array int) (Array int) ArrowType string string int int Table))
(defun (longer t cols idx kept type names-to values-to n k)
  (def m (* n k))
  (def nk (array-length kept))
  (def kept-rows
    (if (any? (fun (c) (not (clr-interleavable? (any-type (clr-column t c))))) kept)
        (kept-row-numbers n k)
        (: (make-array 0) (Array int))))
  (def kept-columns
    {arraying (let ((a (clr-column t c)))
                (if (clr-interleavable? (any-type a))
                    (clr-interleaved (make-array k #:fill a) n)
                    (clr-column (take-rows (clr-select t #[c]) kept-rows m) 0)))
              (:for c kept)})
  (def values
    (if (clr-interleavable? type)
        (clr-interleaved {arraying (clr-column t c) (:for c idx)} n)
        (let* ((rows (value-row-numbers n k))
               (whole (if (= k 1)
                          (clr-column t (array-ref idx 0))
                          (clr-concat {arraying (clr-column t c) (:for c idx)} type)))
               (one (clr-from-fields #[(clr-new-field values-to type)] #[whole] (any-length whole))))
          (clr-column (take-rows one rows m) 0))))
  (clr-from-fields
   {arraying (cond
               ((< i nk) (field-at t (array-ref kept i)))
               ((= i nk) (clr-new-field names-to (cast ArrowType clr-string-type)))
               (else (clr-new-field values-to type)))
             (:for i (range 0 (+ nk 2)))}
   {arraying (cond
               ((< i nk) (array-ref kept-columns i))
               ((= i nk) (clr-repeated (vec->array cols) n))
               (else values))
             (:for i (range 0 (+ nk 2)))}
   m))

;; Rows to columns, as tidyr's pivot_wider: a column for each distinct string
;; of `#:names-from`, in the order they first come, with the values of
;; `#:values-from`. The other columns tell the rows apart: one row for each of
;; their distinct values, in the order of the first rows. A cell that no row
;; gives is a null. An Err for two rows with the same values in the other
;; columns and the same name, since a cell holds one value.
;;
;;     ;; country year sales  ->  country 2024 2025
;;     (pivot-wider t #:names-from "year" #:values-from "sales")
(: (-> Table (#:names-from string) (#:values-from string) (Result TableError Table)))
(defun (pivot-wider t #:names-from "name" #:values-from "value")
  (cond
    ((= names-from values-from) (refuse (str "the names and the values are both from '" names-from "'.")))
    (:def (Ok nc) (column-index t names-from) :propagate)
    (:def (Ok vc) (column-index t values-from) :propagate)
    (:def name-col (clr-column t nc))
    (:def strings? (= (clr-type-name name-col) "String"))
    ((not (or strings? (= (clr-type-name name-col) "Category")))
     (refuse (str "'" names-from "' is a column of " (clr-arrow-name (type-at t nc))
                  "; the names of columns have to be strings.")))
    (:def ids {arraying i (:for i (range 0 (table-column-count t))) (:when (not (or (= i nc) (= i vc))))})
    (else
     (match (find (fun (i) (not (key-type? (type-at t i)))) ids)
       ((Some i)
        (refuse (str "'" (field-name (field-at t i)) "' is a column of " (clr-arrow-name (type-at t i))
                     ", which cannot be a key.")))
       (None (wider t names-from vc name-col strings? ids))))))

(: (-> Table string int AnyColumn bool (Array int) (Result TableError Table)))
(defun (wider t names-from vc name-col strings? ids)
  (def n (table-row-count t))
  (def (Tuple group-of firsts) (clr-groups {arraying (clr-column t i) (:for i ids)} n))
  (def rows (array-length firsts))
  (def (Ok (Tuple col-of new-names)) (name-columns names-from name-col strings? n) :propagate)
  (def (Ok cells) (cell-rows names-from group-of col-of new-names rows n) :propagate)
  (def id-names {vecing (field-name (field-at t i)) (:for i ids)})
  (match (find (fun (s) (any? (fun (x) (= x s)) id-names)) new-names)
    ((Some name) (refuse (str "the table has a column '" name "' already.")))
    (None
     (def id-table (take-rows (clr-select t ids) firsts rows))
     (def value-table (clr-select t #[vc]))
     (def type (type-at t vc))
     (def nids (array-length ids))
     (def count (+ nids (array-length new-names)))
     (Ok (clr-from-fields
          {arraying (if (< i nids)
                        (field-at id-table i)
                        (clr-new-field (array-ref new-names (- i nids)) type))
                    (:for i (range 0 count))}
          {arraying (if (< i nids)
                        (clr-column id-table i)
                        (array-ref (clr-take-or-null value-table (array-ref cells (- i nids))) 0))
                    (:for i (range 0 count))}
          rows)))))

;; The new column of each row, and the name of each new column, in the order
;; the names first come. An Err for a null, since a column needs a name.
(: (-> string AnyColumn bool int (Result TableError (Tuple (Array int) (Array string)))))
(defun (name-columns names-from name-col strings? n)
  (cond
    ((> (any-null-count name-col) 0)
     (def r (let go ((r 0)) (if (clr-any-valid? name-col r) (go (+ r 1)) r)))
     (refuse (str "'" names-from "' has a null in row " (int->string r) ", and a column needs a name.")))
    (strings?
     (def s (as-strings name-col))
     (def (Tuple col-of firsts) (clr-string-ids s))
     (Ok (Tuple col-of {arraying (match (string-column-ref s r) ((Some x) x) (None ""))
                                 (:for r firsts)})))
    (else (Ok (category-columns (column-values (as-ints (clr-codes name-col))) (clr-levels name-col) n)))))

;; Of a category: a new column for each code, in the order the codes first
;; come.
(: (-> (RoSpan int) (Array string) int (Tuple (Array int) (Array string))))
(defun (category-columns codes levels n)
  (def code-to-col (make-array (array-length levels) #:fill -1))
  (def col-of (: (make-array n) (Array int)))
  (let go ((r 0) (names (: [] (Vec string))))
    (if (= r n)
        (Tuple col-of (vec->array names))
        (let* ((code (ro-span-ref codes r))
               (c (array-ref code-to-col code)))
          (if (< c 0)
              (begin
                (array-set! code-to-col code (vec-length names))
                (array-set! col-of r (vec-length names))
                (go (+ r 1) (vec-add names (array-ref levels code))))
              (begin
                (array-set! col-of r c)
                (go (+ r 1) names)))))))

;; The row of each cell of each new column, -1 where no row gives one. An Err
;; for two rows of one cell.
(: (-> string (Array int) (Array int) (Array string) int int (Result TableError (Array (Array int)))))
(defun (cell-rows names-from group-of col-of new-names rows n)
  (def cells {arraying (make-array rows #:fill -1) (:for _c (range 0 (array-length new-names)))})
  (let go ((r 0))
    (if (= r n)
        (Ok cells)
        (let* ((c (array-ref col-of r))
               (column (array-ref cells c))
               (g (array-ref group-of r))
               (cell (array-ref column g)))
          (if (>= cell 0)
              (refuse (str "rows " (int->string cell) " and " (int->string r)
                           " have the same values in the other columns, and both '"
                           (array-ref new-names c) "' in '" names-from "': a cell holds one value."))
              (begin
                (array-set! column g r)
                (go (+ r 1))))))))

;; ===========================================================================
;; Counts
;; ===========================================================================

;; The rows are counted in parts on the compute threads once there are two
;; parts of count-part-rows or more. Each part keeps an array of counts when
;; there are at most count-parts-limit values, and the arrays are summed
;; after; with more, the parts add to one array, with atomic-array-increment!.
;;
;; When each key's values can be numbered in the order of table-sort and the
;; numbers of all keys together are at most DenseLimit (Reshape.cs), the
;; numbers of a row are its slot, and the slots that have a count are the
;; result in its order: no groups to find and no sort. A category's codes
;; are such numbers already. Otherwise the groups of the keys are found and
;; put in order (ReshapeOps.GroupsInOrder).

(import/extern
  (uninitialized-ints (: System.GC.AllocateUninitializedArray (-> int bool (Array int)))))

(: int) (def count-part-rows 16384)
(: int) (def count-parts-limit 16384)

;; The number of parts of n rows, and the rows of each but the last.
(: (-> int (Tuple int int)))
(defun (count-parts n)
  (def parts (max 1 (min (quotient n count-part-rows) (compute-thread-count))))
  (Tuple parts (quotient (+ n (- parts 1)) parts)))

;; The first and the end row of part p.
(: (-> int int int (Tuple int int)))
(defun (part-rows p size n) (Tuple (* p size) (min n (* (+ p 1) size))))

(: (-> (Array long) AnyColumn))
(defun (long-column a) (column->any (array->column a)))

;; The elements of `a` at the indices, in their order.
(: (-> (Array %a) (Array int) (Array %a)))
(defun (gathered a indices)
  (def out (: (make-array (array-length indices)) (Array %a)))
  (let go ((i 0))
    (when (< i (array-length indices))
      (array-set! out i (array-ref a (array-ref indices i)))
      (go (+ i 1))))
  out)

;; The table of the keys' columns, with their fields, and the counts after.
(: (-> Table string AnyColumn int Table))
(defun (with-count keys name counts rows)
  (def k (table-column-count keys))
  (clr-from-fields
   {arraying (if (< i k) (field-at keys i) (clr-new-field name (data-type (clr-data counts))))
             (:for i (range 0 (+ k 1)))}
   {arraying (if (< i k) (clr-column keys i) counts) (:for i (range 0 (+ k 1)))}
   rows))

;; How many rows have each value of the columns `keys`, as dplyr's count: a
;; row for each distinct value, with the count in the column `#:name`, in the
;; order of the keys as table-sort gives it. A null is a value. With no keys,
;; one row of the number of rows.
;;
;;     (table-count sales ["region" "product"])
(: (-> Table (Vec string) (#:name string) (Result TableError Table)))
(defun (table-count t keys #:name "n")
  (def n (table-row-count t))
  (cond
    ((some? (find (fun (k) (= k name)) keys))
     (refuse (str "the count and a key are both named '" name "'.")))
    (:def (Ok cols) (key-columns t keys) :propagate)
    (:def (Ok idx) (column-indices t keys) :propagate)
    ((= (array-length cols) 0)
     (def all (long-column (: (make-array 1 #:fill (cast long n)) (Array long))))
     (Ok (clr-from-fields #[(clr-new-field name (data-type (clr-data all)))] #[all] 1)))
    ((and (= (array-length cols) 1) (= (clr-type-name (array-ref cols 0)) "Category"))
     (Ok (count-category t (array-ref idx 0) (array-ref cols 0) name n)))
    (else
     (Ok (match (if (>= n (* 2 count-part-rows)) (count-sorted t idx cols name n) None)
           ((Some counted) counted)
           (None (count-groups t idx cols name n)))))))

;; The counts of the groups of the keys, in the order of the groups' keys.
(: (-> Table (Array int) (Array AnyColumn) string int Table))
(defun (count-groups t idx cols name n)
  (def (Tuple group-of firsts order) (clr-groups-in-order cols n))
  (def counts (group-counts group-of (array-length firsts) n))
  (def rows (array-length order))
  (with-count (take-rows (clr-select t idx) (gathered firsts order) rows) name
              (column->any (clr-longs-at counts order)) rows))

;; The number of rows in each of the groups.
(: (-> (Array int) int int (Array long)))
(defun (group-counts group-of groups n)
  (def counts (: (make-array groups) (Array long)))
  (if (and (>= n (* 2 count-part-rows)) (<= groups count-parts-limit))
      (let ()
        (def (Tuple parts size) (count-parts n))
        (def each (computing-each parts (fun (p)
                                          (def (Tuple from to) (part-rows p size n))
                                          (counted group-of groups from to))))
        (loop (:for pc each) (:do (add-counts! counts pc)))
        counts)
      (let go ((r 0))
        (if (= r n)
            counts
            (let ()
              (def g (array-ref group-of r))
              (array-set! counts g (+ (array-ref counts g) 1L))
              (go (+ r 1)))))))

;; How often each of the ids from 0 to `slots` comes in `ids`, from `from`
;; to `to`.
(: (-> (Array int) int int int (Array int)))
(defun (counted ids slots from to)
  (def pc (: (make-array slots) (Array int)))
  (let go ((r from))
    (when (< r to)
      (def s (array-ref ids r))
      (array-set! pc s (+ (array-ref pc s) 1))
      (go (+ r 1))))
  pc)

(: (-> (Array long) (Array int) Unit))
(defun (add-counts! counts pc)
  (let go ((g 0))
    (when (< g (array-length counts))
      (array-set! counts g (+ (array-ref counts g) (cast long (array-ref pc g))))
      (go (+ g 1)))))

;; The counts by slot, when each key's values can be numbered in the order
;; of table-sort and the slots are at most DenseLimit; or None.
(: (-> Table (Array int) (Array AnyColumn) string int (Option Table)))
(defun (count-sorted t idx cols name n)
  (def k (array-length cols))
  (def col-ids (: (make-array k) (Array (Array int))))
  (def cards (: (make-array k) (Array int)))
  (def slots
    (let go ((c 0) (total 1L))
      (if (= c k)
          (Some total)
          (match (clr-sorted-ids (array-ref cols c))
            (None None)
            ((Some (Tuple ids card))
             (def ck (if (= card 0) 1 card))
             (def more (* total (cast long ck)))
             (array-set! col-ids c ids)
             (array-set! cards c ck)
             (if (> more clr-dense-limit) None (go (+ c 1) more)))))))
  (match slots
    (None None)
    ((Some s) (Some (count-slots t idx col-ids cards (cast int s) name n)))))

;; The slot of each row is its first key's id, times the next key's number
;; of ids, plus its id, and so on. With two keys it is made as each row is
;; counted; with more, first, into the ids of the first key.
(: (-> Table (Array int) (Array (Array int)) (Array int) int string int Table))
(defun (count-slots t idx col-ids cards slots name n)
  (def k (array-length col-ids))
  (def (Tuple parts size) (count-parts n))
  (def ids (array-ref col-ids 0))
  (when (> k 2)
    (ignore (computing-each parts (fun (p)
                                    (def (Tuple from to) (part-rows p size n))
                                    (combine-slots! ids col-ids cards from to)
                                    unit))))
  (def two? (= k 2))
  (def second (if two? (array-ref col-ids 1) ids))
  (def c1 (if two? (array-ref cards 1) 1))
  (def (Tuple slot-counts slot-firsts)
    (if (<= slots count-parts-limit)
        (slot-counts-in-parts ids second c1 two? slots parts size n)
        (slot-counts-atomic ids second c1 two? slots parts size n)))
  (def (Tuple firsts counts)
    (if (>= slots count-part-rows)
        (compacted-in-parts slot-counts slot-firsts parts)
        (compacted slot-counts slot-firsts)))
  (def rows (array-length firsts))
  (with-count (take-rows (clr-select t idx) firsts rows) name (long-column counts) rows))

(: (-> (Array int) (Array (Array int)) (Array int) int int Unit))
(defun (combine-slots! ids col-ids cards from to)
  (def k (array-length col-ids))
  (let go ((r from))
    (when (< r to)
      (def s (let add ((c 1) (s (array-ref ids r)))
               (if (= c k) s (add (+ c 1) (+ (* s (array-ref cards c)) (array-ref (array-ref col-ids c) r))))))
      (array-set! ids r s)
      (go (+ r 1)))))

;; The counts and the first rows of the slots, from one array of each for
;; each part.
(: (-> (Array int) (Array int) int bool int int int int (Tuple (Array int) (Array int))))
(defun (slot-counts-in-parts ids second c1 two? slots parts size n)
  (def each (computing-each parts (fun (p)
                                    (def (Tuple from to) (part-rows p size n))
                                    (slot-part ids second c1 two? slots from to))))
  (def counts (: (make-array slots) (Array int)))
  (def firsts (: (make-array slots #:fill int-max) (Array int)))
  (loop (:for (Tuple pc pf) each) (:do (merge-part! counts firsts pc pf)))
  (Tuple counts firsts))

(: (-> (Array int) (Array int) int bool int int int (Tuple (Array int) (Array int))))
(defun (slot-part ids second c1 two? slots from to)
  (def pc (: (make-array slots) (Array int)))
  (def pf (: (make-array slots #:fill int-max) (Array int)))
  (if two?
      (let go ((r from))
        (when (< r to)
          (def s (+ (* (array-ref ids r) c1) (array-ref second r)))
          (def c (array-ref pc s))
          (when (= c 0) (array-set! pf s r))
          (array-set! pc s (+ c 1))
          (go (+ r 1))))
      (let go ((r from))
        (when (< r to)
          (def s (array-ref ids r))
          (def c (array-ref pc s))
          (when (= c 0) (array-set! pf s r))
          (array-set! pc s (+ c 1))
          (go (+ r 1)))))
  (Tuple pc pf))

(: (-> (Array int) (Array int) (Array int) (Array int) Unit))
(defun (merge-part! counts firsts pc pf)
  (let go ((s 0))
    (when (< s (array-length counts))
      (array-set! counts s (+ (array-ref counts s) (array-ref pc s)))
      (when (< (array-ref pf s) (array-ref firsts s)) (array-set! firsts s (array-ref pf s)))
      (go (+ s 1)))))

;; The counts and a first row of the slots, from one array of counts that
;; the parts add to. A slot's first row is the row of the step that made its
;; count 1; any row of a slot has its keys.
(: (-> (Array int) (Array int) int bool int int int int (Tuple (Array int) (Array int))))
(defun (slot-counts-atomic ids second c1 two? slots parts size n)
  (def counts (: (make-array slots) (Array int)))
  (def firsts (uninitialized-ints slots #f))
  (ignore (computing-each parts (fun (p)
                                  (def (Tuple from to) (part-rows p size n))
                                  (slot-part-atomic! counts firsts ids second c1 two? from to)
                                  unit)))
  (Tuple counts firsts))

(: (-> (Array int) (Array int) (Array int) (Array int) int bool int int Unit))
(defun (slot-part-atomic! counts firsts ids second c1 two? from to)
  (if two?
      (let go ((r from))
        (when (< r to)
          (def s (+ (* (array-ref ids r) c1) (array-ref second r)))
          (when (= (atomic-array-increment! counts s) 1) (array-set! firsts s r))
          (go (+ r 1))))
      (let go ((r from))
        (when (< r to)
          (def s (array-ref ids r))
          (when (= (atomic-array-increment! counts s) 1) (array-set! firsts s r))
          (go (+ r 1))))))

;; The first row and the count of each slot that has a count, in the order
;; of the slots.
(: (-> (Array int) (Array int) (Tuple (Array int) (Array long))))
(defun (compacted counts firsts)
  (def rows (loop (:for c counts) (:acc k (summing (if (> c 0) 1 0)))))
  (def out-firsts (uninitialized-ints rows #f))
  (def out-counts (: (make-array rows) (Array long)))
  (let go ((s 0) (i 0))
    (when (< s (array-length counts))
      (def c (array-ref counts s))
      (if (> c 0)
          (begin
            (array-set! out-firsts i (array-ref firsts s))
            (array-set! out-counts i (cast long c))
            (go (+ s 1) (+ i 1)))
          (go (+ s 1) i))))
  (Tuple out-firsts out-counts))

;; The same, the slots in parts on the compute threads: the slots with a
;; count in each part, then where each part's go, then the copies.
(: (-> (Array int) (Array int) int (Tuple (Array int) (Array long))))
(defun (compacted-in-parts counts firsts parts)
  (def slots (array-length counts))
  (def size (quotient (+ slots (- parts 1)) parts))
  (def in-part (computing-each parts (fun (p)
                                       (def (Tuple from to) (part-rows p size slots))
                                       (loop (:for s (range from to))
                                             (:acc k (summing (if (> (array-ref counts s) 0) 1 0)))))))
  (def starts (: (make-array parts) (Array int)))
  (def rows
    (let go ((p 0) (at 0))
      (if (= p parts)
          at
          (begin (array-set! starts p at) (go (+ p 1) (+ at (vec-ref in-part p)))))))
  (def out-firsts (uninitialized-ints rows #f))
  (def out-counts (: (make-array rows) (Array long)))
  (ignore (computing-each parts (fun (p)
                                  (def (Tuple from to) (part-rows p size slots))
                                  (let go ((s from) (i (array-ref starts p)))
                                    (when (< s to)
                                      (def c (array-ref counts s))
                                      (if (> c 0)
                                          (begin
                                            (array-set! out-firsts i (array-ref firsts s))
                                            (array-set! out-counts i (cast long c))
                                            (go (+ s 1) (+ i 1)))
                                          (go (+ s 1) i))))
                                  unit)))
  (Tuple out-firsts out-counts))

;; The counts of a category's codes, which are in the order of its levels,
;; and a null after them: no groups to find and no sort.
(: (-> Table int AnyColumn string int Table))
(defun (count-category t col cat name n)
  (def levels (clr-level-count cat))
  (def slots (if (= (any-null-count cat) 0) levels (+ levels 1)))
  (def cells (clr-cells-of-column (as-ints (clr-codes cat))))
  (def counts (: (make-array slots) (Array int)))
  (def firsts (: (make-array slots #:fill int-max) (Array int)))
  (if (and (>= n (* 2 count-part-rows)) (<= slots count-parts-limit))
      (let ()
        (def (Tuple parts size) (count-parts n))
        (def each (computing-each parts (fun (p)
                                          (def (Tuple from to) (part-rows p size n))
                                          (code-part cells levels slots from to))))
        (loop (:for (Tuple pc pf) each) (:do (merge-part! counts firsts pc pf))))
      ;; On this thread, into the counts themselves.
      (count-codes-into! cells levels counts firsts 0 n))
  (def (Tuple out-firsts out-counts) (compacted counts firsts))
  (def rows (array-length out-firsts))
  (with-count (take-rows (clr-select t #[col]) out-firsts rows) name (long-column out-counts) rows))

;; The counts and the first rows of the codes from `from` to `to`, a null
;; counted as the code `levels`.
(: (-> (ClrCells int) int int int int (Tuple (Array int) (Array int))))
(defun (code-part cells levels slots from to)
  (def pc (: (make-array slots) (Array int)))
  (def pf (: (make-array slots #:fill int-max) (Array int)))
  (count-codes-into! cells levels pc pf from to)
  (Tuple pc pf))

;; Adds the codes from `from` to `to` to the counts, and their first rows
;; to the first rows that are int-max.
(: (-> (ClrCells int) int (Array int) (Array int) int int Unit))
(defun (count-codes-into! cells levels pc pf from to)
  (if (= (clr-cells-null-count cells) 0)
      (count-codes! (clr-cells-values cells) pc pf from to)
      (count-codes-or-nulls! (clr-cells-values cells) (clr-cells-valid cells) levels pc pf from to)))

(: (-> (RoSpan int) (Array int) (Array int) int int Unit))
(defun (count-codes! codes pc pf from to)
  (let go ((r from))
    (when (< r to)
      (def s (ro-span-ref codes r))
      (def c (array-ref pc s))
      (when (= c 0) (array-set! pf s r))
      (array-set! pc s (+ c 1))
      (go (+ r 1)))))

(: (-> (RoSpan int) (RoSpan byte) int (Array int) (Array int) int int Unit))
(defun (count-codes-or-nulls! codes valid levels pc pf from to)
  (let go ((r from))
    (when (< r to)
      (def bit (bitwise-and (cast int (ro-span-ref valid (shift-right r 3))) (shift-left 1 (bitwise-and r 7))))
      (def s (if (= bit 0) levels (ro-span-ref codes r)))
      (def c (array-ref pc s))
      (when (= c 0) (array-set! pf s r))
      (array-set! pc s (+ c 1))
      (go (+ r 1)))))

;; How many rows have each pair of values of two columns, as R's table(x, y):
;; a row for each value of `row-key`, and a column for each value of
;; `col-key`, named by its text as table->string prints it, with 0 for a
;; pair that no row has. Both are in the order of table-sort, so the levels
;; of a category keep their order. A row with a null in either key is left
;; out, as R does.
;;
;;     (table-crosstab survey "smoker" "sex")
(: (-> Table string string (Result TableError Table)))
(defun (table-crosstab t row-key col-key)
  (cond
    ((= row-key col-key) (refuse (str "the rows and the columns are both of '" row-key "'.")))
    (:def (Ok cols) (key-columns t [row-key col-key]) :propagate)
    (:def (Ok idx) (column-indices t [row-key col-key]) :propagate)
    (else (crosstab-of t (array-ref idx 0) (array-ref cols 0) (array-ref cols 1) row-key col-key))))

;; The counts are kept by the column's group, then the row's: counts[c][r].
;; Without a null they are counted in parts, from one array of each pair for
;; each part or, with more pairs, from one that the parts add to. With a
;; null, on this thread, leaving out each row of a key's null group, and
;; then each group that kept no count.
(: (-> Table int AnyColumn AnyColumn string string (Result TableError Table)))
(defun (crosstab-of t row-idx row-col col-col row-key col-key)
  (def n (table-row-count t))
  (def (Tuple row-of row-firsts row-order) (clr-groups-in-order #[row-col] n))
  (def (Tuple col-of col-firsts col-order) (clr-groups-in-order #[col-col] n))
  (def r-count (array-length row-firsts))
  (def c-count (array-length col-firsts))
  (def nulls? (or (> (any-null-count row-col) 0) (> (any-null-count col-col) 0)))
  (def counts (pair-counts row-of col-of r-count c-count n))
  ;; A row with a null in a key is in that key's null group: its counts are
  ;; made 0, which leaves the counts of the rows with both keys.
  (when nulls?
    (match (null-group row-col row-firsts)
      ((Some rg) (loop (:for cc counts) (:do (array-set! cc rg 0L))))
      (None unit))
    (match (null-group col-col col-firsts)
      ((Some cg) (array-fill! (array-ref counts cg) 0L))
      (None unit)))
  (def active (if nulls? (Some (active-groups counts r-count)) None))
  (def rows (match active ((Some (Tuple ra _)) (kept row-order (fun (rg) (array-ref ra rg)))) (None row-order)))
  (def columns (match active ((Some (Tuple _ ca)) (kept col-order (fun (cg) (array-ref ca cg)))) (None col-order)))
  (def m (array-length rows))
  (def row-table (take-rows (clr-select t #[row-idx]) (gathered row-firsts rows) m))
  (def names {vecing (any->string col-col (array-ref col-firsts cg) -1) (:for cg columns)})
  (match (repeated-name [row-key] names)
    ((Some name)
     (refuse (str "'" col-key "' has the value '" name "', and the table has a column of that name already.")))
    (None
     (def count-columns {arraying (column->any (clr-longs-at (array-ref counts cg) rows)) (:for cg columns)})
     (def k (array-length count-columns))
     (Ok (clr-from-fields
          {arraying (if (= i 0)
                        (field-at row-table 0)
                        (clr-new-field (vec-ref names (- i 1))
                                       (data-type (clr-data (array-ref count-columns (- i 1))))))
                    (:for i (range 0 (+ k 1)))}
          {arraying (if (= i 0) (clr-column row-table 0) (array-ref count-columns (- i 1)))
                    (:for i (range 0 (+ k 1)))}
          m)))))

;; The first of the names that is the row key's or one before it.
(: (-> (Vec string) (Vec string) (Option string)))
(defun (repeated-name taken names)
  (let go ((i 0) (seen (fold (fun (s m) (map-set m s #t)) (: (map-empty) (Map string bool)) taken)))
    (cond
      ((= i (vec-length names)) None)
      ((map-has-key? seen (vec-ref names i)) (Some (vec-ref names i)))
      (else (go (+ i 1) (map-set seen (vec-ref names i) #t))))))

;; The elements of `order` that `keep` keeps, in their order.
(: (-> (Array int) (-> int bool) (Array int)))
(defun (kept order keep)
  {arraying g (:for g order) (:when (keep g))})

;; Which row groups and which column groups kept a count, in one pass.
(: (-> (Array (Array long)) int (Tuple (Array bool) (Array bool))))
(defun (active-groups counts r-count)
  (def ra (: (make-array r-count) (Array bool)))
  (def ca (: (make-array (array-length counts)) (Array bool)))
  (let go ((c 0))
    (when (< c (array-length counts))
      (def cc (array-ref counts c))
      (let each ((rg 0))
        (when (< rg r-count)
          (when (not (= (array-ref cc rg) 0L))
            (array-set! ra rg #t)
            (array-set! ca c #t))
          (each (+ rg 1))))
      (go (+ c 1))))
  (Tuple ra ca))

(: (-> int int (Array (Array long))))
(defun (zero-counts r-count c-count)
  {arraying (: (make-array r-count) (Array long)) (:for _c (range 0 c-count))})

(: (-> (Array int) (Array int) int int int (Array (Array long))))
(defun (pair-counts row-of col-of r-count c-count n)
  (def counts (zero-counts r-count c-count))
  (def pairs (* (cast long c-count) (cast long r-count)))
  (cond
    ((and (>= n (* 2 count-part-rows)) (<= pairs (cast long count-parts-limit)))
     (def (Tuple parts size) (count-parts n))
     (def each (computing-each parts (fun (p)
                                       (def (Tuple from to) (part-rows p size n))
                                       (pair-part row-of col-of r-count (* c-count r-count) from to))))
     (loop (:for pc each) (:do (add-pairs! counts pc r-count)))
     counts)
    ((and (>= n (* 2 count-part-rows)) (<= pairs clr-dense-limit))
     (def (Tuple parts size) (count-parts n))
     (def flat (: (make-array (* c-count r-count)) (Array int)))
     (ignore (computing-each parts (fun (p)
                                     (def (Tuple from to) (part-rows p size n))
                                     (pair-part-atomic! flat row-of col-of r-count from to)
                                     unit)))
     (add-pairs! counts flat r-count)
     counts)
    (else
     (let go ((r 0))
       (when (< r n)
         (def cc (array-ref counts (array-ref col-of r)))
         (def rg (array-ref row-of r))
         (array-set! cc rg (+ (array-ref cc rg) 1L))
         (go (+ r 1))))
     counts)))

;; The count of each pair from `from` to `to`, at column times rows plus row.
(: (-> (Array int) (Array int) int int int int (Array int)))
(defun (pair-part row-of col-of r-count pairs from to)
  (def pc (: (make-array pairs) (Array int)))
  (let go ((r from))
    (when (< r to)
      (def s (+ (* (array-ref col-of r) r-count) (array-ref row-of r)))
      (array-set! pc s (+ (array-ref pc s) 1))
      (go (+ r 1))))
  pc)

(: (-> (Array int) (Array int) (Array int) int int int Unit))
(defun (pair-part-atomic! flat row-of col-of r-count from to)
  (let go ((r from))
    (when (< r to)
      (ignore (atomic-array-increment! flat (+ (* (array-ref col-of r) r-count) (array-ref row-of r))))
      (go (+ r 1)))))

(: (-> (Array (Array long)) (Array int) int Unit))
(defun (add-pairs! counts flat r-count)
  (let go ((c 0))
    (when (< c (array-length counts))
      (def cc (array-ref counts c))
      (def base (* c r-count))
      (let add ((rg 0))
        (when (< rg r-count)
          (array-set! cc rg (+ (array-ref cc rg) (cast long (array-ref flat (+ base rg)))))
          (add (+ rg 1))))
      (go (+ c 1)))))

;; The group of a key's nulls, the one whose first row is a null; None when
;; the key has none.
(: (-> AnyColumn (Array int) (Option int)))
(defun (null-group col firsts)
  (find (fun (g) (not (clr-any-valid? col (array-ref firsts g)))) (range 0 (array-length firsts))))

;; ===========================================================================
;; Categories
;; ===========================================================================
;;
;; A category is a column of strings from a small set, as R's factor: each
;; string, a level, is kept once, and each row has the number of its level,
;; its code. A group-by, a sort or a join on a category works on the codes.
;; Its cells, read as strings, are its levels:
;;
;;     (def (Ok t2) (table-categorize t "region"))
;;     (loop (:for r* (: (ok (column-as t2 "region")) (Cells string))) ...)
;;
;; A sort of a category is in the order of its levels, as in R.

;; The table with the column `name` a category. With no `#:levels`, the
;; levels are its distinct strings in the order of their code points, as R's
;; factor gives them; with `#:levels`, they are those, in that order, and a
;; string that is not one of them is an Err rather than a null, as it would
;; be in R. A null stays a null. A category is given new levels the same way.
;;
;;     (table-categorize t "size" #:levels ["small" "medium" "large"])
(: (-> Table string (#:levels (Vec string)) (Result TableError Table)))
(defun (table-categorize t name #:levels [])
  (match (clr-categorize t name (vec->array levels))
    ((Ok c) (Ok (with-column t name c)))
    ((Err e) (refuse (.-Message e)))))

(: (-> Table string (Result TableError AnyColumn)))
(defun (find-category t name)
  (def (Ok c) (find-column t name) :propagate)
  (match (type-of-column c)
    (Category (Ok c))
    (other (refuse (str "'" name "' is a column of " (type-text other) ", not a category.")))))

;; The levels of the category `name`, in order: level `i` has code `i`.
(: (-> Table string (Result TableError (Vec string))))
(defun (category-levels t name)
  (def (Ok c) (find-category t name) :propagate)
  (Ok (array->vec (clr-levels c))))

;; The codes of the category `name`, as cells of ints, None at a null. A loop
;; over them reads ints from one span, which Bjolang can vectorize.
(: (-> Table string (Result TableError (Cells int))))
(defun (category-codes t name)
  (def (Ok c) (find-category t name) :propagate)
  (codes-of c name))

(: (-> AnyColumn string (Result TableError (Cells int))))
(defun (codes-of c name)
  (match (clr-cells-of (clr-codes c))
    ((Some cells) (Ok (Cells (clr cells))))
    (None (refuse (str "the codes of '" name "' are not ints.")))))

;; The distinct strings of the column of strings `name`, in the order of
;; their first rows, and the number of the string of each row, None at a
;; null: (bjostat query)'s string-groups. Each string is numbered once, in
;; parts on the compute threads.
(: (-> Table string (Result TableError (Tuple (Vec string) (Cells int)))))
(defun (string-numbers t name)
  (def (Ok c) (find-column t name) :propagate)
  (match (type-of-column c)
    (String
     (def numbered (clr-first-seen c))
     (def (Ok codes) (codes-of numbered name) :propagate)
     (Ok (Tuple (array->vec (clr-levels numbered)) codes)))
    (Category (refuse (str "'" name "' is a category: its groups are category-groups, and the group of a row category-codes.")))
    (other (refuse (str "'" name "' is a column of " (type-text other) ", not of strings.")))))

;; ===========================================================================
;; Files
;; ===========================================================================

;; The table of an Arrow IPC file. A file of several record batches is read
;; as one table, each column in one piece, so that it is one span.
(: (-> string (Result TableError Table)))
(defun (read-arrow path)
  (match (clr-read-file path)
    ((Ok (Some t)) (Ok t))
    ((Ok None) (refuse (str path ": " path " has a schema and no record batch, so it has no rows to read.")))
    ((Err e) (refuse (str path ": " (.-Message e))))))

(: (-> Table string (Result TableError Unit)))
(defun (write-arrow t path)
  (match (clr-write-file t path)
    ((Ok _) (Ok unit))
    ((Err e) (refuse (str path ": " (.-Message e))))))

;; ===========================================================================
;; Printing
;; ===========================================================================

;; The table as text: the names, the types, and the first `#:rows` rows, each
;; column as wide as its widest cell. With `#:digits`, a double or float is
;; rounded to that many decimals; one that is not 0 and rounds to 0 is
;; written with that many significant digits, as 2.551e-11.
(: (-> Table (#:rows int) (#:digits int) string))
(defun (table->string t #:rows 10 #:digits -1)
  (def shown (min rows (table-row-count t)))
  (def columns {vecing (clr-column t i) (:for i (range 0 (table-column-count t)))})
  (def cells
    (vec-map (fun (i)
               (def c (vec-ref columns i))
               (vec-add-first (vec-add-first {vecing (any->string c r digits) (:for r (range 0 shown))}
                                             (type-text (type-of-column c)))
                              (vec-ref (table-names t) i)))
             (range-vec (vec-length columns))))
  (def widths (vec-map (fun (col) (fold (fun (s w) (max w (string-length s))) 0 col)) cells))
  (def sb (stringbuilder-empty))
  (loop (:for line (range 0 (+ shown 2)))
        (:do (loop (:for i (range 0 (vec-length cells)))
                   (:do (when (> i 0) (stringbuilder-add-string! sb "  "))
                        (stringbuilder-add-string! sb (string-pad-right (vec-ref (vec-ref cells i) line)
                                                                        (vec-ref widths i)))))
             (stringbuilder-add-string! sb "\n")))
  (when (> (table-row-count t) shown)
    (stringbuilder-add-string! sb (str "… " (int->string (- (table-row-count t) shown)) " more rows\n")))
  (stringbuilder->string sb))

(: (-> int (Vec int)))
(defun (range-vec n) {vecing i (:for i (range 0 n))})
