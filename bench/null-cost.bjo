;; bjostat/bench/null-cost.bjo — where the time of a loop over cells with
;; nulls goes. The same loops over 1 000 000 doubles with no nulls, with one
;; in twenty at random rows, with as many in one run at the start, and with
;; one in a thousand at random rows. If the run is as fast as no nulls, the
;; cost of the random nulls is the processor guessing the test of each null
;; wrong; if it is as slow as the random ones, it is the loop itself.
;;
;;     bjo bench bench/null-cost.bjo --all
;;
;; Run the cases with nulls on their own too: .NET makes the code of a
;; function from a profile of its first calls, so a function first run on
;; cells without nulls is slower afterwards on cells with nulls (the
;; correlation with nulls in both: 4.36 ms after the case without, 3.66
;; alone). And with DOTNET_TieredPGO=0 the correlation takes 10 ms, nulls or
;; not: only the profile makes .NET inline co-moments-add into the loop.

(import (std prelude))
(import (std bench))
(import (bjostat table))
(import (bjostat stats))

(: int) (def rows 1000000)

;; The values, the same in each column, and a null where `null?` says.
(: (-> (-> int bool) (Cells double)))
(defun (column null?)
  (def t (match (make-table [(named "x" (array->column {arraying (cast double (% (* (cast long i) 7919L) 1000L)) (:for i (range 0 rows))}
                                                       #:valid {arraying (not (null? i)) (:for i (range 0 rows))}))])
           ((Ok t) t)
           ((Err e) (panic! (displayed e)))))
  (match (column-as t "x") ((Ok c) c) ((Err e) (panic! (displayed e)))))

;; A pseudo-random one in `n` rows, the same each run.
(: (-> int int bool))
(defun (one-in n i) (= (% (cast int (% (* (cast long i) 2654435761L) 4294967296L)) n) 0))

;; Half the rows, at random. Not (one-in 2 i): the multiplier is odd, so
;; that is every second row, and (one-in 2 (+ i 7)) is the other rows.
(: (-> int bool))
(defun (half-at i) (= (% (/ (% (* (cast long i) 2654435761L) 4294967296L) 4096L) 2L) 0L))

(: (Cells double)) (def none (column (fun (_) #f)))
(: (Cells double)) (def random (column (fun (i) (one-in 20 i))))
(: (Cells double)) (def run (column (fun (i) (< i (/ rows 20)))))
(: (Cells double)) (def few (column (fun (i) (one-in 1000 i))))
(: (Cells double)) (def half (column half-at))
;; A second column for the correlation, with nulls at other rows.
(: (Cells double)) (def none2 (column (fun (_) #f)))
(: (Cells double)) (def random2 (column (fun (i) (one-in 20 (+ i 7)))))
(: (Cells double)) (def run2 (column (fun (i) (< i (/ rows 20)))))
(: (Cells double)) (def few2 (column (fun (i) (one-in 1000 (+ i 7)))))
;; Other rows: 27% of the rows are complete, near the 25% of two columns
;; that do not depend on each other.
(: (Cells double)) (def half2 (column (fun (i) (half-at (+ (* i 3) 1)))))

(: (-> (Cells double) double))
(defun (sum c) (loop (:for x* c) (:when-let (Some x) x*) (:acc (summing x))))
(: (-> (Cells double) (Option double)))
(defun (sd c) (loop (:for x* c) (:when-let (Some x) x*) (:acc (standard-deviation x))))
(: (-> (Cells double) (Cells double) (Option double)))
(defun (cor a b)
  (loop (:for x* a) (:for y* b) (:when-let (Some x) x*) (:when-let (Some y) y*)
        (:acc (correlation (Tuple x y)))))
;; Both valid, with no statistic: the tests alone.
(: (-> (Cells double) (Cells double) long))
(defun (both-valid a b)
  (loop (:for x* a) (:for y* b) (:when-let (Some x) x*) (:when-let (Some y) y*) (:acc (counting x))))
(: (-> (Cells double) (Cells double) double))
(defun (sum-products a b)
  (loop (:for x* a) (:for y* b) (:when-let (Some x) x*) (:when-let (Some y) y*) (:acc (summing (* x y)))))

(: (-> (Cells double) double))
(defun (sum-skip c) (loop (:for x (skip-nulls c)) (:acc (summing x))))
(: (-> (Cells double) (Option double)))
(defun (sd-skip c) (loop (:for x (skip-nulls c)) (:acc (standard-deviation x))))
(: (-> (Cells double) (Cells double) (Option double)))
(defun (cor-complete a b)
  (loop (:for (Tuple x y) (complete-rows (Tuple a b))) (:acc (correlation (Tuple x y)))))

(def/bench "sum, no nulls" (sum none))
(def/bench "sum, 5% random" (sum random))
(def/bench "sum, 5% in a run" (sum run))
(def/bench "sum, 0.1% random" (sum few))
(def/bench "sum, skip-nulls, 5% random" (sum-skip random))
(def/bench "sd, no nulls" (sd none))
(def/bench "sd, 5% random" (sd random))
(def/bench "sd, 5% in a run" (sd run))
(def/bench "sd, 0.1% random" (sd few))
(def/bench "cor, no nulls" (cor none none2))
(def/bench "cor, 5% random" (cor random random2))
(def/bench "cor, 5% in a run" (cor run run2))
(def/bench "cor, 5% random in x only" (cor random none2))
(def/bench "cor, 5% random, the same rows in both" (cor random random))
(def/bench "both valid, no nulls" (both-valid none none2))
(def/bench "both valid, 5% random" (both-valid random random2))
(def/bench "sum of products, no nulls" (sum-products none none2))
(def/bench "sum of products, 5% random" (sum-products random random2))
(def/bench "cor, complete-rows, 5% random" (cor-complete random random2))

;; skip-nulls and complete-rows for each kind of nulls: they find the next
;; row with a value.
(def/bench "skip-nulls sd, no nulls" (sd-skip none))
(def/bench "skip-nulls sd, 0.1% random" (sd-skip few))
(def/bench "skip-nulls sd, 5% random" (sd-skip random))
(def/bench "skip-nulls sd, 5% in a run" (sd-skip run))
(def/bench "skip-nulls sd, 50% random" (sd-skip half))
(def/bench "complete-rows cor, no nulls" (cor-complete none none2))
(def/bench "complete-rows cor, 0.1% random" (cor-complete few few2))
(def/bench "complete-rows cor, 5% in a run" (cor-complete run run2))
(def/bench "complete-rows cor, 50% random" (cor-complete half half2))

(run-benches)
