;; bjostat/bench/compare.bjo — the operations of
;; bench/compare/polars_bench.py, on the same file, as loops a program would
;; write. The results are printed first, to compare with Polars's.
;;
;;     python3 bench/compare/make_data.py scratch/compare.csv
;;     bjo bench bench/compare.bjo --all
;;
;; COMPARE_CSV names another file, as the wide one:
;;
;;     python3 bench/compare/make_data.py scratch/compare-wide.csv wide
;;     COMPARE_CSV=scratch/compare-wide.csv bjo bench bench/compare.bjo --all

(import (std prelude))
(import (std bench))
(import (bjostat table))
(import (bjostat csv))
(import (bjostat query))
(import (bjostat stats))
(import (bjostat models))
(import (only (std maths) round))


(: (-> (Result TableError %a) %a))
(defun (ok r)
  (match r
    ((Ok v) v)
    ((Err e) (panic! (displayed e)))))

(: string)
(def path (match (getenv "COMPARE_CSV") ((Some p) p) (None "scratch/compare.csv")))

;; In a scope of its own: a module's initialiser has none, and a file read
;; on one thread is a port that a scope owns.
(: Table)
(def t (with-scope (ok (read-csv path))))

(: (Cells string))
(def region (ok (column-as t "region")))

(: (Cells double))
(def price (ok (column-as t "price")))

(: (Cells long))
(def qty (ok (column-as t "qty")))

(: (-> Table))
(defun (kept)
  (loop (:for row (range 0 (table-row-count t)))
        (:for p* price) (:for q* qty)
        (:when-let (Some p) p*) (:when-let (Some q) q*)
        (:when (and (> p 250.0) (> q 20L)))
        (:acc (selecting t row))))

(: (-> Table))
(defun (with-revenue)
  (ok (table-with t "revenue"
        (loop (:for p* price) (:for q* qty)
              (:acc (column-building/option
                      (match (Tuple p* q*)
                        ((Tuple (Some p) (Some q)) (Some (* p (cast double q))))
                        (_ None))))))))

(: (-> Table))
(defun (by-region)
  (def groups (group-index))
  (ok (loop (:for r* region) (:for p* price)
            (:when-let (Some r) r*) (:when-let (Some p) p*)
            (:let g (group-of! groups r))
            (:acc sums (summing-by groups (Tuple g p)))
            => (groups->table groups "region" [(Tuple "price" sums)]))))

;; The same with the strings numbered first, in parts on the workers.
(: (-> Table))
(defun (by-region-ids)
  (def (Tuple groups ids) (ok (string-groups t "region")))
  (ok (loop (:for (Tuple g p) (complete-rows (Tuple ids price)))
            (:acc sums (summing-by groups (Tuple g p)))
            => (groups->table groups "region" [(Tuple "price" sums)]))))

(: (-> Table))
(defun (by-qty)
  (def groups (group-index))
  (ok (loop (:for q* qty) (:for p* price)
            (:when-let (Some q) q*) (:when-let (Some p) p*)
            (:let g (group-of! groups q))
            (:acc sums (summing-by groups (Tuple g p)))
            (:acc counts (counting-by groups (Tuple g p)))
            => (groups->table groups "qty" [(Tuple "price" sums) (Tuple "len" counts)]))))


;; Where the filter's time goes: the loop alone, and the copy of each kind of
;; column on its own.
(: (-> Table Table))
(defun (kept-of u)
  (loop (:for row (range 0 (table-row-count t)))
        (:for p* price) (:for q* qty)
        (:when-let (Some p) p*) (:when-let (Some q) q*)
        (:when (and (> p 250.0) (> q 20L)))
        (:acc (selecting u row))))

(def/bench "filter, count only"
  (loop (:for p* price) (:for q* qty)
        (:when-let (Some p) p*) (:when-let (Some q) q*)
        (:when (and (> p 250.0) (> q 20L)))
        (:acc (counting p))))
(def/bench "filter, count only, always true"
  (loop (:for p* price) (:for q* qty)
        (:when-let (Some p) p*) (:when-let (Some q) q*)
        (:when (and (> p -1.0) (> q -1L)))
        (:acc (counting p))))

(def/bench "filter, no columns" (table-row-count (kept-of (ok (table-select t [])))))
(def/bench "filter, numbers" (table-row-count (kept-of (ok (table-select t ["id" "price" "qty"])))))
(def/bench "filter, region" (table-row-count (kept-of (ok (table-select t ["region"])))))
(def/bench "filter, note" (table-row-count (kept-of (ok (table-select t ["note"])))))

;; The new column: the loop of with-revenue.
(def/bench "new column" (table-column-count (with-revenue)))

(def/bench "read csv" (table-row-count (ok (read-csv path))))
(def/bench "filter, kept rows" (table-row-count (kept)))
(def/bench "group by string, sum" (table-row-count (by-region)))
(def/bench "group by string, sum, string-groups" (table-row-count (by-region-ids)))
(def/bench "group by long, sum and count" (table-row-count (by-qty)))
;; A table of each region, in order, with a rate, and one of each id with a
;; number.
(: Table)
(def region-rates
  (let* ((names (ok (table-select (ok (table-count t ["region"])) ["region"])))
         (n (table-row-count names)))
    (ok (table-with names "rate" {column-building (+ 1.0 (* 0.5 (cast double (% i 4)))) (:for i (range 0 n))}))))
(: Table)
(def id-scores
  (ok (make-table [(named "id" (array->column {arraying (cast long i) (:for i (range 0 (table-row-count t)))}))
                   (named "score" (array->column {arraying (cast double (% i 7)) (:for i (range 0 (table-row-count t)))}))])))

(def/bench "join by a string to the keys" (table-row-count (ok (inner-join t region-rates ["region"]))))
(def/bench "join by a long, one to one" (table-row-count (ok (inner-join t id-scores ["id"]))))

(def/bench "standard deviation"
  (loop (:for p* price) (:when-let (Some p) p*) (:acc (standard-deviation p))))
(def/bench "median" (loop (:for p* price) (:when-let (Some p) p*) (:acc (median p))))
(def/bench "correlation"
  (loop (:for p* price) (:for q* qty) (:when-let (Some p) p*) (:when-let (Some q) q*)
        (:acc (correlation (Tuple p (cast double q))))))
(def/bench "summary of the table" (table-row-count (table-summary t)))

(def/bench "sort by a number" (table-row-count (ok (table-sort t [(ascending "price")]))))
(def/bench "sort by a string, then a number"
  (table-row-count (ok (table-sort t [(ascending "region") (descending "price")]))))

;; Reshaping: distinct rows, two copies of the table one after the other,
;; and the two prices of each id as rows, then back as columns.
(: Table)
(def two-prices
  (ok (table-with (ok (table-select t ["id" "price"])) "price2"
                  (loop (:for p* price) (:acc (column-building/option (: p* (Option double))))))))
(: Table)
(def prices-long (ok (pivot-longer two-prices ["price" "price2"])))

(def/bench "distinct by a string and a long" (table-row-count (ok (table-distinct t #:by ["region" "qty"]))))
(def/bench "distinct rows" (table-row-count (ok (table-distinct t))))
(def/bench "append, two tables" (table-row-count (ok (table-append [t t]))))
(def/bench "pivot longer, two columns" (table-row-count (ok (pivot-longer two-prices ["price" "price2"]))))
(def/bench "pivot wider, two columns" (table-row-count (ok (pivot-wider prices-long))))

;; Categories: the region as codes and levels.
(: Table)
(def by-codes (ok (table-categorize t "region")))
(: Table)
(def region-rates-codes (ok (table-categorize region-rates "region")))

(: (-> Table))
(defun (by-category)
  (def groups (ok (category-groups by-codes "region")))
  (ok (loop (:for c* (ok (category-codes by-codes "region"))) (:for p* price)
            (:when-let (Some c) c*) (:when-let (Some p) p*)
            (:acc sums (summing-by groups (Tuple c p)))
            => (groups->table groups "region" [(Tuple "price" sums)]))))

(def/bench "categorize a string column" (table-row-count (ok (table-categorize t "region"))))
(def/bench "group by category, sum" (table-row-count (by-category)))
(def/bench "sort by a category, then a number"
  (table-row-count (ok (table-sort by-codes [(ascending "region") (descending "price")]))))
(def/bench "join by a category to the keys"
  (table-row-count (ok (inner-join by-codes region-rates-codes ["region"]))))

(def/bench "count by a string and a long" (table-row-count (ok (table-count t ["region" "qty"]))))
(def/bench "count by a category" (table-row-count (ok (table-count by-codes ["region"]))))
(def/bench "crosstab of a string and a long" (table-row-count (ok (table-crosstab t "region" "qty"))))

(def/bench "linear model, one predictor"
  (match (loop (:for p* price) (:for q* qty) (:when-let (Some p) p*) (:when-let (Some q) q*)
               (:acc (simple-linear-model "qty" (Tuple p (cast double q)))))
    ((Ok m) (record-ref m r-squared))
    ((Err _) 0.0)))
(def/bench "linear model, three predictors"
  (match (loop (:for p* price) (:for q* qty) (:for i* (: (ok (column-as t "id")) (Cells long)))
               (:when-let (Some p) p*) (:when-let (Some q) q*) (:when-let (Some i) i*)
               (:let x (cast double q))
               (:acc (linear-model ["qty" "qty2" "id"] (Tuple p [x (* x x) (cast double i)]))))
    ((Ok m) (record-ref m r-squared))
    ((Err _) 0.0)))


;; The results, to compare with the other libraries', printed before the
;; runs.
(: (-> double string))
(defun (rounded x) (double->string (/ (round (* x 100.0)) 100.0)))

(: (-> (Option double) string))
(defun (some-text o) (match o ((Some x) (double->string x)) (None "None")))

(: (-> int))
(defun (print-results)
  (def regions (by-region))
  (println (str "kept rows: " (int->string (table-row-count (kept)))))
  (println (str "groups by string: " (int->string (table-row-count regions))
                ", total " (rounded (column-sum (ok (doubles regions "price"))))))
  (println (str "groups by long: " (int->string (table-row-count (by-qty)))))
  (println (str "join by a string to the keys: " (int->string (table-row-count (ok (inner-join t region-rates ["region"]))))))
  (println (str "join by a long: " (int->string (table-row-count (ok (inner-join t id-scores ["id"]))))))
  (println (str "standard deviation: "
                (some-text (loop (:for p* price) (:when-let (Some p) p*) (:acc (standard-deviation p))))))
  (println (str "median: " (some-text (loop (:for p* price) (:when-let (Some p) p*) (:acc (median p))))))
  (println (str "correlation: "
                (some-text (loop (:for (Tuple p q) (complete-rows (Tuple price qty)))
                                 (:acc (correlation (Tuple p (cast double q))))))))
  (println (str "distinct by a string and a long: "
                (int->string (table-row-count (ok (table-distinct t #:by ["region" "qty"]))))))
  (println (str "pivot wider: " (int->string (table-row-count (ok (pivot-wider prices-long))))))
  (println (str "count by a string and a long: " (int->string (table-row-count (ok (table-count t ["region" "qty"]))))))
  (println (str "crosstab rows: " (int->string (table-row-count (ok (table-crosstab t "region" "qty"))))))
  0)

(: int)
(def _printed (print-results))

(run-benches)
