;; License, v. 2.0. If a copy of the MPL was not distributed with this
;; file, You can obtain one at http://mozilla.org/MPL/2.0/.

;; bjostat/src/stats.bjo — the module (bjostat stats): statistics as
;; collectors, and the summary of a table.
;;
;; Each statistic is a collector of doubles, so it is a loop like any other:
;;
;;     (loop (:for p (skip-nulls price)) (:acc (standard-deviation p)))
;;     (loop (:for (Tuple p q) (complete-rows (Tuple price qty)))
;;           (:acc (correlation (Tuple p (cast double q)))))
;;
;; A null is left out by the loop, with skip-nulls, complete-rows or
;; :when-let, where R would need `na.rm = TRUE`. A statistic of too few values is None: the mean of none,
;; the variance of fewer than two. The variance and the standard deviation
;; are those of a sample, with n - 1, as R's `var` and `sd`. The mean, the
;; variance and the covariance are computed in one pass, from sums of the
;; differences from the first value: subtracting a value near the mean first
;; keeps the precision that plain sums of squares lose, and needs no division
;; for each value, as Welford's method does.
;;
;; The quantiles keep all the values and sort them, as R's `quantile` does by
;; default (its type 7).

(export
  Mean Variance StandardDeviation Covariance Correlation
  Quantile quantile Quantiles quantiles Median
  Summary Summarizing summary->string
  table-summary
  ;; The accumulators, opaque
  Moments CoMoments SummaryAcc
  ;; Moments, for other modules' collectors
  no-moments moments-add moments-count moments-mean moments-variance
  ;; Results that combine, for loops in parts (std parallel)
  MomentsOf moments-standard-deviation
  CoMomentsOf co-moments-count co-moments-covariance co-moments-correlation
  Values ValuesOf values-count values-quantile values-quantiles values-median values-summary
  ;; Of a whole column at once, with vector instructions
  column-moments column-variance column-standard-deviation
  column-co-moments column-covariance column-correlation)

(import (std prelude))
(import (std combine))

;; Combinable, for the results of `moments`, `co-moments` and `values`. A
;; re-exported method carries its trait to importers.
(re-export combine combine-all)

(import (std mutable vec))
(import (bjostat table))
(import (bjostat query))
(import (only (std parallel) computing-each))

(import/extern
  (clr-quantiles (: Bjostat.Stats.Quantiles (-> (MutableVec double) (Array double) (Array double))))
  (clr-summarize (: Bjostat.Stats.Summarize (-> (MutableVec double) (Array double))))
  (stats-grow (: Bjostat.Stats.Grow (-> (MutableVec double) int (MutableVec double))))
  (stats-span (: Bjostat.Stats.Span (-> (MutableVec double) int int (Span double))))
  (stats-no-none! (: Bjostat.Stats.NoNone (-> (MutableVec double) int void)))
  (clr-column-moments (: Bjostat.ColumnStats.Moments (-> (Column %a) (Array double))))
  (clr-column-co-moments (: Bjostat.ColumnStats.CoMoments (-> (Column %a) (Column %b) (Array double)))))

;; ===========================================================================
;; Mean and variance, in one pass
;; ===========================================================================

;; How many values, the first of them, and the sums of their differences
;; from the first and of the squares of those.
(type (: Moments #:opaque (Struct (: n long) (: k double) (: s1 double) (: s2 double))))

(: Moments)
(def no-moments (Moments (n 0L) (k 0.0) (s1 0.0) (s2 0.0)))

(: (-> Moments double Moments))
(defun (moments-add m x) #:inline
  (def k (if (= (record-ref m n) 0L) x (record-ref m k)))
  (def d (- x k))
  (Moments (n (+ (record-ref m n) 1L)) (k k)
           (s1 (+ (record-ref m s1) d)) (s2 (+ (record-ref m s2) (* d d)))))

(: (-> Moments long))
(defun (moments-count m) (record-ref m n))

;; The mean of the values; NaN of none.
(: (-> Moments double))
(defun (moments-mean m)
  (+ (record-ref m k) (/ (record-ref m s1) (cast double (record-ref m n)))))

(: (-> Moments (Option double)))
(defun (moments-variance m)
  (def n (cast double (record-ref m n)))
  (def s1 (record-ref m s1))
  (if (< n 2.0) None (Some (max 0.0 (/ (- (record-ref m s2) (/ (* s1 s1) n)) (- n 1.0))))))

(: (-> Moments (Option double)))
(defun (moments-standard-deviation m)
  (match (moments-variance m)
    ((Some v) (Some (sqrt v)))
    (None None)))

;; The moments of the values `a` was made of, then those of `b`. `b`'s sums
;; are moved to `a`'s first value: exact, as each is a sum of differences.
(impl (Combinable Moments)
  (defun (combine a b)
    (cond
      ((= (record-ref b n) 0L) a)
      ((= (record-ref a n) 0L) b)
      (else
       (let* ((nb (cast double (record-ref b n)))
              (d (- (record-ref b k) (record-ref a k)))
              (s1b (record-ref b s1)))
         (Moments (n (+ (record-ref a n) (record-ref b n)))
                  (k (record-ref a k))
                  (s1 (+ (record-ref a s1) (+ s1b (* nb d))))
                  (s2 (+ (record-ref a s2)
                         (+ (record-ref b s2) (+ (* 2.0 (* d s1b)) (* nb (* d d))))))))))))

;; The moments themselves, for a loop whose parts are combined: finished by
;; `moments-mean`, `moments-variance` and `moments-standard-deviation`.
(type (: MomentsOf (Union moments)))

(impl (Collector MomentsOf)
  (type %elem double)
  (type %acc Moments)
  (type %out Moments)
  (defun (collector-init c) no-moments)
  (defun (collector-step c m x) (moments-add m x))
  (defun (collector-finish c m) m))

(type (: Mean (Union mean)))

(impl (Collector Mean)
  (type %elem double)
  (type %acc Moments)
  (type %out (Option double))
  (defun (collector-init c) no-moments)
  (defun (collector-step c m x) (moments-add m x))
  (defun (collector-finish c m)
    (if (= (record-ref m n) 0L) None (Some (moments-mean m)))))

(type (: Variance (Union variance)))

(impl (Collector Variance)
  (type %elem double)
  (type %acc Moments)
  (type %out (Option double))
  (defun (collector-init c) no-moments)
  (defun (collector-step c m x) (moments-add m x))
  (defun (collector-finish c m) (moments-variance m)))

(type (: StandardDeviation (Union standard-deviation)))

(impl (Collector StandardDeviation)
  (type %elem double)
  (type %acc Moments)
  (type %out (Option double))
  (defun (collector-init c) no-moments)
  (defun (collector-step c m x) (moments-add m x))
  (defun (collector-finish c m) (moments-standard-deviation m)))

;; The moments of the values of a column of numbers that are not null, as
;; `moments` collects them, of the whole column at once (glue/ColumnStats.cs):
;;
;;     (column-standard-deviation (or-panic (doubles t "price")))
;;
;; The sums are added in 8 lanes with vector instructions, in an order that
;; is the same on every machine, so a result is too. It differs from the
;; loop's only in the order of the additions: in the last digits. For a
;; column of doubles or longs; another type of number is added one value at a
;; time, in the same order.
(: (-> (Column %a) Moments))
(defun (column-moments c)
  (def v (clr-column-moments c))
  (Moments (n (cast long (array-ref v 0))) (k (array-ref v 1)) (s1 (array-ref v 2)) (s2 (array-ref v 3))))

;; The variance of a sample, as `variance`; None for fewer than two values.
(: (-> (Column %a) (Option double)))
(defun (column-variance c) (moments-variance (column-moments c)))

;; As `standard-deviation`; None for fewer than two values.
(: (-> (Column %a) (Option double)))
(defun (column-standard-deviation c) (moments-standard-deviation (column-moments c)))

;; ===========================================================================
;; Covariance and correlation, in one pass
;; ===========================================================================

;; Of pairs: the count, the first pair, and the sums of the differences from
;; it, of their squares and of their products.
(type (: CoMoments #:opaque (Struct (: n long) (: kx double) (: ky double)
                                    (: sx double) (: sy double)
                                    (: sxx double) (: syy double) (: sxy double))))

(: CoMoments)
(def no-co-moments (CoMoments (n 0L) (kx 0.0) (ky 0.0) (sx 0.0) (sy 0.0) (sxx 0.0) (syy 0.0) (sxy 0.0)))

;; Written #:inline, as moments-add is, so that a loop of a collector of
;; another module has the step in it and not a call: with a call, .NET
;; inlined the step only with its dynamic profile (bench/null-cost.bjo).
(: (-> CoMoments (Tuple double double) CoMoments))
(defun (co-moments-add m xy) #:inline
  (def (x y) xy)
  (def first? (= (record-ref m n) 0L))
  (def kx (if first? x (record-ref m kx)))
  (def ky (if first? y (record-ref m ky)))
  (def dx (- x kx))
  (def dy (- y ky))
  (CoMoments (n (+ (record-ref m n) 1L)) (kx kx) (ky ky)
             (sx (+ (record-ref m sx) dx)) (sy (+ (record-ref m sy) dy))
             (sxx (+ (record-ref m sxx) (* dx dx)))
             (syy (+ (record-ref m syy) (* dy dy)))
             (sxy (+ (record-ref m sxy) (* dx dy)))))

;; The sums of squares and of products about the means: what the sums about
;; the first pair become.
(: (-> CoMoments (Tuple double double double)))
(defun (centred m)
  (def n (cast double (record-ref m n)))
  (def sx (record-ref m sx))
  (def sy (record-ref m sy))
  (Tuple (max 0.0 (- (record-ref m sxx) (/ (* sx sx) n)))
         (max 0.0 (- (record-ref m syy) (/ (* sy sy) n)))
         (- (record-ref m sxy) (/ (* sx sy) n))))

(: (-> CoMoments long))
(defun (co-moments-count m) (record-ref m n))

;; The covariance of a sample; None for fewer than two pairs.
(: (-> CoMoments (Option double)))
(defun (co-moments-covariance m)
  (def n (record-ref m n))
  (def (_ _ sxy) (centred m))
  (if (< n 2L) None (Some (/ sxy (cast double (- n 1L))))))

;; Pearson's correlation; None for fewer than two pairs, and when one side
;; has the same value in each pair.
(: (-> CoMoments (Option double)))
(defun (co-moments-correlation m)
  (def (sxx syy sxy) (centred m))
  (if (or (< (record-ref m n) 2L) (= sxx 0.0) (= syy 0.0))
      None
      (Some (/ sxy (sqrt (* sxx syy))))))

;; As `Moments`: `b`'s sums moved to `a`'s first pair.
(impl (Combinable CoMoments)
  (defun (combine a b)
    (cond
      ((= (record-ref b n) 0L) a)
      ((= (record-ref a n) 0L) b)
      (else
       (let* ((nb (cast double (record-ref b n)))
              (dx (- (record-ref b kx) (record-ref a kx)))
              (dy (- (record-ref b ky) (record-ref a ky)))
              (sxb (record-ref b sx))
              (syb (record-ref b sy)))
         (CoMoments (n (+ (record-ref a n) (record-ref b n)))
                    (kx (record-ref a kx)) (ky (record-ref a ky))
                    (sx (+ (record-ref a sx) (+ sxb (* nb dx))))
                    (sy (+ (record-ref a sy) (+ syb (* nb dy))))
                    (sxx (+ (record-ref a sxx)
                            (+ (record-ref b sxx) (+ (* 2.0 (* dx sxb)) (* nb (* dx dx))))))
                    (syy (+ (record-ref a syy)
                            (+ (record-ref b syy) (+ (* 2.0 (* dy syb)) (* nb (* dy dy))))))
                    (sxy (+ (record-ref a sxy)
                            (+ (record-ref b sxy)
                               (+ (* dx syb) (+ (* dy sxb) (* nb (* dx dy)))))))))))))

;; The moments of pairs themselves, for a loop whose parts are combined:
;; finished by `co-moments-covariance` and `co-moments-correlation`.
(type (: CoMomentsOf (Union co-moments)))

(impl (Collector CoMomentsOf)
  (type %elem (Tuple double double))
  (type %acc CoMoments)
  (type %out CoMoments)
  (defun (collector-init c) no-co-moments)
  (defun (collector-step c m xy) (co-moments-add m xy))
  (defun (collector-finish c m) m))

(type (: Covariance (Union covariance)))

(impl (Collector Covariance)
  (type %elem (Tuple double double))
  (type %acc CoMoments)
  (type %out (Option double))
  (defun (collector-init c) no-co-moments)
  (defun (collector-step c m xy) (co-moments-add m xy))
  (defun (collector-finish c m) (co-moments-covariance m)))

;; Pearson's correlation. None for fewer than two pairs, and when one side
;; has the same value in each pair, as R's `cor` is NA then.
(type (: Correlation (Union correlation)))

(impl (Collector Correlation)
  (type %elem (Tuple double double))
  (type %acc CoMoments)
  (type %out (Option double))
  (defun (collector-init c) no-co-moments)
  (defun (collector-step c m xy) (co-moments-add m xy))
  (defun (collector-finish c m) (co-moments-correlation m)))

;; The moments of the pairs of two columns of numbers where neither is null,
;; as `co-moments` collects them, of the rows of the shorter column at once,
;; as `column-moments`:
;;
;;     (column-correlation (or-panic (doubles t "price")) (or-panic (longs t "qty")))
(: (-> (Column %a) (Column %b) CoMoments))
(defun (column-co-moments x y)
  (def v (clr-column-co-moments x y))
  (CoMoments (n (cast long (array-ref v 0))) (kx (array-ref v 1)) (ky (array-ref v 2))
             (sx (array-ref v 3)) (sy (array-ref v 4))
             (sxx (array-ref v 5)) (syy (array-ref v 6)) (sxy (array-ref v 7))))

;; As `covariance`; None for fewer than two pairs.
(: (-> (Column %a) (Column %b) (Option double)))
(defun (column-covariance x y) (co-moments-covariance (column-co-moments x y)))

;; As `correlation`; None for fewer than two pairs, and when one column has
;; the same value in each pair.
(: (-> (Column %a) (Column %b) (Option double)))
(defun (column-correlation x y) (co-moments-correlation (column-co-moments x y)))

;; ===========================================================================
;; Quantiles
;; ===========================================================================

;; The quantile at p, 0 to 1, as R's `quantile` gives it by default: the
;; value at (n - 1) p in the sorted values, and between two values a straight
;; line between them. NaN when a value is NaN; None when there are none.
(type (: Quantile #:opaque (Struct (: p double))))

(: (-> double Quantile))
(defun (quantile p) (Quantile (p p)))

(: (-> (MutableVec double) (Array double) (Option (Array double))))
(defun (quantiles-of values ps)
  (if (= (mutablevec-length values) 0)
      None
      (Some (clr-quantiles values ps))))

(impl (Collector Quantile)
  (type %elem double)
  (type %acc (MutableVec double))
  (type %out (Option double))
  (defun (collector-init c) (mutablevec))
  (defun (collector-step c acc x) (mutablevec-add! acc x) acc)
  (defun (collector-finish c acc)
    (match (quantiles-of acc (vec->array [(record-ref c p)]))
      ((Some qs) (Some (array-ref qs 0)))
      (None None))))

(impl (BlockCollector Quantile)
  (type %value double)
  (type %acc (MutableVec double))
  (defun (block-count c acc) (mutablevec-length acc))
  (defun (block-grow c acc n) (stats-grow acc n))
  (defun (block-span c acc start n) (stats-span acc start n))
  (defun (block-none! c acc i) (stats-no-none! acc i)))

;; The quantiles at several p, from one sort.
(type (: Quantiles #:opaque (Struct (: ps (Vec double)))))

(: (-> (Vec double) Quantiles))
(defun (quantiles ps) (Quantiles (ps ps)))

(impl (Collector Quantiles)
  (type %elem double)
  (type %acc (MutableVec double))
  (type %out (Option (Vec double)))
  (defun (collector-init c) (mutablevec))
  (defun (collector-step c acc x) (mutablevec-add! acc x) acc)
  (defun (collector-finish c acc)
    (match (quantiles-of acc (vec->array (record-ref c ps)))
      ((Some qs) (Some (array->vec qs)))
      (None None))))

(impl (BlockCollector Quantiles)
  (type %value double)
  (type %acc (MutableVec double))
  (defun (block-count c acc) (mutablevec-length acc))
  (defun (block-grow c acc n) (stats-grow acc n))
  (defun (block-span c acc start n) (stats-span acc start n))
  (defun (block-none! c acc i) (stats-no-none! acc i)))

;; The median: the quantile at 0.5.
(type (: Median (Union median)))

(impl (Collector Median)
  (type %elem double)
  (type %acc (MutableVec double))
  (type %out (Option double))
  (defun (collector-init c) (mutablevec))
  (defun (collector-step c acc x) (mutablevec-add! acc x) acc)
  (defun (collector-finish c acc)
    (match (quantiles-of acc (vec->array [0.5]))
      ((Some qs) (Some (array-ref qs 0)))
      (None None))))

(impl (BlockCollector Median)
  (type %value double)
  (type %acc (MutableVec double))
  (defun (block-count c acc) (mutablevec-length acc))
  (defun (block-grow c acc n) (stats-grow acc n))
  (defun (block-span c acc start n) (stats-span acc start n))
  (defun (block-none! c acc i) (stats-no-none! acc i)))

;; ===========================================================================
;; Summary
;; ===========================================================================

;; What R's `summary` says of numbers: the least, the quartiles, the mean and
;; the greatest, and here also how many there are and the standard deviation.
(type (: Summary (Record (: count long)
                         (: min double) (: q1 double) (: median double)
                         (: mean double) (: q3 double) (: max double)
                         (: sd (Option double)))))

;; The summary of the values, or None when there are none.
(type (: Summarizing (Union summarizing)))

(type (: SummaryAcc #:opaque (Struct (: values (MutableVec double)))))

(impl (Collector Summarizing)
  (type %elem double)
  (type %acc SummaryAcc)
  (type %out (Option Summary))
  (defun (collector-init c) (SummaryAcc (values (mutablevec))))
  (defun (collector-step c acc x)
    (mutablevec-add! (record-ref acc values) x)
    acc)
  (defun (collector-finish c acc) (summary-of (record-ref acc values))))

;; The summary of the values, reordered in place; None of none.
(: (-> (MutableVec double) (Option Summary)))
(defun (summary-of vs)
  (def n (mutablevec-length vs))
  (if (= n 0)
      None
      (let ((q (clr-summarize vs)))
        (Some (Summary (count (cast long n))
                       (min (array-ref q 0)) (q1 (array-ref q 1)) (median (array-ref q 2))
                       (mean (array-ref q 3)) (q3 (array-ref q 4)) (max (array-ref q 5))
                       (sd (if (< n 2) None (Some (array-ref q 6)))))))))

(impl (BlockCollector Summarizing)
  (type %value double)
  (type %acc SummaryAcc)
  (defun (block-count c acc) (mutablevec-length (record-ref acc values)))
  (defun (block-grow c acc n) (SummaryAcc (values (stats-grow (record-ref acc values) n))))
  (defun (block-span c acc start n) (stats-span (record-ref acc values) start n))
  (defun (block-none! c acc i) (stats-no-none! (record-ref acc values) i)))

;; ===========================================================================
;; Values, for quantiles of a loop in parts
;; ===========================================================================

;; The values a loop collected, in the order of their rows. Immutable, so
;; that it combines: the values of `a`, then those of `b`.
(type (: Values #:opaque (Struct (: xs (IArray double)))))

(impl (Combinable Values)
  (defun (combine a b) (Values (xs (combine (record-ref a xs) (record-ref b xs)))))
  (defun (combine-all vs) (Values (xs (combine-all (vec-map (fun (v) (record-ref v xs)) vs))))))

;; The values themselves, for a loop whose parts are combined: finished by
;; `values-quantile`, `values-quantiles`, `values-median` and `values-summary`.
(type (: ValuesOf (Union values)))

(impl (Collector ValuesOf)
  (type %elem double)
  (type %acc (MutableVec double))
  (type %out Values)
  (defun (collector-init c) (mutablevec))
  (defun (collector-step c acc x) (mutablevec-add! acc x) acc)
  (defun (collector-finish c acc) (Values (xs (mutablevec->iarray acc)))))

(impl (BlockCollector ValuesOf)
  (type %value double)
  (type %acc (MutableVec double))
  (defun (block-count c acc) (mutablevec-length acc))
  (defun (block-grow c acc n) (stats-grow acc n))
  (defun (block-span c acc start n) (stats-span acc start n))
  (defun (block-none! c acc i) (stats-no-none! acc i)))

(: (-> Values long))
(defun (values-count v) (cast long (iarray-length (record-ref v xs))))

;; A copy, which the selections of the quantiles reorder.
(: (-> Values (MutableVec double)))
(defun (values-copy v)
  (def xs (record-ref v xs))
  (def out (mutablevec-with-capacity (iarray-length xs)))
  (loop (:for i (range 0 (iarray-length xs)))
        (:do (mutablevec-add! out (iarray-ref xs i))))
  out)

;; As `quantile`: at p, 0 to 1; NaN when a value is NaN; None of none.
(: (-> Values double (Option double)))
(defun (values-quantile v p)
  (match (quantiles-of (values-copy v) (vec->array [p]))
    ((Some qs) (Some (array-ref qs 0)))
    (None None)))

(: (-> Values (Vec double) (Option (Vec double))))
(defun (values-quantiles v ps)
  (match (quantiles-of (values-copy v) (vec->array ps))
    ((Some qs) (Some (array->vec qs)))
    (None None)))

(: (-> Values (Option double)))
(defun (values-median v) (values-quantile v 0.5))

(: (-> Values (Option Summary)))
(defun (values-summary v) (summary-of (values-copy v)))

(: (-> double string))
(defun (number-text x) (displayed x))

(: (-> Summary string))
(defun (summary->string s)
  (str "n " (displayed (record-ref s count))
       ", min " (number-text (record-ref s min))
       ", q1 " (number-text (record-ref s q1))
       ", median " (number-text (record-ref s median))
       ", mean " (number-text (record-ref s mean))
       ", q3 " (number-text (record-ref s q3))
       ", max " (number-text (record-ref s max))
       (match (record-ref s sd) ((Some sd) (str ", sd " (number-text sd))) (None ""))))

;; The values of a column of numbers as doubles, nulls left out, or None for
;; a column of another type. A bool is 0 or 1, so that the mean is the share
;; of trues, as R's mean of a logical vector.
(: (-> Table string ColumnType (Option (Option Summary))))
(defun (column-summary t name type)
  (match type
    (Double (Some (loop (:for x* (ok-cells (doubles-of t name))) (:when-let (Some x) x*)
                        (:acc (summarizing x)))))
    (Float (Some (loop (:for x* (ok-cells (floats-of t name))) (:when-let (Some x) x*)
                       (:acc (summarizing (cast double x))))))
    (Long (Some (loop (:for x* (ok-cells (longs-of t name))) (:when-let (Some x) x*)
                      (:acc (summarizing (cast double x))))))
    (Int (Some (loop (:for x* (ok-cells (ints-of t name))) (:when-let (Some x) x*)
                     (:acc (summarizing (cast double x))))))
    (Short (Some (loop (:for x* (ok-cells (: (column-as t name) (Result TableError (Cells short))))) (:when-let (Some x) x*)
                      (:acc (summarizing (cast double x))))))
    (Byte (Some (loop (:for x* (ok-cells (: (column-as t name) (Result TableError (Cells byte))))) (:when-let (Some x) x*)
                     (:acc (summarizing (cast double x))))))
    (UShort (Some (loop (:for x* (ok-cells (: (column-as t name) (Result TableError (Cells ushort))))) (:when-let (Some x) x*)
                        (:acc (summarizing (cast double x))))))
    (UInt (Some (loop (:for x* (ok-cells (: (column-as t name) (Result TableError (Cells uint))))) (:when-let (Some x) x*)
                      (:acc (summarizing (cast double x))))))
    (ULong (Some (loop (:for x* (ok-cells (: (column-as t name) (Result TableError (Cells ulong))))) (:when-let (Some x) x*)
                       (:acc (summarizing (cast double x))))))
    (Bool (Some (loop (:for x* (ok-cells (bools-of t name))) (:when-let (Some x) x*)
                      (:acc (summarizing (if x 1.0 0.0))))))
    (_ None)))

(: (-> (Result TableError %a) %a))
(defun (ok-cells r)
  (match r
    ((Ok c) c)
    ((Err e) (panic! (displayed e)))))

(: (-> Table string (Result TableError (Cells double))))
(defun (doubles-of t name) (column-as t name))
(: (-> Table string (Result TableError (Cells float))))
(defun (floats-of t name) (column-as t name))
(: (-> Table string (Result TableError (Cells long))))
(defun (longs-of t name) (column-as t name))
(: (-> Table string (Result TableError (Cells int))))
(defun (ints-of t name) (column-as t name))
(: (-> Table string (Result TableError (Cells bool))))
(defun (bools-of t name) (column-as t name))

;; A table with a row for each column of `t`, as R's `summary` of a data
;; frame: its name, its type, how many values and nulls it has, and for a
;; column of numbers or bools the least, the quartiles, the mean, the greatest and the
;; standard deviation, which are null for other columns and for a column of
;; nulls only. Each column is summarized as a part on (std parallel)'s
;; compute threads; a bjoroutine waits for them suspended.
(: (-> Table Table))
(defun (table-summary t)
  (def schema (table-schema t))
  (def rows (cast long (table-row-count t)))
  (def stats
    (computing-each (vec-length schema)
                    (fun (k)
                      (match (vec-ref schema k)
                        ((Tuple name type)
                         (match (column-summary t name type)
                           ((Some s) s)
                           (None None)))))))
  (def nulls {arraying (match (column-nulls t name) ((Some n) (cast long n)) (None 0L))
                       (:for (Tuple name _) schema)})
  (: (-> (-> Summary double) AnyColumn))
  (defun (stat f)
    (loop (:for s stats)
          (:acc (column-building/option (match s ((Some x) (Some (f x))) (None None))))))
  (match (make-table
           [(named-strings "column" (array->string-column {arraying name (:for (Tuple name _) schema)}))
            (named-strings "type" (array->string-column {arraying (displayed type) (:for (Tuple _ type) schema)}))
            (named "count" (array->column {arraying (- rows (array-ref nulls i)) (:for i (range 0 (array-length nulls)))}))
            (named "nulls" (array->column nulls))
            (named-any "min" (stat (fun (s) (record-ref s min))))
            (named-any "q1" (stat (fun (s) (record-ref s q1))))
            (named-any "median" (stat (fun (s) (record-ref s median))))
            (named-any "mean" (stat (fun (s) (record-ref s mean))))
            (named-any "q3" (stat (fun (s) (record-ref s q3))))
            (named-any "max" (stat (fun (s) (record-ref s max))))
            (named-any "sd" (loop (:for s stats)
                                  (:acc (column-building/option
                                          (match s ((Some x) (record-ref x sd)) (None None))))))])
    ((Ok summary) summary)
    ((Err e) (panic! (displayed e)))))
